# ── OpenMapX Docker Deployment ────────────────────────────────────────────
# Copy to .env and fill in values before deploying.

# ── Domain & TLS ─────────────────────────────────────────────────────────
DOMAIN=openmapx.example.com
ACME_EMAIL=admin@example.com

# ── Database ─────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=changeme

# ── Map Tiles ────────────────────────────────────────────────────────────
MAPTILER_KEY=your_maptiler_key

# ── Mapillary ────────────────────────────────────────────────────────────
MAPILLARY_TOKEN=your_mapillary_token
MAPILLARY_CLIENT_ID=
MAPILLARY_CLIENT_SECRET=

# ── Traffic ──────────────────────────────────────────────────────────────
TOMTOM_TRAFFIC_KEY=your_tomtom_key

# ── Transit ──────────────────────────────────────────────────────────────
TRANSIT_LAND_API_KEY=your_transitland_key
TFL_API_KEY=
MBTA_API_KEY=

# ── Air Quality & Fuel ──────────────────────────────────────────────────
WAQI_TOKEN=your_waqi_token
TANKERKOENIG_API_KEY=your_tankerkoenig_key

# ── Auth ─────────────────────────────────────────────────────────────────
# Generate with: npx @better-auth/cli@latest secret
BETTER_AUTH_SECRET=changeme
OSM_CLIENT_ID=
OSM_CLIENT_SECRET=

# ── SMTP (optional) ─────────────────────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=OpenMapX <noreply@openmapx.org>
