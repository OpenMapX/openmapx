# ── OpenMapX Docker Deployment ────────────────────────────────────────────
# Copy to .env and fill in values before deploying.

# ── Domain & TLS ─────────────────────────────────────────────────────────
DOMAIN=openmapx.example.com
ACME_EMAIL=admin@example.com

# ── Database ─────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=changeme

# ── Map Tiles ────────────────────────────────────────────────────────────
# MapTiler key: optional if self-hosting tiles via TileServer GL
# Self-hosted tiles: run ./manage.sh download-style && ./manage.sh build tiles
# then start with --profile tiles
MAPTILER_KEY=

# ── Mapillary ────────────────────────────────────────────────────────────
MAPILLARY_TOKEN=your_mapillary_token
MAPILLARY_CLIENT_ID=
MAPILLARY_CLIENT_SECRET=

# ── Traffic ──────────────────────────────────────────────────────────────
TOMTOM_TRAFFIC_KEY=your_tomtom_key

# ── Transit ──────────────────────────────────────────────────────────────
TRANSIT_LAND_API_KEY=your_transitland_key
TFL_API_KEY=
MBTA_API_KEY=

# ── Air Quality ──────────────────────────────────────────────────────────
OPENAQ_API_KEY=

# ── Wildfires ────────────────────────────────────────────────────────────
FIRMS_MAP_KEY=

# ── EV Charging ──────────────────────────────────────────────────────────
OPENCHARGEMAP_API_KEY=

# ── Fuel Prices ──────────────────────────────────────────────────────────
TANKERKOENIG_API_KEY=

# ── Deutsche Bahn APIs ───────────────────────────────────────────────────
DB_RIS_CLIENT_ID=
DB_RIS_API_KEY=
DB_PARKING_CLIENT_ID=
DB_PARKING_API_KEY=
DB_GBFS_CLIENT_ID=
DB_GBFS_API_KEY=

# ── Auth ─────────────────────────────────────────────────────────────────
# Generate with: npx @better-auth/cli@latest secret
BETTER_AUTH_SECRET=changeme
OSM_CLIENT_ID=
OSM_CLIENT_SECRET=

# ── SMTP (optional) ─────────────────────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=OpenMapX <noreply@openmapx.org>

# ── Self-Hosted Service Tuning (optional) ────────────────────────────────
# Photon geocoder region (default: planet, ~100 GB). Set to your region to save disk.
# Available regions: https://download.geofabrik.de/
# PHOTON_REGION=germany

# Nominatim: download global Wikipedia rankings (improves search result quality)
# NOMINATIM_IMPORT_WIKIPEDIA=false

# Nominatim: import US/GB postcode data (default: false, enable for US/UK deployments)
# NOMINATIM_IMPORT_US_POSTCODES=true
# NOMINATIM_IMPORT_GB_POSTCODES=true

# Nominatim import threads (default: 8)
# NOMINATIM_THREADS=8

# Overpass API disk space limit in bytes (default: 100 GB)
# OVERPASS_SPACE=107374182400

# Overpass FastCGI worker processes (default: 4)
# OVERPASS_FASTCGI_PROCESSES=4

# GitHub token for dynamic transit registry (higher rate limits)
# GITHUB_TOKEN=
