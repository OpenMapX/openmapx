# OpenMapX Docker Deployment
# Copy to .env and fill in values before deploying.

# Domain & TLS
DOMAIN=openmapx.example.com
ACME_EMAIL=admin@example.com

# Database
POSTGRES_PASSWORD=changeme

# Auth
# Generate with: npx @better-auth/cli@latest secret
BETTER_AUTH_SECRET=changeme

# OpenStreetMap OAuth (optional: enables "Sign in with OSM")
OSM_CLIENT_ID=
OSM_CLIENT_SECRET=

# Map Tiles & Styles
# MapTiler key: optional if self-hosting tiles via TileServer GL
MAPTILER_KEY=

# Style provider: "maptiler" (cloud) or "openmapx" (custom self-hosted)
# NEXT_PUBLIC_STYLE_PROVIDER=openmapx

# Self-hosted tile URLs (set when using --profile tiles)
# Traefik routes TileServer GL at /tiles/ on your domain
NEXT_PUBLIC_MAP_STYLE_URL=https://openmapx.example.com/tiles
NEXT_PUBLIC_TILES_URL=https://openmapx.example.com/tiles/data/openmapx.json

# Street-Level Imagery
MAPILLARY_TOKEN=
MAPILLARY_CLIENT_ID=
MAPILLARY_CLIENT_SECRET=

# Cycling Tiles
# Thunderforest OpenCycleMap
# Sign up for a free Hobby Project key at https://www.thunderforest.com/
THUNDERFOREST_API_KEY=

# Traffic
# TRAFFIC_PROVIDER=tomtom
TOMTOM_TRAFFIC_KEY=

# Transit
TRANSIT_LAND_API_KEY=
TFL_API_KEY=
MBTA_API_KEY=

# Weather (optional)
# Enables weather tile layers and higher-priority point data. Radar + Open-Meteo work without it.
OWM_API_KEY=

# Air Quality
OPENAQ_API_KEY=

# Wildfires
FIRMS_MAP_KEY=

# EV Charging
OPENCHARGEMAP_API_KEY=

# Webcams
WINDY_WEBCAMS_API_KEY=

# Fuel Prices
TANKERKOENIG_API_KEY=

# Photos
FLICKR_API_KEY=

# Deutsche Bahn APIs
DB_RIS_CLIENT_ID=
DB_RIS_API_KEY=
DB_PARKING_CLIENT_ID=
DB_PARKING_API_KEY=
DB_GBFS_CLIENT_ID=
DB_GBFS_API_KEY=

# Parking: UTMC Tyne & Wear (Newcastle, UK)
UTMC_USERNAME=
UTMC_PASSWORD=

# Parking: Transport for NSW (Sydney, Australia)
NSW_TRANSPORT_API_KEY=

# Service URLs
# Defaults point to self-hosted Docker containers.
# Uncomment the public fallback URLs to use external services instead.

# Routing
# OSRM_URL=http://osrm:5000
# OSRM_URL=https://router.project-osrm.org

# VALHALLA_URL=http://valhalla:8002
# VALHALLA_URL=https://valhalla1.openstreetmap.de

# Transit
# OTP_URL=http://otp:8080
# MOTIS_URL=http://motis:8080
# TRANSITOUS_URL=https://api.transitous.org

# Geocoding
# PELIAS_URL=http://pelias-api:4000
# NOMINATIM_URL=http://nominatim:8080
# NOMINATIM_URL=https://nominatim.openstreetmap.org
# PHOTON_URL=http://photon:2322
# PHOTON_URL=https://photon.komoot.io

# OSM Queries
# OVERPASS_URL=http://overpass:80
# OVERPASS_URL=https://overpass-api.de

# Geocoding Provider Chain
# Comma-separated list of geocoding providers in priority order.
# Available: photon, nominatim, pelias, maptiler, motis, transitous, db-ris
# GEOCODING_PROVIDER=photon,nominatim,maptiler

# Legal / Imprint
# Required for legal pages (imprint, privacy policy)
# LEGAL_NAME=
# LEGAL_STREET=
# LEGAL_POSTAL_CODE=
# LEGAL_CITY=
# LEGAL_COUNTRY=
# LEGAL_EMAIL=
# LEGAL_PHONE=
# LEGAL_JURISDICTION_CITY=

# Email (for verification emails, 2FA codes, email change)
# Provider is auto-detected from env vars (priority: EmailLabs > Lettermint > SMTP)
# EMAIL_FROM=OpenMapX <noreply@openmapx.org>

# Option 1: EmailLabs (emaillabs.io, Polish EU company, 9k emails/mo free)
# EMAILLABS_APP_KEY=
# EMAILLABS_SECRET_KEY=
# EMAILLABS_SMTP_ACCOUNT=

# Option 2: Lettermint (lettermint.co, Dutch EU company, 300 emails/mo free)
# LETTERMINT_API_TOKEN=

# Option 3: SMTP fallback
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=

# Self-Hosted Service Tuning (optional)
# Photon geocoder region (default: planet, ~100 GB). Set to your region to save disk.
# Available regions: https://download.geofabrik.de/
# PHOTON_REGION=germany

# Nominatim: download global Wikipedia rankings (improves search result quality)
# NOMINATIM_IMPORT_WIKIPEDIA=false

# Nominatim: import US/GB postcode data (default: false, enable for US/UK deployments)
# NOMINATIM_IMPORT_US_POSTCODES=true
# NOMINATIM_IMPORT_GB_POSTCODES=true

# Nominatim import threads (default: 8)
# NOMINATIM_THREADS=8

# Overpass API disk space limit in bytes (default: 100 GB)
# OVERPASS_SPACE=107374182400

# Overpass FastCGI worker processes (default: 4)
# OVERPASS_FASTCGI_PROCESSES=4

# GitHub token for dynamic transit registry (higher rate limits)
# GITHUB_TOKEN=
