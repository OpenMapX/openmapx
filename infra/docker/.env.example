# infra/docker/.env
#
# Copy this file to `.env` in the same directory before running `docker
# compose -f docker-compose.generated.yml up -d`. Docker Compose auto-loads
# `.env` from the directory containing the compose file; the values here are
# substituted into `${VAR}` references in the generated YAML at stack
# startup time.

# Public domain + TLS
# Used by Traefik routing rules, auth URLs (BETTER_AUTH_URL, PASSKEY_RP_ID,
# PASSKEY_ORIGIN), the web app's NEXT_PUBLIC_API_URL, and tile-server URLs.
DOMAIN=openmapx.example.com
ACME_EMAIL=admin@example.com

# Infrastructure
# REQUIRED. The postgis + app-api services use `${POSTGRES_PASSWORD:?...}`
# — docker compose refuses to start with an unset value, which prevents
# production from silently shipping with the old `postgres` default.
# Generate with:   openssl rand -hex 32
POSTGRES_PASSWORD=change-me

# Absolute host path of the OpenMapX repo checkout. REQUIRED.
#
# The app-api container shells out to `docker compose` from inside the
# container to drive service lifecycle and data-maintenance workflows. The
# bind-mount source and target therefore must agree with the actual host
# path. App-api bind-mounts `${OPENMAPX_HOST_DIR}:${OPENMAPX_HOST_DIR}`
# (same path both sides) and points OPENMAPX_ROOT_DIR at it, so compose-
# generated bind sources like `./data` resolve to a real path on the Docker
# host.
#
# The manifest uses `${OPENMAPX_HOST_DIR:?…}` so compose fails loud when
# this is missing, instead of silently binding to a throwaway path.
#
# Find the right value with:   pwd   (from the repo root)
OPENMAPX_HOST_DIR=

# Community integrations installed by the admin panel or CLI are stored under
# `${OPENMAPX_HOST_DIR}/custom_integrations` on the host and mounted here in
# the app-api container. Leave this at the default unless you also change the
# app-api bind mount target.
OPENMAPX_CUSTOM_INTEGRATIONS_DIR=/app/custom_integrations

# Host UID/GID for bind-mounted volumes (Linux). macOS/Windows typically
# don't need these — Docker Desktop handles ownership automatically.
# UID=1000
# GID=1000

# Authentication secrets (REQUIRED)
# Better Auth session signing key. No fallback — the API refuses to start
# without it. Generate with:   npx @better-auth/cli@latest secret
BETTER_AUTH_SECRET=

# Symmetric key used to encrypt integration secrets in the vault
# (`integration_secret` table). 32 bytes, hex-encoded (64 chars). Generate
# with:   openssl rand -hex 32
# If unset, integrations that store secrets via the admin panel will refuse
# to decrypt on subsequent API restarts.
OPENMAPX_SECRETS_KEY=

# Internal service auth (REQUIRED in production)
# Shared secret between app-api and the data-manager service. Every
# mutation endpoint on the data-manager (downloads, hardlinks, dataset
# reload, conversions) requires it as an Authorization bearer / X-Data-
# Manager-Token header. Without it set, the data-manager refuses to start
# in production and generates a random ephemeral token in development.
# Generate with:   openssl rand -hex 32
DATA_MANAGER_AUTH_TOKEN=

# Base URL apps/api uses to reach the data-manager. Defaults to
# `http://localhost:4000` for `pnpm dev`; docker-compose overrides this to
# the service-network DNS name (e.g. `http://data-manager:4000`).
# DATA_MANAGER_URL=http://data-manager:4000

# Cron schedule for the daily Transitous sync (E7). Use `disabled` to
# turn it off entirely (e.g. on staging where you trigger manually).
# TRANSITOUS_SYNC_CRON=0 3 * * *
# Cron schedule for the feed-proxy nginx-reload heartbeat. Heartbeat
# re-reads feed-proxy.conf when it's newer than the last reload and bounces
# nginx if so — small safety-net against a missed reload during sync.
# TRANSITOUS_FEED_PROXY_RELOAD_CRON=*/15 * * * *

# Transitous feed-proxy age private key (optional). The data-manager service
# bind-mounts `infra/docker/secrets/transitous-feed-proxy.age` from the host
# to `/secrets/transitous-feed-proxy.age` inside the container, and exports
# `TRANSITOUS_FEED_PROXY_KEY_FILE=/secrets/transitous-feed-proxy.age` so
# Transitous's `src/utils.py` can decrypt `AGE-ENCRYPTED:` feed values. The
# mount is omitted automatically when the host file is absent (the renderer
# logs an advisory and encrypted feeds are skipped at fetch time).
#
# To enable: generate the key, place it at the host path, and re-render
# compose. See `infra/docker/secrets/README.md` for the generation steps.
# There's no env-var to set here — drop the file at the documented path.

# Shared secret for the CLI ↔ API loopback admin short-circuit. When set,
# requests from 127.0.0.1 / ::1 only become admin if they carry a matching
# X-OpenMapX-Local-Admin header — which blocks browser-originated CSRF
# against `http://127.0.0.1:<port>/api/...` from a malicious site. The
# openmapx CLI attaches it automatically. In production with no token, the
# loopback bypass is denied entirely and the CLI needs a session cookie
# from the web login flow. Generate with:   openssl rand -hex 32
OPENMAPX_LOCAL_ADMIN_TOKEN=

# Social login (OAuth, optional)
# OpenStreetMap: https://www.openstreetmap.org/oauth2/applications
# OSM_CLIENT_ID=
# OSM_CLIENT_SECRET=

# Mapillary: https://www.mapillary.com/dashboard/developers (re-uses the
# same app as MAPILLARY_TOKEN below)
# MAPILLARY_CLIENT_ID=
# MAPILLARY_CLIENT_SECRET=

# Map style / tiles (baked into the web container via NEXT_PUBLIC_*)
# Pick a tile source. `maptiler` uses MapTiler Cloud (requires a key).
# `openmapx` uses the self-hosted tile stack (requires tiles profile).
NEXT_PUBLIC_STYLE_PROVIDER=maptiler

# MapTiler API key. Also settable in /admin/settings → Map (MapTiler API
# Key). Leave commented to manage from the admin UI; uncomment to lock a
# value for this deployment (env always wins over admin-stored values).
# MAPTILER_KEY=

# NEXT_PUBLIC_MAP_STYLE_URL — base URL of the self-hosted tileserver-gl.
# The web app appends `/styles/<style>/style.json` per
# request. With the built-in Traefik route this is ${DOMAIN}/tiles.
# NEXT_PUBLIC_MAP_STYLE_URL=https://openmapx.example.com/tiles
# NEXT_PUBLIC_TILES_URL=https://openmapx.example.com/tiles/data/openmapx.json

# Web-app tile overrides. All NEXT_PUBLIC_* except NEXT_PUBLIC_API_URL are
# read per-request via the EnvProvider context (server-side process.env →
# React context → client), so runtime values in this file reach both server
# and client components without a rebuild.
# NEXT_PUBLIC_TRAFFIC_MIN_ZOOM=10
# NEXT_PUBLIC_TRAFFIC_TILE_URL_TEMPLATE=
# NEXT_PUBLIC_CYCLOSM_TILE_URL_TEMPLATE=
# NEXT_PUBLIC_TERRAIN_TILE_URL_TEMPLATE=

# Street-level imagery (apps/api `/streetview/images` route)
# The photos-mapillary integration is configured separately in the admin UI.
#
# MAPILLARY_TOKEN stays server-side. It is used by /api/mapillary/* (vector
# tile proxy) and any integration that fetches Mapillary on behalf of the
# user. NEVER set NEXT_PUBLIC_MAPILLARY_TOKEN to this value directly — Next.js
# would bundle it into the JS the browser downloads.
MAPILLARY_TOKEN=

# Optional client token for the in-browser Mapillary viewer (Pegman → Street
# View). This is intentionally separate from MAPILLARY_TOKEN above:
#   - It ships in the public JS bundle (visible to every visitor).
#   - Use a DEDICATED Mapillary OAuth app with read-only scope and a quota
#     you're comfortable exposing.
#   - Leave this unset to hide Street View from the UI entirely.
# MAPILLARY_VIEWER_TOKEN=

# Backend URL fallbacks / manual overrides
# Primary resolution for self-hosted backends now comes from the service
# registry (`ctx.getRequiredService(...)`) where applicable. These env vars
# remain as explicit overrides and fallback URLs for apps/api direct-call
# helpers plus shared helper packages used by some integrations.
#
# Set them when a backend runs outside the compose stack, or when you want
# to force a custom/public endpoint instead of the resolved self-hosted one.
#
#   - OSRM_URL                       → apps/api road-snap (driving/walking/cycling)
#   - VALHALLA_URL, VALHALLA_API_KEY → apps/api isochrone, elevation, road-snap
#                                      (bus) + the Valhalla routing/directions provider
#   - MOTIS_URL                → apps/api motis manager + shared local MOTIS helpers
#   - OVERPASS_URL             → packages/core/src/utils/overpass/client.ts
#   - NOMINATIM_URL            → packages/shared-mobility/nominatim.ts
#                                (station reverse-geocoding for bike / scooter
#                                 / car sharing)
#   - TRANSITOUS_URL           → packages/shared-mobility/motis-rentals.ts
#                                (rental POIs for shared-mobility integrations)
# Valhalla: the old free FOSSGIS demo (valhalla1.openstreetmap.de) is
# unreliable, so the default is now Stadia Maps' hosted Valhalla — same endpoint
# paths, but it REQUIRES an API key (free non-commercial tier; sign up at
# https://stadiamaps.com/). Set VALHALLA_API_KEY. For EU data residency use
# https://api-eu.stadiamaps.com. A self-hosted Valhalla (e.g. the bundled
# `valhalla` service) needs no key — point VALHALLA_URL at it, leave the key blank.
# OSRM_URL=http://osrm:5000
# VALHALLA_URL=https://api.stadiamaps.com
# VALHALLA_API_KEY=
# MOTIS_URL=http://motis:8081
# OVERPASS_URL=http://overpass:80
# NOMINATIM_URL=http://nominatim:8080
# TRANSITOUS_URL=https://api.transitous.org

# Regional defaults (used by the CLI + selected services)
# The `openmapx` CLI auto-loads `infra/docker/.env`, so you can keep regional
# defaults here instead of repeating CLI flags.
#
# Shared default for OSM-region selectors like:
#   - `pnpm openmapx data download osm`
#   - `pnpm openmapx services build ...`
#   - `pnpm openmapx data convert overpass`
# OPENMAPX_REGION=europe/germany
#
# Per-service build overrides. These win over OPENMAPX_REGION for the matching
# build target when `--region` is omitted.
# OSRM_REGION=europe/germany
# OTP_REGION=europe/germany
# MOTIS_REGION=planet
# PELIAS_REGION=europe/germany
# TILESERVER_REGION=europe/germany
# OVERPASS_REGION=europe/germany
#
# Transitous / GTFS country filter. Used by:
#   - `pnpm openmapx data download gtfs`
#   - MOTIS Transitous config generation during `pnpm openmapx services build motis`
# TRANSITOUS_COUNTRIES=de,at,ch
#
# Photon runtime download region.
PHOTON_REGION=planet

# Service tuning (forwarded into the backend containers)
# Nominatim (self-hosted geocoder)
NOMINATIM_THREADS=8
NOMINATIM_IMPORT_WIKIPEDIA=true
NOMINATIM_IMPORT_GB_POSTCODES=false
NOMINATIM_IMPORT_US_POSTCODES=false

# Overpass API
OVERPASS_SPACE=107374182400
OVERPASS_FASTCGI_PROCESSES=4

# Traffic + tile-proxy (apps/api)
# TomTom Flow tile proxy. Sign up at https://developer.tomtom.com/
TRAFFIC_PROVIDER=tomtom
TOMTOM_TRAFFIC_KEY=
# TOMTOM_TRAFFIC_URL=https://api.tomtom.com
# TOMTOM_TRAFFIC_VERSION=4
# TOMTOM_TRAFFIC_STYLE=relative-delay
# TOMTOM_TRAFFIC_TILE_SIZE=256
# TOMTOM_TRAFFIC_THICKNESS=2

# Thunderforest OpenCycleMap (free Hobby Project key at
# https://www.thunderforest.com/)
THUNDERFOREST_API_KEY=

# Optional tile-URL overrides for the apps/api tile proxy
# CYCLOSM_TILE_URL=https://{s}.tile-cyclosm.openstreetmap.fr/cyclosm/{z}/{x}/{y}.png
# WAYMARKED_CYCLING_TILE_URL=https://tile.waymarkedtrails.org/cycling/{z}/{x}/{y}.png
# OPENTOPOMAP_TILE_URL=https://tile.opentopomap.org/{z}/{x}/{y}.png

# Email (verification, 2FA, email-change)
# Provider is auto-detected (priority: EmailLabs > Lettermint > SMTP).
#
# EMAIL_FROM, SMTP_*, etc. are also settable in /admin/settings → Email /
# SMTP. Env always wins; leave commented to manage from the admin UI,
# uncomment to lock a value for this deployment.
# EMAIL_FROM=OpenMapX <noreply@openmapx.example.com>

# Option 1: EmailLabs (emaillabs.io, 9k emails/mo free)
# EMAILLABS_APP_KEY=
# EMAILLABS_SECRET_KEY=
# EMAILLABS_SMTP_ACCOUNT=

# Option 2: Lettermint (lettermint.co, 300 emails/mo free)
# LETTERMINT_API_TOKEN=

# Option 3: SMTP (any provider)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=

# Advanced / optional
# Fastify log level (trace | debug | info | warn | error | fatal)
# LOG_LEVEL=info

# Multi-tenant hosts: disable the loopback admin short-circuit entirely,
# regardless of whether OPENMAPX_LOCAL_ADMIN_TOKEN is set. Use this on
# shared hosts where another local user or process could connect to
# 127.0.0.1 of the API container.
# OPENMAPX_DISABLE_LOCALHOST_AUTH=1

# Isochrone provider override (default: valhalla). Use "otp" to route
# isochrones through OpenTripPlanner instead.
# ISOCHRONE_PROVIDER=valhalla

# Activity retention (days). The API prunes the admin audit log and finished
# admin jobs once a day. In-flight jobs (finishedAt IS NULL) are never
# pruned. Defaults track apps/api/src/server.ts.
# AUDIT_LOG_RETENTION_DAYS=90
# ADMIN_JOB_RETENTION_DAYS=30

# GitHub API token — raises the Transitous catalog fetch rate limit from 60
# to 5000 req/h. Only needed on multi-tenant hosts.
# GITHUB_TOKEN=

# Community-service catalog URL (for `pnpm openmapx repos add`)
# STORE_CATALOG_URL=https://openmapx.org/api/store/catalog.json

# Legal pages (shown in /terms, /privacy)
# Optional but required for production legal pages. Leave blank to omit.
# LEGAL_NAME=
# LEGAL_STREET=
# LEGAL_POSTAL_CODE=
# LEGAL_CITY=
# LEGAL_COUNTRY=
# LEGAL_JURISDICTION_CITY=
# LEGAL_EMAIL=
# LEGAL_PHONE=

# Per-integration / per-service overrides
# Integration credentials & config and per-service knobs are managed in the
# admin UI:
#
#   /admin/integrations         — per-integration detail page
#   /admin/integrations/bulk    — every integration on one page + the env
#                                 catalogue (Copy config / Copy credentials
#                                 / Copy all) ready to paste below
#   /admin/services/<id>        — per-service config (SERVICE_<ID>_<KEY>)
#
# Env always wins over admin-stored values. Paste the lines you actually
# want to pin from the bulk page; nothing here is required at deploy time.

# Service selection
# Compose-render and `pnpm openmapx services start` default to the
# `services-selection.json` file written by the admin UI / CLI. To pin a
# specific selection from this .env (e.g. for CI/repeatable deploys), set:
#
#   OPENMAPX_ENABLED_SERVICES=app-api,app-web,postgis,redis,traefik,well-known,osrm,valhalla
#
# Comma- or space-separated. Wins over services-selection.json when set.
