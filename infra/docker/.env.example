# infra/docker/.env
#
# Copy this file to `.env` in the same directory before running `docker
# compose -f docker-compose.generated.yml up -d`. Docker Compose auto-loads
# `.env` from the directory containing the compose file; the values here are
# substituted into `${VAR}` references in the generated YAML at stack
# startup time.

# --- Public domain + TLS ---------------------------------------------------
# Used by Traefik routing rules, auth URLs (BETTER_AUTH_URL, PASSKEY_RP_ID,
# PASSKEY_ORIGIN), the web app's NEXT_PUBLIC_API_URL, and tile-server URLs.
DOMAIN=openmapx.example.com
ACME_EMAIL=admin@example.com

# --- Infrastructure --------------------------------------------------------
POSTGRES_PASSWORD=change-me

# Host UID/GID for bind-mounted volumes (Linux). macOS/Windows typically
# don't need these — Docker Desktop handles ownership automatically.
# UID=1000
# GID=1000

# --- Authentication secrets (REQUIRED) ------------------------------------
# Better Auth session signing key. No fallback — the API refuses to start
# without it. Generate with:   npx @better-auth/cli@latest secret
BETTER_AUTH_SECRET=

# Symmetric key used to encrypt integration secrets in the vault
# (`integration_secret` table). 32 bytes, hex-encoded (64 chars). Generate
# with:   openssl rand -hex 32
# If unset, integrations that store secrets via the admin panel will refuse
# to decrypt on subsequent API restarts.
OPENMAPX_SECRETS_KEY=

# --- Social login (OAuth, optional) ---------------------------------------
# OpenStreetMap: https://www.openstreetmap.org/oauth2/applications
# OSM_CLIENT_ID=
# OSM_CLIENT_SECRET=

# Mapillary: https://www.mapillary.com/dashboard/developers (re-uses the
# same app as MAPILLARY_TOKEN below)
# MAPILLARY_CLIENT_ID=
# MAPILLARY_CLIENT_SECRET=

# --- Map style / tiles (baked into the web container via NEXT_PUBLIC_*) ----
# Pick a tile source. `maptiler` uses MapTiler Cloud (requires a key).
# `openmapx` uses the self-hosted tile stack (requires tiles profile).
NEXT_PUBLIC_STYLE_PROVIDER=maptiler
MAPTILER_KEY=
# NEXT_PUBLIC_MAP_STYLE_URL=https://openmapx.example.com/tiles/style.json
# NEXT_PUBLIC_TILES_URL=https://openmapx.example.com/tiles/data/openmapx.json

# Web-app tile overrides. All NEXT_PUBLIC_* except NEXT_PUBLIC_API_URL are
# read per-request via the EnvProvider context (server-side process.env →
# React context → client), so runtime values in this file reach both server
# and client components without a rebuild.
# NEXT_PUBLIC_TRAFFIC_MIN_ZOOM=10
# NEXT_PUBLIC_TRAFFIC_TILE_URL_TEMPLATE=
# NEXT_PUBLIC_CYCLOSM_TILE_URL_TEMPLATE=
# NEXT_PUBLIC_TERRAIN_TILE_URL_TEMPLATE=

# --- Street-level imagery (apps/api `/streetview/images` route) -----------
# The photos-mapillary integration is configured separately in the admin panel
# or via INTEGRATION_PHOTOS_MAPILLARY_ACCESSTOKEN.
MAPILLARY_TOKEN=

# --- Self-hosted backend URLs ---------------------------------------------
# Used by apps/api's direct-call helpers and shared packages (not by the
# routing / geocoding / transit *integrations* — those have their own
# configSchema.endpoint, configure them via admin panel or
# INTEGRATION_<ID>_ENDPOINT).
#
#   - OSRM_URL, VALHALLA_URL   → apps/api road-snap, elevation, isochrone
#   - MOTIS_URL                → apps/api motis manager (status + lifecycle)
#   - OVERPASS_URL             → packages/core/src/utils/overpass/client.ts
#   - NOMINATIM_URL            → packages/shared-mobility/nominatim.ts
#                                (station reverse-geocoding for bike / scooter
#                                 / car sharing)
#   - TRANSITOUS_URL           → packages/shared-mobility/motis-rentals.ts
#                                (rental POIs for shared-mobility integrations)
#
# Leave commented to use the container-network default ("http://osrm:5000",
# etc). Uncomment and set if your backends run outside the compose stack.
# OSRM_URL=http://osrm:5000
# VALHALLA_URL=http://valhalla:8002
# MOTIS_URL=http://motis:8081
# OVERPASS_URL=http://overpass:80
# NOMINATIM_URL=http://nominatim:8080
# TRANSITOUS_URL=https://api.transitous.org

# --- Service tuning (forwarded into the backend containers) ---------------
# Nominatim (self-hosted geocoder)
NOMINATIM_THREADS=8
NOMINATIM_IMPORT_WIKIPEDIA=true
NOMINATIM_IMPORT_GB_POSTCODES=false
NOMINATIM_IMPORT_US_POSTCODES=false

# Overpass API
OVERPASS_SPACE=107374182400
OVERPASS_FASTCGI_PROCESSES=4

# Photon (self-hosted geocoder)
PHOTON_REGION=planet

# --- Traffic + tile-proxy (apps/api) --------------------------------------
# TomTom Flow tile proxy. Sign up at https://developer.tomtom.com/
TRAFFIC_PROVIDER=tomtom
TOMTOM_TRAFFIC_KEY=
# TOMTOM_TRAFFIC_URL=https://api.tomtom.com
# TOMTOM_TRAFFIC_VERSION=4
# TOMTOM_TRAFFIC_STYLE=relative-delay
# TOMTOM_TRAFFIC_TILE_SIZE=256
# TOMTOM_TRAFFIC_THICKNESS=2

# Thunderforest OpenCycleMap (free Hobby Project key at
# https://www.thunderforest.com/)
THUNDERFOREST_API_KEY=

# Optional tile-URL overrides for the apps/api tile proxy
# CYCLOSM_TILE_URL=https://{s}.tile-cyclosm.openstreetmap.fr/cyclosm/{z}/{x}/{y}.png
# WAYMARKED_CYCLING_TILE_URL=https://tile.waymarkedtrails.org/cycling/{z}/{x}/{y}.png
# OPENTOPOMAP_TILE_URL=https://tile.opentopomap.org/{z}/{x}/{y}.png

# --- Email (verification, 2FA, email-change) -----------------------------
# Provider is auto-detected (priority: EmailLabs > Lettermint > SMTP).
EMAIL_FROM=OpenMapX <noreply@openmapx.example.com>

# Option 1: EmailLabs (emaillabs.io, 9k emails/mo free)
# EMAILLABS_APP_KEY=
# EMAILLABS_SECRET_KEY=
# EMAILLABS_SMTP_ACCOUNT=

# Option 2: Lettermint (lettermint.co, 300 emails/mo free)
# LETTERMINT_API_TOKEN=

# Option 3: SMTP (any provider)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=

# --- Advanced / optional --------------------------------------------------
# Fastify log level (trace | debug | info | warn | error | fatal)
# LOG_LEVEL=info

# Multi-tenant hosts: disable the loopback admin short-circuit that lets
# requests from 127.0.0.1 act as admin without a session cookie.
# OPENMAPX_DISABLE_LOCALHOST_AUTH=1

# Isochrone provider override (default: valhalla). Use "otp" to route
# isochrones through OpenTripPlanner instead.
# ISOCHRONE_PROVIDER=valhalla

# GitHub API token — raises the Transitous catalog fetch rate limit from 60
# to 5000 req/h. Only needed on multi-tenant hosts.
# GITHUB_TOKEN=

# Community-service catalog URL (for `pnpm openmapx repos add`)
# STORE_CATALOG_URL=https://openmapx.org/api/store/catalog.json

# --- Legal pages (shown in /terms, /privacy) ------------------------------
# Optional but required for production legal pages. Leave blank to omit.
# LEGAL_NAME=
# LEGAL_STREET=
# LEGAL_POSTAL_CODE=
# LEGAL_CITY=
# LEGAL_COUNTRY=
# LEGAL_JURISDICTION_CITY=
# LEGAL_EMAIL=
# LEGAL_PHONE=

# --- Integration config (operator env overrides) --------------------------
# Integration API keys, tokens, and endpoints live in the admin panel
# (vault for secrets, database for non-secrets). To override any value via
# host env at docker-compose-up time, use the pattern:
#
#   INTEGRATION_<ID>_<KEY>=value
#
# e.g.  INTEGRATION_GEOCODING_MAPTILER_APIKEY=...
#       INTEGRATION_ROUTING_VALHALLA_ENDPOINT=https://valhalla.example.com
#       INTEGRATION_PHOTOS_FLICKR_APIKEY=...
#
# Env vars always win the resolution cascade.
