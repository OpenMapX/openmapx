{
  "id": "elasticsearch",
  "name": "Elasticsearch (for Pelias)",
  "version": "1.0.0",
  "description": "Search backend for Pelias. Single-node, security disabled (internal only).",
  "license": "Elastic-License-2.0",
  "quality": "built-in",
  "container": {
    "image": "elasticsearch",
    "tag": "7.17.18",
    "digest": "sha256:5f99f2f450ca38aff315a4a8849e892934cafef0aee5e6ab5d894ede97a02ca9",
    "expose": [9200],
    "environment": {
      "discovery.type": "single-node",
      "ES_JAVA_OPTS": "-Xms2g -Xmx2g",
      "xpack.security.enabled": "false"
    },
    "memory": "4g",
    "restart": "unless-stopped",
    "healthcheck": {
      "type": "http",
      "path": "/_cluster/health",
      "port": 9200,
      "interval": "15s",
      "timeout": "5s",
      "retries": 10
    }
  },
  "volumes": [
    { "name": "openmapx-esdata", "mountAt": "/usr/share/elasticsearch/data", "backup": false }
  ],
  "exposure": {
    "hostPorts": [{ "container": 9200, "host": 9200, "bindAddress": "127.0.0.1" }]
  },
  "ui": { "category": "geocoding" }
}
