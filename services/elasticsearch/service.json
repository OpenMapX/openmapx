{
  "id": "elasticsearch",
  "name": "Elasticsearch (for Pelias)",
  "version": "1.0.0",
  "description": "Search backend for Pelias. Single-node, security disabled (internal only).",
  "license": "Elastic-License-2.0",
  "quality": "built-in",
  "subjectData": {
    "storesPersonalData": false,
    "strategy": "not_personal",
    "registrationIds": [],
    "operatorInstructions": null
  },
  "container": {
    "image": "elasticsearch",
    "tag": "7.17.28",
    "digest": "sha256:a06b03a2db8db2be43d3c3851e7bcebdd4fff79f4db08c7da6bad7a8776d3e15",
    "expose": [9200],
    "environment": {
      "discovery.type": "single-node",
      "ES_JAVA_OPTS": "-Xms2g -Xmx2g",
      "xpack.security.enabled": "false"
    },
    "user": "${UID:-1000}:0",
    "memory": "4g",
    "restart": "unless-stopped",
    "healthcheck": {
      "type": "http",
      "path": "/_cluster/health",
      "port": 9200,
      "interval": "15s",
      "timeout": "5s",
      "retries": 10
    }
  },
  "bindMounts": [
    {
      "source": "@infra:data/pelias/elasticsearch",
      "target": "/usr/share/elasticsearch/data",
      "readOnly": false
    }
  ],
  "exposure": {
    "hostPorts": [{ "container": 9200, "host": 9200, "bindAddress": "127.0.0.1" }]
  },
  "ui": { "category": "geocoding" }
}
