{
  "id": "elasticsearch",
  "name": "Elasticsearch (for Pelias)",
  "version": "1.0.0",
  "description": "Search backend for Pelias. Single-node, security disabled (internal only).",
  "license": "Elastic-License-2.0",
  "quality": "built-in",
  "subjectData": {
    "storesPersonalData": false,
    "strategy": "not_personal",
    "registrationIds": [],
    "operatorInstructions": null
  },
  "container": {
    "image": "elasticsearch",
    "tag": "8.19.23",
    "digest": "sha256:ef5cafd961d7e273f13fed8def82e63c5ae0491106b5eecb5a69aa12d64f089b",
    "expose": [9200],
    "environment": {
      "discovery.type": "single-node",
      "ES_JAVA_OPTS": "-Xms2g -Xmx2g",
      "xpack.security.enabled": "false"
    },
    "user": "${UID:?UID must be set, run pnpm openmapx compose render}:0",
    "memory": "4g",
    "restart": "unless-stopped",
    "healthcheck": {
      "type": "http",
      "path": "/_cluster/health",
      "port": 9200,
      "interval": "15s",
      "timeout": "5s",
      "retries": 10
    }
  },
  "bindMounts": [
    {
      "source": "@infra:data/pelias/elasticsearch",
      "target": "/usr/share/elasticsearch/data",
      "readOnly": false
    }
  ],
  "exposure": {
    "hostPorts": [
      {
        "container": 9200,
        "host": 9200,
        "bindAddress": "127.0.0.1"
      }
    ]
  },
  "ui": {
    "category": "geocoding"
  },
  "configSchema": {
    "type": "object",
    "properties": {
      "OPENMAPX_JAVA_HEAP_MIB": {
        "type": "integer",
        "title": "Java heap (MiB)",
        "minimum": 128,
        "maximum": 262144
      },
      "OPENMAPX_MEMORY_MIB": {
        "type": "integer",
        "title": "Container memory limit (MiB)",
        "minimum": 16,
        "maximum": 1048576,
        "description": "Optional Docker resource limit. Unset preserves the image manifest limit. Clear the field to restore the manifest limit."
      },
      "OPENMAPX_CPU_LIMIT": {
        "type": "number",
        "title": "Container CPU limit",
        "minimum": 0.125,
        "maximum": 256,
        "description": "Optional Docker resource limit. Unset preserves the image manifest limit. Clear the field to restore the manifest limit."
      }
    }
  }
}
