{
  "id": "postgis",
  "name": "PostGIS",
  "version": "1.0.0",
  "description": "PostgreSQL with PostGIS extension — primary spatial database.",
  "license": "PostgreSQL",
  "quality": "built-in",
  "homepage": "https://postgis.net/",
  "communityNetworkAccess": ["openconditions-ingest", "openconditions-contributions-api"],
  "subjectData": {
    "storesPersonalData": false,
    "strategy": "not_personal",
    "registrationIds": [],
    "operatorInstructions": null
  },
  "container": {
    "image": "ghcr.io/baosystems/postgis",
    "tag": "18-3.6",
    "digest": "sha256:8784f86b3e0e046859c96ea25eb8b10f0b801fd891b99a82b82f28ac4a643db8",
    "containerName": "postgis",
    "expose": [5432],
    "environment": {
      "POSTGRES_DB": "openmapx",
      "POSTGRES_USER": "postgres",
      "POSTGRES_PASSWORD": "${POSTGRES_PASSWORD:?POSTGRES_PASSWORD must be set — generate a strong value, do not use the default \"postgres\"}",
      "MARTIN_DB_PASSWORD": "${MARTIN_DB_PASSWORD:-}"
    },
    "shmSize": "1g",
    "memory": "${POSTGIS_MEMORY:-2g}",
    "restart": "unless-stopped",
    "stopGracePeriod": "5m",
    "entrypoint": ["/usr/local/bin/openmapx-postgis-entrypoint.sh"],
    "command": [
      "postgres",
      "-c",
      "max_wal_size=${POSTGIS_MAX_WAL_SIZE:-4GB}",
      "-c",
      "checkpoint_timeout=${POSTGIS_CHECKPOINT_TIMEOUT:-15min}",
      "-c",
      "wal_compression=zstd"
    ],
    "healthcheck": {
      "type": "exec",
      "command": [
        "sh",
        "-c",
        "pg_isready -U \"${POSTGRES_USER:-postgres}\" -q && test -f /var/run/postgresql/openmapx-password-synced"
      ],
      "interval": "10s",
      "timeout": "3s",
      "retries": 30,
      "startPeriod": "30s"
    }
  },
  "provides": ["database"],
  "volumes": [
    {
      "name": "openmapx-pgdata",
      "mountAt": "/var/lib/postgresql",
      "backup": true,
      "backupMode": "pg_dump"
    }
  ],
  "bindMounts": [
    {
      "source": "scripts/sync-password.sh",
      "target": "/usr/local/bin/openmapx-postgis-entrypoint.sh",
      "readOnly": true
    }
  ],
  "exposure": {
    "hostPorts": [{ "container": 5432, "host": 5432, "bindAddress": "127.0.0.1" }]
  },
  "ui": { "category": "infrastructure" }
}
