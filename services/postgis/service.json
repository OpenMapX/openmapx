{
  "id": "postgis",
  "name": "PostGIS",
  "version": "1.0.0",
  "description": "PostgreSQL with PostGIS extension — primary spatial database.",
  "license": "PostgreSQL",
  "quality": "built-in",
  "homepage": "https://postgis.net/",
  "container": {
    "image": "postgis/postgis",
    "tag": "18-3.6",
    "expose": [5432],
    "environment": {
      "POSTGRES_DB": "openmapx",
      "POSTGRES_USER": "postgres",
      "POSTGRES_PASSWORD": "${POSTGRES_PASSWORD:?POSTGRES_PASSWORD must be set — generate a strong value, do not use the default \"postgres\"}"
    },
    "memory": "2g",
    "restart": "unless-stopped",
    "healthcheck": {
      "type": "exec",
      "command": ["pg_isready", "-U", "postgres"],
      "interval": "10s",
      "timeout": "3s",
      "retries": 5
    }
  },
  "provides": ["database"],
  "volumes": [{ "name": "openmapx-pgdata", "mountAt": "/var/lib/postgresql", "backup": true }],
  "exposure": {
    "hostPorts": [{ "container": 5432, "host": 5432, "bindAddress": "127.0.0.1" }]
  },
  "ui": { "category": "infrastructure" }
}
