{
  "id": "motis",
  "name": "MOTIS",
  "version": "1.0.0",
  "description": "Multi-modal transit + routing engine. Regional by default; planet deployments require an explicit experimental profile and measured capacity.",
  "license": "MIT",
  "quality": "built-in",
  "homepage": "https://github.com/motis-project/motis",
  "subjectData": {
    "storesPersonalData": false,
    "strategy": "not_personal",
    "registrationIds": [],
    "operatorInstructions": null
  },
  "container": {
    "image": "ghcr.io/motis-project/motis",
    "tag": "2.11.3",
    "digest": "sha256:7126a80f8d1537426655a14a121e395e9d56451c36144f3a1ce5c3e4deb38f64",
    "containerName": "motis",
    "expose": [8080],
    "user": "${UID:-1000}:${GID:-1000}",
    "workingDir": "/motis-data",
    "entrypoint": ["/bin/sh", "-c"],
    "command": [
      "until [ -f /motis-data/config.yml ]; do echo 'motis: waiting for /motis-data/config.yml'; sleep 5; done; /motis import && /motis server || { echo 'motis: import/serve failed; holding (a pipeline restart will retry)'; while true; do sleep 3600; done; }"
    ],
    "dependsOn": [{ "service": "motis-feed-proxy", "condition": "service_started" }],
    "memory": "${MOTIS_SLOT_MEMORY:-16g}",
    "restart": "unless-stopped",
    "healthcheck": {
      "type": "http",
      "path": "/api/v1/health",
      "port": 8080,
      "interval": "30s",
      "timeout": "10s",
      "retries": 5,
      "startPeriod": "600s"
    },
    "logging": {
      "driver": "json-file",
      "options": { "max-size": "50m", "max-file": "3" }
    }
  },
  "buildCommand": "openmapx services build motis",
  "provides": ["transit-engine", "routing-engine"],
  "produces": [{ "type": "motis-feed-proxy-config", "sourceDir": "data/motis-feed-proxy/conf" }],
  "bindMounts": [
    { "source": "@infra:data/motis/live", "target": "/motis-data", "readOnly": false }
  ],
  "exposure": {
    "hostPorts": [{ "container": 8080, "host": 8081, "bindAddress": "127.0.0.1" }]
  },
  "ui": { "category": "transit" }
}
