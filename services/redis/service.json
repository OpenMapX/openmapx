{
  "id": "redis",
  "name": "Valkey (Redis-compatible)",
  "version": "1.0.0",
  "description": "Valkey 8 — cache and session store.",
  "license": "BSD-3-Clause",
  "quality": "built-in",
  "homepage": "https://valkey.io/",
  "container": {
    "image": "valkey/valkey",
    "tag": "8-alpine",
    "expose": [6379],
    "memory": "512m",
    "restart": "unless-stopped",
    "healthcheck": {
      "type": "exec",
      "command": ["redis-cli", "ping"],
      "interval": "10s",
      "timeout": "3s",
      "retries": 5
    }
  },
  "provides": ["cache"],
  "volumes": [{ "name": "openmapx-redisdata", "mountAt": "/data", "backup": true }],
  "exposure": {
    "hostPorts": [{ "container": 6379, "host": 6379, "bindAddress": "127.0.0.1" }]
  },
  "ui": { "category": "infrastructure" }
}
