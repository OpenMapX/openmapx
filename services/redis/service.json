{
  "id": "redis",
  "name": "Valkey (Redis-compatible)",
  "version": "1.0.0",
  "description": "Valkey 8 — cache and session store.",
  "license": "BSD-3-Clause",
  "quality": "built-in",
  "homepage": "https://valkey.io/",
  "subjectData": {
    "storesPersonalData": true,
    "strategy": "operator_task",
    "registrationIds": ["redis-subject-controls"],
    "operatorInstructions": "Review exact subject-derived controls; do not export keys or values."
  },
  "container": {
    "image": "valkey/valkey",
    "tag": "9.1.2-alpine",
    "digest": "sha256:48332870af354a799964c0012ae1194a0bf2bf894eb508f945810596dc2d8d11",
    "expose": [6379],
    "command": ["--aclfile", "/etc/valkey/users.acl"],
    "memory": "512m",
    "restart": "unless-stopped",
    "healthcheck": {
      "type": "exec",
      "command": "REDISCLI_AUTH=\"$(cat /run/secrets/redis-password)\" exec redis-cli ping",
      "interval": "10s",
      "timeout": "3s",
      "retries": 5
    }
  },
  "provides": ["cache"],
  "bindMounts": [
    {
      "source": "@infra:secrets/redis-password",
      "target": "/run/secrets/redis-password",
      "readOnly": true
    },
    {
      "source": "@infra:secrets/redis-acl.conf",
      "target": "/etc/valkey/users.acl",
      "readOnly": true
    }
  ],
  "volumes": [
    {
      "name": "openmapx-redisdata",
      "mountAt": "/data",
      "backup": true,
      "backupMode": "tar"
    }
  ],
  "exposure": {
    "hostPorts": [
      {
        "container": 6379,
        "host": 6379,
        "bindAddress": "127.0.0.1"
      }
    ]
  },
  "ui": {
    "category": "infrastructure"
  },
  "configSchema": {
    "type": "object",
    "properties": {
      "OPENMAPX_MEMORY_MIB": {
        "type": "integer",
        "title": "Container memory limit (MiB)",
        "minimum": 16,
        "maximum": 1048576,
        "description": "Optional Docker resource limit. Unset preserves the image manifest limit. Clear the field to restore the manifest limit."
      },
      "OPENMAPX_CPU_LIMIT": {
        "type": "number",
        "title": "Container CPU limit",
        "minimum": 0.125,
        "maximum": 256,
        "description": "Optional Docker resource limit. Unset preserves the image manifest limit. Clear the field to restore the manifest limit."
      }
    }
  }
}
