{
  "name": "@openmapx/data-manager",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file=.env --watch --import tsx/esm src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "check-types": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@openmapx/db-schema": "workspace:^",
    "@openmapx/hardlinks": "workspace:*",
    "@openmapx/motis-feed-proxy-config": "workspace:^",
    "@openmapx/poi-source-registry": "workspace:^",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-prometheus": "^0.218.0",
    "@opentelemetry/sdk-metrics": "^2.7.1",
    "croner": "^10.0.1",
    "drizzle-orm": "^0.45.2",
    "execa": "^9.6.1",
    "fastify": "^5.8.5",
    "ioredis": "^5.11.1",
    "postgres": "^3.4.9",
    "tsx": "4.21.0"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.0.1",
    "@types/node": "^25.9.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.8"
  }
}
