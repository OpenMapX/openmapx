    "croner": "^10.0.1",
    "drizzle-orm": "^0.45.2",
    "execa": "^9.6.1",
    "fastify": "^5.8.5",
    "h3-js": "^4.4.0",
    "ioredis": "^5.11.1",
    "pino": "^10.3.1",
    "postgres": "^3.4.9",
    "tsx": "4.23.0"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.0.2",
