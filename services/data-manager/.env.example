# data-manager service
PORT=4000
HOST=127.0.0.1

# Shared bearer token that apps/api uses to authenticate against data-manager.
# All mutation endpoints (downloads, hardlinks, dataset reload, conversions)
# require it as a Bearer or X-Data-Manager-Token header.
# Required in production — the service refuses to start without it.
# In development an ephemeral token is generated if this is unset.
# Must match DATA_MANAGER_AUTH_TOKEN in apps/api/.env.
# Generate with:   openssl rand -hex 32
DATA_MANAGER_AUTH_TOKEN=

# PostgreSQL with PostGIS extension. Matches the postgis service in infra/docker.
DATABASE_URL=postgresql://postgres:postgres@postgis:5432/openmapx

# Redis / Valkey — used for job state and caching.
REDIS_URL=redis://localhost:6379

# Absolute path to the data directory where downloads and GTFS feeds are
# stored. Inside the Docker container the volume is mounted at /data.
# Optional, default: /data
# DATA_DIR=/data

# Absolute path to the repo checkout inside the container (or on the host for
# bare-metal runs). Required for POI source discovery and the pnpm lockfile
# path resolution. The compose-rendered environment sets this automatically.
OPENMAPX_ROOT_DIR=

# Directory where community integrations are stored. Optional; only needed
# when community-provided POI sources should be discovered at runtime.
# Default: <OPENMAPX_ROOT_DIR>/custom_integrations
# OPENMAPX_CUSTOM_INTEGRATIONS_DIR=

# Geographic region for MOTIS config overrides. Used to select the right
# routing profile and external service URLs. Falls back to OPENMAPX_REGION.
# Example: de (Germany), at (Austria), ch (Switzerland)
# MOTIS_REGION=
# OPENMAPX_REGION=

# URL of the primary (live) MOTIS instance. Optional, default: http://localhost:8081
# MOTIS_URL=http://localhost:8081

# URL of the staging MOTIS instance used during Transitous pipeline
# import/health-check before promoting to the live slot.
# Optional, default: http://localhost:8082
# MOTIS_STAGING_URL=http://localhost:8082

# Elevator real-time integration (FaSta / SIRI-FM, e.g. DB Bahnhof)
# When set, data-manager injects the elevator feed into the MOTIS config.
# MOTIS_ELEVATORS_URL=
# Authorization header value for the elevator endpoint (e.g. "Bearer <token>")
# MOTIS_ELEVATORS_AUTH=

# Optional generated-config controls. Validate footpath/elevation resource use
# on staging before enabling them in production.
# MOTIS_OSR_FOOTPATH=true
# MOTIS_INCREMENTAL_RT_UPDATE=true

# Compute leg geometry from OSM for feeds without GTFS shapes (e.g. de-DELFI
# long-distance ICE/IC trips, which otherwise render as straight lines). Values:
# "missing" (only shape-less routes; preserves feed shapes), "all", or unset
# (off). Requires with_shapes + street_routing + osm; adds import time/RAM, so
# validate on motis-staging before promoting.
# MOTIS_ROUTE_SHAPES=missing

# Enable MOTIS vector tile generation during the Transitous pipeline.
# Set to "true" to keep the tiles block in the generated MOTIS config.
# Optional, default: omit tiles block (disabled)
# MOTIS_TILES=true

# Maximum import/first-health wait and deterministic promotion canary geometry.
# MOTIS_IMPORT_TIMEOUT_MS=1800000
# MOTIS_HEALTH_BBOX_MIN_LAT=52.49
# MOTIS_HEALTH_BBOX_MIN_LNG=13.35
# MOTIS_HEALTH_BBOX_MAX_LAT=52.55
# MOTIS_HEALTH_BBOX_MAX_LNG=13.46
# MOTIS_HEALTH_PLAN_FROM_LAT=52.5208
# MOTIS_HEALTH_PLAN_FROM_LNG=13.4095
# MOTIS_HEALTH_PLAN_TO_LAT=52.5251
# MOTIS_HEALTH_PLAN_TO_LNG=13.3694

# Base URL of apps/api — used by data-manager to call back for cache
# invalidation and integration reload after a dataset update. Optional.
# APP_API_BASE_URL=http://localhost:3001

# Transitous pipeline configuration
# Git repository containing Transitous feed definitions.
# Optional, default: https://github.com/public-transport/transitous.git
# TRANSITOUS_REPO_URL=

# Path to the Transitous API keys JSON file (per-feed authentication tokens).
# Optional, default: /config/transitous/api-keys.json
# TRANSITOUS_API_KEYS_PATH=

# Path to the feeds overlay JSON file that extends or overrides Transitous feeds.
# Optional, default: /data/overrides/feeds-overlay.json
# TRANSITOUS_FEEDS_OVERLAY_PATH=

# Path to the private key file used to decrypt encrypted Transitous feed URLs.
# Optional — without this, encrypted feeds are silently skipped.
# TRANSITOUS_FEED_PROXY_KEY_FILE=

# GitHub alerting for stale Transitous feeds (optional).
# Both vars must be set to enable automatic issue creation.
# TRANSITOUS_ALERT_GH_TOKEN=
# TRANSITOUS_ALERT_GH_REPO=owner/repo

# POI ingest scheduler configuration
# Set to "true" to run an immediate full bootstrap ingest on startup.
# Optional, default: not set (scheduled runs only)
# POI_INGEST_BOOTSTRAP=true

# Cron expression for the staleness check that checks whether POI datasets
# are due for a refresh. Optional, default: "30 4 * * *" (04:30 UTC daily)
# POI_INGEST_STALENESS_CHECK_CRON=30 4 * * *

# GitHub alerting for stale POI datasets (optional).
# Both vars must be set to enable automatic issue creation.
# POI_INGEST_ALERT_GH_TOKEN=
# POI_INGEST_ALERT_GH_REPO=owner/repo
