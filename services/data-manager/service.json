{
  "id": "data-manager",
  "name": "Data Manager",
  "version": "1.0.0",
  "description": "Downloads and shares source data (OSM PBFs, GTFS feeds, tile assets) with consumer services.",
  "license": "MIT",
  "quality": "built-in",
  "container": {
    "image": "ghcr.io/openmapx/data-manager",
    "tag": "latest",
    "expose": [4000],
    "user": "${UID:-1000}:${GID:-1000}",
    "environment": {
      "HOME": "/tmp",
      "DATA_DIR": "/data",
      "PORT": "4000",
      "HOST": "0.0.0.0",
      "DATA_MANAGER_AUTH_TOKEN": "${DATA_MANAGER_AUTH_TOKEN:?DATA_MANAGER_AUTH_TOKEN must be set — generate with: openssl rand -hex 32}",
      "DATABASE_URL": "postgresql://postgres:${POSTGRES_PASSWORD:?POSTGRES_PASSWORD must be set}@postgis:5432/openmapx",
      "REDIS_URL": "redis://redis:6379",
      "OPENMAPX_ROOT_DIR": "${OPENMAPX_HOST_DIR:?OPENMAPX_HOST_DIR must be set — the data-manager container persists the Transitous lockfile (POST /transit/bump) via this path; see infra/docker/.env.example}",
      "OPENMAPX_CUSTOM_INTEGRATIONS_DIR": "${OPENMAPX_CUSTOM_INTEGRATIONS_DIR:-/app/custom_integrations}",
      "TSX_TSCONFIG_PATH": "${OPENMAPX_HOST_DIR:?OPENMAPX_HOST_DIR must be set}/tsconfig.base.json",
      "APP_API_BASE_URL": "${APP_API_BASE_URL:-http://app-api:3001}",
      "MOTIS_URL": "${MOTIS_URL:-http://motis:8080}",
      "MOTIS_STAGING_URL": "${MOTIS_STAGING_URL:-http://motis-staging:8080}",
      "OPENMAPX_REGION": "${OPENMAPX_REGION:-}",
      "MOTIS_REGION": "${MOTIS_REGION:-}",
      "TRANSIT_SOURCE": "${TRANSIT_SOURCE:-}",
      "TRANSITOUS_COUNTRIES": "${TRANSITOUS_COUNTRIES:-}",
      "MOTIS_OPERATIONS_PROFILE": "${MOTIS_OPERATIONS_PROFILE:-regional-assisted}",
      "MOTIS_PLANET_CONFIRM": "${MOTIS_PLANET_CONFIRM:-false}",
      "MOTIS_FEED_ALLOW_LIST": "${MOTIS_FEED_ALLOW_LIST:-}",
      "MOTIS_MAX_FEED_COUNT": "${MOTIS_MAX_FEED_COUNT:-500}",
      "MOTIS_RETENTION_GENERATIONS": "${MOTIS_RETENTION_GENERATIONS:-2}",
      "MOTIS_OSM_FILE": "${MOTIS_OSM_FILE:-}",
      "MOTIS_OSM_REGION": "${MOTIS_OSM_REGION:-}",
      "MOTIS_SLOT_MEMORY_GB": "${MOTIS_SLOT_MEMORY_GB:-16}",
      "MOTIS_SLOT_CPU": "${MOTIS_SLOT_CPU:-4}",
      "MOTIS_FILE_DESCRIPTOR_LIMIT": "${MOTIS_FILE_DESCRIPTOR_LIMIT:-65536}",
      "MOTIS_BUILD_TIMEOUT_HOURS": "${MOTIS_BUILD_TIMEOUT_HOURS:-12}",
      "MOTIS_TWO_SLOT": "${MOTIS_TWO_SLOT:-false}",
      "MOTIS_IMAGE_DIGEST": "${MOTIS_IMAGE_DIGEST:-}",
      "TRANSITOUS_ARTIFACT_BASE_URL": "${TRANSITOUS_ARTIFACT_BASE_URL:-}",
      "TRANSITOUS_API_KEYS_PATH": "${TRANSITOUS_API_KEYS_PATH:-}",
      "TRANSITOUS_FEEDS_OVERLAY_PATH": "${TRANSITOUS_FEEDS_OVERLAY_PATH:-}",
      "OPENMAPX_TRANSITOUS_FEED_PROXY_URL": "${OPENMAPX_TRANSITOUS_FEED_PROXY_URL:-}",
      "TRANSITOUS_REPO_URL": "${TRANSITOUS_REPO_URL:-}",
      "TRANSITOUS_SYNC_CRON": "${TRANSITOUS_SYNC_CRON:-}",
      "TRANSITOUS_STALENESS_CHECK_CRON": "${TRANSITOUS_STALENESS_CHECK_CRON:-}",
      "TRANSITOUS_FEED_PROXY_RELOAD_CRON": "${TRANSITOUS_FEED_PROXY_RELOAD_CRON:-}",
      "MOTIS_ELEVATORS_URL": "${MOTIS_ELEVATORS_URL:-}",
      "MOTIS_ELEVATORS_AUTH": "${MOTIS_ELEVATORS_AUTH:-}",
      "MOTIS_OSR_FOOTPATH": "${MOTIS_OSR_FOOTPATH:-}",
      "MOTIS_ROUTE_SHAPES": "${MOTIS_ROUTE_SHAPES:-}",
      "MOTIS_TILES": "${MOTIS_TILES:-}",
      "MOTIS_INCREMENTAL_RT_UPDATE": "${MOTIS_INCREMENTAL_RT_UPDATE:-}",
      "MOTIS_IMPORT_TIMEOUT_MS": "${MOTIS_IMPORT_TIMEOUT_MS:-}",
      "MOTIS_HEALTH_BBOX_MIN_LAT": "${MOTIS_HEALTH_BBOX_MIN_LAT:-}",
      "MOTIS_HEALTH_BBOX_MIN_LNG": "${MOTIS_HEALTH_BBOX_MIN_LNG:-}",
      "MOTIS_HEALTH_BBOX_MAX_LAT": "${MOTIS_HEALTH_BBOX_MAX_LAT:-}",
      "MOTIS_HEALTH_BBOX_MAX_LNG": "${MOTIS_HEALTH_BBOX_MAX_LNG:-}",
      "MOTIS_HEALTH_PLAN_FROM_LAT": "${MOTIS_HEALTH_PLAN_FROM_LAT:-}",
      "MOTIS_HEALTH_PLAN_FROM_LNG": "${MOTIS_HEALTH_PLAN_FROM_LNG:-}",
      "MOTIS_HEALTH_PLAN_TO_LAT": "${MOTIS_HEALTH_PLAN_TO_LAT:-}",
      "MOTIS_HEALTH_PLAN_TO_LNG": "${MOTIS_HEALTH_PLAN_TO_LNG:-}",
      "MOTIS_HEALTH_RENTAL_PROVIDER_IDS": "${MOTIS_HEALTH_RENTAL_PROVIDER_IDS:-}",
      "MOTIS_HEALTH_RENTAL_PLAN": "${MOTIS_HEALTH_RENTAL_PLAN:-false}",
      "MOTIS_HEALTH_RENTAL_PROVIDER_GROUPS": "${MOTIS_HEALTH_RENTAL_PROVIDER_GROUPS:-}",
      "MOTIS_HEALTH_RENTAL_PROVIDERS": "${MOTIS_HEALTH_RENTAL_PROVIDERS:-}",
      "MOTIS_HEALTH_RENTAL_FORM_FACTORS": "${MOTIS_HEALTH_RENTAL_FORM_FACTORS:-}",
      "MOTIS_GBFS_CATALOG_ENABLED": "${MOTIS_GBFS_CATALOG_ENABLED:-false}",
      "MOTIS_GBFS_CATALOG_MAX_ADDITIONS": "${MOTIS_GBFS_CATALOG_MAX_ADDITIONS:-50}",
      "MOTIS_GBFS_CATALOG_CONCURRENCY": "${MOTIS_GBFS_CATALOG_CONCURRENCY:-4}",
      "MOTIS_GBFS_CATALOG_TIMEOUT_MS": "${MOTIS_GBFS_CATALOG_TIMEOUT_MS:-5000}",
      "MOTIS_GBFS_CATALOG_MAX_FAILURE_RATIO": "${MOTIS_GBFS_CATALOG_MAX_FAILURE_RATIO:-0.35}",
      "POI_INGEST_BOOTSTRAP": "${POI_INGEST_BOOTSTRAP:-true}",
      "OVERTURE_ENABLED": "${OVERTURE_ENABLED:-}",
      "OVERTURE_SYNC_CRON": "${OVERTURE_SYNC_CRON:-}",
      "OPENCONDITIONS_URL": "${OPENCONDITIONS_URL:-}",
      "TRAFFIC_LIVE_CRON": "${TRAFFIC_LIVE_CRON:-}",
      "TRAFFIC_PREDICTED_CRON": "${TRAFFIC_PREDICTED_CRON:-}",
      "TRAFFIC_PREDICTED_CSV_DIR": "${TRAFFIC_PREDICTED_CSV_DIR:-}",
      "TRAFFIC_TAR_PATH": "${TRAFFIC_TAR_PATH:-}",
      "UTMC_USERNAME": "${UTMC_USERNAME:-}",
      "UTMC_PASSWORD": "${UTMC_PASSWORD:-}",
      "DB_BAHNPARK_CLIENT_ID": "${DB_BAHNPARK_CLIENT_ID:-}",
      "DB_BAHNPARK_API_KEY": "${DB_BAHNPARK_API_KEY:-}",
      "NSW_TRANSPORT_API_KEY": "${NSW_TRANSPORT_API_KEY:-}",
      "TRANSITOUS_FEED_PROXY_KEY_FILE": "/secrets/transitous-feed-proxy.age",
      "OLLAMA_URL": "${OLLAMA_URL:-http://local-ai:11434}"
    },
    "memory": "8g",
    "restart": "unless-stopped",
    "healthcheck": {
      "type": "http",
      "path": "/status",
      "port": 4000,
      "interval": "30s",
      "timeout": "5s",
      "retries": 3
    }
  },
  "provides": ["osm-data", "gtfs-data", "tile-asset-data"],
  "produces": [
    { "type": "osm-pbf", "sourceDir": "data/osm" },
    { "type": "osm-pbf-bz2", "sourceDir": "data/osm-bz2" },
    { "type": "gtfs", "sourceDir": "data/gtfs" },
    { "type": "tile-fonts", "sourceDir": "data/tile-fonts" },
    { "type": "tile-styles", "sourceDir": "data/tile-styles" }
  ],
  "bindMounts": [
    { "source": "@infra:data", "target": "/data", "readOnly": false },
    {
      "source": "@service:motis:tools/transitous",
      "target": "/config/transitous",
      "readOnly": true
    },
    {
      "source": "@docker-socket",
      "target": "/var/run/docker.sock",
      "readOnly": false
    },
    {
      "source": "${OPENMAPX_HOST_DIR:?OPENMAPX_HOST_DIR must be set — the data-manager bind-mounts the repo root so POST /transit/bump can persist infra/docker/transitous.lock.json on the host}",
      "target": "${OPENMAPX_HOST_DIR:?OPENMAPX_HOST_DIR must be set}",
      "readOnly": false
    },
    {
      "source": "${OPENMAPX_HOST_DIR:?OPENMAPX_HOST_DIR must be set — community integrations contribute POI sources via discoverPoiSources(); without this mount data-manager and apps/api drift on the source list}/custom_integrations",
      "target": "${OPENMAPX_CUSTOM_INTEGRATIONS_DIR:-/app/custom_integrations}",
      "readOnly": false
    },
    {
      "source": "@infra:secrets/transitous-feed-proxy.age",
      "target": "/secrets/transitous-feed-proxy.age",
      "readOnly": true,
      "optional": true
    }
  ],
  "exposure": {
    "hostPorts": [{ "container": 4000, "host": 4000, "bindAddress": "127.0.0.1" }]
  },
  "ui": { "category": "infrastructure" }
}
