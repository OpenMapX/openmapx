{
  "id": "data-manager",
  "name": "Data Manager",
  "version": "1.0.0",
  "description": "Downloads and shares source data (OSM PBFs, GTFS feeds, tile assets) with consumer services.",
  "license": "MIT",
  "quality": "built-in",
  "container": {
    "image": "ghcr.io/openmapx/data-manager",
    "tag": "latest",
    "expose": [4000],
    "user": "${UID:-1000}:${GID:-1000}",
    "environment": {
      "HOME": "/tmp",
      "DATA_DIR": "/data",
      "PORT": "4000",
      "HOST": "0.0.0.0",
      "DATA_MANAGER_AUTH_TOKEN": "${DATA_MANAGER_AUTH_TOKEN:?DATA_MANAGER_AUTH_TOKEN must be set — generate with: openssl rand -hex 32}",
      "DATABASE_URL": "postgresql://postgres:${POSTGRES_PASSWORD:?POSTGRES_PASSWORD must be set}@postgis:5432/openmapx",
      "REDIS_URL": "redis://redis:6379",
      "OPENMAPX_ROOT_DIR": "${OPENMAPX_HOST_DIR:?OPENMAPX_HOST_DIR must be set — the data-manager container persists the Transitous lockfile (POST /transit/bump) via this path; see infra/docker/.env.example}",
      "OPENMAPX_CUSTOM_INTEGRATIONS_DIR": "${OPENMAPX_CUSTOM_INTEGRATIONS_DIR:-/app/custom_integrations}",
      "TSX_TSCONFIG_PATH": "${OPENMAPX_HOST_DIR:?OPENMAPX_HOST_DIR must be set}/tsconfig.base.json",
      "APP_API_BASE_URL": "${APP_API_BASE_URL:-http://app-api:3001}",
      "MOTIS_URL": "${MOTIS_URL:-http://motis:8080}",
      "MOTIS_STAGING_URL": "${MOTIS_STAGING_URL:-http://motis-staging:8080}",
      "OPENMAPX_REGION": "${OPENMAPX_REGION:-}",
      "MOTIS_REGION": "${MOTIS_REGION:-}",
      "POI_INGEST_BOOTSTRAP": "${POI_INGEST_BOOTSTRAP:-true}",
      "UTMC_USERNAME": "${UTMC_USERNAME:-}",
      "UTMC_PASSWORD": "${UTMC_PASSWORD:-}",
      "DB_BAHNPARK_CLIENT_ID": "${DB_BAHNPARK_CLIENT_ID:-}",
      "DB_BAHNPARK_API_KEY": "${DB_BAHNPARK_API_KEY:-}",
      "NSW_TRANSPORT_API_KEY": "${NSW_TRANSPORT_API_KEY:-}",
      "TRANSITOUS_FEED_PROXY_KEY_FILE": "/secrets/transitous-feed-proxy.age"
    },
    "memory": "8g",
    "restart": "unless-stopped",
    "healthcheck": {
      "type": "http",
      "path": "/status",
      "port": 4000,
      "interval": "30s",
      "timeout": "5s",
      "retries": 3
    }
  },
  "provides": ["osm-data", "gtfs-data", "tile-asset-data"],
  "produces": [
    { "type": "osm-pbf", "sourceDir": "data/osm" },
    { "type": "osm-pbf-bz2", "sourceDir": "data/osm-bz2" },
    { "type": "gtfs", "sourceDir": "data/gtfs" },
    { "type": "tile-fonts", "sourceDir": "data/tile-fonts" },
    { "type": "tile-styles", "sourceDir": "data/tile-styles" }
  ],
  "bindMounts": [
    { "source": "@infra:data", "target": "/data", "readOnly": false },
    {
      "source": "@service:motis:tools/transitous",
      "target": "/config/transitous",
      "readOnly": true
    },
    {
      "source": "@docker-socket",
      "target": "/var/run/docker.sock",
      "readOnly": false
    },
    {
      "source": "${OPENMAPX_HOST_DIR:?OPENMAPX_HOST_DIR must be set — the data-manager bind-mounts the repo root so POST /transit/bump can persist infra/docker/transitous.lock.json on the host}",
      "target": "${OPENMAPX_HOST_DIR:?OPENMAPX_HOST_DIR must be set}",
      "readOnly": false
    },
    {
      "source": "${OPENMAPX_HOST_DIR:?OPENMAPX_HOST_DIR must be set — community integrations contribute POI sources via discoverPoiSources(); without this mount data-manager and apps/api drift on the source list}/custom_integrations",
      "target": "${OPENMAPX_CUSTOM_INTEGRATIONS_DIR:-/app/custom_integrations}",
      "readOnly": false
    },
    {
      "source": "@infra:secrets/transitous-feed-proxy.age",
      "target": "/secrets/transitous-feed-proxy.age",
      "readOnly": true,
      "optional": true
    }
  ],
  "exposure": {
    "hostPorts": [{ "container": 4000, "host": 4000, "bindAddress": "127.0.0.1" }]
  },
  "ui": { "category": "infrastructure" }
}
