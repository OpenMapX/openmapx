{
  "id": "data-manager",
  "name": "Data Manager",
  "version": "1.0.0",
  "description": "Downloads and shares source data (OSM PBFs, GTFS feeds, tile assets) with consumer services.",
  "license": "MIT",
  "quality": "built-in",
  "container": {
    "image": "ghcr.io/medformatik/openmapx-data-manager",
    "tag": "latest",
    "expose": [4000],
    "environment": {
      "DATA_DIR": "/data",
      "PORT": "4000"
    },
    "memory": "1g",
    "restart": "unless-stopped",
    "healthcheck": {
      "type": "http",
      "path": "/status",
      "port": 4000,
      "interval": "30s",
      "timeout": "5s",
      "retries": 3
    }
  },
  "provides": ["osm-data", "gtfs-data", "tile-asset-data"],
  "produces": [
    { "type": "osm-pbf", "sourceDir": "data/osm" },
    { "type": "osrm-graph", "sourceDir": "data/osrm-graph" },
    { "type": "otp-graph", "sourceDir": "data/otp-graph" },
    { "type": "motis-data", "sourceDir": "data/motis-data" },
    { "type": "gtfs", "sourceDir": "data/gtfs" },
    { "type": "tile-mbtiles", "sourceDir": "data/tile-mbtiles" },
    { "type": "tile-fonts", "sourceDir": "data/tile-fonts" },
    { "type": "tile-styles", "sourceDir": "data/tile-styles" },
    { "type": "pelias-placeholder-data", "sourceDir": "data/pelias/placeholder" },
    { "type": "pelias-whosonfirst-data", "sourceDir": "data/pelias/whosonfirst" },
    { "type": "osm-pbf-bz2", "sourceDir": "data/osm-bz2" }
  ],
  "bindMounts": [{ "source": "@infra:data", "target": "/data", "readOnly": false }],
  "exposure": {
    "hostPorts": [{ "container": 4000, "host": 4000, "bindAddress": "127.0.0.1" }]
  },
  "ui": { "category": "infrastructure" }
}
