{
  "id": "data-manager",
  "name": "Data Manager",
  "version": "1.0.0",
  "description": "Downloads and shares source data (OSM PBFs, GTFS feeds, tile assets) with consumer services.",
  "license": "MIT",
  "quality": "built-in",
  "container": {
    "image": "ghcr.io/medformatik/openmapx-data-manager",
    "tag": "latest",
    "expose": [4000],
    "user": "${UID:-1000}:${GID:-1000}",
    "environment": {
      "HOME": "/tmp",
      "DATA_DIR": "/data",
      "PORT": "4000",
      "HOST": "0.0.0.0",
      "DATA_MANAGER_AUTH_TOKEN": "${DATA_MANAGER_AUTH_TOKEN:?DATA_MANAGER_AUTH_TOKEN must be set — generate with: openssl rand -hex 32}",
      "OPENMAPX_ROOT_DIR": "${OPENMAPX_HOST_DIR:?OPENMAPX_HOST_DIR must be set — the data-manager container persists the Transitous lockfile (POST /transit/bump) via this path; see infra/docker/.env.example}",
      "TRANSITOUS_FEED_PROXY_KEY_FILE": "/secrets/transitous-feed-proxy.age"
    },
    "memory": "8g",
    "restart": "unless-stopped",
    "healthcheck": {
      "type": "http",
      "path": "/status",
      "port": 4000,
      "interval": "30s",
      "timeout": "5s",
      "retries": 3
    }
  },
  "provides": ["osm-data", "gtfs-data", "tile-asset-data"],
  "produces": [
    { "type": "osm-pbf", "sourceDir": "data/osm" },
    { "type": "osm-pbf-bz2", "sourceDir": "data/osm-bz2" },
    { "type": "gtfs", "sourceDir": "data/gtfs" },
    { "type": "tile-fonts", "sourceDir": "data/tile-fonts" },
    { "type": "tile-styles", "sourceDir": "data/tile-styles" }
  ],
  "bindMounts": [
    { "source": "@infra:data", "target": "/data", "readOnly": false },
    {
      "source": "@service:motis:tools/transitous",
      "target": "/config/transitous",
      "readOnly": true
    },
    {
      "source": "@docker-socket",
      "target": "/var/run/docker.sock",
      "readOnly": false
    },
    {
      "source": "${OPENMAPX_HOST_DIR:?OPENMAPX_HOST_DIR must be set — the data-manager bind-mounts the repo root so POST /transit/bump can persist infra/docker/transitous.lock.json on the host}",
      "target": "${OPENMAPX_HOST_DIR:?OPENMAPX_HOST_DIR must be set}",
      "readOnly": false
    },
    {
      "source": "@infra:secrets/transitous-feed-proxy.age",
      "target": "/secrets/transitous-feed-proxy.age",
      "readOnly": true,
      "optional": true
    }
  ],
  "exposure": {
    "hostPorts": [{ "container": 4000, "host": 4000, "bindAddress": "127.0.0.1" }]
  },
  "ui": { "category": "infrastructure" }
}
