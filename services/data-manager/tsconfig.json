{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": "..",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "lib": ["ES2023"],
    "types": ["node"]
  },
  "include": ["src/**/*", "__tests__/**/*", "../motis-feed-proxy/lib/**/*.ts"]
}
