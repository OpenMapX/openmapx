{
  "id": "motis-feed-proxy",
  "name": "MOTIS Feed Proxy",
  "version": "1.0.0",
  "description": "Transitous-style feed proxy for GTFS-RT and GBFS URLs that need header/URL indirection.",
  "license": "MIT",
  "quality": "built-in",
  "homepage": "https://github.com/public-transport/transitous",
  "subjectData": {
    "storesPersonalData": false,
    "strategy": "not_personal",
    "registrationIds": [],
    "operatorInstructions": null
  },
  "container": {
    "image": "nginx",
    "tag": "1.31.6-alpine",
    "digest": "sha256:adad2ae9204d0fd7a34f40299bc838c3782be1293b10005eac4315ff5a1abf4e",
    "containerName": "motis-feed-proxy",
    "expose": [80],
    "networkAliases": ["rt.openmapx.local"],
    "memory": "256m",
    "restart": "unless-stopped",
    "healthcheck": {
      "type": "http",
      "path": "/healthz",
      "port": 80,
      "interval": "30s",
      "timeout": "5s",
      "retries": 3
    }
  },
  "provides": ["proxy"],
  "consumes": [
    {
      "type": "motis-feed-proxy-config",
      "mountAt": "/etc/nginx/conf.d",
      "readOnly": true,
      "required": true
    }
  ],
  "ui": { "category": "transit" }
}
