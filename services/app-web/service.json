{
  "id": "app-web",
  "name": "OpenMapX Web",
  "version": "1.0.0",
  "description": "Next.js 16 frontend. MapLibre + MUI + Tailwind.",
  "license": "MIT",
  "quality": "built-in",
  "container": {
    "image": "ghcr.io/medformatik/openmapx-web",
    "tag": "latest",
    "expose": [3000],
    "environment": {
      "NEXT_PUBLIC_API_URL": "https://${DOMAIN:-localhost}",
      "INTERNAL_API_URL": "http://app-api:3001",
      "NEXT_PUBLIC_MAPILLARY_TOKEN": "${MAPILLARY_TOKEN:-}",
      "NEXT_PUBLIC_MAP_STYLE_URL": "${NEXT_PUBLIC_MAP_STYLE_URL:-}",
      "NEXT_PUBLIC_TILES_URL": "${NEXT_PUBLIC_TILES_URL:-}",
      "NEXT_PUBLIC_STYLE_PROVIDER": "${NEXT_PUBLIC_STYLE_PROVIDER:-maptiler}",
      "NEXT_PUBLIC_TRAFFIC_MIN_ZOOM": "${NEXT_PUBLIC_TRAFFIC_MIN_ZOOM:-}",
      "NEXT_PUBLIC_TRAFFIC_TILE_URL_TEMPLATE": "${NEXT_PUBLIC_TRAFFIC_TILE_URL_TEMPLATE:-}",
      "NEXT_PUBLIC_CYCLOSM_TILE_URL_TEMPLATE": "${NEXT_PUBLIC_CYCLOSM_TILE_URL_TEMPLATE:-}",
      "NEXT_PUBLIC_TERRAIN_TILE_URL_TEMPLATE": "${NEXT_PUBLIC_TERRAIN_TILE_URL_TEMPLATE:-}",
      "LEGAL_NAME": "${LEGAL_NAME:-}",
      "LEGAL_STREET": "${LEGAL_STREET:-}",
      "LEGAL_POSTAL_CODE": "${LEGAL_POSTAL_CODE:-}",
      "LEGAL_CITY": "${LEGAL_CITY:-}",
      "LEGAL_COUNTRY": "${LEGAL_COUNTRY:-}",
      "LEGAL_EMAIL": "${LEGAL_EMAIL:-}",
      "LEGAL_PHONE": "${LEGAL_PHONE:-}",
      "LEGAL_JURISDICTION_CITY": "${LEGAL_JURISDICTION_CITY:-}"
    },
    "memory": "512m",
    "restart": "unless-stopped",
    "dependsOn": [{ "service": "app-api", "condition": "service_healthy" }]
  },
  "exposure": {
    "proxy": {
      "enabled": true,
      "pathPrefix": "/",
      "priority": 1,
      "additionalRoutes": [
        {
          "path": "/sw.js",
          "middleware": ["sw-no-cache@file"]
        },
        {
          "path": "/manifest.webmanifest",
          "middleware": ["manifest-short-cache@file"]
        }
      ]
    }
  },
  "ui": { "category": "application" }
}
