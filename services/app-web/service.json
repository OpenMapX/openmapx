{
  "id": "app-web",
  "name": "OpenMapX Web",
  "version": "1.0.0",
  "description": "Next.js 16 frontend. MapLibre + MUI.",
  "license": "MIT",
  "quality": "built-in",
  "subjectData": {
    "storesPersonalData": false,
    "strategy": "not_personal",
    "registrationIds": [],
    "operatorInstructions": null
  },
  "container": {
    "image": "ghcr.io/openmapx/web",
    "tag": "main",
    "expose": [3000],
    "environment": {
      "BASEMAP_PROVIDER": "${BASEMAP_PROVIDER:-}",
      "NEXT_PUBLIC_API_URL": "https://${DOMAIN:-localhost}",
      "INTERNAL_API_URL": "http://app-api:3001",
      "NEXT_PUBLIC_MAP_STYLE_URL": "${NEXT_PUBLIC_MAP_STYLE_URL:-}",
      "NEXT_PUBLIC_TILES_URL": "${NEXT_PUBLIC_TILES_URL:-}",
      "NEXT_PUBLIC_STYLE_PROVIDER": "${NEXT_PUBLIC_STYLE_PROVIDER:-openmapx}",
      "NEXT_PUBLIC_TRAFFIC_MIN_ZOOM": "${NEXT_PUBLIC_TRAFFIC_MIN_ZOOM:-}",
      "NEXT_PUBLIC_TRAFFIC_TILE_URL_TEMPLATE": "${NEXT_PUBLIC_TRAFFIC_TILE_URL_TEMPLATE:-}",
      "NEXT_PUBLIC_CYCLOSM_TILE_URL_TEMPLATE": "${NEXT_PUBLIC_CYCLOSM_TILE_URL_TEMPLATE:-}",
      "NEXT_PUBLIC_TERRAIN_DEM_TILEJSON_URL": "${NEXT_PUBLIC_TERRAIN_DEM_TILEJSON_URL:-}",
      "NEXT_PUBLIC_TERRAIN_CONTOUR_TILEJSON_URL": "${NEXT_PUBLIC_TERRAIN_CONTOUR_TILEJSON_URL:-}",
      "NEXT_PUBLIC_TERRAIN_ATTRIBUTION_NAME": "${NEXT_PUBLIC_TERRAIN_ATTRIBUTION_NAME:-}",
      "NEXT_PUBLIC_TERRAIN_ATTRIBUTION_URL": "${NEXT_PUBLIC_TERRAIN_ATTRIBUTION_URL:-}",
      "LEGAL_NAME": "${LEGAL_NAME:-}",
      "LEGAL_STREET": "${LEGAL_STREET:-}",
      "LEGAL_POSTAL_CODE": "${LEGAL_POSTAL_CODE:-}",
      "LEGAL_CITY": "${LEGAL_CITY:-}",
      "LEGAL_COUNTRY": "${LEGAL_COUNTRY:-}",
      "LEGAL_EMAIL": "${LEGAL_EMAIL:-}",
      "LEGAL_PHONE": "${LEGAL_PHONE:-}",
      "LEGAL_JURISDICTION_CITY": "${LEGAL_JURISDICTION_CITY:-}"
    },
    "memory": "512m",
    "restart": "unless-stopped",
    "dependsOn": [
      {
        "service": "app-api",
        "condition": "service_healthy"
      }
    ]
  },
  "exposure": {
    "proxy": {
      "enabled": true,
      "pathPrefix": "/",
      "priority": 1,
      "additionalRoutes": [
        {
          "path": "/sw.js",
          "middleware": ["sw-no-cache@file"]
        },
        {
          "path": "/manifest.webmanifest",
          "middleware": ["manifest-short-cache@file"]
        }
      ]
    }
  },
  "ui": {
    "category": "application"
  },
  "configSchema": {
    "type": "object",
    "properties": {
      "NEXT_PUBLIC_STYLE_PROVIDER": {
        "type": "string",
        "title": "Map style provider",
        "enum": ["openmapx", "maptiler"]
      },
      "NEXT_PUBLIC_MAP_STYLE_URL": {
        "type": "string",
        "title": "Glyph server base URL",
        "format": "map-url",
        "maxLength": 2048
      },
      "NEXT_PUBLIC_TILES_URL": {
        "type": "string",
        "title": "Basemap TileJSON URL",
        "format": "map-url",
        "maxLength": 2048
      },
      "NEXT_PUBLIC_TRAFFIC_TILE_URL_TEMPLATE": {
        "type": "string",
        "title": "Raster traffic tile URL template",
        "format": "map-tile-url",
        "maxLength": 2048
      },
      "NEXT_PUBLIC_CYCLOSM_TILE_URL_TEMPLATE": {
        "type": "string",
        "title": "CyclOSM tile URL template",
        "format": "map-tile-url",
        "maxLength": 2048
      },
      "NEXT_PUBLIC_TERRAIN_DEM_TILEJSON_URL": {
        "type": "string",
        "title": "Terrain DEM TileJSON URL",
        "format": "map-url",
        "maxLength": 2048
      },
      "NEXT_PUBLIC_TERRAIN_CONTOUR_TILEJSON_URL": {
        "type": "string",
        "title": "Contour TileJSON URL",
        "format": "map-url",
        "maxLength": 2048
      },
      "NEXT_PUBLIC_TERRAIN_ATTRIBUTION_NAME": {
        "type": "string",
        "title": "Terrain attribution",
        "maxLength": 200
      },
      "NEXT_PUBLIC_TERRAIN_ATTRIBUTION_URL": {
        "type": "string",
        "title": "Terrain attribution URL",
        "format": "map-url",
        "maxLength": 2048
      },
      "NEXT_PUBLIC_TRAFFIC_MIN_ZOOM": {
        "type": "integer",
        "title": "Raster traffic minimum zoom",
        "minimum": 0,
        "maximum": 24
      },
      "OPENMAPX_MEMORY_MIB": {
        "type": "integer",
        "title": "Container memory limit (MiB)",
        "minimum": 16,
        "maximum": 1048576,
        "description": "Optional Docker resource limit. Unset preserves the image manifest limit. Clear the field to restore the manifest limit."
      },
      "OPENMAPX_CPU_LIMIT": {
        "type": "number",
        "title": "Container CPU limit",
        "minimum": 0.125,
        "maximum": 256,
        "description": "Optional Docker resource limit. Unset preserves the image manifest limit. Clear the field to restore the manifest limit."
      }
    }
  }
}
