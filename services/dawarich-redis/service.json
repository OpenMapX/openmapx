{
  "id": "dawarich-redis",
  "name": "Dawarich Redis",
  "version": "8.10",
  "description": "Dedicated transient job queue and cache for the managed Dawarich timeline.",
  "license": "RSALv2 OR SSPL-1.0 OR AGPL-3.0",
  "quality": "built-in",
  "homepage": "https://redis.io/",
  "subjectData": {
    "storesPersonalData": true,
    "strategy": "operator_task",
    "registrationIds": ["redis-subject-controls"],
    "operatorInstructions": "Review exact subject-derived controls; do not export keys or values."
  },
  "container": {
    "image": "redis",
    "tag": "8.10-alpine",
    "digest": "sha256:21090af93f8324db2f0f0f4f38a7c60369d47d917e000c3423d89d2ae2883537",
    "expose": [6379],
    "command": ["redis-server", "--save", "900", "1", "--save", "300", "10", "--appendonly", "no"],
    "memory": "512m",
    "restart": "unless-stopped",
    "healthcheck": {
      "type": "exec",
      "command": ["redis-cli", "--raw", "incr", "ping"],
      "interval": "10s",
      "timeout": "10s",
      "retries": 5,
      "startPeriod": "30s"
    }
  },
  "provides": ["cache"],
  "volumes": [
    {
      "name": "openmapx-dawarich-redis-data",
      "mountAt": "/data",
      "backup": false
    }
  ],
  "ui": { "category": "infrastructure" }
}
