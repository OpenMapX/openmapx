{
  "id": "dawarich-redis",
  "name": "Dawarich Redis",
  "version": "7.4",
  "description": "Dedicated transient job queue and cache for the managed Dawarich timeline.",
  "license": "RSALv2 OR SSPL-1.0",
  "quality": "built-in",
  "homepage": "https://redis.io/",
  "container": {
    "image": "redis",
    "tag": "7.4-alpine",
    "expose": [6379],
    "command": ["redis-server", "--save", "900", "1", "--save", "300", "10", "--appendonly", "no"],
    "memory": "512m",
    "restart": "unless-stopped",
    "healthcheck": {
      "type": "exec",
      "command": ["redis-cli", "--raw", "incr", "ping"],
      "interval": "10s",
      "timeout": "10s",
      "retries": 5,
      "startPeriod": "30s"
    }
  },
  "provides": ["cache"],
  "volumes": [
    {
      "name": "openmapx-dawarich-redis-data",
      "mountAt": "/data",
      "backup": false
    }
  ],
  "ui": { "category": "infrastructure" }
}
