{
  "id": "pelias",
  "name": "Pelias API",
  "version": "1.0.0",
  "description": "Modular geocoder query API. Requires Elasticsearch + placeholder + pip services.",
  "license": "MIT",
  "quality": "built-in",
  "homepage": "https://pelias.io/",
  "container": {
    "image": "pelias/api",
    "tag": "latest",
    "digest": "sha256:831766a9c0f9ded0d6f1d8bfb2121eb0b6778e80eda5c16636515da1b53aadf8",
    "expose": [4000],
    "environment": { "PELIAS_CONFIG": "/code/pelias.json" },
    "restart": "unless-stopped",
    "dependsOn": [
      { "service": "elasticsearch", "condition": "service_healthy" },
      { "service": "pelias-placeholder", "condition": "service_started" },
      { "service": "pelias-pip", "condition": "service_started" }
    ]
  },
  "buildCommand": "openmapx services build pelias",
  "provides": ["geocoder"],
  "produces": [
    { "type": "pelias-placeholder-data", "sourceDir": "data/pelias/placeholder" },
    { "type": "pelias-whosonfirst-data", "sourceDir": "data/pelias/whosonfirst" }
  ],
  "bindMounts": [{ "source": "config/pelias.json", "target": "/code/pelias.json" }],
  "exposure": {
    "hostPorts": [{ "container": 4000, "host": 4300, "bindAddress": "127.0.0.1" }]
  },
  "ui": { "category": "geocoding" }
}
