{
  "id": "pelias",
  "name": "Pelias API",
  "version": "1.0.0",
  "description": "Modular geocoder query API. Requires Elasticsearch + placeholder + pip services.",
  "license": "MIT",
  "quality": "built-in",
  "homepage": "https://pelias.io/",
  "subjectData": {
    "storesPersonalData": false,
    "strategy": "not_personal",
    "registrationIds": [],
    "operatorInstructions": null
  },
  "container": {
    "image": "pelias/api",
    "tag": "v7.11.0",
    "digest": "sha256:7174871a9ecd1343fc0dcb0a0d11848a0b634677de40f9b80ed2ce6b64308080",
    "expose": [4000],
    "environment": { "PELIAS_CONFIG": "/code/pelias.json" },
    "restart": "unless-stopped",
    "dependsOn": [
      { "service": "elasticsearch", "condition": "service_healthy" },
      { "service": "pelias-placeholder", "condition": "service_started" },
      { "service": "pelias-pip", "condition": "service_started" }
    ]
  },
  "buildCommand": "openmapx services build pelias",
  "buildImages": {
    "schema": {
      "image": "pelias/schema",
      "tag": "v10.1.1",
      "digest": "sha256:518a5b7772c54594df5155c7525bef4f5de039f4762e7b01d565de2cef44738a"
    },
    "whosonfirst": {
      "image": "pelias/whosonfirst",
      "tag": "v9.2.0",
      "digest": "sha256:3226682d028e49ffe49ff051fe739d913df5141ae563bbd2ec606c5bfe5ad2f0"
    },
    "openstreetmap": {
      "image": "pelias/openstreetmap",
      "tag": "v9.5.0",
      "digest": "sha256:867526e241bdaada37aee9fcca972d26425cac1f5abd46da289cbcaa32cda488"
    }
  },
  "provides": ["geocoder"],
  "produces": [
    { "type": "pelias-placeholder-data", "sourceDir": "data/pelias/placeholder" },
    { "type": "pelias-whosonfirst-data", "sourceDir": "data/pelias/whosonfirst" }
  ],
  "bindMounts": [{ "source": "config/pelias.json", "target": "/code/pelias.json" }],
  "exposure": {
    "hostPorts": [{ "container": 4000, "host": 4300, "bindAddress": "127.0.0.1" }]
  },
  "ui": { "category": "geocoding" }
}
