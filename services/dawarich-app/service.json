{
  "id": "dawarich-app",
  "name": "Dawarich Timeline",
  "version": "1.10.3",
  "description": "Managed multi-user Dawarich web application with OpenMapX OIDC sign-in.",
  "license": "AGPL-3.0",
  "quality": "built-in",
  "homepage": "https://dawarich.app/",
  "documentation": "https://dawarich.app/docs/self-hosting/",
  "container": {
    "image": "freikin/dawarich",
    "tag": "1.10.3",
    "digest": "sha256:d7457e7b27a9992f2fdd367fe22a515b1b44fc6e0cfb7a68f3c69c439c465a6b",
    "expose": [3000],
    "entrypoint": ["/usr/local/bin/openmapx-entrypoint.sh"],
    "command": ["bin/rails", "server", "-p", "3000", "-b", "::"],
    "environment": {
      "RAILS_ENV": "production",
      "REDIS_URL": "redis://dawarich-redis:6379",
      "DATABASE_HOST": "dawarich-postgis",
      "DATABASE_PORT": "5432",
      "DATABASE_USERNAME": "postgres",
      "DATABASE_NAME": "dawarich_production",
      "APPLICATION_HOSTS": "timeline.${DOMAIN:-localhost}",
      "APPLICATION_URL": "https://timeline.${DOMAIN:-localhost}",
      "DOMAIN": "timeline.${DOMAIN:-localhost}",
      "APPLICATION_PROTOCOL": "https",
      "TIME_ZONE": "UTC",
      "RAILS_MAX_THREADS": "5",
      "RAILS_LOG_TO_STDOUT": "true",
      "SELF_HOSTED": "true",
      "STORE_GEODATA": "true",
      "WEB_CONCURRENCY": "1",
      "PROMETHEUS_EXPORTER_ENABLED": "false",
      "OIDC_CLIENT_ID": "${SERVICE_DAWARICH_APP_OIDC_CLIENT_ID:-}",
      "OIDC_ISSUER": "https://${DOMAIN:-localhost}/api/auth",
      "OIDC_REDIRECT_URI": "https://timeline.${DOMAIN:-localhost}/users/auth/openid_connect/callback",
      "OIDC_PROVIDER_NAME": "OpenMapX",
      "OIDC_AUTO_REGISTER": "true",
      "OIDC_PKCE_ENABLED": "true",
      "ALLOW_EMAIL_PASSWORD_REGISTRATION": "true",
      "ALLOW_EMAIL_PASSWORD_LOGIN": "true"
    },
    "memory": "4g",
    "restart": "unless-stopped",
    "healthcheck": {
      "type": "http",
      "path": "/api/v1/health",
      "port": 3000,
      "interval": "10s",
      "timeout": "10s",
      "retries": 30,
      "startPeriod": "30s"
    },
    "dependsOn": [
      { "service": "dawarich-postgis", "condition": "service_healthy" },
      { "service": "dawarich-redis", "condition": "service_healthy" }
    ],
    "logging": {
      "driver": "json-file",
      "options": { "max-size": "100m", "max-file": "5" }
    }
  },
  "provides": ["timeline"],
  "selectionDependencies": ["dawarich-sidekiq"],
  "configSchema": {
    "type": "object",
    "properties": {
      "APPLICATION_HOSTS": {
        "type": "string",
        "title": "Public Dawarich hostname",
        "default": "timeline.{domain}"
      },
      "APPLICATION_URL": {
        "type": "string",
        "title": "Public Dawarich URL",
        "default": "https://timeline.{domain}"
      },
      "DOMAIN": { "type": "string", "title": "Dawarich public hostname" },
      "APPLICATION_PROTOCOL": {
        "type": "string",
        "title": "Dawarich public protocol",
        "default": "https"
      },
      "TIME_ZONE": { "type": "string", "title": "Default time zone", "default": "UTC" },
      "REDIS_URL": { "type": "string", "title": "Dawarich Redis URL" },
      "DATABASE_HOST": { "type": "string", "title": "Dawarich database host" },
      "DATABASE_PORT": { "type": "string", "title": "Dawarich database port" },
      "DATABASE_USERNAME": { "type": "string", "title": "Dawarich database user" },
      "DATABASE_NAME": { "type": "string", "title": "Dawarich database name" },
      "OIDC_CLIENT_ID": { "type": "string", "title": "OpenMapX OIDC client ID" },
      "OIDC_ISSUER": {
        "type": "string",
        "title": "OpenMapX OIDC issuer",
        "default": "https://{domain}/api/auth"
      },
      "OIDC_REDIRECT_URI": {
        "type": "string",
        "title": "Dawarich OIDC callback URL",
        "default": "https://timeline.{domain}/users/auth/openid_connect/callback"
      },
      "OIDC_PROVIDER_NAME": { "type": "string", "title": "OIDC provider name" },
      "OIDC_AUTO_REGISTER": { "type": "string", "title": "OIDC automatic registration" },
      "OIDC_PKCE_ENABLED": { "type": "string", "title": "OIDC PKCE requirement" },
      "OPENMAPX_PROVISIONING_GENERATION": {
        "type": "string",
        "title": "OpenMapX managed provisioning generation",
        "description": "Internal non-secret marker used to verify that the managed app and worker run the same applied configuration.",
        "readOnly": true
      },
      "WEB_CONCURRENCY": {
        "type": "string",
        "title": "Puma worker count",
        "default": "1"
      },
      "RAILS_MAX_THREADS": {
        "type": "string",
        "title": "Rails database pool/thread count",
        "default": "5"
      },
      "LOG_MAX_SIZE": {
        "type": "string",
        "title": "Maximum JSON log file size",
        "default": "100m"
      },
      "LOG_MAX_FILE": {
        "type": "string",
        "title": "Maximum JSON log file count",
        "default": "5"
      },
      "DATABASE_PASSWORD": {
        "type": "string",
        "title": "Dawarich database password",
        "x-openmapx-secret": true
      },
      "SECRET_KEY_BASE": {
        "type": "string",
        "title": "Dawarich Rails secret key base",
        "x-openmapx-secret": true
      },
      "OIDC_CLIENT_SECRET": {
        "type": "string",
        "title": "OpenMapX OIDC client secret",
        "x-openmapx-secret": true
      }
    }
  },
  "volumes": [
    {
      "name": "openmapx-dawarich-public",
      "mountAt": "/var/app/public",
      "backup": true,
      "backupMode": "tar"
    },
    {
      "name": "openmapx-dawarich-watched",
      "mountAt": "/var/app/tmp/imports/watched",
      "backup": true,
      "backupMode": "tar"
    },
    {
      "name": "openmapx-dawarich-storage",
      "mountAt": "/var/app/storage",
      "backup": true,
      "backupMode": "tar"
    }
  ],
  "bindMounts": [
    {
      "source": "scripts/openmapx-entrypoint.sh",
      "target": "/usr/local/bin/openmapx-entrypoint.sh",
      "readOnly": true
    }
  ],
  "exposure": {
    "proxy": {
      "enabled": true,
      "host": { "default": "timeline.{domain}", "configKey": "APPLICATION_HOSTS" }
    }
  },
  "ui": { "category": "timeline" }
}
