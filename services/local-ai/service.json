{
  "id": "local-ai",
  "name": "Local AI (Ollama)",
  "version": "1.0.0",
  "description": "Self-hosted LLM inference (Ollama) for natural-language search parsing.",
  "license": "MIT",
  "quality": "built-in",
  "homepage": "https://ollama.com/",
  "subjectData": {
    "storesPersonalData": false,
    "strategy": "not_personal",
    "registrationIds": [],
    "operatorInstructions": null
  },
  "container": {
    "image": "ollama/ollama",
    "tag": "0.40.13",
    "digest": "sha256:b2f0122c476bc9fe7ce679d8bb4bd555351e25e2554eefb156f61cb0a89cf429",
    "expose": [11434],
    "environment": {
      "OLLAMA_KEEP_ALIVE": "${OLLAMA_KEEP_ALIVE:-30m}",
      "OLLAMA_MAX_LOADED_MODELS": "${OLLAMA_MAX_LOADED_MODELS:-1}"
    },
    "memory": "${LOCAL_AI_MEMORY:-8g}",
    "restart": "unless-stopped",
    "healthcheck": {
      "type": "exec",
      "command": ["ollama", "list"],
      "interval": "30s",
      "timeout": "5s",
      "retries": 5,
      "startPeriod": "60s"
    }
  },
  "provides": ["llm-inference"],
  "volumes": [
    {
      "name": "openmapx-ollama",
      "mountAt": "/root/.ollama",
      "backup": false
    }
  ],
  "exposure": {
    "hostPorts": [
      {
        "container": 11434,
        "host": 11434,
        "bindAddress": "127.0.0.1"
      }
    ]
  },
  "ui": {
    "category": "infrastructure"
  },
  "configSchema": {
    "type": "object",
    "properties": {
      "OLLAMA_KEEP_ALIVE": {
        "type": "string",
        "title": "Model keep-alive (0 or duration, at most 24h)",
        "format": "ollama-duration",
        "maxLength": 32
      },
      "OLLAMA_MAX_LOADED_MODELS": {
        "type": "integer",
        "title": "Maximum loaded models",
        "minimum": 1,
        "maximum": 32
      },
      "OPENMAPX_MEMORY_MIB": {
        "type": "integer",
        "title": "Container memory limit (MiB)",
        "minimum": 16,
        "maximum": 1048576,
        "description": "Optional Docker resource limit. Unset preserves the image manifest limit. Clear the field to restore the manifest limit."
      },
      "OPENMAPX_CPU_LIMIT": {
        "type": "number",
        "title": "Container CPU limit",
        "minimum": 0.125,
        "maximum": 256,
        "description": "Optional Docker resource limit. Unset preserves the image manifest limit. Clear the field to restore the manifest limit."
      }
    }
  }
}
