{
  "id": "overpass",
  "name": "Overpass API",
  "version": "1.0.0",
  "description": "OSM query service. Planet import: ~24h, ~200GB disk, ~4GB RAM.",
  "license": "AGPL-3.0",
  "quality": "built-in",
  "homepage": "https://wiki.openstreetmap.org/wiki/Overpass_API",
  "communityNetworkAccess": ["openconditions-ingest"],
  "subjectData": {
    "storesPersonalData": false,
    "strategy": "not_personal",
    "registrationIds": [],
    "operatorInstructions": null
  },
  "container": {
    "image": "wiktorn/overpass-api",
    "tag": "latest",
    "digest": "sha256:9bb5f4a9b54cd225bf828c04c67e7f4010650ff4d70b72157a9473a9ba02d93c",
    "expose": [80],
    "environment": {
      "OVERPASS_META": "yes",
      "OVERPASS_MODE": "init",
      "OVERPASS_PLANET_URL": "file:///osm/data.osm.bz2",
      "OVERPASS_PLANET_PREPROCESS": "rm -f /db/planet.osm.bz2 && ln -s /osm/data.osm.bz2 /db/planet.osm.bz2",
      "OVERPASS_DIFF_URL": "${OVERPASS_DIFF_URL:-https://planet.openstreetmap.org/replication/day/}",
      "OVERPASS_COMPRESSION": "lz4",
      "OVERPASS_RULES_LOAD": "10",
      "OVERPASS_SPACE": "${OVERPASS_SPACE:-107374182400}",
      "OVERPASS_UPDATE_SLEEP": "86400",
      "OVERPASS_FASTCGI_PROCESSES": "${OVERPASS_FASTCGI_PROCESSES:-4}",
      "OVERPASS_STOP_AFTER_INIT": "false",
      "OVERPASS_MAX_TIMEOUT": "300s",
      "OVERPASS_ALLOW_DUPLICATE_QUERIES": "${OVERPASS_ALLOW_DUPLICATE_QUERIES:-yes}"
    },
    "memory": "32g",
    "restart": "unless-stopped",
    "healthcheck": {
      "type": "exec",
      "command": [
        "sh",
        "-c",
        "curl -g -qfs 'http://localhost/api/interpreter?data=[out:json];node(1);out;' | grep -q Overpass || exit 1"
      ],
      "interval": "60s",
      "timeout": "10s",
      "retries": 3,
      "startPeriod": "172800s"
    },
    "logging": {
      "driver": "json-file",
      "options": {
        "max-size": "50m",
        "max-file": "3"
      }
    }
  },
  "provides": ["osm-query"],
  "consumes": [
    {
      "type": "osm-pbf-bz2",
      "mountAt": "/osm",
      "readOnly": true,
      "required": true
    }
  ],
  "bindMounts": [
    {
      "source": "@infra:data/overpass/db",
      "target": "/db",
      "readOnly": false
    }
  ],
  "exposure": {
    "hostPorts": [
      {
        "container": 80,
        "host": 8082,
        "bindAddress": "127.0.0.1"
      }
    ]
  },
  "ui": {
    "category": "osm-query"
  },
  "configSchema": {
    "type": "object",
    "properties": {
      "OVERPASS_SPACE": {
        "type": "integer",
        "title": "Maximum query memory (bytes)",
        "minimum": 1073741824,
        "maximum": 10995116277760
      },
      "OVERPASS_FASTCGI_PROCESSES": {
        "type": "integer",
        "title": "FastCGI processes",
        "minimum": 1,
        "maximum": 128
      },
      "OVERPASS_UPDATE_SLEEP": {
        "type": "integer",
        "title": "Update interval (seconds)",
        "minimum": 60,
        "maximum": 604800
      },
      "OVERPASS_RULES_LOAD": {
        "type": "integer",
        "title": "Rules load",
        "minimum": 1,
        "maximum": 100
      },
      "OPENMAPX_MEMORY_MIB": {
        "type": "integer",
        "title": "Container memory limit (MiB)",
        "minimum": 16,
        "maximum": 1048576,
        "description": "Optional Docker resource limit. Unset preserves the image manifest limit. Clear the field to restore the manifest limit."
      },
      "OPENMAPX_CPU_LIMIT": {
        "type": "number",
        "title": "Container CPU limit",
        "minimum": 0.125,
        "maximum": 256,
        "description": "Optional Docker resource limit. Unset preserves the image manifest limit. Clear the field to restore the manifest limit."
      }
    }
  }
}
