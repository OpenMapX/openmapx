{
  "id": "motis-staging",
  "name": "MOTIS (staging)",
  "version": "1.0.0",
  "description": "Staging MOTIS instance — rebuild target for the data-manager's Transitous atomic-swap pipeline. Not query-facing; only the primary `motis` service receives application traffic. Opt-in: start with `--services motis-staging` (or add to the persisted selection) when running the data-manager promotion flow.",
  "license": "MIT",
  "quality": "built-in",
  "homepage": "https://github.com/motis-project/motis",
  "container": {
    "image": "ghcr.io/motis-project/motis",
    "tag": "2.10.2",
    "containerName": "motis-staging",
    "expose": [8080],
    "user": "${UID:-1000}:${GID:-1000}",
    "workingDir": "/motis-data",
    "entrypoint": ["/bin/sh", "-c"],
    "command": [
      "until [ -f /motis-data/config.yml ]; do echo 'motis-staging: waiting for /motis-data/config.yml'; sleep 5; done; /motis import && /motis server"
    ],
    "dependsOn": [{ "service": "motis-feed-proxy", "condition": "service_started" }],
    "memory": "16g",
    "restart": "unless-stopped",
    "healthcheck": {
      "type": "http",
      "path": "/api/v1/health",
      "port": 8080,
      "interval": "30s",
      "timeout": "10s",
      "retries": 5,
      "startPeriod": "600s"
    },
    "logging": {
      "driver": "json-file",
      "options": { "max-size": "50m", "max-file": "3" }
    }
  },
  "provides": ["transit-engine-staging"],
  "bindMounts": [
    { "source": "@infra:data/motis/staging", "target": "/motis-data", "readOnly": false }
  ],
  "exposure": {
    "hostPorts": [{ "container": 8080, "host": 8083, "bindAddress": "127.0.0.1" }]
  },
  "ui": { "category": "transit" }
}
