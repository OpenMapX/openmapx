{
  "mjolnir": {
    "tile_dir": "/custom_files/valhalla_tiles",
    "concurrency": 8
  },
  "additional_data": {
    "elevation": "/custom_files/elevation_data"
  },
  "httpd": {
    "service": {
      "listen": "tcp://*:8002",
      "loopback": "ipc:///tmp/loopback",
      "interrupt": "ipc:///tmp/interrupt",
      "drain_seconds": 28,
      "shutdown_seconds": 1
    }
  },
  "service_limits": {
    "auto": {
      "max_distance": 5000000.0,
      "max_locations": 20
    },
    "bicycle": {
      "max_distance": 500000.0,
      "max_locations": 50
    },
    "pedestrian": {
      "max_distance": 250000.0,
      "max_locations": 50,
      "max_transit_walking_distance": 10000,
      "min_transit_walking_distance": 1
    },
    "isochrone": {
      "max_contours": 4,
      "max_distance": 25000.0,
      "max_locations": 1,
      "max_time_contour": 120
    },
    "trace": {
      "max_distance": 200000.0,
      "max_shape": 16000
    },
    "skadi": {
      "max_shape": 750000,
      "min_resample": 10.0
    }
  },
  "loki": {
    "logging": {
      "type": "",
      "long_request": 110.0
    }
  },
  "thor": {
    "logging": {
      "type": "",
      "long_request": 110.0
    }
  },
  "meili": {
    "logging": {
      "type": "",
      "long_request": 110.0
    }
