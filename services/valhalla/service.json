{
  "id": "valhalla",
  "name": "Valhalla",
  "version": "1.0.0",
  "description": "Multi-modal routing engine using OpenStreetMap data. Handles planet-scale (~16GB RAM).",
  "license": "MIT",
  "quality": "built-in",
  "homepage": "https://valhalla.github.io/valhalla/",
  "documentation": "https://valhalla.github.io/valhalla/api/",
  "subjectData": {
    "storesPersonalData": false,
    "strategy": "not_personal",
    "registrationIds": [],
    "operatorInstructions": null
  },
  "container": {
    "image": "ghcr.io/valhalla/valhalla-scripted",
    "tag": "latest",
    "digest": "sha256:f9f12c3f835750fc657d1d030a392f7a548699c1c2a961d083ed761e0db8bc14",
    "expose": [8002],
    "environment": {
      "serve_tiles": "True",
      "build_elevation": "True",
      "build_admins": "True",
      "build_time_zones": "True",
      "use_tiles_ignore_pbf": "False"
    },
    "memory": "16g",
    "restart": "unless-stopped",
    "healthcheck": {
      "type": "http",
      "path": "/status",
      "port": 8002,
      "interval": "30s",
      "timeout": "10s",
      "retries": 5
    },
    "entrypoint": ["python3", "/opt/openmapx/traffic-watchdog.py"],
    "command": ["build_tiles"]
  },
  "provides": ["routing-engine"],
  "consumes": [
    {
      "type": "osm-pbf",
      "mountAt": "/custom_files",
      "required": true
    }
  ],
  "bindMounts": [
    {
      "source": "config/valhalla.json",
      "target": "/custom_files/valhalla.json",
      "readOnly": false
    },
    {
      "source": "scripts/traffic-watchdog.py",
      "target": "/opt/openmapx/traffic-watchdog.py",
      "readOnly": true
    },
    {
      "source": "@infra:data/traffic",
      "target": "/traffic-state",
      "readOnly": false
    }
  ],
  "configSchema": {
    "type": "object",
    "properties": {
      "build_elevation": {
        "type": "boolean",
        "default": true,
        "title": "Build elevation data"
      },
      "build_admins": {
        "type": "boolean",
        "default": true,
        "title": "Build admin boundaries"
      }
    }
  },
  "exposure": {
    "hostPorts": [
      {
        "container": 8002,
        "host": 8002,
        "bindAddress": "127.0.0.1"
      }
    ]
  },
  "ui": {
    "category": "routing",
    "icon": "icons/valhalla.svg"
  }
}
