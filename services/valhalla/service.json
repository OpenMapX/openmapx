{
  "id": "valhalla",
  "name": "Valhalla",
  "version": "1.0.0",
  "description": "Multi-modal routing engine using OpenStreetMap data. Handles planet-scale (~16GB RAM).",
  "license": "MIT",
  "quality": "built-in",
  "homepage": "https://valhalla.github.io/valhalla/",
  "documentation": "https://valhalla.github.io/valhalla/api/",
  "subjectData": {
    "storesPersonalData": false,
    "strategy": "not_personal",
    "registrationIds": [],
    "operatorInstructions": null
  },
  "container": {
    "image": "ghcr.io/valhalla/valhalla-scripted",
    "tag": "3.9.1",
    "digest": "sha256:6238809f9dc3057743d70a20efd3911ec38e458bfa13a0601909b58f68dfd956",
    "expose": [8002],
    "environment": {
      "SERVE_TILES": "True",
      "BUILD_ELEVATION": "True",
      "BUILD_ADMINS": "True",
      "BUILD_TIME_ZONES": "True",
      "USE_TILES_IGNORE_PBF": "False"
    },
    "memory": "16g",
    "restart": "unless-stopped",
    "healthcheck": {
      "type": "http",
      "path": "/status",
      "port": 8002,
      "interval": "30s",
      "timeout": "10s",
      "retries": 5
    },
    "entrypoint": ["python3", "/opt/openmapx/traffic-watchdog.py"],
    "command": ["build_tiles"]
  },
  "provides": ["routing-engine"],
  "consumes": [
    {
      "type": "osm-pbf",
      "mountAt": "/custom_files",
      "required": true
    }
  ],
  "bindMounts": [
    {
      "source": "config/valhalla.json",
      "target": "/custom_files/valhalla.json",
      "readOnly": false,
      "writableCopy": "@infra:data/valhalla/config/valhalla.json"
    },
    {
      "source": "scripts/traffic-watchdog.py",
      "target": "/opt/openmapx/traffic-watchdog.py",
      "readOnly": true
    },
    {
      "source": "@infra:data/traffic",
      "target": "/traffic-state",
      "readOnly": false
    }
  ],
  "configSchema": {
    "type": "object",
    "properties": {
      "BUILD_ELEVATION": {
        "type": "boolean",
        "default": true,
        "title": "Build elevation data"
      },
      "BUILD_ADMINS": {
        "type": "boolean",
        "default": true,
        "title": "Build admin boundaries"
      },
      "SERVE_TILES": {
        "type": "boolean",
        "title": "Serve tiles"
      },
      "BUILD_TIME_ZONES": {
        "type": "boolean",
        "title": "Build time zones"
      },
      "USE_TILES_IGNORE_PBF": {
        "type": "boolean",
        "title": "Use tiles ignore pbf"
      },
      "OPENMAPX_MEMORY_MIB": {
        "type": "integer",
        "title": "Container memory limit (MiB)",
        "minimum": 16,
        "maximum": 1048576,
        "description": "Optional Docker resource limit. Unset preserves the image manifest limit. Clear the field to restore the manifest limit."
      },
      "OPENMAPX_CPU_LIMIT": {
        "type": "number",
        "title": "Container CPU limit",
        "minimum": 0.125,
        "maximum": 256,
        "description": "Optional Docker resource limit. Unset preserves the image manifest limit. Clear the field to restore the manifest limit."
      }
    }
  },
  "exposure": {
    "hostPorts": [
      {
        "container": 8002,
        "host": 8002,
        "bindAddress": "127.0.0.1"
      }
    ]
  },
  "ui": {
    "category": "routing",
    "icon": "icons/valhalla.svg"
  }
}
