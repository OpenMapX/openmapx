{
  "id": "app-api",
  "name": "OpenMapX API",
  "version": "1.0.0",
  "description": "Fastify BFF gateway. Proxies external services and registers integrations.",
  "license": "MIT",
  "quality": "built-in",
  "container": {
    "image": "ghcr.io/medformatik/openmapx-api",
    "tag": "latest",
    "expose": [3001],
    "environment": {
      "PORT": "3001",
      "HOST": "0.0.0.0",
      "DATABASE_URL": "postgresql://postgres:${POSTGRES_PASSWORD:-postgres}@postgis:5432/openmapx",
      "REDIS_URL": "redis://redis:6379",
      "OSRM_URL": "${OSRM_URL:-http://osrm:5000}",
      "VALHALLA_URL": "${VALHALLA_URL:-http://valhalla:8002}",
      "MOTIS_URL": "${MOTIS_URL:-http://motis:8080}",
      "TRANSITOUS_URL": "${TRANSITOUS_URL:-https://api.transitous.org}",
      "NOMINATIM_URL": "${NOMINATIM_URL:-http://nominatim:8080}",
      "OVERPASS_URL": "${OVERPASS_URL:-http://overpass:80}",
      "CORS_ORIGIN": "https://${DOMAIN:-localhost},http://localhost:3000",
      "BETTER_AUTH_SECRET": "${BETTER_AUTH_SECRET:-}",
      "BETTER_AUTH_URL": "https://${DOMAIN:-localhost}",
      "PASSKEY_RP_ID": "${DOMAIN:-localhost}",
      "PASSKEY_ORIGIN": "https://${DOMAIN:-localhost},openmapx://",
      "OPENMAPX_SECRETS_KEY": "${OPENMAPX_SECRETS_KEY:-}",
      "OSM_CLIENT_ID": "${OSM_CLIENT_ID:-}",
      "OSM_CLIENT_SECRET": "${OSM_CLIENT_SECRET:-}",
      "MAPILLARY_TOKEN": "${MAPILLARY_TOKEN:-}",
      "MAPILLARY_CLIENT_ID": "${MAPILLARY_CLIENT_ID:-}",
      "MAPILLARY_CLIENT_SECRET": "${MAPILLARY_CLIENT_SECRET:-}",
      "TRAFFIC_PROVIDER": "${TRAFFIC_PROVIDER:-tomtom}",
      "TOMTOM_TRAFFIC_KEY": "${TOMTOM_TRAFFIC_KEY:-}",
      "TOMTOM_TRAFFIC_URL": "${TOMTOM_TRAFFIC_URL:-}",
      "TOMTOM_TRAFFIC_VERSION": "${TOMTOM_TRAFFIC_VERSION:-}",
      "TOMTOM_TRAFFIC_STYLE": "${TOMTOM_TRAFFIC_STYLE:-}",
      "TOMTOM_TRAFFIC_TILE_SIZE": "${TOMTOM_TRAFFIC_TILE_SIZE:-}",
      "TOMTOM_TRAFFIC_THICKNESS": "${TOMTOM_TRAFFIC_THICKNESS:-}",
      "THUNDERFOREST_API_KEY": "${THUNDERFOREST_API_KEY:-}",
      "CYCLOSM_TILE_URL": "${CYCLOSM_TILE_URL:-}",
      "WAYMARKED_CYCLING_TILE_URL": "${WAYMARKED_CYCLING_TILE_URL:-}",
      "OPENTOPOMAP_TILE_URL": "${OPENTOPOMAP_TILE_URL:-}",
      "EMAIL_FROM": "${EMAIL_FROM:-}",
      "EMAILLABS_APP_KEY": "${EMAILLABS_APP_KEY:-}",
      "EMAILLABS_SECRET_KEY": "${EMAILLABS_SECRET_KEY:-}",
      "EMAILLABS_SMTP_ACCOUNT": "${EMAILLABS_SMTP_ACCOUNT:-}",
      "LETTERMINT_API_TOKEN": "${LETTERMINT_API_TOKEN:-}",
      "SMTP_HOST": "${SMTP_HOST:-}",
      "SMTP_PORT": "${SMTP_PORT:-}",
      "SMTP_SECURE": "${SMTP_SECURE:-}",
      "SMTP_USER": "${SMTP_USER:-}",
      "SMTP_PASS": "${SMTP_PASS:-}",
      "LOG_LEVEL": "${LOG_LEVEL:-info}",
      "OPENMAPX_DISABLE_LOCALHOST_AUTH": "${OPENMAPX_DISABLE_LOCALHOST_AUTH:-}",
      "ISOCHRONE_PROVIDER": "${ISOCHRONE_PROVIDER:-}",
      "GITHUB_TOKEN": "${GITHUB_TOKEN:-}",
      "STORE_CATALOG_URL": "${STORE_CATALOG_URL:-}"
    },
    "memory": "1g",
    "restart": "unless-stopped",
    "dependsOn": [
      { "service": "postgis", "condition": "service_healthy" },
      { "service": "redis", "condition": "service_healthy" }
    ]
  },
  "exposure": {
    "proxy": {
      "enabled": true,
      "pathPrefix": "/api",
      "additionalRoutes": [{ "path": "/health" }]
    }
  },
  "ui": { "category": "application" }
}
