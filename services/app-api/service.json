{
  "id": "app-api",
  "name": "OpenMapX API",
  "version": "1.0.0",
  "description": "Fastify BFF gateway. Proxies external services and registers integrations.",
  "license": "MIT",
  "quality": "built-in",
  "container": {
    "image": "ghcr.io/openmapx/api",
    "tag": "latest",
    "expose": [3001],
    "envFile": [".env"],
    "environment": {
      "PORT": "3001",
      "HOST": "0.0.0.0",
      "DOMAIN": "${DOMAIN:-localhost}",
      "OPENMAPX_ROOT_DIR": "/app",
      "OPENMAPX_CUSTOM_INTEGRATIONS_DIR": "${OPENMAPX_CUSTOM_INTEGRATIONS_DIR:-/app/custom_integrations}",
      "DATABASE_URL": "postgresql://postgres:${POSTGRES_PASSWORD:?POSTGRES_PASSWORD must be set}@postgis:5432/openmapx",
      "REDIS_URL": "redis://redis:6379",
      "REDIS_PASSWORD_FILE": "/run/secrets/redis-password",
      "OFFLINE_PACKAGE_PRINCIPAL_KEY_FILE": "/run/secrets/offline-package-principal-key",
      "OFFLINE_PACKAGE_PRINCIPAL_KEY_UID": "${UID:-1000}",
      "OPS_AGENT_URL": "${OPS_AGENT_URL:-http://ops-agent:4300}",
      "OPS_AGENT_TOKEN_FILE": "/run/secrets/ops-agent-api-token",
      "OPS_TRUSTED_CONFIG_DIR": "/var/lib/openmapx/trusted-config",
      "OPS_TRUSTED_CONFIG_UID": "${UID:-1000}",
      "OPS_TRUSTED_CONFIG_GID": "${GID:-1000}",
      "DATA_MANAGER_URL": "${DATA_MANAGER_URL:-http://data-manager:4000}",
      "DATA_MANAGER_AUTH_TOKEN": "${DATA_MANAGER_AUTH_TOKEN:?DATA_MANAGER_AUTH_TOKEN must be set — generate with: openssl rand -hex 32}",
      "MOTIS_LICENSE_FILE": "/var/lib/openmapx/motis-live/license.json",
      "OSRM_URL": "${OSRM_URL:-https://router.project-osrm.org}",
      "VALHALLA_URL": "${VALHALLA_URL:-https://api.stadiamaps.com}",
      "VALHALLA_API_KEY": "${VALHALLA_API_KEY:-}",
      "MOTIS_URL": "${MOTIS_URL:-https://api.transitous.org}",
      "MOTIS_OPERATIONS_PROFILE": "${MOTIS_OPERATIONS_PROFILE:-regional-assisted}",
      "TRANSITOUS_URL": "${TRANSITOUS_URL:-https://api.transitous.org}",
      "NOMINATIM_URL": "${NOMINATIM_URL:-https://nominatim.openstreetmap.org}",
      "OVERPASS_URL": "${OVERPASS_URL:-https://overpass-api.de}",
      "MAPTILER_KEY": "${MAPTILER_KEY:-}",
      "CORS_ORIGIN": "https://${DOMAIN:-localhost}",
      "BETTER_AUTH_SECRET": "${BETTER_AUTH_SECRET:-}",
      "BETTER_AUTH_URL": "https://${DOMAIN:-localhost}",
      "PASSKEY_RP_ID": "${DOMAIN:-localhost}",
      "PASSKEY_ORIGIN": "https://${DOMAIN:-localhost},openmapx://",
      "OPENMAPX_SECRETS_KEY": "${OPENMAPX_SECRETS_KEY:-}",
      "OSM_CLIENT_ID": "${OSM_CLIENT_ID:-}",
      "OSM_CLIENT_SECRET": "${OSM_CLIENT_SECRET:-}",
      "MAPILLARY_CLIENT_ID": "${MAPILLARY_CLIENT_ID:-}",
      "MAPILLARY_CLIENT_SECRET": "${MAPILLARY_CLIENT_SECRET:-}",
      "TRAFFIC_PROVIDER": "${TRAFFIC_PROVIDER:-tomtom}",
      "TOMTOM_TRAFFIC_KEY": "${TOMTOM_TRAFFIC_KEY:-}",
      "TOMTOM_TRAFFIC_URL": "${TOMTOM_TRAFFIC_URL:-}",
      "TOMTOM_TRAFFIC_VERSION": "${TOMTOM_TRAFFIC_VERSION:-}",
      "TOMTOM_TRAFFIC_STYLE": "${TOMTOM_TRAFFIC_STYLE:-}",
      "TOMTOM_TRAFFIC_TILE_SIZE": "${TOMTOM_TRAFFIC_TILE_SIZE:-}",
      "TOMTOM_TRAFFIC_THICKNESS": "${TOMTOM_TRAFFIC_THICKNESS:-}",
      "THUNDERFOREST_API_KEY": "${THUNDERFOREST_API_KEY:-}",
      "CYCLOSM_TILE_URL": "${CYCLOSM_TILE_URL:-}",
      "WAYMARKED_CYCLING_TILE_URL": "${WAYMARKED_CYCLING_TILE_URL:-}",
      "OPENTOPOMAP_TILE_URL": "${OPENTOPOMAP_TILE_URL:-}",
      "EMAIL_FROM": "${EMAIL_FROM:-}",
      "EMAILLABS_APP_KEY": "${EMAILLABS_APP_KEY:-}",
      "EMAILLABS_SECRET_KEY": "${EMAILLABS_SECRET_KEY:-}",
      "EMAILLABS_SMTP_ACCOUNT": "${EMAILLABS_SMTP_ACCOUNT:-}",
      "LETTERMINT_API_TOKEN": "${LETTERMINT_API_TOKEN:-}",
      "SMTP_HOST": "${SMTP_HOST:-}",
      "SMTP_PORT": "${SMTP_PORT:-}",
      "SMTP_SECURE": "${SMTP_SECURE:-}",
      "SMTP_USER": "${SMTP_USER:-}",
      "SMTP_PASS": "${SMTP_PASS:-}",
      "LOG_LEVEL": "${LOG_LEVEL:-info}",
      "OPENMAPX_DISABLE_LOCALHOST_AUTH": "${OPENMAPX_DISABLE_LOCALHOST_AUTH:-}",
      "OPENMAPX_LOCAL_ADMIN_TOKEN": "${OPENMAPX_LOCAL_ADMIN_TOKEN:-}",
      "ISOCHRONE_PROVIDER": "${ISOCHRONE_PROVIDER:-valhalla}",
      "GITHUB_TOKEN": "${GITHUB_TOKEN:-}",
      "EXTENSION_CATALOG_URL": "${EXTENSION_CATALOG_URL:-}",
      "NODE_OPTIONS": "${OPENMAPX_API_NODE_OPTIONS:---max-old-space-size=1536}",
      "OSM_API_URL": "${OSM_API_URL:-https://api.openstreetmap.org}",
      "OSM_WEB_URL": "${OSM_WEB_URL:-https://www.openstreetmap.org}",
      "OSM_DISCOVERY_URL": "${OSM_DISCOVERY_URL:-https://www.openstreetmap.org/.well-known/openid-configuration}",
      "OSM_CONTRIBUTIONS_ENABLED": "${OSM_CONTRIBUTIONS_ENABLED:-false}",
      "OSM_DIRECT_EDITING_ENABLED": "${OSM_DIRECT_EDITING_ENABLED:-false}",
      "OPENMAPX_VERSION": "${OPENMAPX_VERSION:-1.0}",
      "RATE_LIMIT_OSM_CONTRIBUTION_READ_MAX": "${RATE_LIMIT_OSM_CONTRIBUTION_READ_MAX:-60}",
      "RATE_LIMIT_OSM_CONTRIBUTION_READ_WINDOW_MS": "${RATE_LIMIT_OSM_CONTRIBUTION_READ_WINDOW_MS:-600000}",
      "RATE_LIMIT_OSM_CONTRIBUTION_PREVIEW_MAX": "${RATE_LIMIT_OSM_CONTRIBUTION_PREVIEW_MAX:-30}",
      "RATE_LIMIT_OSM_CONTRIBUTION_PREVIEW_WINDOW_MS": "${RATE_LIMIT_OSM_CONTRIBUTION_PREVIEW_WINDOW_MS:-600000}",
      "RATE_LIMIT_OSM_CONTRIBUTION_PUBLISH_MAX": "${RATE_LIMIT_OSM_CONTRIBUTION_PUBLISH_MAX:-10}",
      "RATE_LIMIT_OSM_CONTRIBUTION_PUBLISH_WINDOW_MS": "${RATE_LIMIT_OSM_CONTRIBUTION_PUBLISH_WINDOW_MS:-600000}",
      "RATE_LIMIT_OSM_CONTRIBUTION_NOTE_MAX": "${RATE_LIMIT_OSM_CONTRIBUTION_NOTE_MAX:-5}",
      "RATE_LIMIT_OSM_CONTRIBUTION_NOTE_WINDOW_MS": "${RATE_LIMIT_OSM_CONTRIBUTION_NOTE_WINDOW_MS:-600000}"
    },
    "memory": "2g",
    "restart": "unless-stopped",
    "dependsOn": [
      { "service": "postgis", "condition": "service_healthy" },
      { "service": "redis", "condition": "service_healthy" },
      { "service": "ops-agent", "condition": "service_healthy" }
    ],
    "healthcheck": {
      "type": "http",
      "path": "/health",
      "port": 3001,
      "interval": "15s",
      "timeout": "3s",
      "retries": 10,
      "startPeriod": "30s"
    }
  },
  "bindMounts": [
    {
      "source": "@infra:data/motis/live",
      "target": "/var/lib/openmapx/motis-live",
      "readOnly": true
    },
    {
      "source": "@infra:data/ops-agent/trusted-config",
      "target": "/var/lib/openmapx/trusted-config",
      "readOnly": false
    },
    {
      "source": "@infra:secrets/ops-agent-api-token",
      "target": "/run/secrets/ops-agent-api-token",
      "readOnly": true
    },
    {
      "source": "@infra:secrets/redis-password",
      "target": "/run/secrets/redis-password",
      "readOnly": true
    },
    {
      "source": "@infra:secrets/offline-package-principal-key",
      "target": "/run/secrets/offline-package-principal-key",
      "readOnly": true
    },
    {
      "source": "${OPENMAPX_HOST_DIR:?OPENMAPX_HOST_DIR must be set — community integrations are stored under the host checkout}/custom_integrations",
      "target": "${OPENMAPX_CUSTOM_INTEGRATIONS_DIR:-/app/custom_integrations}",
      "readOnly": false
    }
  ],
  "exposure": {
    "proxy": {
      "enabled": true,
      "pathPrefix": "/api",
      "additionalRoutes": [
        { "path": "/health" },
        { "pathPrefix": "/api/internal", "middleware": ["internal-deny@file"] }
      ]
    }
  },
  "ui": { "category": "application" }
}
