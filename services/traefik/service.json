{
  "id": "traefik",
  "name": "Traefik",
  "version": "1.0.0",
  "description": "Reverse proxy and TLS termination via Let's Encrypt.",
  "license": "MIT",
  "quality": "built-in",
  "homepage": "https://traefik.io/",
  "container": {
    "image": "traefik",
    "tag": "v3.6",
    "digest": "sha256:31267173a15b4944e797a76ffd9c419707c8d8b32fe5b610f80cd0cfa05f372d",
    "expose": [80, 443],
    "environment": {
      "TRAEFIK_CERTIFICATESRESOLVERS_LETSENCRYPT_ACME_EMAIL": "${ACME_EMAIL:-admin@example.com}"
    },
    "memory": "256m",
    "restart": "unless-stopped"
  },
  "provides": ["proxy"],
  "volumes": [
    {
      "name": "openmapx-traefik-acme",
      "mountAt": "/etc/traefik",
      "backup": true,
      "backupMode": "tar"
    }
  ],
  "bindMounts": [
    { "source": "config/traefik.yml", "target": "/etc/traefik/traefik.yml", "readOnly": true },
    { "source": "config/dynamic", "target": "/etc/traefik/dynamic", "readOnly": true }
  ],
  "exposure": {
    "hostPorts": [
      { "container": 80, "host": 80 },
      { "container": 443, "host": 443 },
      { "container": 443, "host": 443, "protocol": "udp" }
    ]
  },
  "ui": { "category": "infrastructure" }
}
