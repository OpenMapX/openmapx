{
  "id": "traefik",
  "name": "Traefik",
  "version": "1.0.0",
  "description": "Reverse proxy and TLS termination via Let's Encrypt.",
  "license": "MIT",
  "quality": "built-in",
  "privateNetworks": ["dawarich-ingress"],
  "homepage": "https://traefik.io/",
  "subjectData": {
    "storesPersonalData": false,
    "strategy": "not_personal",
    "registrationIds": [],
    "operatorInstructions": null
  },
  "container": {
    "image": "traefik",
    "tag": "v3.7.16",
    "digest": "sha256:1336e85aaed293bd63d005086e0dd013b04078b26aaeb1c18b26a2f928af7e65",
    "expose": [80, 443],
    "environment": {
      "TRAEFIK_CERTIFICATESRESOLVERS_LETSENCRYPT_ACME_EMAIL": "${ACME_EMAIL:-admin@example.com}"
    },
    "memory": "256m",
    "restart": "unless-stopped"
  },
  "provides": ["proxy"],
  "volumes": [
    {
      "name": "openmapx-traefik-acme",
      "mountAt": "/etc/traefik",
      "backup": true,
      "backupMode": "tar"
    }
  ],
  "bindMounts": [
    {
      "source": "@infra:state/ops-agent/configuration/current/traefik/traefik.yml",
      "target": "/etc/traefik/traefik.yml",
      "readOnly": true
    },
    {
      "source": "@infra:state/ops-agent/traefik/dynamic",
      "target": "/etc/traefik/dynamic",
      "readOnly": true,
      "optional": true
    }
  ],
  "exposure": {
    "hostPorts": [
      { "container": 80, "host": 80 },
      { "container": 443, "host": 443 },
      { "container": 443, "host": 443, "protocol": "udp" }
    ]
  },
  "ui": { "category": "infrastructure" }
}
