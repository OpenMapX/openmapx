{
  "id": "dawarich-postgis",
  "name": "Dawarich PostGIS",
  "version": "18-3.6",
  "description": "Dedicated PostgreSQL 17 and PostGIS 3.5 database for the managed Dawarich timeline.",
  "license": "PostgreSQL",
  "quality": "built-in",
  "homepage": "https://github.com/baosystems/docker-postgis",
  "subjectData": {
    "storesPersonalData": true,
    "strategy": "operator_task",
    "registrationIds": ["managed-dawarich"],
    "operatorInstructions": "Use the pinned managed Dawarich collector or an approved isolated backup review."
  },
  "container": {
    "image": "ghcr.io/baosystems/postgis",
    "tag": "18-3.6",
    "digest": "sha256:8784f86b3e0e046859c96ea25eb8b10f0b801fd891b99a82b82f28ac4a643db8",
    "expose": [5432],
    "environment": {
      "POSTGRES_USER": "postgres",
      "POSTGRES_DB": "dawarich_production"
    },
    "shmSize": "1g",
    "memory": "2g",
    "restart": "unless-stopped",
    "healthcheck": {
      "type": "exec",
      "command": ["pg_isready", "-U", "postgres", "-d", "dawarich_production"],
      "interval": "10s",
      "timeout": "10s",
      "retries": 5,
      "startPeriod": "30s"
    }
  },
  "provides": ["database"],
  "configSchema": {
    "type": "object",
    "properties": {
      "POSTGRES_USER": {
        "type": "string",
        "title": "Dawarich database user",
        "default": "postgres"
      },
      "POSTGRES_DB": {
        "type": "string",
        "title": "Dawarich database name",
        "default": "dawarich_production"
      },
      "POSTGRES_PASSWORD": {
        "type": "string",
        "title": "Dawarich database password",
        "x-openmapx-secret": true
      },
      "OPENMAPX_MEMORY_MIB": {
        "type": "integer",
        "title": "Container memory limit (MiB)",
        "minimum": 16,
        "maximum": 1048576,
        "description": "Optional Docker resource limit. Unset preserves the image manifest limit. Clear the field to restore the manifest limit."
      },
      "OPENMAPX_CPU_LIMIT": {
        "type": "number",
        "title": "Container CPU limit",
        "minimum": 0.125,
        "maximum": 256,
        "description": "Optional Docker resource limit. Unset preserves the image manifest limit. Clear the field to restore the manifest limit."
      }
    }
  },
  "volumes": [
    {
      "name": "openmapx-dawarich-db-data",
      "mountAt": "/var/lib/postgresql/data",
      "backup": true,
      "backupMode": "pg_dump"
    }
  ],
  "ui": {
    "category": "infrastructure"
  }
}
