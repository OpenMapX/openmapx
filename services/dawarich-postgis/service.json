{
  "id": "dawarich-postgis",
  "name": "Dawarich PostGIS",
  "version": "18-3.6",
  "description": "Dedicated PostgreSQL 17 and PostGIS 3.5 database for the managed Dawarich timeline.",
  "license": "PostgreSQL",
  "quality": "built-in",
  "platformNetwork": false,
  "privateNetworks": ["dawarich"],
  "homepage": "https://github.com/baosystems/docker-postgis",
  "subjectData": {
    "storesPersonalData": true,
    "strategy": "operator_task",
    "registrationIds": ["managed-dawarich"],
    "operatorInstructions": "Use the pinned managed Dawarich collector or an approved isolated backup review."
  },
  "container": {
    "image": "ghcr.io/baosystems/postgis",
    "tag": "18-3.6",
    "digest": "sha256:dd7515b7d8b8b8bac3516a9c3e12584df5890b0864c29295c1b934ecd1db81a7",
    "expose": [5432],
    "environment": {
      "POSTGRES_USER": "postgres",
      "POSTGRES_DB": "dawarich_production"
    },
    "shmSize": "1g",
    "memory": "2g",
    "restart": "unless-stopped",
    "healthcheck": {
      "type": "exec",
      "command": ["pg_isready", "-U", "postgres", "-d", "dawarich_production"],
      "interval": "10s",
      "timeout": "10s",
      "retries": 5,
      "startPeriod": "30s"
    }
  },
  "provides": ["database"],
  "configSchema": {
    "type": "object",
    "properties": {
      "POSTGRES_USER": {
        "type": "string",
        "title": "Dawarich database user",
        "default": "postgres"
      },
      "POSTGRES_DB": {
        "type": "string",
        "title": "Dawarich database name",
        "default": "dawarich_production"
      },
      "POSTGRES_PASSWORD": {
        "type": "string",
        "title": "Dawarich database password",
        "x-openmapx-secret": true
      }
    }
  },
  "volumes": [
    {
      "name": "openmapx-dawarich-db-data",
      "mountAt": "/var/lib/postgresql/data",
      "backup": true,
      "backupMode": "pg_dump"
    }
  ],
  "ui": { "category": "infrastructure" }
}
