{
  "id": "well-known",
  "name": "Well-Known Files",
  "version": "1.0.0",
  "description": "nginx serving /.well-known/ for passkey RP and mobile app linking.",
  "license": "BSD-2-Clause",
  "quality": "built-in",
  "subjectData": {
    "storesPersonalData": false,
    "strategy": "not_personal",
    "registrationIds": [],
    "operatorInstructions": null
  },
  "container": {
    "image": "nginx",
    "tag": "1.31.6-alpine",
    "digest": "sha256:df221db836e1754089190208cee7eeda94f233197056426eda74a43ab1abeac2",
    "expose": [80],
    "memory": "32m",
    "restart": "unless-stopped"
  },
  "bindMounts": [
    { "source": "config/html", "target": "/usr/share/nginx/html/.well-known" },
    { "source": "config/nginx.conf", "target": "/etc/nginx/conf.d/default.conf" }
  ],
  "exposure": {
    "proxy": {
      "enabled": true,
      "pathPrefix": "/.well-known"
    }
  },
  "ui": { "category": "infrastructure" }
}
