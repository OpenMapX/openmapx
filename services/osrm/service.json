{
  "id": "osrm",
  "name": "OSRM",
  "version": "1.0.0",
  "description": "Open Source Routing Machine — region-only alternative to Valhalla (~4GB RAM per country).",
  "license": "BSD-2-Clause",
  "quality": "built-in",
  "homepage": "https://project-osrm.org/",
  "container": {
    "image": "ghcr.io/project-osrm/osrm-backend",
    "tag": "latest",
    "digest": "sha256:3ac496ff8fd7e1af53846179d73d06a97f719c8ad2217d008ed868942398665c",
    "expose": [5000],
    "command": ["osrm-routed", "--algorithm", "mld", "/data/region.osrm"],
    "memory": "8g",
    "restart": "unless-stopped"
  },
  "buildCommand": "openmapx services build osrm",
  "provides": ["routing-engine"],
  "produces": [{ "type": "osrm-graph", "sourceDir": "data/osrm-graph" }],
  "consumes": [{ "type": "osrm-graph", "mountAt": "/data", "readOnly": true, "required": true }],
  "exposure": {
    "hostPorts": [{ "container": 5000, "host": 5000, "bindAddress": "127.0.0.1" }]
  },
  "ui": { "category": "routing" }
}
