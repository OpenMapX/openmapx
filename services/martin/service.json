{
  "id": "martin",
  "name": "Martin",
  "version": "1.0.0",
  "description": "Vector tile server for PostGIS, MBTiles, and PMTiles. Exposed via Traefik at /martin.",
  "license": "MIT/Apache-2.0",
  "quality": "built-in",
  "homepage": "https://maplibre.org/martin/",
  "subjectData": {
    "storesPersonalData": false,
    "strategy": "not_personal",
    "registrationIds": [],
    "operatorInstructions": null
  },
  "container": {
    "image": "ghcr.io/maplibre/martin",
    "tag": "1.16.1",
    "digest": "sha256:59902019bf9038926ff0c71174237d6852e64c457830a6349abe7090be8818ca",
    "expose": [3000],
    "environment": {
      "DATABASE_URL": "postgresql://openmapx_tiles:${MARTIN_DB_PASSWORD:?MARTIN_DB_PASSWORD must be set}@postgis:5432/openmapx"
    },
    "command": ["--config", "/etc/martin/martin.yaml"],
    "restart": "unless-stopped",
    "dependsOn": [
      {
        "service": "postgis",
        "condition": "service_healthy"
      }
    ]
  },
  "provides": ["tile-server"],
  "bindMounts": [
    {
      "source": "config/martin.yaml",
      "target": "/etc/martin/martin.yaml",
      "readOnly": true
    }
  ],
  "exposure": {
    "hostPorts": [
      {
        "container": 3000,
        "host": 3002,
        "bindAddress": "127.0.0.1"
      }
    ],
    "proxy": {
      "enabled": true,
      "pathPrefix": "/martin",
      "stripPrefix": true,
      "middleware": ["tiles-cache@file"],
      "additionalRoutes": [
        {
          "pathPrefix": "/martin/segment_flow",
          "middleware": ["martin-strip", "tiles-cache-live@file"]
        }
      ]
    }
  },
  "ui": {
    "category": "tiles"
  },
  "configSchema": {
    "type": "object",
    "properties": {
      "OPENMAPX_MEMORY_MIB": {
        "type": "integer",
        "title": "Container memory limit (MiB)",
        "minimum": 16,
        "maximum": 1048576,
        "description": "Optional Docker resource limit. Unset preserves the image manifest limit. Clear the field to restore the manifest limit."
      },
      "OPENMAPX_CPU_LIMIT": {
        "type": "number",
        "title": "Container CPU limit",
        "minimum": 0.125,
        "maximum": 256,
        "description": "Optional Docker resource limit. Unset preserves the image manifest limit. Clear the field to restore the manifest limit."
      }
    }
  }
}
