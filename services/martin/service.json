{
  "id": "martin",
  "name": "Martin",
  "version": "1.0.0",
  "description": "Vector tile server for PostGIS, MBTiles, and PMTiles. Exposed via Traefik at /martin.",
  "license": "MIT/Apache-2.0",
  "quality": "built-in",
  "homepage": "https://maplibre.org/martin/",
  "container": {
    "image": "ghcr.io/maplibre/martin",
    "tag": "latest",
    "digest": "sha256:fe5e8952312ca8ea0a25c4b1f72ceb13676f2b50dca310843e48b31c8ceb2264",
    "expose": [3000],
    "environment": {
      "DATABASE_URL": "postgresql://postgres:${POSTGRES_PASSWORD:?POSTGRES_PASSWORD must be set}@postgis:5432/openmapx"
    },
    "command": ["--config", "/etc/martin/martin.yaml"],
    "restart": "unless-stopped",
    "dependsOn": [{ "service": "postgis", "condition": "service_healthy" }]
  },
  "provides": ["tile-server"],
  "bindMounts": [
    { "source": "config/martin.yaml", "target": "/etc/martin/martin.yaml", "readOnly": true }
  ],
  "exposure": {
    "hostPorts": [{ "container": 3000, "host": 3002, "bindAddress": "127.0.0.1" }],
    "proxy": {
      "enabled": true,
      "pathPrefix": "/martin",
      "stripPrefix": true,
      "middleware": ["tiles-cache@file"],
      "additionalRoutes": [
        {
          "pathPrefix": "/martin/segment_flow",
          "middleware": ["martin-strip", "tiles-cache-live@file"]
        }
      ]
    }
  },
  "ui": { "category": "tiles" }
}
