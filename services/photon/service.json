{
  "id": "photon",
  "name": "Photon",
  "version": "1.0.0",
  "description": "Lightweight OSM geocoder with search-as-you-type. Auto-downloads worldwide index (~8GB RAM, ~200GB disk).",
  "license": "Apache-2.0",
  "quality": "built-in",
  "homepage": "https://github.com/komoot/photon",
  "subjectData": {
    "storesPersonalData": false,
    "strategy": "not_personal",
    "registrationIds": [],
    "operatorInstructions": null
  },
  "container": {
    "image": "rtuszik/photon-docker",
    "tag": "2.5.0",
    "digest": "sha256:c5babeb0ac396b485822036cf3c69e54fb6c79d699328a4e042e11bbd6f73f1a",
    "expose": [2322],
    "environment": {
      "REGION": "${PHOTON_REGION:-planet}",
      "UPDATE_STRATEGY": "PARALLEL",
      "UPDATE_INTERVAL": "720h",
      "LOG_LEVEL": "INFO"
    },
    "memory": "8g",
    "restart": "unless-stopped",
    "healthcheck": {
      "type": "http",
      "path": "/api?q=test",
      "port": 2322,
      "interval": "30s",
      "timeout": "10s",
      "retries": 5,
      "startPeriod": "600s"
    }
  },
  "provides": ["geocoder"],
  "bindMounts": [
    {
      "source": "@infra:data/photon",
      "target": "/photon/data",
      "readOnly": false
    }
  ],
  "exposure": {
    "hostPorts": [
      {
        "container": 2322,
        "host": 2322,
        "bindAddress": "127.0.0.1"
      }
    ]
  },
  "ui": {
    "category": "geocoding"
  },
  "configSchema": {
    "type": "object",
    "properties": {
      "REGION": {
        "type": "string",
        "title": "Index region",
        "format": "resource-region"
      },
      "UPDATE_STRATEGY": {
        "type": "string",
        "title": "Update strategy",
        "enum": ["PARALLEL", "SEQUENTIAL"]
      },
      "UPDATE_INTERVAL": {
        "type": "string",
        "title": "Update interval (1h–8760h)",
        "format": "photon-duration",
        "maxLength": 32
      },
      "LOG_LEVEL": {
        "type": "string",
        "title": "Log level",
        "enum": ["DEBUG", "INFO", "WARN", "ERROR"]
      },
      "OPENMAPX_MEMORY_MIB": {
        "type": "integer",
        "title": "Container memory limit (MiB)",
        "minimum": 16,
        "maximum": 1048576,
        "description": "Optional Docker resource limit. Unset preserves the image manifest limit. Clear the field to restore the manifest limit."
      },
      "OPENMAPX_CPU_LIMIT": {
        "type": "number",
        "title": "Container CPU limit",
        "minimum": 0.125,
        "maximum": 256,
        "description": "Optional Docker resource limit. Unset preserves the image manifest limit. Clear the field to restore the manifest limit."
      }
    }
  }
}
