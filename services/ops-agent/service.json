{
  "id": "ops-agent",
  "name": "OpenMapX Operations Agent",
  "version": "1.0.0",
  "description": "Private typed broker for trusted Docker and host-repository operations.",
  "license": "AGPL-3.0-or-later",
  "quality": "built-in",
  "subjectData": {
    "storesPersonalData": true,
    "strategy": "operator_task",
    "registrationIds": ["backup-retained-copies"],
    "operatorInstructions": "Review retained backup inventory and perform only approved isolated extraction."
  },
  "container": {
    "image": "ghcr.io/openmapx/ops-agent",
    "tag": "main",
    "expose": [4300],
    "user": "${UID:?UID must be set, run pnpm openmapx compose render}:${GID:?GID must be set, run pnpm openmapx compose render}",
    "environment": {
      "HOME": "/home/node",
      "HOST": "0.0.0.0",
      "PORT": "4300",
      "OPENMAPX_ROOT_DIR": "${OPENMAPX_HOST_DIR:?OPENMAPX_HOST_DIR must be set}",
      "OPENMAPX_ENABLED_SERVICES": "${OPENMAPX_ENABLED_SERVICES:-}",
      "OPENMAPX_RELEASE": "${OPENMAPX_RELEASE:-main}",
      "OPENMAPX_RELEASE_MANIFEST_REPOSITORY": "${OPENMAPX_RELEASE_MANIFEST_REPOSITORY:-ghcr.io/openmapx/release-manifest}",
      "OPENMAPX_REGION": "${OPENMAPX_REGION:-europe/germany}",
      "OPENMAPX_ALLOWED_REGIONS": "${OPENMAPX_ALLOWED_REGIONS:-europe/germany}",
      "OPENMAPX_ALLOWED_COUNTRIES": "${OPENMAPX_ALLOWED_COUNTRIES:-DE}",
      "OPENMAPX_PROXY_NETWORK": "${OPENMAPX_PROXY_NETWORK:-}",
      "DOCKER_CONFIG": "/home/node/.docker",
      "OPS_AGENT_API_TOKEN_FILE": "/run/secrets/ops-agent-api-token",
      "OPS_AGENT_DATA_MANAGER_TOKEN_FILE": "/run/secrets/ops-agent-data-manager-token",
      "DATA_MANAGER_URL": "${DATA_MANAGER_URL:-http://data-manager:4000}",
      "DATA_MANAGER_AUTH_TOKEN": "${DATA_MANAGER_AUTH_TOKEN:?DATA_MANAGER_AUTH_TOKEN must be set}",
      "OPS_TRUSTED_CONFIG_DIR": "/var/lib/openmapx/trusted-config",
      "OPS_PRIVACY_BACKUP_CAPABILITY_KEY_FILE": "/run/secrets/privacy-backup-capability-key",
      "OPS_PRIVACY_BACKUP_COLLECTOR_ENABLED": "${OPS_PRIVACY_BACKUP_COLLECTOR_ENABLED:-false}",
      "OPS_PRIVACY_BACKUP_COLLECTOR_IMAGE": "${OPS_PRIVACY_BACKUP_COLLECTOR_IMAGE:-}",
      "OPS_PRIVACY_BACKUP_SCRATCH_ROOT": "/var/lib/openmapx/privacy-extraction",
      "BACKUP_RETENTION_DAYS": "${BACKUP_RETENTION_DAYS:-30}",
      "OPENMAPX_ARTIFACT_TRANSFER_POLICY_FILE": "/run/openmapx/artifact-transfer-policy.json"
    },
    "capDrop": ["ALL"],
    "memory": "1g",
    "restart": "unless-stopped",
    "healthcheck": {
      "type": "http",
      "path": "/health",
      "port": 4300,
      "interval": "15s",
      "timeout": "3s",
      "retries": 5,
      "startPeriod": "10s"
    }
  },
  "bindMounts": [
    {
      "source": "@infra:state/ops-agent/trusted-config",
      "target": "/var/lib/openmapx/trusted-config",
      "readOnly": false
    },
    {
      "source": "@infra:state/ops-agent/privacy-extraction",
      "target": "/var/lib/openmapx/privacy-extraction",
      "readOnly": false
    },
    {
      "source": "@infra:secrets/ops-agent-api-token",
      "target": "/run/secrets/ops-agent-api-token",
      "readOnly": true
    },
    {
      "source": "@infra:secrets/ops-agent-data-manager-token",
      "target": "/run/secrets/ops-agent-data-manager-token",
      "readOnly": true
    },
    {
      "source": "@infra:secrets/privacy-backup-capability-key",
      "target": "/run/secrets/privacy-backup-capability-key",
      "readOnly": true
    },
    {
      "source": "@docker-socket",
      "target": "/var/run/docker.sock",
      "readOnly": false
    },
    {
      "source": "${OPENMAPX_HOST_DIR:?OPENMAPX_HOST_DIR must be set \u2014 ops-agent renders and applies trusted local stack configuration}/infra/docker",
      "target": "${OPENMAPX_HOST_DIR:?OPENMAPX_HOST_DIR must be set}/infra/docker",
      "readOnly": true
    },
    {
      "source": "${OPENMAPX_HOST_DIR:?OPENMAPX_HOST_DIR must be set}/infra/docker/state",
      "target": "${OPENMAPX_HOST_DIR:?OPENMAPX_HOST_DIR must be set}/infra/docker/state",
      "readOnly": false
    },
    {
      "source": "${OPENMAPX_HOST_DIR:?OPENMAPX_HOST_DIR must be set}/infra/docker/data",
      "target": "${OPENMAPX_HOST_DIR:?OPENMAPX_HOST_DIR must be set}/infra/docker/data",
      "readOnly": false
    },
    {
      "source": "${OPENMAPX_HOST_DIR:?OPENMAPX_HOST_DIR must be set}/infra/docker/secrets",
      "target": "${OPENMAPX_HOST_DIR:?OPENMAPX_HOST_DIR must be set}/infra/docker/secrets",
      "readOnly": false
    },
    {
      "source": "${OPENMAPX_HOST_DIR:?OPENMAPX_HOST_DIR must be set}/infra/docker/backups",
      "target": "${OPENMAPX_HOST_DIR:?OPENMAPX_HOST_DIR must be set}/infra/docker/backups",
      "readOnly": false
    },
    {
      "source": "${OPENMAPX_HOST_DIR:?OPENMAPX_HOST_DIR must be set}/infra/docker/catalog-pins",
      "target": "${OPENMAPX_HOST_DIR:?OPENMAPX_HOST_DIR must be set}/infra/docker/catalog-pins",
      "readOnly": false
    },
    {
      "source": "${OPENMAPX_DOCKER_CONFIG_DIR:-/root/.docker}",
      "target": "/home/node/.docker",
      "readOnly": true
    },
    {
      "source": "@infra:secrets/control-ops-agent.key",
      "target": "/run/secrets/openmapx-control-role-key",
      "readOnly": true
    },
    {
      "source": "@infra:secrets/control-verifiers.json",
      "target": "/run/secrets/openmapx-control-verifiers",
      "readOnly": true
    },
    {
      "source": "@infra:control-private/ops-agent",
      "target": "/var/lib/openmapx/control-private",
      "readOnly": false
    },
    {
      "source": "@infra:control-private/hidden-key",
      "target": "${OPENMAPX_HOST_DIR:?OPENMAPX_HOST_DIR must be set}/infra/docker/secrets/control-data-manager.key",
      "readOnly": true
    },
    {
      "source": "@infra:control-private/empty",
      "target": "${OPENMAPX_HOST_DIR:?OPENMAPX_HOST_DIR must be set}/infra/docker/control-private/data-manager",
      "readOnly": true
    },
    {
      "source": "@infra:control-private/hidden-key",
      "target": "${OPENMAPX_HOST_DIR:?OPENMAPX_HOST_DIR must be set}/infra/docker/secrets/control-host-cli.key",
      "readOnly": true
    },
    {
      "source": "@infra:control-private/empty",
      "target": "${OPENMAPX_HOST_DIR:?OPENMAPX_HOST_DIR must be set}/infra/docker/control-private/host-cli",
      "readOnly": true
    },
    {
      "source": "@infra:artifact-transfer-policy.json",
      "target": "/run/openmapx/artifact-transfer-policy.json",
      "readOnly": true,
      "optional": true
    }
  ],
  "ui": {
    "category": "infrastructure"
  },
  "configSchema": {
    "type": "object",
    "properties": {
      "OPENMAPX_MEMORY_MIB": {
        "type": "integer",
        "title": "Container memory limit (MiB)",
        "minimum": 16,
        "maximum": 1048576,
        "description": "Optional Docker resource limit. Unset preserves the image manifest limit. Clear the field to restore the manifest limit."
      },
      "OPENMAPX_CPU_LIMIT": {
        "type": "number",
        "title": "Container CPU limit",
        "minimum": 0.125,
        "maximum": 256,
        "description": "Optional Docker resource limit. Unset preserves the image manifest limit. Clear the field to restore the manifest limit."
      }
    }
  }
}
