{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "NODE_OPTIONS='--max-old-space-size=16384' pnpm build:runtime && pnpm build:licenses && next dev",
    "prebuild": "node scripts/copy-preset-icons.mjs && pnpm build:runtime && pnpm build:licenses",
    "build": "next build && pnpm build:sw && pnpm build:copy-assets",
    "build:runtime": "node scripts/build-runtime-modules.mjs",
    "build:licenses": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/generate-license-notices.mjs",
    "build:sw": "esbuild src/sw.ts --bundle --outfile=public/sw.js --format=iife --platform=browser --define:process.env.NODE_ENV='\"production\"'",
    "build:copy-assets": "mkdir -p .next/standalone/apps/web/public .next/standalone/apps/web/.next/static && cp -R public/. .next/standalone/apps/web/public/ && cp -R .next/static/. .next/standalone/apps/web/.next/static/",
    "start": "node .next/standalone/apps/web/server.js",
    "check-types": "pnpm build:licenses && tsc --noEmit && tsc --noEmit -p tsconfig.sw.json",
    "icons:sync": "node scripts/copy-preset-icons.mjs"
  },
  "dependencies": {
    "@better-auth/passkey": "^1.6.9",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@emoji-mart/data": "^1.2.1",
    "@emoji-mart/react": "^1.1.1",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@iconify-json/meteocons": "^1.2.4",
    "@iconify/react": "^6.0.2",
    "@mui/icons-material": "^9.0.1",
    "@mui/material": "^9.0.1",
    "@mui/material-nextjs": "^9.0.1",
    "@openmapx/command-palette": "workspace:^",
    "@openmapx/core": "workspace:^",
    "@openmapx/i18n": "workspace:*",
    "@openmapx/integration-framework": "workspace:^",
    "@openmapx/mangrove-client": "workspace:^",
    "@openmapx/mangrove-react": "workspace:^",
    "@openmapx/place-ids": "workspace:^",
    "@serwist/next": "^9.5.10",
    "@serwist/window": "^9.5.10",
    "@tanstack/query-sync-storage-persister": "^5.100.9",
    "@tanstack/react-query": "^5.100.7",
    "@tanstack/react-query-persist-client": "^5.100.9",
    "@turf/area": "^7.3.5",
    "@turf/helpers": "^7.3.5",
    "@turf/length": "^7.3.5",
    "better-auth": "^1.6.9",
    "emoji-mart": "^5.6.0",
    "framer-motion": "^12.38.0",
    "hls.js": "^1.6.16",
    "mapillary-js": "^4.1.2",
    "maplibre-gl": "^5.24.0",
    "maplibre-theme": "^1.0.0",
    "next": "^16.2.6",
    "next-intl": "^4.11.0",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-icons": "^5.6.0",
    "recharts": "^3.8.1",
    "serwist": "^9.5.10",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@mapbox/maki": "^8.2.0",
    "@rapideditor/temaki": "^5.13.0",
    "@tailwindcss/postcss": "^4.2.4",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.6.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "esbuild": "^0.28.0",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.2.4",
    "typescript": "^5.9.3"
  }
}
