{
  "name": "web",
  "license": "AGPL-3.0-or-later",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "NODE_OPTIONS='--max-old-space-size=16384' pnpm build:maplibre-runtime && pnpm build:licenses && next dev",
    "prebuild": "node scripts/copy-preset-icons.mjs && pnpm build:maplibre-runtime && pnpm build:licenses",
    "build": "next build && pnpm build:sw && pnpm build:copy-assets",
    "build:maplibre-runtime": "node scripts/copy-maplibre-runtime.mjs",
    "build:licenses": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/generate-license-notices.mjs",
    "build:sw": "node scripts/build-sw.mjs",
    "build:copy-assets": "mkdir -p .next/standalone/apps/web/public .next/standalone/apps/web/.next/static && cp -R public/. .next/standalone/apps/web/public/ && cp -R .next/static/. .next/standalone/apps/web/.next/static/",
    "start": "node .next/standalone/apps/web/server.js",
    "check-types": "pnpm build:licenses && tsc --noEmit && tsc --noEmit -p tsconfig.sw.json && tsc --noEmit -p tsconfig.integrations.json",
    "icons:sync": "node scripts/copy-preset-icons.mjs"
  },
  "dependencies": {
    "@better-auth/core": "1.6.26",
    "@better-auth/passkey": "1.6.26",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@emoji-mart/data": "^1.2.1",
    "@emoji-mart/react": "^1.1.1",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource-variable/plus-jakarta-sans": "5.3.0",
    "@iconify-json/meteocons": "^1.2.4",
    "@iconify/react": "^6.0.2",
    "@mui/icons-material": "^9.3.1",
    "@mui/material": "^9.3.1",
    "@mui/material-nextjs": "^9.3.0",
    "@openmapx/command-palette": "workspace:^",
    "@openmapx/core": "workspace:^",
    "@openmapx/ev-charge-planner": "workspace:^",
    "@openmapx/i18n": "workspace:*",
    "@openmapx/integration-framework": "workspace:^",
    "@openmapx/mangrove-client": "workspace:^",
    "@openmapx/mangrove-react": "workspace:^",
    "@openmapx/place-ids": "workspace:^",
    "@photo-sphere-viewer/core": "^5.15.1",
    "@photo-sphere-viewer/virtual-tour-plugin": "^5.15.1",
    "@serwist/next": "^9.5.12",
    "@serwist/window": "^9.5.12",
    "@tanstack/react-query": "^5.102.5",
    "@tanstack/react-query-persist-client": "^5.102.5",
    "@tmcw/togeojson": "^7.1.2",
    "@turf/along": "^7.4.0",
    "@turf/helpers": "^7.4.0",
    "@turf/length": "^7.4.0",
    "@turf/line-slice-along": "^7.4.0",
    "better-auth": "1.6.26",
    "emoji-mart": "^5.6.0",
    "hls.js": "^1.7.1",
    "maplibre-gl": "^6.6.0",
    "maplibre-theme": "^1.0.0",
    "next": "^16.3.3",
    "next-intl": "^4.13.7",
    "pure-web-bottom-sheet": "1.0.0",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-icons": "^5.7.0",
    "react-window": "^2.3.0",
    "recharts": "^3.10.1",
