{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && pnpm build:sw && pnpm build:copy-assets",
    "build:sw": "esbuild src/sw.ts --bundle --outfile=public/sw.js --format=iife --platform=browser --define:process.env.NODE_ENV='\"production\"'",
    "build:copy-assets": "rsync -a public/ .next/standalone/apps/web/public/ && rsync -a .next/static/ .next/standalone/apps/web/.next/static/",
    "start": "node .next/standalone/apps/web/server.js"
  },
  "dependencies": {
    "@better-auth/passkey": "^1.5.4",
    "@emoji-mart/data": "^1.2.1",
    "@emoji-mart/react": "^1.1.1",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.3.8",
    "@mui/material": "^7.3.8",
    "@mui/material-nextjs": "^7.3.8",
    "@openmapx/core": "workspace:^",
    "@serwist/next": "^9.5.6",
    "@serwist/window": "^9.5.6",
    "@tanstack/react-query": "^5.90.21",
    "better-auth": "^1.5.4",
    "emoji-mart": "^5.6.0",
    "framer-motion": "^12.34.4",
    "mapillary-js": "^4.1.2",
    "maplibre-gl": "^5.19.0",
    "next": "16.1.6",
    "next-intl": "^4.8.3",
    "qrcode": "^1.5.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "serwist": "^9.5.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.27.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
