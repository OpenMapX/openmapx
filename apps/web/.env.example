# URL of the API server (apps/api)
NEXT_PUBLIC_API_URL=http://localhost:3001

# MapTiler Cloud is configured server-side in apps/api via MAPTILER_KEY.
# The browser loads default map assets through the API proxy.

# Optional: self-hosted map style base URL (TileServer GL)
# When set, replaces MapTiler Cloud for all map tiles.
# Should point to TileServer GL root, e.g. https://example.com/tiles
# The app appends /styles/{style}/style.json automatically.
# NEXT_PUBLIC_MAP_STYLE_URL=http://localhost:8080

# Style provider: "maptiler" (default) or "openmapx" (custom Google Maps-like style)
# The openmapx style uses OpenMapTiles schema and works with self-hosted tiles.
# When using openmapx with MapTiler Cloud tiles, MAPTILER_KEY is still required in apps/api.
# NEXT_PUBLIC_STYLE_PROVIDER=openmapx

# Optional: self-hosted vector tile source URL for OpenMapTiles tiles
# Used by the openmapx style provider. Points to a tiles.json endpoint.
# NEXT_PUBLIC_TILES_URL=http://localhost:8080/data/v3.json

# Optional: override traffic tile URL template (defaults to `${NEXT_PUBLIC_API_URL}/api/traffic/flow/{z}/{x}/{y}.png`)
# NEXT_PUBLIC_TRAFFIC_TILE_URL_TEMPLATE=http://localhost:3001/api/traffic/flow/{z}/{x}/{y}.png

# Optional: minimum zoom level to show traffic overlay (city/county scale)
# NEXT_PUBLIC_TRAFFIC_MIN_ZOOM=10

# Mapillary client access token for the in-browser Street View viewer.
#
# SECURITY: this token is bundled into the public JavaScript and is visible to
# every visitor. Mapillary's `MLY|<app_id>|<token>` shape is *designed* for
# client-side use, but anyone who extracts it can burn your quota. To minimise
# the blast radius:
#   - Create a *dedicated* Mapillary OAuth app for this purpose (separate from
#     the server-side MAPILLARY_TOKEN used by /api/mapillary/* and OAuth).
#   - Pick a token with the minimum scopes you need (read-only).
#   - Monitor usage; rotate if abused.
#   - Leave this *empty* to disable Street View entirely — the Pegman entry
#     point is hidden when no token is set, and no token reaches the browser.
#
# The Docker deployment reads `MAPILLARY_VIEWER_TOKEN` from infra/docker/.env
# (NOT `MAPILLARY_TOKEN` — that one stays server-side).
# NEXT_PUBLIC_MAPILLARY_TOKEN=

# Legal pages (Impressum, Privacy Policy, Terms of Service)
LEGAL_NAME=Your Name
LEGAL_STREET=Street 1
LEGAL_POSTAL_CODE=12345
LEGAL_CITY=City
LEGAL_COUNTRY=Country
LEGAL_EMAIL=email@example.com
LEGAL_PHONE=+49 123 456789
LEGAL_JURISDICTION_CITY=City
