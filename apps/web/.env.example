# URL of the API server (apps/api)
NEXT_PUBLIC_API_URL=http://localhost:3001

# Hosted vectors default to OpenFreeMap without a key, MapTiler with a key.
# Configure BASEMAP_PROVIDER=auto|openfreemap|maptiler in apps/api/.env or
# Admin Settings → Map. Keys remain in the API; reload after admin changes.
# Enabled TileServer GL is discovered automatically and always takes priority.

# Optional explicit self-hosted glyph base (root with a /fonts endpoint)
# NEXT_PUBLIC_MAP_STYLE_URL=http://localhost:8080

# Style family: owned OpenMapX style (default); complete MapTiler style is
# honored only when hosted MapTiler vectors are selected.
# NEXT_PUBLIC_STYLE_PROVIDER=openmapx

# Explicit self-hosted OpenMapTiles TileJSON always takes priority.
# NEXT_PUBLIC_TILES_URL=http://localhost:8080/data/openmapx.json

# Optional: override traffic tile URL template (defaults to `${NEXT_PUBLIC_API_URL}/api/traffic/flow/{z}/{x}/{y}.png`)
# NEXT_PUBLIC_TRAFFIC_TILE_URL_TEMPLATE=http://localhost:3001/api/traffic/flow/{z}/{x}/{y}.png

# Optional: override CyclOSM tile URL template served through the API proxy.
# Defaults to `${NEXT_PUBLIC_API_URL}/api/tiles/cyclosm/{z}/{x}/{y}.png`
# NEXT_PUBLIC_CYCLOSM_TILE_URL_TEMPLATE=

# Terrain uses proxied Mapterhorn DEM with generated contours when OpenMapX
# vector tiles are self-hosted; MapTiler basemaps keep proxied MapTiler terrain.
# For your own DEM, set TileJSON, encoding, and the provider credit. An
# optional matching local tile URL template avoids a second TileJSON request.
# NEXT_PUBLIC_TERRAIN_DEM_TILEJSON_URL=
# NEXT_PUBLIC_TERRAIN_DEM_TILE_URL_TEMPLATE=
# NEXT_PUBLIC_TERRAIN_DEM_ENCODING=terrarium
# NEXT_PUBLIC_TERRAIN_CONTOUR_TILEJSON_URL=
# NEXT_PUBLIC_TERRAIN_ATTRIBUTION_NAME=
# NEXT_PUBLIC_TERRAIN_ATTRIBUTION_URL=

# Legal pages (Impressum, Privacy Policy, Terms of Service)
LEGAL_NAME=Your Name
LEGAL_STREET=Street 1
LEGAL_POSTAL_CODE=12345
LEGAL_CITY=City
LEGAL_COUNTRY=Country
LEGAL_EMAIL=email@example.com
LEGAL_PHONE=+49 123 456789
LEGAL_JURISDICTION_CITY=City
# Location-dependent privacy facts rendered on /privacy. Leave blank to omit the
# sentence (e.g. if you have no DPA-relevant hosting). Examples:
#   LEGAL_SUPERVISORY_AUTHORITY=Landesbeauftragte für Datenschutz und Informationsfreiheit NRW (LDI NRW), Kavalleriestr. 2–4, 40213 Düsseldorf
#   LEGAL_SUPERVISORY_AUTHORITY_URL=https://www.ldi.nrw.de/
#   LEGAL_HOSTING_PROVIDER=Hetzner Online GmbH, Industriestr. 25, 91710 Gunzenhausen, Germany
#   LEGAL_HOSTING_LOCATIONS=Germany and Finland (EU)
LEGAL_SUPERVISORY_AUTHORITY=
LEGAL_SUPERVISORY_AUTHORITY_URL=
LEGAL_HOSTING_PROVIDER=
LEGAL_HOSTING_LOCATIONS=
LEGAL_SERVER_LOG_RETENTION_DAYS=30
