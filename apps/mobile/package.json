{
  "name": "@openmapx/mobile",
  "version": "1.0.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "main": "index.ts",
  "scripts": {
    "start": "expo start --dev-client",
    "prebuild": "LANG=en_US.UTF-8 LC_ALL=en_US.UTF-8 expo prebuild --clean",
    "ios": "LANG=en_US.UTF-8 LC_ALL=en_US.UTF-8 expo run:ios",
    "android": "expo run:android",
    "doctor": "tsx scripts/run-doctor.mts",
    "check-types": "tsc --noEmit",
    "test": "jest --runInBand",
    "test:native": "tsx scripts/run-native-tests.mts",
    "assert-generated": "tsx scripts/assert-generated-native.mts",
    "assert-boundary": "tsx scripts/assert-no-community-runtime.mts",
    "assert-permissions": "tsx scripts/assert-release-permissions.mts --generated",
    "inventory": "tsx compliance/dependency-inventory.mts --check",
    "store-answers": "tsx compliance/store-answers.mts"
  },
  "dependencies": {
    "@openmapx/core": "workspace:^",
    "@openmapx/i18n": "workspace:^",
    "@react-native-community/netinfo": "12.0.1",
    "babel-preset-expo": "~57.0.12",
    "expo": "~57.0.24",
    "expo-application": "~57.0.3",
    "expo-build-properties": "~58.0.3",
    "expo-constants": "~57.0.19",
    "expo-keep-awake": "~57.0.2",
    "expo-location": "~57.0.19",
    "expo-notifications": "~57.0.20",
    "expo-splash-screen": "~57.0.9",
    "expo-sqlite": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "expo-task-manager": "~57.0.19",
    "react": "19.3.0",
    "react-native": "0.86.3",
    "react-native-webview": "13.16.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@expo/plist": "^0.8.1",
    "@react-native/jest-preset": "0.86.3",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "esbuild": "^0.28.2",
    "expo-doctor": "^1.20.4",
    "jest": "^30.5.2",
    "jest-expo": "^57.0.5",
    "test-renderer": "^1.3.0",
    "tsx": "4.23.15",
    "typescript": "^6.0.3"
  },
  "expo": {
    "install": {
      "exclude": [
        "jest",
        "@types/jest",
        "react",
        "@types/react"
      ]
    }
  }
}
