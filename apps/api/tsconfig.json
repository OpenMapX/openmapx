{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2024",
    "lib": ["ES2024", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowArbitraryExtensions": true,
    "outDir": "./dist"
  },
  "include": ["src", "scripts", "drizzle.config.ts", "../../integrations/*/index.ts"],
  // The integration template is not a workspace package: its imports resolve
  // only once `openmapx integrations scaffold` copies it into one.
  "exclude": ["../../integrations/_template"]
}
