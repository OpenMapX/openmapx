{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2024",
    "lib": ["ES2024", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowArbitraryExtensions": true,
    "noEmit": true
  },
  "include": ["src", "scripts", "drizzle.config.ts", "../../integrations/*/index.ts"],
  // The integration template is not a workspace package; it has its own
  // program, tsconfig.integration-template.json.
  "exclude": ["../../integrations/_template"]
}
