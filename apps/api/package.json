{
  "name": "@openmapx/api",
  "version": "1.0.0",
  "private": true,
  "description": "",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "dev": "node --env-file=.env --watch --import tsx/esm src/server.ts",
    "build": "tsc --noEmit && node esbuild.config.mjs",
    "start": "node dist/server.js",
    "check-types": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "auth:generate": "npx @better-auth/cli@latest generate --config ./src/auth.ts --output ./src/db/auth-schema.ts --yes",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@better-auth/expo": "^1.6.9",
    "@better-auth/i18n": "^1.6.9",
    "@better-auth/passkey": "^1.6.9",
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^13.0.2",
    "@hey-api/client-fetch": "workspace:*",
    "@motis-project/motis-client": "^2.9.2",
    "@openmapx/integration-framework": "workspace:^",
    "@openmapx/place-ids": "workspace:^",
    "better-auth": "^1.6.9",
    "better-auth-harmony": "^1.3.2",
    "cached-hafas-client": "^5.1.9",
    "db-vendo-client": "^6.10.9",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.8.5",
    "gtfs-realtime-bindings-transit": "^1.8.10",
    "hafas-client": "^6.3.6",
    "ioredis": "^5.10.1",
    "lettermint": "^1.5.1",
    "nodemailer": "^8.0.7",
    "opening_hours": "^3.12.0",
    "pino": "^10.3.1",
    "postgres": "^3.4.9",
    "simple-git": "^3.36.0",
    "tsx": "^4.21.0"
  },
  "devDependencies": {
    "@openmapx/core": "workspace:^",
    "@openmapx/mobility-core": "workspace:^",
    "@openmapx/mobility-formats": "workspace:^",
    "@types/node": "^25.6.0",
    "@types/nodemailer": "^7.0.11",
    "@vitest/coverage-v8": "^4.1.5",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.28.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.5"
  }
