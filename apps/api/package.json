{
  "name": "@openmapx/api",
  "version": "1.0.0",
  "description": "",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "dev": "node --env-file=.env --watch --import tsx/esm src/server.ts",
    "build": "tsc --noEmit && node esbuild.config.mjs",
    "start": "node dist/server.js",
    "check-types": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "auth:generate": "npx @better-auth/cli@latest generate --config ./src/auth.ts --output ./src/db/auth-schema.ts --yes",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@better-auth/passkey": "^1.5.5",
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^13.0.2",
    "@hey-api/client-fetch": "0.4.4",
    "@motis-project/motis-client": "^2.9.1",
    "@openstreetmap/id-tagging-schema": "^6.15.0",
    "better-auth": "^1.5.5",
    "cached-hafas-client": "^5.1.9",
    "db-vendo-client": "^6.10.8",
    "drizzle-orm": "^0.45.1",
    "fastify": "^5.8.2",
    "hafas-client": "^6.3.6",
    "ioredis": "^5.10.1",
    "nodemailer": "^8.0.3",
    "opening_hours": "^3.12.0",
    "postgres": "^3.4.8"
  },
  "devDependencies": {
    "@openmapx/core": "workspace:^",
    "@types/node": "^25.5.0",
    "@types/nodemailer": "^7.0.11",
    "@vitest/coverage-v8": "^4.1.0",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.27.4",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  }
}
