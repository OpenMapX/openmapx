# Geocoding provider: maptiler (default) | nominatim | pelias | photon
GEOCODING_PROVIDER=maptiler

# Required when GEOCODING_PROVIDER=maptiler
MAPTILER_KEY=your_maptiler_key_here

# Optional: override Nominatim instance URL (defaults to public OSM instance)
# NOMINATIM_URL=https://nominatim.openstreetmap.org

# Optional: override Photon instance URL (defaults to public Komoot instance)
# PHOTON_URL=https://photon.komoot.io

# Required when GEOCODING_PROVIDER=pelias
# PELIAS_URL=http://localhost:4000

# Traffic provider: tomtom
TRAFFIC_PROVIDER=tomtom
TOMTOM_TRAFFIC_KEY=your_tomtom_traffic_key_here
TOMTOM_TRAFFIC_URL=https://api.tomtom.com
TOMTOM_TRAFFIC_VERSION=4
TOMTOM_TRAFFIC_STYLE=relative-delay
TOMTOM_TRAFFIC_TILE_SIZE=256
# TOMTOM_TRAFFIC_THICKNESS=2

# Mapillary (get at https://www.mapillary.com/dashboard/developers)
MAPILLARY_TOKEN=your_mapillary_token_here

# WAQI air quality tiles — get free token at https://aqicn.org/data-platform/token/
WAQI_TOKEN=your_waqi_token_here

# Tankerkönig API key (get at https://creativecommons.tankerkoenig.de/)
TANKERKOENIG_API_KEY=your_tankerkoenig_api_key_here

# Mapillary OAuth (required for "Sign in with Mapillary")
# Register your app at: https://www.mapillary.com/dashboard/developers
MAPILLARY_CLIENT_ID=
MAPILLARY_CLIENT_SECRET=

# API server
PORT=3001
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:3000

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/openmapx

# ── Auth ───────────────────────────────────────────────────────────────
# Generate with: npx @better-auth/cli@latest secret
BETTER_AUTH_SECRET=your_secret_here
BETTER_AUTH_URL=http://localhost:3001

# OpenStreetMap OAuth 2.0
# Register at: https://www.openstreetmap.org/oauth2/applications
OSM_CLIENT_ID=
OSM_CLIENT_SECRET=

# Passkeys
PASSKEY_RP_ID=localhost
PASSKEY_ORIGIN=http://localhost:3000

# ── SMTP (for verification emails, 2FA codes, email change) ────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
SMTP_FROM=OpenMapX <noreply@openmapx.org>
