# API Server
PORT=3001
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# PostgreSQL with PostGIS extension
# Default matches the docker-compose service
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/openmapx

# Redis (optional, recommended for transit caching)
# Default matches the docker-compose service
REDIS_URL=redis://localhost:6379

# Geocoding provider(s): comma-separated fallback chain
# Available: maptiler, nominatim, pelias, photon, motis, transitous, db-ris
# Tries each in order; falls back to the next on failure
GEOCODING_PROVIDER=photon,nominatim,maptiler,db-ris,motis,transitous

# Required when GEOCODING_PROVIDER=maptiler
# Sign up at https://cloud.maptiler.com/ and create a key
MAPTILER_KEY=

# Optional: self-hosted Nominatim URL (defaults to https://nominatim.openstreetmap.org)
# Start self-hosted: docker compose --profile nominatim up -d
# NOMINATIM_URL=http://localhost:8088

# Optional: self-hosted Photon URL (defaults to https://photon.komoot.io)
# Start self-hosted: docker compose --profile photon up -d
# PHOTON_URL=http://localhost:2322

# Required when GEOCODING_PROVIDER=pelias (self-hosted via docker-compose)
# PELIAS_URL=http://localhost:4000

# Optional: self-hosted Overpass API URL (defaults to https://overpass-api.de)
# Start self-hosted: docker compose --profile overpass up -d
# OVERPASS_URL=http://localhost:8082

# Traffic: TomTom flow tiles
# Sign up at https://developer.tomtom.com/ and create an API key
TRAFFIC_PROVIDER=tomtom
TOMTOM_TRAFFIC_KEY=
TOMTOM_TRAFFIC_URL=https://api.tomtom.com
TOMTOM_TRAFFIC_VERSION=4
TOMTOM_TRAFFIC_STYLE=relative-delay
TOMTOM_TRAFFIC_TILE_SIZE=256
# TOMTOM_TRAFFIC_THICKNESS=2

# Street-level imagery: Mapillary
# Create an app at https://www.mapillary.com/dashboard/developers to get a client token
MAPILLARY_TOKEN=

# Mapillary OAuth (optional, enables "Sign in with Mapillary")
# Uses the same app registered above; set the OAuth redirect URI to your domain
MAPILLARY_CLIENT_ID=
MAPILLARY_CLIENT_SECRET=

# Place photos: Flickr (optional, adds CC-licensed photos to place galleries)
# Get a free API key at https://www.flickr.com/services/api/misc.api_keys.html
FLICKR_API_KEY=

# CyclOSM tiles (optional, default uses public OSM France servers)
# CYCLOSM_TILE_URL=https://{s}.tile-cyclosm.openstreetmap.fr/cyclosm/{z}/{x}/{y}.png

# Waymarked Trails cycling routes tiles (optional)
# WAYMARKED_CYCLING_TILE_URL=https://tile.waymarkedtrails.org/cycling/{z}/{x}/{y}.png

# Air quality overlay: OpenAQ
# Register at https://explore.openaq.org/register for a free API key
OPENAQ_API_KEY=

# Wildfires: NASA FIRMS (Fire Information for Resource Management System)
# Get a free MAP_KEY at https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=

# EV charging: OpenChargeMap
# Register at https://openchargemap.org/ and get an API key
OPENCHARGEMAP_API_KEY=

# Fuel prices: Tankerkoenig (Germany only)
# Get a free API key at https://creativecommons.tankerkoenig.de/
TANKERKOENIG_API_KEY=

# Deutsche Bahn: RIS APIs (Boards, Journeys, Routing, Maps, Stations, etc.)
# Get credentials at https://developers.deutschebahn.com/ or via hackathon access
DB_RIS_CLIENT_ID=
DB_RIS_API_KEY=

# Deutsche Bahn: Parking Information / BahnPark (station parking with occupancy data)
# Requires a separate Marketplace subscription (free tier available)
# Subscribe at https://developers.deutschebahn.com/db-api-marketplace/apis/product/parking-information-db-bahnpark
DB_PARKING_CLIENT_ID=
DB_PARKING_API_KEY=

# Deutsche Bahn: Shared Mobility GBFS (Call-a-Bike / StadtRad)
# Register at https://developers.deutschebahn.com/ and subscribe to the Shared Mobility GBFS API
DB_GBFS_CLIENT_ID=
DB_GBFS_API_KEY=

# Authentication (Better Auth)
# Generate a secret: npx @better-auth/cli@latest secret
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://127.0.0.1:3001

# OpenStreetMap OAuth 2.0 (optional, enables "Sign in with OSM")
# Register at https://www.openstreetmap.org/oauth2/applications
OSM_CLIENT_ID=
OSM_CLIENT_SECRET=

# Passkeys / WebAuthn
# RP ID must match the domain users access the app from
PASSKEY_RP_ID=127.0.0.1
# Comma-separated list of allowed origins (web + mobile)
# For Android: add android:apk-key-hash:<BASE64_SHA256> for each signing certificate
# For iOS: the RP ID domain must have a .well-known/apple-app-site-association file
PASSKEY_ORIGIN=http://127.0.0.1:3000,openmapx://

# Email (for verification emails, 2FA codes, email change)
# Provider is auto-detected from env vars (priority: EmailLabs > Lettermint > SMTP)
EMAIL_FROM=OpenMapX <noreply@openmapx.org>

# Option 1: EmailLabs (emaillabs.io, Polish EU company, 9k emails/mo free)
# Sign up at https://emaillabs.io/ and get credentials from the panel
# EMAILLABS_APP_KEY=
# EMAILLABS_SECRET_KEY=
# EMAILLABS_SMTP_ACCOUNT=

# Option 2: Lettermint (lettermint.co, Dutch EU company, 300 emails/mo free)
# Sign up at https://lettermint.co/ and create an API token
# LETTERMINT_API_TOKEN=

# Option 3: SMTP fallback (any SMTP provider, e.g. for local dev with Mailpit)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Transit: TransitLand
# Sign up for a free API key at https://www.transit.land/
TRANSIT_LAND_API_KEY=

# Transit: Transport for London
# Get a free key at https://api.tfl.gov.uk/
TFL_API_KEY=

# Transit: MBTA (Boston)
# Get a free key at https://api-v3.mbta.com/
MBTA_API_KEY=

# Transit: OpenTripPlanner (self-hosted)
# Start with: docker compose --profile transit up -d otp
OTP_URL=http://localhost:8090

# Transit: MOTIS v2 (self-hosted, same API as api.transitous.org)
# Start with: docker compose --profile transit up -d motis
# Data managed by: infra/docker/manage.sh
MOTIS_URL=http://localhost:8081

# GitHub token (optional)
# Increases rate limits for the dynamic transit registry and GTFS catalog fetches
# Generate a personal access token at https://github.com/settings/tokens
# GITHUB_TOKEN=
