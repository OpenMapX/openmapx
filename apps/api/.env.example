# API Server
PORT=3001
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# Number of reverse-proxy hops in front of the API.
# - 0 — direct exposure (dev). request.ip is the actual TCP peer.
# - 1 — single reverse proxy (default, e.g. Traefik in infra/docker).
# - 2+ — chained proxies (e.g. Cloudflare → Traefik → API).
# Setting this too high lets clients forge X-Forwarded-For; setting it too low
# makes IP-keyed rate limits collapse to a single bucket per proxy. Pick the
# exact count for your deployment.
# TRUST_PROXY_HOPS=1

# Public base URL of the API (e.g. https://maps.example.com). Used to rewrite
# upstream tile/style URLs in /api/maptiler responses. If unset, falls back to
# https://${DOMAIN}. Never derived from X-Forwarded-Host (header-spoofable).
# PUBLIC_BASE_URL=https://maps.example.com

# Rate limits for the public surface. Keys are the client IP resolved through
# TRUST_PROXY_HOPS. Defaults are sized for an interactive map session and
# capping scripted abuse. Loopback peers and /health are exempt; admin routes
# use their own per-action limiters.
# RATE_LIMIT_PUBLIC_MAX=600           # broad floor, requests per window
# RATE_LIMIT_PUBLIC_WINDOW_MS=60000
# RATE_LIMIT_TILE_MAX=1800             # /api/maptiler, /api/tiles, /api/traffic — bursty, cacheable
# RATE_LIMIT_TILE_WINDOW_MS=60000
# RATE_LIMIT_EXPENSIVE_MAX=60         # /api/isochrone, /api/places, /api/elevation, /api/motis, ...
# RATE_LIMIT_EXPENSIVE_WINDOW_MS=60000
# RATE_LIMIT_AUTH_MAX=10              # /api/auth/* — credential stuffing + email spam
# RATE_LIMIT_AUTH_WINDOW_MS=60000

# PostgreSQL with PostGIS extension
# The password must match POSTGRES_PASSWORD in infra/docker/.env, which is
# what `pnpm openmapx services start --preset dev` reads to boot postgis.
# The default below matches `POSTGRES_PASSWORD=postgres` — a fine convenience
# for local dev. Production deployments use a strong value generated with
# `openssl rand -hex 32`.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/openmapx

# Redis / Valkey (optional, recommended for transit caching)
# Matches the redis service started by `pnpm openmapx services start --preset dev`.
REDIS_URL=redis://localhost:6379

# Per-integration credentials & config — managed in the admin UI at
# /admin/integrations (or /admin/integrations/bulk for the full list +
# the env-var override catalogue). Operators who prefer to keep secrets
# in env can paste the override block from the bulk page into this file.
# Env always wins; nothing is required at deploy time.
#
# Encryption key for secrets stored via the admin vault. 32 bytes hex.
# Generate:   openssl rand -hex 32
# OPENMAPX_SECRETS_KEY=

# Traffic: TomTom flow tiles (read directly by apps/api tile proxy)
# Sign up at https://developer.tomtom.com/ and create an API key
TRAFFIC_PROVIDER=tomtom
TOMTOM_TRAFFIC_KEY=
TOMTOM_TRAFFIC_URL=https://api.tomtom.com
TOMTOM_TRAFFIC_VERSION=4
TOMTOM_TRAFFIC_STYLE=relative-delay
TOMTOM_TRAFFIC_TILE_SIZE=256
# TOMTOM_TRAFFIC_THICKNESS=2

# MapTiler Cloud map assets (style JSON, vector tiles, satellite tiles, glyphs)
# Used by apps/api's `/api/maptiler/*` proxy for the hosted map fallback,
# MapTiler styles, and MapTiler-backed layers so the browser does not contact
# MapTiler directly.
MAPTILER_KEY=

# Mapillary OAuth (optional, enables "Sign in with Mapillary")
# Uses the same app registered above; set the OAuth redirect URI to your domain
MAPILLARY_CLIENT_ID=
MAPILLARY_CLIENT_SECRET=

# Backend URL fallbacks / manual overrides.
#
# Primary resolution for self-hosted backends now comes from the service
# registry (`ctx.getRequiredService(...)`) where applicable. These env vars
# remain as explicit overrides and fallback URLs for apps/api direct-call
# helpers plus shared helper packages used by some integrations.
#
# Set them when a backend runs outside the local dev stack, or when you want
# to force a custom/public endpoint instead of the resolved self-hosted one.
#
#   - OSRM_URL                       → road-snap (driving/walking/cycling)
#   - VALHALLA_URL, VALHALLA_API_KEY → isochrone, elevation, road-snap (bus),
#                                      and the Valhalla routing/directions provider
#   - MOTIS_URL              → motis manager + shared local MOTIS helpers
#   - OVERPASS_URL           → Overpass shared helper
#   - NOMINATIM_URL          → shared-mobility reverse-geocoder fallback
#   - TRANSITOUS_URL         → shared-mobility Transitous rentals fallback
#
# Valhalla: the old free FOSSGIS demo (valhalla1.openstreetmap.de) is
# unreliable, so the default is now Stadia Maps' hosted Valhalla, which uses
# the same endpoint paths but REQUIRES an API key (free non-commercial tier —
# sign up at https://stadiamaps.com/). Set VALHALLA_API_KEY below. For EU data
# residency use https://api-eu.stadiamaps.com. A self-hosted Valhalla needs no
# key — just point VALHALLA_URL at it and leave VALHALLA_API_KEY blank.
# OSRM_URL=http://localhost:5000
# VALHALLA_URL=https://api.stadiamaps.com
# VALHALLA_API_KEY=
#
# VALHALLA_API_KEY above is what the actual isochrone/elevation/routing
# requests use. The routing-valhalla + overlay-tool-travel-time *health checks*
# validate the key via the integration config instead (security: manifest
# templates can only read an integration's own config keys, not arbitrary env).
# To turn those health dots green, set the same key in the admin UI for both
# integrations, or via these env aliases (yes, this duplicates the key):
#   INTEGRATION_ROUTING_VALHALLA_APIKEY=
#   INTEGRATION_OVERLAY_TOOL_TRAVEL_TIME_APIKEY=
# MOTIS_URL=http://localhost:8081
# OVERPASS_URL=http://localhost:8082
# NOMINATIM_URL=http://localhost:8088
# TRANSITOUS_URL=https://api.transitous.org

# Thunderforest OpenCycleMap (apps/api tile proxy)
# Sign up for a free Hobby Project key at https://www.thunderforest.com/
THUNDERFOREST_API_KEY=

# CyclOSM tiles (optional, custom tile URL override for apps/api)
# CYCLOSM_TILE_URL=https://{s}.tile-cyclosm.openstreetmap.fr/cyclosm/{z}/{x}/{y}.png

# Waymarked Trails cycling routes tiles (optional, apps/api tile proxy)
# WAYMARKED_CYCLING_TILE_URL=https://tile.waymarkedtrails.org/cycling/{z}/{x}/{y}.png

# OpenTopoMap tiles (optional, apps/api tile proxy)
# OPENTOPOMAP_TILE_URL=https://tile.opentopomap.org/{z}/{x}/{y}.png

# Authentication (Better Auth)
# Generate a secret: npx @better-auth/cli@latest secret
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://127.0.0.1:3001

# OpenStreetMap OAuth 2.0 (optional, enables "Sign in with OSM")
# Register at https://www.openstreetmap.org/oauth2/applications
OSM_CLIENT_ID=
OSM_CLIENT_SECRET=

# Passkeys / WebAuthn
# RP ID must match the domain users access the app from
PASSKEY_RP_ID=127.0.0.1
# Comma-separated list of allowed origins (web + mobile)
# For Android: add android:apk-key-hash:<BASE64_SHA256> for each signing certificate
# For iOS: the RP ID domain must have a .well-known/apple-app-site-association file
PASSKEY_ORIGIN=http://127.0.0.1:3000,openmapx://

# Email (for verification emails, 2FA codes, email change)
# Provider is auto-detected from env vars (priority: EmailLabs > Lettermint > SMTP).
#
# Every value below can also be set in /admin/settings → Email / SMTP. Env
# vars always win the resolution cascade, so leave them commented if you
# want to manage email config from the admin UI; uncomment to lock a
# specific value for this deployment.
# EMAIL_FROM=OpenMapX <noreply@openmapx.org>

# Option 1: EmailLabs (emaillabs.io, Polish EU company, 9k emails/mo free)
# Sign up at https://emaillabs.io/ and get credentials from the panel
# EMAILLABS_APP_KEY=
# EMAILLABS_SECRET_KEY=
# EMAILLABS_SMTP_ACCOUNT=

# Option 2: Lettermint (lettermint.co, Dutch EU company, 300 emails/mo free)
# Sign up at https://lettermint.co/ and create an API token
# LETTERMINT_API_TOKEN=

# Option 3: SMTP fallback (any SMTP provider, e.g. for local dev with Mailpit)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=

# Multi-tenant hosts: disable the loopback admin short-circuit
# OPENMAPX_DISABLE_LOCALHOST_AUTH=1

# Local admin token — when set, the loopback admin short-circuit requires this
# token as a Bearer or X-Admin-Token header instead of accepting any loopback
# request without auth. Optional; leave unset for single-operator deployments.
# OPENMAPX_LOCAL_ADMIN_TOKEN=

# Fastify log level (trace | debug | info | warn | error | fatal). Optional, default: info
# LOG_LEVEL=info

# Activity retention (days). The API prunes admin_audit_log and admin_job
# rows once a day; the defaults match the current values in
# apps/api/src/server.ts. Set lower for tight-disk deployments, higher to
# keep more history. In-flight jobs are never pruned.
# AUDIT_LOG_RETENTION_DAYS=90
# ADMIN_JOB_RETENTION_DAYS=30

# Isochrone provider override (default: valhalla). Use "otp" to route
# isochrones through OpenTripPlanner instead.
# ISOCHRONE_PROVIDER=valhalla

# GitHub API token — raises the Transitous GTFS catalog fetch rate limit from
# 60 to 5000 req/h. Optional; only needed on high-traffic or multi-tenant hosts.
# GITHUB_TOKEN=

# Community extensions catalog URL. Optional,
# default: https://raw.githubusercontent.com/openmapx/community-extensions/main/catalog.json
# EXTENSION_CATALOG_URL=

# Overture Maps POI integration (weekly release check by data-manager)
# OVERTURE_ENABLED=false
# OVERTURE_SYNC_CRON=0 5 * * 2
# OVERTURE_CONFLATION_RETRY_CRON=*/15 * * * *

# Instance display name shown in the admin UI header. Optional; falls back to
# the value set in /admin/settings.
# INSTANCE_NAME=

# data-manager service connection (runs on port 4000 by default)
# Set DATA_MANAGER_URL when the data-manager runs at a non-default address.
# DATA_MANAGER_URL=http://localhost:4000
# Shared bearer token that apps/api uses to authenticate against data-manager.
# Must match DATA_MANAGER_AUTH_TOKEN in services/data-manager/.env. Optional in
# development (both sides accept empty); required in production.
# DATA_MANAGER_AUTH_TOKEN=

# Path to the active MOTIS data directory (license/config artifacts). Optional,
# default: <repo_root>/infra/docker/data/motis/live
# MOTIS_DATA_DIR=

# Path to the MOTIS license.json file (shown in /admin/attribution). Optional,
# default: <repo_root>/infra/docker/data/motis-data/license.json
# MOTIS_LICENSE_FILE=

# Alternate MapTiler key read by the /api/maptiler proxy as a fallback when
# MAPTILER_KEY is not set. Useful in dev when only NEXT_PUBLIC_MAPTILER_KEY
# is populated. Optional; prefer setting MAPTILER_KEY above instead.
# NEXT_PUBLIC_MAPTILER_KEY=

# File-system paths used by the admin compose runner and GTFS importer.
# In Docker deployments these are set by the compose-rendered environment.
#
# Absolute path to the repo checkout on the Docker HOST (not the container
# filesystem). Required by the admin service lifecycle commands that shell out
# to `docker compose`. Must match OPENMAPX_HOST_DIR in infra/docker/.env.
# OPENMAPX_HOST_DIR=
#
# Absolute path to the repo root inside the container (or on the host for
# bare-metal runs). Defaults to cwd walk; set explicitly for predictability.
# OPENMAPX_ROOT_DIR=
#
# Absolute path to the infra/docker directory. Overrides the root-relative
# default; useful when the API container mounts compose files at a custom path.
# DOCKER_INFRA_DIR=
#
# Directory where community integrations installed via the admin panel are
# stored. Default: <repo_root>/custom_integrations
# OPENMAPX_CUSTOM_INTEGRATIONS_DIR=

# Comma- or space-separated list of service IDs to enable. When set, takes
# precedence over the persisted services-selection.json written by the admin
# UI. Useful for CI or repeatable deployments.
# OPENMAPX_ENABLED_SERVICES=

# Concurrent place-enrichment requests per /api/places call. Optional, default: 8
# OPENMAPX_PLACE_ENRICH_CONCURRENCY=8

# Public domain name of this deployment (e.g. maps.example.com). Used as a
# fallback when PUBLIC_BASE_URL is unset — the tile proxy rewrites asset URLs
# to https://${DOMAIN}. Also used by the admin compose runner. Optional in
# dev (falls back to "localhost"); set in production.
# In Docker deployments this is injected from DOMAIN in infra/docker/.env.
# DOMAIN=maps.example.com

# Note: docker-compose deployment settings (DOMAIN, ACME_EMAIL,
# POSTGRES_PASSWORD, LEGAL_*, service tuning, etc.) live in
# `infra/docker/.env` — see `infra/docker/.env.example`.
