# API Server
PORT=3001
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# PostgreSQL with PostGIS extension
# The password must match POSTGRES_PASSWORD in infra/docker/.env, which is
# what `pnpm openmapx services start --preset dev` reads to boot postgis.
# The default below matches `POSTGRES_PASSWORD=postgres` — a fine convenience
# for local dev. Production deployments use a strong value generated with
# `openssl rand -hex 32`.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/openmapx

# Redis / Valkey (optional, recommended for transit caching)
# Matches the redis service started by `pnpm openmapx services start --preset dev`.
REDIS_URL=redis://localhost:6379

# Per-integration credentials & config — managed in the admin UI at
# /admin/integrations (or /admin/integrations/bulk for the full list +
# the env-var override catalogue). Operators who prefer to keep secrets
# in env can paste the override block from the bulk page into this file.
# Env always wins; nothing is required at deploy time.
#
# Encryption key for secrets stored via the admin vault. 32 bytes hex.
# Generate:   openssl rand -hex 32
# OPENMAPX_SECRETS_KEY=

# Traffic: TomTom flow tiles (read directly by apps/api tile proxy)
# Sign up at https://developer.tomtom.com/ and create an API key
TRAFFIC_PROVIDER=tomtom
TOMTOM_TRAFFIC_KEY=
TOMTOM_TRAFFIC_URL=https://api.tomtom.com
TOMTOM_TRAFFIC_VERSION=4
TOMTOM_TRAFFIC_STYLE=relative-delay
TOMTOM_TRAFFIC_TILE_SIZE=256
# TOMTOM_TRAFFIC_THICKNESS=2

# Street-level imagery: Mapillary
# Used by apps/api's `/streetview/images` route. The photos-mapillary
# integration is configured separately in the admin UI.
MAPILLARY_TOKEN=

# Mapillary OAuth (optional, enables "Sign in with Mapillary")
# Uses the same app registered above; set the OAuth redirect URI to your domain
MAPILLARY_CLIENT_ID=
MAPILLARY_CLIENT_SECRET=

# Backend URL fallbacks / manual overrides.
#
# Primary resolution for self-hosted backends now comes from the service
# registry (`ctx.getRequiredService(...)`) where applicable. These env vars
# remain as explicit overrides and fallback URLs for apps/api direct-call
# helpers plus shared helper packages used by some integrations.
#
# Set them when a backend runs outside the local dev stack, or when you want
# to force a custom/public endpoint instead of the resolved self-hosted one.
#
#   - OSRM_URL, VALHALLA_URL → road-snap, elevation, isochrone helpers
#   - MOTIS_URL              → motis manager + shared local MOTIS helpers
#   - OVERPASS_URL           → Overpass shared helper
#   - NOMINATIM_URL          → shared-mobility reverse-geocoder fallback
#   - TRANSITOUS_URL         → shared-mobility Transitous rentals fallback
# OSRM_URL=http://localhost:5000
# VALHALLA_URL=http://localhost:8002
# MOTIS_URL=http://localhost:8081
# OVERPASS_URL=http://localhost:8082
# NOMINATIM_URL=http://localhost:8088
# TRANSITOUS_URL=https://api.transitous.org

# Thunderforest OpenCycleMap (apps/api tile proxy)
# Sign up for a free Hobby Project key at https://www.thunderforest.com/
THUNDERFOREST_API_KEY=

# CyclOSM tiles (optional, custom tile URL override for apps/api)
# CYCLOSM_TILE_URL=https://{s}.tile-cyclosm.openstreetmap.fr/cyclosm/{z}/{x}/{y}.png

# Waymarked Trails cycling routes tiles (optional, apps/api tile proxy)
# WAYMARKED_CYCLING_TILE_URL=https://tile.waymarkedtrails.org/cycling/{z}/{x}/{y}.png

# OpenTopoMap tiles (optional, apps/api tile proxy)
# OPENTOPOMAP_TILE_URL=https://tile.opentopomap.org/{z}/{x}/{y}.png

# Authentication (Better Auth)
# Generate a secret: npx @better-auth/cli@latest secret
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://127.0.0.1:3001

# OpenStreetMap OAuth 2.0 (optional, enables "Sign in with OSM")
# Register at https://www.openstreetmap.org/oauth2/applications
OSM_CLIENT_ID=
OSM_CLIENT_SECRET=

# Passkeys / WebAuthn
# RP ID must match the domain users access the app from
PASSKEY_RP_ID=127.0.0.1
# Comma-separated list of allowed origins (web + mobile)
# For Android: add android:apk-key-hash:<BASE64_SHA256> for each signing certificate
# For iOS: the RP ID domain must have a .well-known/apple-app-site-association file
PASSKEY_ORIGIN=http://127.0.0.1:3000,openmapx://

# Email (for verification emails, 2FA codes, email change)
# Provider is auto-detected from env vars (priority: EmailLabs > Lettermint > SMTP).
#
# Every value below can also be set in /admin/settings → Email / SMTP. Env
# vars always win the resolution cascade, so leave them commented if you
# want to manage email config from the admin UI; uncomment to lock a
# specific value for this deployment.
# EMAIL_FROM=OpenMapX <noreply@openmapx.org>

# Option 1: EmailLabs (emaillabs.io, Polish EU company, 9k emails/mo free)
# Sign up at https://emaillabs.io/ and get credentials from the panel
# EMAILLABS_APP_KEY=
# EMAILLABS_SECRET_KEY=
# EMAILLABS_SMTP_ACCOUNT=

# Option 2: Lettermint (lettermint.co, Dutch EU company, 300 emails/mo free)
# Sign up at https://lettermint.co/ and create an API token
# LETTERMINT_API_TOKEN=

# Option 3: SMTP fallback (any SMTP provider, e.g. for local dev with Mailpit)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=

# Multi-tenant hosts: disable the loopback admin short-circuit
# OPENMAPX_DISABLE_LOCALHOST_AUTH=1

# Activity retention (days). The API prunes admin_audit_log and admin_job
# rows once a day; the defaults match the current values in
# apps/api/src/server.ts. Set lower for tight-disk deployments, higher to
# keep more history. In-flight jobs are never pruned.
# AUDIT_LOG_RETENTION_DAYS=90
# ADMIN_JOB_RETENTION_DAYS=30

# Note: docker-compose deployment settings (DOMAIN, ACME_EMAIL,
# POSTGRES_PASSWORD, LEGAL_*, service tuning, etc.) live in
# `infra/docker/.env` — see `infra/docker/.env.example`.
