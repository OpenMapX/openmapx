{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "globalDependencies": ["tsconfig.base.json"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**", "build/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "interactive": true
    },
    "start": {
      "cache": false,
      "persistent": true
    },
    "web#build": {
      "cache": false,
      "env": ["SW_BUILD_ID"]
    },
    "web#build:app": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*", "$TURBO_ROOT$/integrations/**"],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "public/runtime/**",
        "public/icons/**",
        "src/generated/open-source-licenses.json"
      ]
    },
    "web#build:deploy": {
      "dependsOn": ["build:app"],
      "env": ["SW_BUILD_ID"],
      "cache": false
    }
  }
}
