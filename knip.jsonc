{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "include": ["files", "dependencies"],
  "ignoreWorkspaces": [
    "integrations/__tests__",
    "integrations/_placeholder",
    "integrations/_template"
  ],
  "workspaces": {
    ".": {
      "entry": [
        // The CI privacy-backup fixture spawns this file by path.
        "services/ops-agent/privacy-backup/verify-output.ts"
      ],
      "ignoreFiles": ["docs/**"]
    },
    "scripts": {
      // Discover dynamically loaded GraphQL Code Generator plugins from their real config.
      "graphql-codegen": { "config": ["entur/codegen.config.mjs"] },
      "entry": [
        // The Git pre-commit hook invokes this script directly.
        "check-staged.mjs",
        // The scoped unused-export audit loads this Knip postprocessor by path.
        "knip-service-exports.mjs",
        // Nested workspace commands and an explicitly selected Vitest config.
        "discovery-eval/run.ts",
        "record-search-eval.mts",
        "self-hosting-replay-vitest.config.ts",
        // Docker-context scanner tests spawn this deadline-isolated fixture by path.
        "fixtures/docker-context-redirection-probe.ts",
        // Codegen artifact tests spawn these lifetime and zombie-process fixtures by path.
        "codegen/fixtures/*.mjs",
        // Release IO tests copy this executable into fake gh/docker/trivy subprocess paths.
        "fixtures/product-release-command.mjs",
        // Release IO tests invoke this fixed JSON-input Node subprocess entry point.
        "fixtures/product-release-probe.mjs",
        // Exact native package candidates and synthetic publish handoff probe.
        "fixtures/package-release-probe.mjs",
        // Bounded candidate IO race and adversarial tar-path subprocess.
        "fixtures/package-release-io-probe.mjs",
        "discovery-eval/business-name-address/replay.ts",
        "check-dockerfile-workspace-sync.ts",
        "check-credential-keys.ts",
        "check-feed-ids.ts",
        "check-legal-tables.ts",
        "check-legal-updated.ts",
        "check-legal-urls.ts",
        "check-license-metadata.ts",
        "check-toolchain-pins.ts",
        "bench-air-quality.ts",
        "benchmark-motis-reachability.ts",
        "ev-vehicles/generate.ts"
      ],
      // TypeScript resolves the .mjs validator import to this typed companion.
      "ignoreFiles": ["validate-privacy-release.d.mts"]
    },
    "apps/api": {
      "entry": [
        "scripts/**/*.ts",
        // Memory tests spawn these children by path in heap-constrained processes.
        "src/privacy/__tests__/fixtures/*-memory-child.ts"
      ],
      "ignoreFiles": [
        "src/__tests__/fixtures/**",
        // TypeScript resolves the .mjs fingerprint import to this typed companion.
        "privacy-source-fingerprint.d.mts"
      ],
      // Integration adapters are copied into the API image and discovered from
      // their manifests at runtime, so their API-only packages have no static
      // import path from this workspace.
      "ignoreDependencies": [
        "@openmapx/mobility-formats",
        "gtfs-realtime-bindings-transit",
        "hafas-client"
      ]
    },
    "apps/mobile": {
      "entry": [
        "modules/**/index.ts",
        "compliance/**/*.mts",
        "qa/**/*.mts",
        "release/**/*.mts",
        "scripts/**/*.mts",
        "store/screenshots/**/*.mts"
      ],
      "ignoreFiles": [
        // The production local-notification adapter is complete, but foreground
        // navigation composition is not yet mounted by App.tsx. Keep this explicit
        // so Knip does not turn unfinished product wiring into a deletion.
        "src/notifications/ExpoNotificationScheduler.ts"
      ]
    },
    "apps/ops-agent": {
      "entry": [
        // Runtime bundle entries from scripts/build-runtime-bundles.mjs: the
        // agent itself and the helper that replaces the agent's container.
        "src/index.ts",
        "src/agent-handoff-main.ts",
        "src/configuration-handoff-main.ts",
        // Concurrency tests spawn these writer processes by path.
        "src/__fixtures__/*.mjs",
        // Native recovery tests bundle or execute these isolated children by path.
        "src/artifact-transfer/test-fixtures/*.{ts,mjs}",
        "src/test-fixtures/data-owned-http-process.ts",
        // The fixed CLI nonempty-link test loads this HTTP-only native preload.
        "src/test-fixtures/fixed-cli-data-manager-preload.mjs",
        "src/test-fixtures/terminal-retention-process.ts"
      ]
    },
    "apps/web": {
      "entry": ["src/sw.ts", "scripts/**/*.{mjs,ts}"],
      "ignoreFiles": ["public/**"],
      // Keep the web app's auth runtime pinned alongside core and API. These
      // direct dependencies are enforced by auth-oauth-provider.test.ts even
      // though the imports live in the shared core workspace.
      "ignoreDependencies": ["@better-auth/core", "@better-auth/passkey", "better-auth"],
      "paths": {
        "@/*": ["src/*"],
        "@integrations/*": ["../../integrations/*"]
      }
    },
    "integrations/*": {
      "entry": [
        "{index,map-layer,legend,panel,ReportDialog,ReportFab,CrowdApproachPrompt}.{ts,tsx}"
      ],
      "paths": {
        "@/*": ["../../apps/web/src/*"],
        "@integrations/*": ["../*"]
      }
    },
    "integrations/live-transit-siri-sx-ch": {
      // The Swiss SIRI integration aliases the shared OTD implementation in its
      // manifest; it does not import that implementation from TypeScript.
      "ignoreDependencies": ["@openmapx/integration-transit-opentransportdata-ch"]
    },
    "integrations/overlay-traffic-tomtom": {
      // Exact workspace configuration replaces the integrations/* defaults.
      "entry": [
        "{index,map-layer,legend,panel,ReportDialog,ReportFab,CrowdApproachPrompt}.{ts,tsx}"
      ],
      "paths": {
        "@/*": ["../../apps/web/src/*"],
        "@integrations/*": ["../*"]
      },
      // ReactJSX emits react/jsx-runtime; TypeScript resolves its @types/react companion.
      "ignoreDependencies": ["react", "@types/react"]
    },
    "packages/brands": {
      // The package root is resolved as data with require.resolve().
      "ignoreDependencies": ["name-suggestion-index"]
    },
    "packages/cli": {
      // Durable data tests bundle this fixed CLI subprocess by path.
      "entry": ["__tests__/fixtures/single-data-cli-process.ts"],
      // Root scripts invoke this workspace through `pnpm exec tsx`.
      "ignoreDependencies": ["tsx"]
    },
    "packages/core": {
      // Artifact/authority tests build these native subprocess entrypoints.
      "entry": ["src/build-artifacts/test-fixtures/*.ts"]
    },
    "packages/entur-client": {
      // check-types compiles this never-imported file to assert generated
      // GraphQL variable inference.
      "entry": ["src/client.typecheck.ts"]
    },
    "packages/extension-cli": {
      "ignoreFiles": ["templates/**"]
    },
    "packages/i18n": {
      // Root locale scripts invoke this workspace through `pnpm exec tsx`.
      "ignoreDependencies": ["tsx"]
    },
    "packages/air-quality": {
      // The pinned Natural Earth generator loads this CommonJS package through
      // createRequire(), which static import analysis cannot discover.
      "ignoreDependencies": ["shapefile"]
    },
    "packages/presets": {
      // The schema is loaded with a template-literal dynamic import.
      "ignoreDependencies": ["@openstreetmap/id-tagging-schema"]
    },
    "services/data-manager": {
      "entry": [
        "src/jobs/overture/eval/*.ts",
        // Package start and Docker invoke the emitted supervisor entrypoint.
        "src/supervisor.ts",
        // Production clients select source/emitted Worker URLs at runtime.
        "src/jobs/traffic/live-writer-worker.ts",
        "src/offline-packages/extractor-worker.ts",
        // Documented verification CLIs and their runtime-URL fault child.
        "scripts/verify-engine-watchdog.ts",
        "scripts/verify-road-condition-engine.ts",
        "scripts/verify-route-traffic-proof.ts",
        "scripts/traffic-writer-fault.ts",
        // Native catalog and execution recovery tests spawn these files by path.
        "__tests__/fixtures/catalog-data-manager-process.mjs",
        "src/jobs/execution/test-fixtures/dm-recovery-process.ts",
        // Root package scripts invoke this nested OpenAPI CLI directly.
        "scripts/openapi/generate.ts"
      ],
      // The glyph utility loads this CommonJS package through its compatibility
      // loader because the dependency does not expose an ESM entry point.
      "ignoreDependencies": ["@mapbox/glyph-pbf-composite"]
    }
  }
}
