language js

// Admin copy comes from the message catalogue so every locale can read it.
// Biome's noJsxLiterals covers text between tags. This plugin covers the other
// places a string literal reaches the screen: expression children, props and
// object members that show text, label maps, the values handed to a
// translator, and toast, snackbar and setter calls that carry a message.
//
// A string is copy when it holds a word. Separators such as "·" or "—" are not.
// A literal also counts when it is a branch of a conditional, either side of
// `??`, `||` or `&&`, or a `+` operand, because those values are shown as they
// are. Literals inside a call, such as translator keys, are not followed.

// Strings that read the same in every language. Each one is listed.
pattern non_copy() {
  or {
    // The product name.
    r"[\"'`]OpenMapX[\"'`]",
    // Environment variable names the admin screens show, and the
    // INTEGRATION_<ID>_<KEY> and SERVICE_<ID>_<KEY> name patterns.
    r"[\"'`](?:OPENMAPX_[A-Z0-9_]+|(?:INTEGRATION|SERVICE)_<ID>_<KEY>|TRANSITOUS_API_KEYS|PUBLIC_URL|EMAIL_FROM)[\"'`]",
    // Commands, file names and protocol names.
    r"[\"'`](?:openssl rand -hex 32|pnpm openmapx compose down|infra/docker/\.env|extension\.json|tcp)[\"'`]",
    // Licence identifiers.
    r"[\"'`](?:CC-BY-4\.0)[\"'`]",
    // Example input values shown as placeholders.
    r"[\"'`](?:https://…/extension\.json|https://…/catalog\.json|https://example\.com/feed\.gtfs\.zip|timeline\.example\.com|europe/germany|de-be|valhalla, osrm, motis|app-api, valhalla, osrm)[\"'`]"
  }
}

pattern word_literal() {
  or {
    JsStringLiteralExpression(),
    JsxString()
  } as $literal where { $literal <: r"(?s).*\p{L}{2,}.*", not $literal <: non_copy() }
}

// Words in the text of an untagged template; names inside a placeholder such
// as `${row.state}` are code, and so is text made only of environment variable
// characters, such as the `<KEY>` in `${prefix}<KEY>`.
pattern word_template() {
  JsTemplateExpression(tag=$tag, elements=$elements) where {
    $tag <: .,
    $elements <: some JsTemplateChunkElement() as $chunk where {
      $chunk <: r"(?s).*\p{L}{2,}.*",
      not $chunk <: r"[<>A-Z0-9_]+"
    }
  }
}

pattern copy_value() {
  or {
    word_literal(),
    word_template(),
    JsConditionalExpression(consequent=copy_value()),
    JsConditionalExpression(alternate=copy_value()),
    JsLogicalExpression(left=copy_value()),
    JsLogicalExpression(right=copy_value()),
    JsParenthesizedExpression(expression=copy_value()),
    `$left + $right` where { or { $left <: copy_value(), $right <: copy_value() } }
  }
}

// Props and object keys whose value is shown: label, title, helperText,
// aria-label, noOptionsText, confirmLabel and the like.
pattern copy_name() {
  r"(?:(?:[\w-]*[a-z0-9])?(?:Label|Title|Text|Placeholder|Description|Message|Caption|Heading|Tooltip|Hint)|label|title|subtitle|text|placeholder|description|message|caption|heading|tooltip|hint|aria-(?:label|description|valuetext|roledescription)|alt|primary|secondary|headerName|children)"
}

// Calls that show their first argument: toasts, snackbars and setters that
// hold a message. Later arguments, such as a severity, are not copy.
pattern copy_sink() {
  r"(?:toast(?:\.\w+)?|showToast|setToast|enqueueSnackbar|showSnackbar|setSnackbar|notify\w*|on\w*(?:Error|Message)|set\w*(?:Error|Message|Notice|Toast|Snackbar|Feedback|Success|Warning|Info|Hint|Label|Title|Text|Copy|Alert)s?)"
}

pattern translator() { r"(?:t|t[a-z]|t[A-Z]\w*)(?:\.(?:rich|markup))?" }

// Maps from codes to copy, such as `const STATUS_LABELS = { active: "Active" }`.
pattern label_map_name() {
  r"(?:(?:\w*[a-z0-9])?(?:Label|Title|Text|Copy|Message|Description|Caption|Heading|Hint)s?|(?:\w*_)?(?:LABEL|TITLE|TEXT|COPY|MESSAGE|DESCRIPTION|CAPTION|HEADING|HINT)S?|(?:label|title|text|copy|message|description|caption|heading|hint)s?)"
}

or {
  JsxExpressionChild(expression=copy_value()),
  JsxAttribute(name=$name, initializer=$initializer) where {
    $name <: copy_name(),
    $initializer <: or {
      JsxAttributeInitializerClause(value=word_literal()),
      JsxAttributeInitializerClause(value=JsxExpressionAttributeValue(expression=copy_value()))
    }
  },
  JsPropertyObjectMember(name=$name, value=copy_value()) where { $name <: copy_name() },
  JsCallExpression(callee=copy_sink(), arguments=JsCallArguments(args=[copy_value(), ...])),
  JsNewExpression(callee=`AdminDisplayError`, arguments=JsCallArguments(args=[copy_value(), ...])),
  JsCallExpression(callee=`reportJob`, arguments=JsCallArguments(args=[$_, copy_value(), ...])),
  JsCallExpression(callee=$callee, arguments=JsCallArguments(args=$arguments)) where {
    $callee <: translator(),
    $arguments <: some JsObjectExpression(members=$members) where {
      $members <: some JsPropertyObjectMember(value=copy_value())
    }
  },
  JsVariableDeclarator(id=$id, initializer=$initializer) where {
    $id <: label_map_name(),
    $initializer <: contains JsPropertyObjectMember(value=copy_value())
  }
} as $copy where {
  register_diagnostic(span=$copy, message="Visible copy belongs in the message catalogue. Use a translator call instead of a string literal.")
}
