{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2024",
    "lib": ["ES2024"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    // Scripts run under Node's type stripping, which needs the `.ts` suffix on
    // relative imports of other TypeScript files.
    "allowImportingTsExtensions": true,
    // Several TypeScript scripts import sibling `.mjs` modules that carry no
    // declaration file; reading their JavaScript infers the types instead of
    // reporting each import as implicitly `any`. The JavaScript is not checked.
    "allowJs": true
  },
  "include": ["**/*.ts", "**/*.mts"],
  // The discovery evaluation keeps its own project. The build contract test
  // imports the web app's Next configuration, whose global types make
  // `NODE_ENV` a required environment variable in every program that contains
  // them, so it is checked alone (`tsconfig.next-config.json`).
  "exclude": ["node_modules", "discovery-eval", "build-ci-contract.test.ts"]
}
