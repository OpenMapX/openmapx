# Staged-scoped fast gate. Biome lints only the staged files (native --staged
# support, no lint-staged needed); check-translations is cheap and global.
pnpm exec biome check --staged --no-errors-on-unmatched || exit 1
pnpm check-translations || exit 1

# Type-check only the workspace packages affected by uncommitted changes.
# Turbo's [HEAD] selector diffs the working tree against HEAD and `...` pulls
# in dependents. Files outside the workspace globs (apps/*, packages/*,
# integrations/*, services/data-manager) can't be attributed to a package —
# root configs, scripts/, the lockfile — so any such staged path falls back to
# the full workspace check. pre-push re-runs the full check as a backstop.
if git diff --cached --name-only | grep -qvE '^(apps|packages|integrations)/[^/]+/|^services/data-manager/'; then
  echo "pre-commit: staged changes outside workspace packages -> full check-types"
  pnpm check-types || exit 1
else
  echo "pre-commit: affected-only check-types"
  pnpm exec turbo run check-types --filter='...[HEAD]' || exit 1
fi

pnpm check:policy || exit 1

# Only when the API surface could have moved: mounting the route table costs a
# few seconds, and nothing else in the repo can change it.
if git diff --cached --name-only | grep -qE '^apps/api/src/routes/|^apps/api/src/(server|integration-routes)\.ts$|^integrations/|^packages/integration-framework/src/'; then
  pnpm check-openapi || exit 1
fi
