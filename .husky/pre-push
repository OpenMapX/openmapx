# Full workspace gates before anything leaves the machine. check-types runs
# unscoped here as the backstop for the affected-only pre-commit check (turbo's
# local cache makes an unchanged re-run near-instant). The portable suite needs
# neither Docker nor a database: database suites run only through
# `pnpm test:database`, which sets OPENMAPX_RUN_DATABASE_TESTS=1.
#
# Git exports repository-local paths to hooks. Those paths point at the shared
# metadata directory in a linked worktree and would leak into tests that create
# temporary repositories, so clear the complete local-variable set first.
unset \
  GIT_ALTERNATE_OBJECT_DIRECTORIES \
  GIT_COMMON_DIR \
  GIT_CONFIG \
  GIT_CONFIG_COUNT \
  GIT_CONFIG_PARAMETERS \
  GIT_DIR \
  GIT_GRAFT_FILE \
  GIT_IMPLICIT_WORK_TREE \
  GIT_INDEX_FILE \
  GIT_NO_REPLACE_OBJECTS \
  GIT_OBJECT_DIRECTORY \
  GIT_PREFIX \
  GIT_REPLACE_REF_BASE \
  GIT_SHALLOW_FILE \
  GIT_WORK_TREE

# Concurrent pushes from other worktrees or repositories (OpenConditions' hook
# takes the same lock file) would starve each other's timing-sensitive tests,
# so one pre-push runs at a time on this machine. Vitest keeps half the cores
# free for whatever else is running.
gates='pnpm check-types && pnpm test --maxWorkers=50%'
lock="${TMPDIR:-/tmp}/pre-push.lock"
if command -v flock >/dev/null 2>&1; then
  flock "$lock" sh -c "$gates"
elif [ -x /usr/bin/lockf ]; then
  /usr/bin/lockf -k "$lock" sh -c "$gates"
else
  sh -c "$gates"
fi
