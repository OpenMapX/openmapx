{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "maxLength": 48,
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "maxLength": 256,
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-((?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*))*))?(?:\\+([0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*))?$"
    },
    "platform": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "webPlatform": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "description": {
      "type": "string"
    },
    "author": {
      "type": "string"
    },
    "license": {
      "type": "string"
    },
    "homepage": {
      "type": "string",
      "format": "uri"
    },
    "changelog": {
      "type": "string",
      "maxLength": 2048
    },
    "services": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "repo": {
            "type": "string",
            "maxLength": 2048
          },
          "ref": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9._\\-/]+$"
          },
          "service": {
            "type": "string",
            "maxLength": 48,
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "optional": {
            "type": "boolean"
          }
        },
        "required": ["repo", "service"]
      }
    },
    "integrations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "artifact": {
            "type": "string",
            "maxLength": 2048
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "id": {
            "type": "string",
            "maxLength": 48,
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          }
        },
        "required": ["artifact", "sha256", "id"]
      }
    },
    "config": {
      "maxItems": 64,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "maxLength": 64,
            "pattern": "^[a-z][a-z0-9]*(?:[A-Z][a-z0-9]+)*$"
          },
          "targets": {
            "minItems": 1,
            "maxItems": 16,
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "component": {
                      "type": "string",
                      "pattern": "^(service|integration):[a-z0-9]+(-[a-z0-9]+)*$"
                    },
                    "key": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 64
                    }
                  },
                  "required": ["component", "key"],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "capability": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128
                    }
                  },
                  "required": ["capability"],
                  "additionalProperties": false
                }
              ]
            }
          },
          "secret": {
            "type": "boolean"
          },
          "generated": {
            "type": "boolean"
          },
          "default": {
            "type": "string",
            "maxLength": 4096
          }
        },
        "required": ["key", "targets"],
        "additionalProperties": false
      }
    }
  },
  "required": ["id", "name", "version", "platform"],
  "additionalProperties": false,
  "$id": "https://openmapx.org/schemas/extension-contracts/1.0/extension.json",
  "$comment": "Structural authoring schema. Runtime validation additionally checks structured licensing, media hosts, component references, compatibility and community policy. This identifier does not imply hosted schema availability."
}
