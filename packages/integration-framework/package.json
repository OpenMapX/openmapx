{
  "name": "@openmapx/integration-framework",
  "license": "Apache-2.0",
  "version": "1.0.0",
  "description": "Manifest validation, registry, installer, and runtime context for OpenMapX integrations",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./react": {
      "types": "./src/react.ts",
      "default": "./src/react.ts"
    },
    "./shared-mobility-provider": {
      "types": "./src/shared-mobility-provider-factory.ts",
      "default": "./src/shared-mobility-provider-factory.ts"
    },
    "./shared-mobility": {
      "types": "./src/shared-mobility/ids.ts",
      "default": "./src/shared-mobility/ids.ts"
    },
    "./installer": {
      "types": "./src/installer.ts",
      "default": "./src/installer.ts"
    },
    "./strings": {
      "types": "./strings/index.ts",
      "default": "./strings/index.ts"
    },
    "./testing": {
      "types": "./src/testing/index.ts",
      "default": "./src/testing/index.ts"
    },
    "./test/shared-mobility-provider": {
      "types": "./src/testing/shared-mobility-provider.ts",
      "default": "./src/testing/shared-mobility-provider.ts"
    },
    "./impersonate": {
      "types": "./src/impersonate.ts",
      "default": "./src/impersonate.ts"
    }
  },
  "scripts": {
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@openmapx/air-quality": "workspace:^",
    "@openmapx/core": "workspace:^",
    "@openmapx/mobility-core": "workspace:^",
    "@openmapx/place-ids": "workspace:^",
    "@openmapx/poi-source-registry": "workspace:^",
    "impit": "^0.14.5",
    "intl-messageformat": "^12.1.2",
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "react": ">=19"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "react": "19.3.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.1"
  }
}
