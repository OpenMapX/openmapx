{
  "name": "@openmapx/integration-framework",
  "version": "1.0.0",
  "description": "Manifest validation, registry, installer, and runtime context for OpenMapX integrations",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./react": {
      "types": "./src/react.ts",
      "default": "./src/react.ts"
    },
    "./installer": {
      "types": "./src/installer.ts",
      "default": "./src/installer.ts"
    },
    "./strings": {
      "types": "./strings/index.ts",
      "default": "./strings/index.ts"
    }
  },
  "scripts": {
    "test": "vitest run",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@openmapx/core": "workspace:^",
    "@openmapx/mobility-core": "workspace:^",
    "@openmapx/place-ids": "workspace:^",
    "@openmapx/poi-source-registry": "workspace:^",
    "intl-messageformat": "^11.2.8",
    "js-yaml": "^4.2.0",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "esbuild": "^0.28.0",
    "react": ">=19"
  },
  "peerDependenciesMeta": {
    "esbuild": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.9.2",
    "@types/react": "^19.2.17",
    "esbuild": "^0.28.0",
    "react": "19.2.6",
    "typescript": "^5.9.3",
    "vitest": "^4.1.8"
  }
}
