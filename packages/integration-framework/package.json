{
  "name": "@openmapx/integration-framework",
  "license": "Apache-2.0",
  "version": "1.0.0",
  "description": "Manifest validation, registry, installer, and runtime context for OpenMapX integrations",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./react": {
      "types": "./src/react.ts",
      "default": "./src/react.ts"
    },
    "./shared-mobility-provider": {
      "types": "./src/shared-mobility-provider-factory.ts",
      "default": "./src/shared-mobility-provider-factory.ts"
    },
    "./shared-mobility": {
      "types": "./src/shared-mobility/ids.ts",
      "default": "./src/shared-mobility/ids.ts"
    },
    "./installer": {
      "types": "./src/installer.ts",
      "default": "./src/installer.ts"
    },
    "./strings": {
      "types": "./strings/index.ts",
      "default": "./strings/index.ts"
    },
    "./context": {
      "types": "./src/context.ts",
      "default": "./src/context.ts"
    },
    "./contracts/routing-provider": {
      "types": "./src/contracts/routing-provider.ts",
      "default": "./src/contracts/routing-provider.ts"
    },
    "./contracts/transit-provider": {
      "types": "./src/contracts/transit-provider.ts",
      "default": "./src/contracts/transit-provider.ts"
    },
    "./cursor": {
      "types": "./src/cursor.ts",
      "default": "./src/cursor.ts"
    },
    "./http-error": {
      "types": "./src/http-error.ts",
      "default": "./src/http-error.ts"
    },
    "./provider-execution": {
      "types": "./src/provider-execution.ts",
      "default": "./src/provider-execution.ts"
    },
    "./query": {
      "types": "./src/query.ts",
      "default": "./src/query.ts"
    },
    "./upstream-runtime": {
      "types": "./src/upstream-runtime.ts",
      "default": "./src/upstream-runtime.ts"
    },
    "./provider-daily-budget": {
      "types": "./src/provider-daily-budget.ts",
      "default": "./src/provider-daily-budget.ts"
    },
    "./tile-proxy": {
      "types": "./src/tile-proxy.ts",
      "default": "./src/tile-proxy.ts"
    },
    "./testing": {
      "types": "./src/testing/index.ts",
      "default": "./src/testing/index.ts"
    },
    "./testing/nth": {
      "types": "./src/testing/nth.ts",
      "default": "./src/testing/nth.ts"
    },
    "./test/shared-mobility-provider": {
      "types": "./src/testing/shared-mobility-provider.ts",
      "default": "./src/testing/shared-mobility-provider.ts"
    }
  },
  "scripts": {
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@openmapx/air-quality": "workspace:^",
    "@openmapx/core": "workspace:^",
    "@openmapx/extension-contracts": "workspace:^",
    "@openmapx/mobility-core": "workspace:^",
    "@openmapx/place-ids": "workspace:^",
    "intl-messageformat": "^12.1.4",
    "p-map": "7.1.1",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "react": ">=19",
    "vitest": "^5.0.5"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "react": "19.3.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
