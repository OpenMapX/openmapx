{
  "name": "@openmapx/extension-cli",
  "version": "0.1.0",
  "description": "Standalone Apache-2.0 CLI for scaffolding, packaging, and validating OpenMapX integrations and services",
  "license": "Apache-2.0",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "openmapx-ext": "./dist/cli.js"
  },
  "files": [
    "dist",
    "templates"
  ],
  "scripts": {
    "build": "tsup",
    "check-types": "tsc --noEmit",
    "test": "cd ../.. && vitest run --project node packages/extension-cli/src/__tests__",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "commander": "^15.0.0"
  },
  "devDependencies": {
    "@openmapx/extension-contracts": "workspace:^",
    "@openmapx/integration-framework": "workspace:^",
    "@types/node": "^26.6.6",
    "tsup": "9.0.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OpenMapX/openmapx.git",
    "directory": "packages/extension-cli"
  },
  "homepage": "https://github.com/OpenMapX/openmapx"
}
