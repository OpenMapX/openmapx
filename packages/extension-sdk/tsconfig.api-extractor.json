{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": false,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@openmapx/core": ["dist-temp/packages/core/src/index.d.ts"],
      "@openmapx/core/*": ["dist-temp/packages/core/src/*.d.ts"],
      "@openmapx/integration-framework": [
        "dist-temp/packages/integration-framework/src/index.d.ts"
      ],
      "@openmapx/integration-framework/testing": [
        "dist-temp/packages/integration-framework/src/testing/index.d.ts"
      ],
      "@openmapx/mobility-core/attribution": [
        "dist-temp/packages/mobility-core/src/types/attribution.d.ts"
      ],
      "@openmapx/mobility-core/freshness": [
        "dist-temp/packages/mobility-core/src/types/freshness.d.ts"
      ],
      "@openmapx/mobility-core/result": ["dist-temp/packages/mobility-core/src/types/result.d.ts"],
      "@openmapx/mobility-core/transit": [
        "dist-temp/packages/mobility-core/src/types/transit.d.ts"
      ],
      "@openmapx/mobility-core/*": ["dist-temp/packages/mobility-core/src/*.d.ts"],
      "@openmapx/place-ids": ["dist-temp/packages/place-ids/src/index.d.ts"],
      "@openmapx/poi-source-registry": ["dist-temp/packages/poi-source-registry/src/index.d.ts"]
    }
  },
  "include": [
    "dist-temp/packages/extension-sdk/src/index.d.ts",
    "dist-temp/packages/extension-sdk/src/testing.d.ts"
  ]
}
