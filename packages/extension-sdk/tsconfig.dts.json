{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "dist-temp",
    "rootDir": "../..",
    "paths": {
      "@integrations/*": ["../../integrations/*"],
      "@openmapx/core": ["../../packages/core/src/index.ts"],
      "@openmapx/core/*": ["../../packages/core/src/*.ts"],
      "@openmapx/integration-framework": ["../../packages/integration-framework/src/index.ts"],
      "@openmapx/integration-framework/testing": [
        "../../packages/integration-framework/src/testing/index.ts"
      ],
      "@openmapx/mobility-core/*": [
        "../../packages/mobility-core/src/*.ts",
        "../../packages/mobility-core/src/types/*.ts"
      ],
      "@openmapx/mobility-core/types": [
        "../../packages/mobility-core/src/types/shared-mobility.ts"
      ],
      "@openmapx/place-ids": ["../../packages/place-ids/src/index.ts"],
      "@openmapx/poi-source-registry": ["../../packages/poi-source-registry/src/index.ts"],
      "@openmapx/extension-sdk": ["./src/index.ts"],
      "@openmapx/extension-sdk/testing": ["./src/testing.ts"]
    }
  },
  "include": ["src"]
}
