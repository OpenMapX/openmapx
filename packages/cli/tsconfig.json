{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "lib": ["ES2023", "DOM"],
    "types": ["node"],
    "paths": {
      "@integrations/*": ["../../integrations/*"],
      "@openmapx/integration-framework": ["../integration-framework/src/index.ts"],
      "@openmapx/mobility-core/*": ["../mobility-core/src/*.ts", "../mobility-core/src/types/*.ts"],
      "@openmapx/mobility-core/types": ["../mobility-core/src/types/shared-mobility.ts"]
    }
  },
  "include": ["src/**/*", "__tests__/**/*", "../../integrations/*/types.ts"]
}
