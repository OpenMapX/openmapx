{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "lib": ["ES2023", "DOM"],
    "types": ["node"],
    "paths": {
      "@integrations/*": ["../../integrations/*"]
    }
  },
  "include": ["src/**/*", "__tests__/**/*", "../../integrations/*/types.ts"]
}
