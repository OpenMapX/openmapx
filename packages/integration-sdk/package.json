{
  "name": "@openmapx/integration-sdk",
  "version": "0.1.0",
  "description": "Public SDK that OpenMapX extension backends import from the host",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./errors": {
      "types": "./src/errors.ts",
      "import": "./src/errors.ts",
      "default": "./src/errors.ts"
    },
    "./places": {
      "types": "./src/places.ts",
      "import": "./src/places.ts",
      "default": "./src/places.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./errors": {
        "types": "./dist/errors.d.ts",
        "import": "./dist/errors.js"
      },
      "./places": {
        "types": "./dist/places.d.ts",
        "import": "./dist/places.js"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "tsup",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@openmapx/air-quality": "workspace:^",
    "@openmapx/core": "workspace:^",
    "@openmapx/extension-contracts": "workspace:^",
    "@openmapx/integration-framework": "workspace:^",
    "@openmapx/mobility-core": "workspace:^",
    "@openmapx/place-ids": "workspace:^",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsup": "9.0.0",
    "typescript": "^6.0.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OpenMapX/openmapx.git",
    "directory": "packages/integration-sdk"
  },
  "homepage": "https://github.com/OpenMapX/openmapx"
}
