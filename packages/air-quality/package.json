{
  "name": "@openmapx/air-quality",
  "license": "Apache-2.0",
  "version": "1.0.0",
  "description": "Air-quality evidence, regional standards, jurisdiction, and selection for OpenMapX",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./server": {
      "types": "./src/server.ts",
      "default": "./src/server.ts"
    }
  },
  "scripts": {
    "check-types": "tsc --noEmit",
    "generate:jurisdiction": "tsx src/jurisdiction/generate.ts"
  },
  "dependencies": {
    "@turf/boolean-point-in-polygon": "^7.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.3.0",
    "esbuild": "^0.28.2",
    "shapefile": "0.6.6",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
