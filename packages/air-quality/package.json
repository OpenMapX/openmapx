{
  "name": "@openmapx/air-quality",
  "license": "Apache-2.0",
  "version": "1.0.0",
  "description": "Air-quality evidence, regional standards, jurisdiction, and selection for OpenMapX",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./server": {
      "types": "./src/server.ts",
      "default": "./src/server.ts"
    },
    "./ids": {
      "types": "./src/ids.ts",
      "default": "./src/ids.ts"
    },
    "./api": {
      "types": "./src/api.ts",
      "default": "./src/api.ts"
    },
    "./types": {
      "types": "./src/types.ts",
      "default": "./src/types.ts"
    },
    "./forecast": {
      "types": "./src/forecast.ts",
      "default": "./src/forecast.ts"
    },
    "./selection": {
      "types": "./src/selection.ts",
      "default": "./src/selection.ts"
    },
    "./standards/adapter": {
      "types": "./src/standards/adapter.ts",
      "default": "./src/standards/adapter.ts"
    },
    "./standards/registry": {
      "types": "./src/standards/registry.ts",
      "default": "./src/standards/registry.ts"
    },
    "./normalize/coherence": {
      "types": "./src/normalize/coherence.ts",
      "default": "./src/normalize/coherence.ts"
    },
    "./normalize/units": {
      "types": "./src/normalize/units.ts",
      "default": "./src/normalize/units.ts"
    }
  },
  "scripts": {
    "check-types": "tsc --noEmit",
    "generate:jurisdiction": "tsx src/jurisdiction/generate.ts"
  },
  "dependencies": {
    "@openmapx/mobility-core": "workspace:*",
    "@turf/boolean-point-in-polygon": "^7.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "shapefile": "0.6.6",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
