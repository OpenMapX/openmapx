{
  "id": "overlay-live-transit",
  "version": "1.0.0",
  "author": "OpenMapX",
  "license": "MIT",
  "documentation": "https://developer.entur.org/pages-real-time-vehicle/",
  "domains": ["map-overlay", "live-transit"],
  "frontend": {
    "mapLayer": true,
    "legend": true,
    "layerSelector": {
      "group": "map-details",
      "labelKey": "liveTransit",
      "icon": "train",
      "preview": "preview.svg"
    },
    "overlay": {
      "excludes": [],
      "minZoom": 12
    }
  },
  "backend": {
    "routes": true
  },
  "configSchema": {
    "type": "object",
    "properties": {
      "enabled": {
        "type": "boolean",
        "default": true
      },
      "providerOrder": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "maxItems": 64,
        "default": []
      }
    }
  },
  "quality": "built-in"
}
