{
  "id": "overlay-live-transit",
  "version": "1.0.0",
  "author": "OpenMapX",
  "license": "MIT",
  "documentation": "https://developer.entur.org/pages-real-time-vehicle/",
  "subjectData": {
    "storesPersonalData": false,
    "strategy": "not_personal",
    "registrationIds": [],
    "operatorInstructions": null
  },
  "domains": ["map-overlay", "live-transit"],
  "frontend": {
    "mapLayer": true,
    "legend": true,
    "panel": false,
    "layerSelector": {
      "group": "map-details",
      "labelKey": "liveTransit",
      "icon": "train",
      "preview": "preview.svg"
    },
    "overlay": {
      "excludes": [],
      "minZoom": 12
    }
  },
  "backend": {
    "routes": true
  },
  "configSchema": {
    "type": "object",
    "properties": {
      "enabled": {
        "type": "boolean",
        "default": true
      }
    }
  },
  "quality": "built-in",
  "category": "Transit"
}
