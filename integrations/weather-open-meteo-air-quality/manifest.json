{
  "id": "weather-open-meteo-air-quality",
  "version": "1.0.0",
  "author": "OpenMapX",
  "license": "MIT",
  "documentation": "https://open-meteo.com/en/docs/air-quality-api",
  "domains": ["weather"],
  "dependencies": ["weather"],
  "frontend": {
    "mapLayer": false,
    "legend": false,
    "panel": false
  },
  "backend": {
    "routes": true
  },
  "configSchema": {
    "type": "object",
    "properties": {
      "enabled": {
        "type": "boolean",
        "default": true
      }
    }
  },
  "healthCheck": {
    "type": "http",
    "url": "https://air-quality-api.open-meteo.com/v1/air-quality?latitude=0&longitude=0&current=european_aqi"
  },
  "quality": "built-in",
  "category": "Weather",
  "dataSources": [
    {
      "sourceId": "open-meteo-air-quality",
      "name": "Open-Meteo Air Quality",
      "url": "https://air-quality-api.open-meteo.com/",
      "license": "CC BY 4.0 (free tier: non-commercial only)",
      "licenseUrl": "https://open-meteo.com/en/terms",
      "commercialUse": "no",
      "notes": "Open-Meteo's free tier is licensed for non-commercial use only; commercial use requires a paid Open-Meteo API plan.",
      "providerCountry": "CH",
      "providerPrivacyUrl": "https://open-meteo.com/en/terms",
      "endUserExposure": "server-only",
      "personalData": false,
      "cookies": false,
      "dpaAvailable": false
    }
  ]
}
