{
  "id": "transit-opentransportdata-ch",
  "version": "1.0.0",
  "author": "OpenMapX",
  "license": "MIT",
  "quality": "built-in",
  "domains": ["transit"],
  "category": "Transit",
  "configSchema": {
    "type": "object",
    "properties": {
      "enabled": {
        "type": "boolean",
        "default": true
      },
      "apiKey": {
        "type": "string",
        "title": "OpenTransportData CH API Key",
        "description": "API key from api-manager.opentransportdata.swiss for OJP, live alerts, GTFS-RT and optional formation access.",
        "x-openmapx-secret": true,
        "x-openmapx-sharedSecretName": "opentransportdata-ch-api-key",
        "x-openmapx-setup": {
          "url": "https://api-manager.opentransportdata.swiss/",
          "urlLabel": "Get opentransportdata.swiss API key",
          "steps": [
            "Register at api-manager.opentransportdata.swiss with your email, name, and a password.",
            "Create an application in your account.",
            "On the API Manager overview, select the API you need (e.g. OJP 2.0, GTFS-RT alerts), open it, and assign it to your app.",
            "Copy the generated key."
          ],
          "cost": "Free with registration.",
          "notes": "Only one key can be created per API, and a revoked key cannot be self-recreated for the same API. Sent as an 'Authorization: Bearer <key>' header. Support: opendata@sbb.ch."
        }
      },
      "requestorRef": {
        "type": "string",
        "title": "RequestorRef",
        "description": "Requestor identifier sent in OJP XML requests.",
        "default": "OpenMapX"
      },
      "requestLanguage": {
        "type": "string",
        "title": "Request language",
        "description": "Preferred response language for OJP requests.",
        "default": "de"
      },
      "ojpEndpoint": {
        "type": "string",
        "title": "OJP endpoint",
        "description": "Primary Swiss OJP 2.0 endpoint.",
        "format": "url",
        "default": "https://api.opentransportdata.swiss/ojp20"
      },
      "ojpFareEndpoint": {
        "type": "string",
        "title": "OJP Fare endpoint",
        "description": "Swiss OJP fare endpoint used for optional itinerary price lookup.",
        "format": "url",
        "default": "https://api.opentransportdata.swiss/ojpfare"
      },
      "fallbackEndpoint": {
        "type": "string",
        "title": "Fallback OJP endpoint",
        "description": "Fallback Swiss OJP endpoint used if the primary endpoint fails.",
        "format": "url",
        "default": "https://api.opentransportdata.swiss/ojp2020"
      },
      "gtfsSaEndpoint": {
        "type": "string",
        "title": "GTFS-SA endpoint",
        "description": "Swiss national GTFS Realtime Service Alerts endpoint.",
        "format": "url",
        "default": "https://api.opentransportdata.swiss/la/gtfs-sa"
      },
      "gtfsRtEndpoint": {
        "type": "string",
        "title": "GTFS-RT endpoint",
        "description": "Swiss national GTFS Realtime Trip Updates endpoint.",
        "format": "url",
        "default": "https://api.opentransportdata.swiss/la/gtfs-rt"
      },
      "siriSxEndpoint": {
        "type": "string",
        "title": "SIRI-SX endpoint",
        "description": "Swiss national planned/full SIRI Situation Exchange feed.",
        "format": "url",
        "default": "https://api.opentransportdata.swiss/la/siri-sx"
      },
      "siriSxUnplannedEndpoint": {
        "type": "string",
        "title": "SIRI-SX unplanned endpoint",
        "description": "Swiss national unplanned/disruption-only SIRI Situation Exchange feed.",
        "format": "url",
        "default": "https://api.opentransportdata.swiss/la/siri-sx-unplanned"
      },
      "formationEndpoint": {
        "type": "string",
        "title": "Formation endpoint",
        "description": "Swiss train formation API base URL for coach composition details.",
        "format": "url",
        "default": "https://api.opentransportdata.swiss/formation"
      },
      "userAgent": {
        "type": "string",
        "title": "User-Agent override",
        "description": "Optional custom User-Agent for Swiss API calls."
      }
    }
  },
  "backend": {
    "routes": false
  },
  "healthCheck": [
    {
      "name": "OJP",
      "type": "ping",
      "url": "https://api.opentransportdata.swiss/ojp20",
      "urlTemplate": "${ojpEndpoint}",
      "headers": {
        "Authorization": "Bearer ${apiKey}"
      },
      "requiredConfigKeys": ["apiKey"]
    },
    {
      "name": "OJP geometry / OSM attribution",
      "type": "http",
      "url": "https://www.openstreetmap.org/api/0.6/capabilities"
    },
    {
      "name": "GTFS static timetable",
      "type": "http",
      "url": "https://opentransportdata.swiss/en/cookbook/timetable-cookbook/gtfs/"
    },
    {
      "name": "GTFS Realtime Service Alerts",
      "type": "http",
      "url": "https://api.opentransportdata.swiss/la/gtfs-sa",
      "urlTemplate": "${gtfsSaEndpoint}",
      "headers": {
        "Authorization": "Bearer ${apiKey}"
      },
      "requiredConfigKeys": ["apiKey"]
    },
    {
      "name": "GTFS Realtime Trip Updates",
      "type": "http",
      "url": "https://api.opentransportdata.swiss/la/gtfs-rt",
      "urlTemplate": "${gtfsRtEndpoint}",
      "headers": {
        "Authorization": "Bearer ${apiKey}"
      },
      "requiredConfigKeys": ["apiKey"]
    },
    {
      "name": "SIRI Situation Exchange",
      "type": "http",
      "url": "https://api.opentransportdata.swiss/la/siri-sx",
      "urlTemplate": "${siriSxEndpoint}",
      "headers": {
        "Authorization": "Bearer ${apiKey}"
      },
      "requiredConfigKeys": ["apiKey"]
    },
    {
      "name": "OJP Fare",
      "type": "ping",
      "url": "https://api.opentransportdata.swiss/ojpfare",
      "urlTemplate": "${ojpFareEndpoint}",
      "headers": {
        "Authorization": "Bearer ${apiKey}"
      },
      "requiredConfigKeys": ["apiKey"]
    },
    {
      "name": "Train formation",
      "type": "ping",
      "url": "https://api.opentransportdata.swiss/formation",
      "urlTemplate": "${formationEndpoint}",
      "headers": {
        "Authorization": "Bearer ${apiKey}"
      },
      "requiredConfigKeys": ["apiKey"]
    },
    {
      "name": "Occupancy forecast",
      "type": "http",
      "url": "https://data.opentransportdata.swiss/en/dataset/occupancy-forecast-json-dataset/permalink"
    },
    {
      "name": "GO realtime",
      "type": "http",
      "url": "https://data.opentransportdata.swiss/dataset/27aba9bd-59ed-4d7c-bc71-a3813d1d1799/resource/83b8b8d0-e345-453b-857e-1192d48c4c64/download/go-realtime.csv"
    },
    {
      "name": "GO SIRI-SX",
      "type": "http",
      "url": "https://data.opentransportdata.swiss/dataset/b3ac097b-ff72-4a1f-9d69-76e72962d769/resource/a8312f3a-18a6-4e92-9906-bbb623a24369/download/go-siri-sx.csv"
    },
    {
      "name": "Master data",
      "type": "http",
      "url": "https://data.opentransportdata.swiss/en/dataset/service-points-actual-date"
    }
  ],
