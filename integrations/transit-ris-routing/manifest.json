{
  "id": "transit-ris-routing",
  "version": "1.0.0",
  "author": "OpenMapX",
  "license": "MIT",
  "quality": "built-in",
  "domains": ["transit"],
  "category": "Transit",
  "envVars": ["DB_RIS_CLIENT_ID", "DB_RIS_API_KEY"],
  "configSchema": {
    "type": "object",
    "properties": {
      "enabled": {
        "type": "boolean",
        "default": true
      },
      "clientId": {
        "type": "string",
        "title": "Client ID",
        "description": "Deutsche Bahn RIS API client ID."
      },
      "apiKey": {
        "type": "string",
        "title": "API Key",
        "description": "Deutsche Bahn RIS API key.",
        "x-openmapx-secret": true,
        "x-openmapx-sharedSecretName": "db-ris-api-key"
      }
    }
  },
  "backend": {
    "routes": false
  },
  "healthCheck": {
    "type": "ping",
    "url": "https://apis.deutschebahn.com/db/apis/ris-routing/v2",
    "requiredEnvVars": ["DB_RIS_CLIENT_ID", "DB_RIS_API_KEY"]
  },
  "attribution": [
    {
      "name": "Deutsche Bahn RIS",
      "url": "https://developers.deutschebahn.com/",
      "license": "Proprietary"
    }
  ],
  "privacy": [
    {
      "providerCountry": "DE",
      "providerPrivacyUrl": "https://www.bahn.de/datenschutz",
      "personalData": false
    }
  ]
}
