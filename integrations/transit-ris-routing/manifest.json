{
  "id": "transit-ris-routing",
  "version": "1.0.0",
  "author": "OpenMapX",
  "license": "MIT",
  "quality": "built-in",
  "domains": ["transit"],
  "category": "Transit",
  "configSchema": {
    "type": "object",
    "properties": {
      "enabled": {
        "type": "boolean",
        "default": true
      },
      "clientId": {
        "type": "string",
        "title": "Client ID",
        "description": "Deutsche Bahn RIS API client ID.",
        "x-openmapx-secret": true
      },
      "apiKey": {
        "type": "string",
        "title": "API Key",
        "description": "Deutsche Bahn RIS API key.",
        "x-openmapx-secret": true,
        "x-openmapx-sharedSecretName": "db-ris-api-key"
      }
    }
  },
  "backend": {
    "routes": false
  },
  "healthCheck": {
    "type": "ping",
    "url": "https://apis.deutschebahn.com/db/apis/ris-routing/v2",
    "requiredConfigKeys": ["clientId", "apiKey"]
  },
  "dataSources": [
    {
      "sourceId": "db-ris-routing",
      "name": "Deutsche Bahn RIS Routing",
      "url": "https://apis.deutschebahn.com/",
      "license": "Proprietary (bilateral license)",
      "licenseUrl": "https://developers.deutschebahn.com/db-api-marketplace/apis/nutzungsbedingungen",
      "commercialUse": "conditional",
      "providerCountry": "DE",
      "providerPrivacyUrl": "https://developers.deutschebahn.com/db-api-marketplace/apis/privacypolicy",
      "endUserExposure": "server-only",
      "personalData": false,
      "cookies": false,
      "dpaAvailable": false
    }
  ],
  "dependencies": ["transit"]
}
