{
  "id": "photos-flickr",
  "version": "1.0.0",
  "author": "OpenMapX",
  "license": "MIT",
  "domains": ["photos"],
  "dependencies": ["photos"],
  "backend": {
    "routes": false
  },
  "configSchema": {
    "type": "object",
    "properties": {
      "enabled": {
        "type": "boolean",
        "default": true
      },
      "apiKey": {
        "type": "string",
        "title": "API Key",
        "description": "Flickr API key.",
        "x-openmapx-secret": true
      }
    }
  },
  "healthCheck": {
    "type": "http",
    "urlTemplate": "https://api.flickr.com/services/rest/?method=flickr.photos.search&api_key=${apiKey}&lat=0&lon=0&radius=1&per_page=1&format=json&nojsoncallback=1",
    "requiredConfigKeys": ["apiKey"]
  },
  "quality": "built-in",
  "category": "External",
  "dataSources": [
    {
      "sourceId": "flickr",
      "name": "Flickr",
      "url": "https://www.flickr.com/",
      "license": "Proprietary",
      "licenseUrl": "https://www.flickr.com/help/terms/api",
      "commercialUse": "conditional",
      "providerCountry": "US",
      "providerPrivacyUrl": "https://www.flickr.com/help/privacy",
      "endUserExposure": "server-only",
      "personalData": false,
      "cookies": false,
      "dpaAvailable": true,
      "dpaUrl": "https://www.flickr.com/help/dpa"
    }
  ]
}
