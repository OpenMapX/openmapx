{
  "id": "photos-flickr",
  "version": "1.0.0",
  "author": "OpenMapX",
  "license": "MIT",
  "domains": ["photos"],
  "backend": {
    "routes": false
  },
  "configSchema": {
    "type": "object",
    "properties": {
      "enabled": {
        "type": "boolean",
        "default": true
      },
      "apiKey": {
        "type": "string",
        "title": "API Key",
        "description": "Flickr API key.",
        "x-openmapx-secret": true
      }
    }
  },
  "envVars": ["FLICKR_API_KEY"],
  "healthCheck": {
    "type": "http",
    "urlTemplate": "https://api.flickr.com/services/rest/?method=flickr.photos.search&api_key=${FLICKR_API_KEY}&lat=0&lon=0&radius=1&per_page=1&format=json&nojsoncallback=1",
    "requiredEnvVars": ["FLICKR_API_KEY"]
  },
  "quality": "built-in",
  "category": "External",
  "attribution": [
    {
      "name": "Flickr",
      "url": "https://www.flickr.com/",
      "license": "Various (per photo)",
      "licenseUrl": "https://www.flickr.com/creativecommons/"
    }
  ],
  "privacy": [
    {
      "providerCountry": "US",
      "providerPrivacyUrl": "https://www.flickr.com/help/privacy",
      "personalData": false
    }
  ]
}
