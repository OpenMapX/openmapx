{
  "id": "geocoding-nominatim",
  "version": "1.0.0",
  "author": "OpenMapX",
  "license": "MIT",
  "domains": ["geocoding"],
  "backend": {
    "routes": false
  },
  "configSchema": {
    "type": "object",
    "properties": {
      "enabled": {
        "type": "boolean",
        "default": true
      }
    }
  },
  "envVars": [],
  "healthCheck": {
    "type": "http",
    "url": "https://nominatim.openstreetmap.org/status",
    "category": "Geocoding"
  },
  "quality": "built-in",
  "attribution": [
    {
      "name": "Nominatim/OSM",
      "url": "https://nominatim.openstreetmap.org/",
      "license": "ODbL"
    }
  ],
  "privacy": [
    {
      "providerCountry": "DE",
      "providerPrivacyUrl": "https://nominatim.openstreetmap.org/",
      "personalData": false
    }
  ]
}
