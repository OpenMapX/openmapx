{
  "id": "geocoding-nominatim",
  "version": "1.0.0",
  "author": "OpenMapX",
  "license": "MIT",
  "subjectData": {
    "storesPersonalData": false,
    "strategy": "not_personal",
    "registrationIds": [],
    "operatorInstructions": null
  },
  "domains": ["geocoding"],
  "dependencies": ["geocoding"],
  "infrastructure": {
    "dataRequirements": ["osm-pbf"]
  },
  "backend": {
    "routes": false
  },
  "configSchema": {
    "type": "object",
    "properties": {
      "enabled": {
        "type": "boolean",
        "default": true
      },
      "endpoint": {
        "type": "string",
        "title": "Nominatim endpoint URL",
        "description": "Base URL of the Nominatim server. Leave blank to use the public OSM instance or a self-hosted service resolved via the `nominatim` capability.",
        "format": "url"
      }
    }
  },
  "endpointConfigKeys": {
    "nominatim": "endpoint"
  },
  "healthCheck": {
    "type": "http",
    "urlTemplate": "${endpoint:nominatim}/status"
  },
  "quality": "built-in",
  "category": "Geocoding",
  "dataSources": [
    {
      "sourceId": "nominatim",
      "name": "Nominatim (OpenStreetMap)",
      "url": "https://nominatim.openstreetmap.org/",
      "attribution": "© <a href=\"https://www.openstreetmap.org/copyright\">OpenStreetMap contributors</a>",
      "commercialUse": "yes",
      "providerCountry": "UK",
      "providerPrivacyUrl": "https://osmfoundation.org/wiki/Privacy_Policy",
      "endUserExposure": "server-only",
      "personalData": false,
      "cookies": false,
      "dpaAvailable": false,
      "licensing": {
        "version": 1,
        "bindings": [
          {
            "scope": "data",
            "subject": "Nominatim (OpenStreetMap) material",
            "license": {
              "kind": "spdx",
              "expression": "ODbL-1.0",
              "url": "https://www.openstreetmap.org/copyright"
            }
          }
        ],
        "declarations": [
          {
            "text": "ODbL-1.0",
            "url": "https://www.openstreetmap.org/copyright"
          }
        ]
      }
    }
  ],
  "requires": [
    {
      "service": "nominatim",
      "optional": true
    }
  ]
}
