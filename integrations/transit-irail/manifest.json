{
  "id": "transit-irail",
  "version": "1.0.0",
  "author": "OpenMapX",
  "license": "MIT",
  "quality": "built-in",
  "domains": ["transit"],
  "category": "Transit",
  "envVars": [],
  "configSchema": {
    "type": "object",
    "properties": {
      "enabled": {
        "type": "boolean",
        "default": true,
        "description": "Enable iRail transit integration"
      }
    }
  },
  "backend": {
    "routes": false
  },
  "healthCheck": {
    "type": "http",
    "url": "https://api.irail.be/stations/?format=json&lang=en"
  },
  "dataSources": [
    {
      "name": "iRail",
      "url": "https://api.irail.be/",
      "license": "AGPL-3.0 (software); CC0 (log data)",
      "licenseUrl": "https://hello.irail.be/api/",
      "attribution": "Belgian rail data by <a href=\"https://irail.be/\">iRail</a>",
      "commercialUse": "yes",
      "providerCountry": "BE",
      "providerPrivacyUrl": "-",
      "endUserExposure": "server-only",
      "personalData": false,
      "cookies": false,
      "dpaAvailable": false
    }
  ],
  "dependencies": ["transit"]
}
