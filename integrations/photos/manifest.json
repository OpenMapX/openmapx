{
  "id": "photos",
  "version": "1.0.0",
  "author": "OpenMapX",
  "license": "MIT",
  "domains": ["photos"],
  "dependencies": ["geocoding"],
  "backend": { "routes": true },
  "healthCheck": [
    {
      "name": "OpenStreetMap",
      "type": "http",
      "url": "https://www.openstreetmap.org/api/0.6/capabilities"
    },
    {
      "name": "Google Photos",
      "type": "ping",
      "url": "https://photos.google.com/"
    }
  ],
  "quality": "built-in",
  "category": "External",
  "dataSources": [
    {
      "sourceId": "osm",
      "name": "OpenStreetMap",
      "url": "https://www.openstreetmap.org/",
      "license": "ODbL 1.0",
      "licenseUrl": "https://opendatacommons.org/licenses/odbl/1-0/",
      "attribution": "© <a href=\"https://www.openstreetmap.org/copyright\">OpenStreetMap contributors</a>",
      "commercialUse": "yes",
      "providerCountry": "UK",
      "providerPrivacyUrl": "https://osmfoundation.org/wiki/Privacy_Policy",
      "endUserExposure": "server-only",
      "personalData": false,
      "cookies": false,
      "dpaAvailable": false
    },
    {
      "sourceId": "google-photos",
      "name": "Google Photos",
      "url": "https://photos.google.com/",
      "license": "Per-file (copyright holder)",
      "commercialUse": "no",
      "providerCountry": "US",
      "providerPrivacyUrl": "https://policies.google.com/privacy",
      "endUserExposure": "server-only",
      "personalData": false,
      "cookies": false,
      "dpaAvailable": false
    }
  ]
