{
  "id": "overlay-hiking",
  "version": "1.0.0",
  "author": "OpenMapX",
  "license": "MIT",
  "documentation": "https://waymarkedtrails.org/",
  "subjectData": {
    "storesPersonalData": false,
    "strategy": "not_personal",
    "registrationIds": [],
    "operatorInstructions": null
  },
  "domains": ["map-overlay"],
  "frontend": {
    "mapLayer": true,
    "legend": true,
    "panel": false,
    "layerSelector": {
      "group": "map-details",
      "labelKey": "hiking",
      "icon": "hiking",
      "quickSelector": true,
      "preview": "preview.svg"
    },
    "overlay": {
      "excludes": ["street-level-imagery", "winter-sports"]
    }
  },
  "backend": {
    "routes": true
  },
  "configSchema": {
    "type": "object",
    "properties": {
      "enabled": {
        "type": "boolean",
        "default": true
      },
      "tileUrl": {
        "type": "string",
        "title": "Tile URL template",
        "description": "Tile URL with `{z}/{x}/{y}` placeholders. Defaults to the Waymarked Trails hiking tileset.",
        "format": "url"
      }
    }
  },
  "healthCheck": [
    {
      "name": "Waymarked Trails",
      "type": "http",
      "url": "https://hiking.waymarkedtrails.org/api/v1/list/search?query=test&limit=1"
    },
    {
      "name": "Refuges.info",
      "type": "http",
      "url": "https://www.refuges.info/api/bbox?bbox=6.85,45.9,6.86,45.91&format=geojson&detail=simple&nb_points=1"
    },
    {
      "name": "OpenStreetMap Overpass",
      "type": "http",
      "urlTemplate": "${endpoint:overpass}/api/status"
    }
  ],
  "quality": "built-in",
  "category": "Map Overlays",
  "dataSources": [
    {
      "sourceId": "waymarked-trails",
      "name": "Waymarked Trails",
      "url": "https://waymarkedtrails.org/",
      "attribution": "© <a href=\"https://waymarkedtrails.org/\">waymarkedtrails.org</a>, © <a href=\"https://www.openstreetmap.org/copyright\">OpenStreetMap contributors</a>",
      "commercialUse": "yes",
      "providerCountry": "DE",
      "providerPrivacyUrl": "-",
      "endUserExposure": "server-only",
      "personalData": false,
      "cookies": false,
      "dpaAvailable": false,
      "licensing": {
        "version": 1,
        "bindings": [
          {
            "scope": "imagery",
            "subject": "Waymarked Trails tiles",
            "license": {
              "kind": "spdx",
              "expression": "CC-BY-SA-3.0-DE"
            }
          },
          {
            "scope": "data",
            "subject": "Underlying OSM database",
            "license": {
              "kind": "spdx",
              "expression": "ODbL-1.0"
            }
          }
        ],
        "declarations": [
          {
            "text": "CC-BY-SA-3.0-DE (tiles); ODbL-1.0 (OSM data)",
            "url": "https://hiking.waymarkedtrails.org/#help-legal"
          }
        ]
      }
    },
    {
      "sourceId": "refuges-info",
      "name": "Refuges.info",
      "url": "https://www.refuges.info/",
      "commercialUse": "yes",
      "providerCountry": "FR",
      "providerPrivacyUrl": "https://www.refuges.info/wiki/mentions-legales",
      "endUserExposure": "server-only",
      "personalData": false,
      "cookies": false,
      "dpaAvailable": false,
      "licensing": {
        "version": 1,
        "bindings": [
          {
            "scope": "data",
            "subject": "Refuges.info material",
            "license": {
              "kind": "custom",
              "namespace": "publisher:refuges-info",
              "id": "LicenseRef-CC-BY-SA-2.0-FR",
              "name": "Creative Commons Attribution-ShareAlike 2.0 France",
              "url": "https://www.refuges.info/wiki/licence"
            }
          }
        ],
        "declarations": [
          {
            "text": "CC BY-SA 2.0 FR",
            "url": "https://www.refuges.info/wiki/licence"
          }
        ]
      }
    },
    {
      "sourceId": "osm",
      "name": "OpenStreetMap",
      "url": "https://www.openstreetmap.org/",
      "attribution": "© <a href=\"https://www.openstreetmap.org/copyright\">OpenStreetMap contributors</a>",
      "commercialUse": "yes",
      "providerCountry": "UK",
      "providerPrivacyUrl": "https://osmfoundation.org/wiki/Privacy_Policy",
      "endUserExposure": "server-only",
      "personalData": false,
      "cookies": false,
      "dpaAvailable": false,
      "licensing": {
        "version": 1,
        "bindings": [
          {
            "scope": "data",
            "subject": "OpenStreetMap material",
            "license": {
              "kind": "spdx",
              "expression": "ODbL-1.0",
              "url": "https://opendatacommons.org/licenses/odbl/1-0/"
            }
          }
        ],
        "declarations": [
          {
            "text": "ODbL-1.0",
            "url": "https://opendatacommons.org/licenses/odbl/1-0/"
          }
        ]
      }
    }
  ],
  "requires": [
    {
      "service": "overpass",
      "optional": true
    }
  ]
}
