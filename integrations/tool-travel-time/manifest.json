{
  "id": "tool-travel-time",
  "version": "1.0.0",
  "author": "OpenMapX",
  "license": "MIT",
  "domains": ["map-overlay"],
  "infrastructure": {
    "dockerProfile": "routing",
    "services": ["valhalla"],
    "dataRequirements": ["osm-pbf"]
  },
  "frontend": {
    "mapLayer": true,
    "legend": true,
    "panel": false,
    "layerSelector": {
      "group": "map-tools",
      "labelKey": "travelTime",
      "icon": "timer"
    },
    "overlay": {
      "excludes": []
    }
  },
  "backend": {
    "routes": false
  },
  "configSchema": {
    "type": "object",
    "properties": {
      "enabled": {
        "type": "boolean",
        "default": true
      }
    }
  },
  "envVars": [],
  "healthCheck": {
    "type": "ping",
    "urlTemplate": "${VALHALLA_URL}/status",
    "url": "https://valhalla1.openstreetmap.de/status"
  },
  "quality": "built-in",
  "category": "Map Tools",
  "dataSources": [
    {
      "name": "Valhalla (Isochrone)",
      "url": "https://github.com/valhalla/valhalla",
      "license": "MIT (software); fair-use demo server",
      "licenseUrl": "https://github.com/valhalla/valhalla/blob/master/COPYING",
      "attribution": "Isochrones by <a href=\"https://github.com/valhalla/valhalla\">Valhalla</a>, Data © <a href=\"https://www.openstreetmap.org/copyright\">OSM contributors</a>",
      "commercialUse": "yes",
      "providerCountry": "DE",
      "providerPrivacyUrl": "https://www.fossgis.de/datenschutzerkl%C3%A4rung/",
      "endUserExposure": "server-only",
      "personalData": false,
      "cookies": false,
      "dpaAvailable": false
    }
  ]
}
