{
  "id": "overlay-weather",
  "version": "1.0.0",
  "author": "OpenMapX",
  "license": "MIT",
  "documentation": "https://open-meteo.com/en/docs",
  "subjectData": {
    "storesPersonalData": false,
    "strategy": "not_personal",
    "registrationIds": [],
    "operatorInstructions": null
  },
  "domains": ["map-overlay"],
  "frontend": {
    "mapLayer": true,
    "legend": true,
    "panel": false,
    "layerSelector": {
      "group": "map-details",
      "labelKey": "weather",
      "icon": "cloud",
      "iconPath": "M19.35 10.04A7.49 7.49 0 0012 4C9.11 4 6.6 5.64 5.35 8.04A5.994 5.994 0 000 14c0 3.31 2.69 6 6 6h13c2.76 0 5-2.24 5-5 0-2.64-2.05-4.78-4.65-4.96z",
      "preview": "preview.svg"
    },
    "overlay": {
      "excludes": ["air-quality", "environment"]
    }
  },
  "backend": {
    "routes": true
  },
  "configSchema": {
    "type": "object",
    "properties": {
      "enabled": {
        "type": "boolean",
        "default": true
      },
      "owmApiKey": {
        "type": "string",
        "title": "OpenWeatherMap API Key",
        "description": "Required for temperature/cloud/wind/pressure tile layers. Radar works without it.",
        "x-openmapx-secret": true,
        "x-openmapx-setup": {
          "url": "https://home.openweathermap.org/users/sign_up",
          "urlLabel": "Sign up for OpenWeather",
          "steps": [
            "Create a free account at home.openweathermap.org using your email.",
            "Confirm your email via the verification link.",
            "Sign in and open the 'API keys' tab (home.openweathermap.org/api_keys).",
            "Copy the default key or generate a new one."
          ],
          "cost": "Free plan: 60 calls/minute, 1,000,000 calls/month.",
          "notes": "Optional — the radar overlay works without it; the key only enables the temperature/cloud/wind/pressure tile layers. Same OpenWeather account/key as weather-openweathermap. New keys activate up to 2 hours after registration."
        }
      }
    }
  },
  "quality": "built-in",
  "category": "Data Overlays",
  "healthCheck": [
    {
      "name": "RainViewer",
      "type": "http",
      "url": "https://api.rainviewer.com/public/weather-maps.json"
    },
    {
      "name": "OpenWeatherMap",
      "type": "http",
      "urlTemplate": "https://tile.openweathermap.org/map/temp_new/0/0/0.png?appid=${owmApiKey}",
      "requiredConfigKeys": ["owmApiKey"]
    },
    {
      "name": "Open-Meteo",
      "type": "ping",
      "url": "https://api.open-meteo.com/v1/forecast?latitude=0&longitude=0&current=temperature_2m"
    }
  ],
  "dataSources": [
    {
      "sourceId": "rainviewer",
      "name": "RainViewer",
      "url": "https://www.rainviewer.com/",
      "commercialUse": "no",
      "providerCountry": "US",
      "providerPrivacyUrl": "https://www.rainviewer.com/privacy.html",
      "endUserExposure": "proxied",
      "personalData": false,
      "cookies": false,
      "dpaAvailable": false,
      "licensing": {
        "version": 1,
        "bindings": [
          {
            "scope": "data",
            "subject": "RainViewer material",
            "license": {
              "kind": "unknown"
            }
          },
          {
            "scope": "service",
            "subject": "RainViewer access/account contract",
            "license": {
              "kind": "unknown",
              "url": "https://www.rainviewer.com/terms.html"
            },
            "attribution": {
              "placement": "visible",
              "surfaces": ["map"],
              "basis": "recommendation",
              "reviewedAt": "2026-10-14",
              "evidenceUrls": ["https://www.rainviewer.com/api.html"],
              "reason": "FAQ says visible mandatory credit; same page terms softer request wording",
              "compactText": "<a href=\"https://www.rainviewer.com/\">RainViewer</a>"
            }
          }
        ],
        "declarations": [
          {
            "text": "Proprietary (personal/educational use only)",
            "url": "https://www.rainviewer.com/terms.html"
          }
        ]
      }
    },
    {
      "sourceId": "openweathermap",
      "name": "OpenWeather",
      "url": "https://openweathermap.org/",
      "attribution": "© <a href=\"https://openweathermap.org/\">OpenWeather</a>",
      "commercialUse": "yes",
      "providerCountry": "UK",
      "providerPrivacyUrl": "https://openweather.co.uk/privacy-policy",
      "endUserExposure": "proxied",
      "personalData": false,
      "cookies": false,
      "dpaAvailable": false,
      "licensing": {
        "version": 1,
        "bindings": [
          {
            "scope": "data",
            "subject": "OpenWeather material",
            "license": {
              "kind": "spdx",
              "expression": "ODbL-1.0",
              "url": "https://opendatacommons.org/licenses/odbl/1-0/"
            },
            "attribution": {
              "placement": "visible",
              "surfaces": ["content", "map"],
              "basis": "provider-terms",
              "reviewedAt": "2026-10-14",
              "evidenceUrls": ["https://docs.openweather.co.uk/faq"],
              "reason": "Standard Free-Professional plan; accepted enterprise contract unreviewed",
              "compactText": "Weather data provided by <a href=\"https://openweathermap.org/\">OpenWeather</a> (<a href=\"https://opendatacommons.org/licenses/odbl/1-0/\">ODbL-1.0</a>)",
              "logo": "openweather"
            }
          }
        ],
        "declarations": [
          {
            "text": "ODbL-1.0",
            "url": "https://openweathermap.org/full-price"
          }
        ]
      }
    }
  ]
}
