{
  "id": "live-transit-entur",
  "version": "1.0.0",
  "author": "OpenMapX",
  "license": "MIT",
  "documentation": "https://developer.entur.org/pages-real-time-vehicle/",
  "subjectData": {
    "storesPersonalData": false,
    "strategy": "not_personal",
    "registrationIds": [],
    "operatorInstructions": null
  },
  "domains": ["live-transit"],
  "backend": {
    "routes": false
  },
  "configSchema": {
    "type": "object",
    "properties": {
      "enabled": {
        "type": "boolean",
        "default": true
      },
      "clientName": {
        "type": "string",
        "title": "ET-Client-Name",
        "description": "Client identifier sent to Entur realtime APIs. Entur recommends the format \"company-application\".",
        "default": "openmapx-server"
      },
      "journeyPlannerEndpoint": {
        "type": "string",
        "title": "Journey Planner endpoint",
        "description": "Full URL of the Entur Journey Planner v3 GraphQL endpoint.",
        "format": "url"
      },
      "vehiclesEndpoint": {
        "type": "string",
        "title": "Vehicle positions endpoint",
        "description": "Full URL of the Entur realtime vehicle GraphQL endpoint.",
        "format": "url"
      }
    }
  },
  "healthCheck": {
    "name": "Entur realtime APIs",
    "type": "ping",
    "url": "https://api.entur.io/journey-planner/v3/graphql",
    "urlTemplate": "${journeyPlannerEndpoint}"
  },
  "quality": "built-in",
  "category": "Transit",
  "dataSources": [
    {
      "sourceId": "entur-live-vehicles",
      "name": "Entur Vehicle Positions v2",
      "url": "https://developer.entur.org/pages-real-time-vehicle/",
      "attribution": "Data made available by Entur",
      "commercialUse": "yes",
      "providerCountry": "NO",
      "providerPrivacyUrl": "https://om.entur.no/personvern/",
      "endUserExposure": "server-only",
      "personalData": false,
      "cookies": false,
      "dpaAvailable": false,
      "licensing": {
        "version": 1,
        "bindings": [
          {
            "scope": "data",
            "subject": "Entur Vehicle Positions v2 material",
            "license": {
              "kind": "spdx",
              "expression": "NLOD-2.0",
              "url": "https://data.norge.no/nlod/en/2.0"
            }
          }
        ],
        "declarations": [
          {
            "text": "NLOD-2.0",
            "url": "https://data.norge.no/nlod/en/2.0"
          }
        ]
      }
    },
    {
      "sourceId": "entur-live-situations",
      "name": "Entur Journey Planner Situations",
      "url": "https://developer.entur.org/pages-journeyplanner-journeyplanner/",
      "attribution": "Data made available by Entur",
      "commercialUse": "yes",
      "providerCountry": "NO",
      "providerPrivacyUrl": "https://om.entur.no/personvern/",
      "endUserExposure": "server-only",
      "personalData": false,
      "cookies": false,
      "dpaAvailable": false,
      "licensing": {
        "version": 1,
        "bindings": [
          {
            "scope": "data",
            "subject": "Entur Journey Planner Situations material",
            "license": {
              "kind": "spdx",
              "expression": "NLOD-2.0",
              "url": "https://data.norge.no/nlod/en/2.0"
            }
          }
        ],
        "declarations": [
          {
            "text": "NLOD-2.0",
            "url": "https://data.norge.no/nlod/en/2.0"
          }
        ]
      }
    }
  ]
}
