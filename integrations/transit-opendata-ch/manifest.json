{
  "id": "transit-opendata-ch",
  "name": "Swiss Transit (transport.opendata.ch)",
  "description": "Swiss public transit data",
  "version": "1.0.0",
  "author": "OpenMapX",
  "license": "MIT",
  "quality": "built-in",
  "domains": ["transit"],
  "category": "Transit",
  "envVars": [],
  "configSchema": {
    "enabled": {
      "type": "boolean",
      "default": true,
      "description": "Enable Swiss transit integration"
    }
  },
  "backend": {
    "routes": false
  },
  "healthCheck": {
    "type": "http",
    "url": "https://transport.opendata.ch/v1/locations?query=Bern&type=station"
  },
  "attribution": [
    {
      "name": "transport.opendata.ch",
      "url": "https://transport.opendata.ch/",
      "license": "Open Data"
    }
  ],
  "privacy": {
    "purpose": "Swiss transit stops and connections",
    "dataSent": "Station names, coordinates",
    "providerCountry": "CH",
    "providerPrivacyUrl": "https://transport.opendata.ch/",
    "personalData": false
  }
}
