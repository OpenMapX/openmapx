{
  "id": "transit-opendata-ch",
  "version": "1.0.0",
  "author": "OpenMapX",
  "license": "MIT",
  "quality": "built-in",
  "domains": ["transit"],
  "category": "Transit",
  "envVars": [],
  "configSchema": {
    "type": "object",
    "properties": {
      "enabled": {
        "type": "boolean",
        "default": true,
        "description": "Enable Swiss transit integration"
      }
    }
  },
  "backend": {
    "routes": false
  },
  "healthCheck": {
    "type": "http",
    "url": "https://transport.opendata.ch/v1/locations?query=Bern&type=station"
  },
  "dataSources": [
    {
      "sourceId": "opendata-ch",
      "name": "OpenData.ch Transport API",
      "url": "https://transport.opendata.ch/",
      "license": "MIT (software)",
      "licenseUrl": "https://github.com/OpendataCH/Transport/blob/master/LICENSE",
      "attribution": "Swiss transport data by <a href=\"https://transport.opendata.ch/\">OpenData.ch</a>",
      "commercialUse": "yes",
      "providerCountry": "CH",
      "providerPrivacyUrl": "-",
      "endUserExposure": "server-only",
      "personalData": false,
      "cookies": false,
      "dpaAvailable": false
    }
  ],
  "dependencies": ["transit"]
}
