{
  "id": "hotels",
  "version": "1.0.0",
  "author": "OpenMapX",
  "license": "MIT",
  "domains": ["hotel-search"],
  "backend": {
    "routes": true
  },
  "configSchema": {
    "type": "object",
    "properties": {
      "enabled": { "type": "boolean", "default": true },
      "bookingAid": {
        "type": "string",
        "title": "Booking.com Affiliate ID (aid)",
        "description": "Optional. Appended to Booking.com links as &aid= for commission tracking. Leave empty to deep-link without tracking (no account required)."
      },
      "affiliateTemplates": {
        "type": "object",
        "title": "Affiliate link wrappers",
        "description": "Optional per-provider affiliate deep-link wrappers. Key = provider id (e.g. \"expedia\"), value = a URL template containing the literal token {url}, which is replaced with the URL-encoded destination link. Lets you plug in a CJ / Impact / Partnerize / Awin wrapper without code changes. Leave empty for plain links.",
        "additionalProperties": { "type": "string" }
      },
      "liteApiKey": {
        "type": "string",
        "title": "LiteAPI key (live prices)",
        "description": "Optional. When set, the hotel panel shows a live lowest nightly rate from LiteAPI (https://liteapi.travel). Leave empty to ship deep-link comparison only.",
        "x-openmapx-secret": true
      },
      "liteApiCurrency": {
        "type": "string",
        "title": "LiteAPI rate currency",
        "description": "ISO-4217 currency for LiteAPI rate requests (e.g. EUR, USD).",
        "default": "EUR"
      }
    }
  },
  "quality": "built-in",
  "category": "External",
  "dataSources": [
    {
      "sourceId": "booking",
      "name": "Booking.com",
      "url": "https://www.booking.com/",
      "license": "Proprietary (deep-link only)",
      "commercialUse": "conditional",
      "providerCountry": "NL",
      "providerPrivacyUrl": "https://www.booking.com/content/privacy.html",
      "endUserExposure": "direct"
    },
    {
      "sourceId": "expedia",
      "name": "Expedia",
      "url": "https://www.expedia.com/",
      "license": "Proprietary (deep-link only)",
      "commercialUse": "conditional",
      "providerCountry": "US",
      "providerPrivacyUrl": "https://www.expedia.com/privacy",
      "endUserExposure": "direct"
    },
    {
      "sourceId": "hotelscom",
      "name": "Hotels.com",
      "url": "https://www.hotels.com/",
      "license": "Proprietary (deep-link only)",
      "commercialUse": "conditional",
      "providerCountry": "US",
      "providerPrivacyUrl": "https://www.hotels.com/privacy/",
      "endUserExposure": "direct"
    },
    {
      "sourceId": "agoda",
      "name": "Agoda",
      "url": "https://www.agoda.com/",
      "license": "Proprietary (deep-link only)",
      "commercialUse": "conditional",
      "providerCountry": "SG",
      "providerPrivacyUrl": "https://www.agoda.com/info/agoda-privacy.html",
      "endUserExposure": "direct"
    },
    {
      "sourceId": "tripcom",
      "name": "Trip.com",
      "url": "https://www.trip.com/",
      "license": "Proprietary (deep-link only)",
      "commercialUse": "conditional",
      "providerCountry": "SG",
      "providerPrivacyUrl": "https://pages.trip.com/privacy/privacy-en-xx.html",
      "endUserExposure": "direct"
    },
    {
      "sourceId": "hrs",
      "name": "HRS",
      "url": "https://www.hrs.de/",
      "license": "Proprietary (deep-link only)",
      "commercialUse": "conditional",
      "providerCountry": "DE",
      "providerPrivacyUrl": "https://www.hrs.de/datenschutz/",
      "endUserExposure": "direct"
    },
    {
      "sourceId": "liteapi",
      "name": "LiteAPI",
      "url": "https://www.liteapi.travel/",
      "license": "Proprietary (commercial API)",
      "commercialUse": "conditional",
      "providerCountry": "AE",
      "providerPrivacyUrl": "https://www.liteapi.travel/privacy-policy",
      "endUserExposure": "proxied"
    }
  ]
}
