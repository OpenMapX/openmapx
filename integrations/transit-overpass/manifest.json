{
  "id": "transit-overpass",
  "version": "1.0.0",
  "author": "OpenMapX",
  "license": "MIT",
  "quality": "built-in",
  "domains": ["transit"],
  "infrastructure": {
    "dockerProfile": "overpass",
    "services": ["overpass"],
    "dataRequirements": ["osm-pbf"]
  },
  "category": "Transit",
  "envVars": [],
  "configSchema": {
    "type": "object",
    "properties": {
      "enabled": {
        "type": "boolean",
        "default": true,
        "description": "Enable OSM Overpass transit integration"
      }
    }
  },
  "backend": {
    "routes": false
  },
  "healthCheck": {
    "type": "ping",
    "url": "https://overpass-api.de/api/status"
  },
  "attribution": [
    {
      "name": "OpenStreetMap/Overpass",
      "url": "https://overpass-api.de/",
      "license": "ODbL",
      "licenseUrl": "https://opendatacommons.org/licenses/odbl/1-0/"
    }
  ],
  "privacy": [
    {
      "providerCountry": "DE",
      "providerPrivacyUrl": "https://osmfoundation.org/wiki/Privacy_Policy",
      "personalData": false
    }
  ]
}
