{
  "id": "weather-openweathermap",
  "version": "1.0.0",
  "author": "OpenMapX",
  "license": "MIT",
  "documentation": "https://openweathermap.org/current",
  "domains": ["weather"],
  "dependencies": ["weather"],
  "frontend": {
    "mapLayer": false,
    "legend": false,
    "panel": false
  },
  "backend": {
    "routes": false
  },
  "configSchema": {
    "type": "object",
    "properties": {
      "enabled": {
        "type": "boolean",
        "default": true
      },
      "apiKey": {
        "type": "string",
        "title": "OpenWeatherMap API Key",
        "description": "API key for current weather and 5-day forecast",
        "x-openmapx-secret": true,
        "x-openmapx-setup": {
          "url": "https://home.openweathermap.org/users/sign_up",
          "urlLabel": "Sign up for OpenWeather",
          "steps": [
            "Create a free account at home.openweathermap.org using your email.",
            "Confirm your email via the verification link.",
            "Sign in and open the 'API keys' tab (home.openweathermap.org/api_keys).",
            "Copy the default key or generate a new one."
          ],
          "cost": "Free plan: 60 calls/minute, 1,000,000 calls/month.",
          "notes": "A new key is not usable immediately — it activates automatically up to 2 hours after registration (requests return HTTP 401 until then)."
        }
      }
    }
  },
  "quality": "built-in",
  "category": "Weather",
  "healthCheck": {
    "type": "http",
    "urlTemplate": "https://api.openweathermap.org/data/2.5/weather?lat=0&lon=0&appid=${apiKey}",
    "requiredConfigKeys": ["apiKey"]
  },
  "dataSources": [
    {
      "sourceId": "openweathermap",
      "name": "OpenWeather",
      "url": "https://openweathermap.org/",
      "license": "ODbL",
      "licenseUrl": "https://openweathermap.org/full-price",
      "attribution": "© <a href=\"https://openweathermap.org/\">OpenWeather</a>",
      "commercialUse": "yes",
      "providerCountry": "UK",
      "providerPrivacyUrl": "https://openweather.co.uk/privacy-policy",
      "endUserExposure": "server-only",
      "personalData": false,
      "cookies": false,
      "dpaAvailable": false
    }
  ]
}
