{
  "id": "transit-dynamic-registry",
  "version": "1.0.0",
  "author": "OpenMapX",
  "license": "MIT",
  "quality": "built-in",
  "domains": ["transit"],
  "category": "Transit",
  "envVars": [],
  "configSchema": {
    "type": "object",
    "properties": {
      "enabled": {
        "type": "boolean",
        "default": true,
        "description": "Enable dynamic transit registry"
      }
    }
  },
  "backend": {
    "routes": false
  },
  "healthCheck": {
    "type": "http",
    "url": "https://api.github.com/repos/public-transport/transport-apis/git/trees/v1"
  },
  "dataSources": [
    {
      "name": "JSDelivr CDN",
      "url": "https://cdn.jsdelivr.net/",
      "license": "MIT",
      "licenseUrl": "https://www.jsdelivr.com/terms/terms-of-use",
      "commercialUse": "yes",
      "providerCountry": "UK",
      "providerPrivacyUrl": "https://www.jsdelivr.com/terms/privacy-policy",
      "endUserExposure": "server-only",
      "personalData": false,
      "cookies": false,
      "dpaAvailable": true,
      "dpaUrl": "https://www.jsdelivr.com/documents/data-processing-agreement.pdf"
    },
    {
      "name": "GitHub API",
      "url": "https://api.github.com/",
      "license": "Proprietary (GitHub ToS)",
      "licenseUrl": "https://docs.github.com/en/site-policy/github-terms/github-terms-of-service",
      "commercialUse": "yes",
      "providerCountry": "US",
      "providerPrivacyUrl": "https://docs.github.com/site-policy/privacy-policies/github-privacy-statement",
      "endUserExposure": "server-only",
      "personalData": false,
      "cookies": false,
      "dpaAvailable": true,
      "dpaUrl": "https://github.com/customer-terms/github-data-protection-agreement"
    }
  ],
  "dependencies": ["transit"]
}
