{
  "id": "transit-dynamic-registry",
  "version": "1.0.0",
  "author": "OpenMapX",
  "license": "MIT",
  "quality": "built-in",
  "domains": ["transit"],
  "category": "Transit",
  "configSchema": {
    "type": "object",
    "properties": {
      "enabled": {
        "type": "boolean",
        "default": true,
        "description": "Enable dynamic transit registry"
      },
      "githubToken": {
        "type": "string",
        "title": "GitHub API Token (Transit Registry)",
        "description": "Optional GitHub API token. Raises the unauthenticated 60/hr rate limit to 5000/hr when fetching the registry from api.github.com.",
        "x-openmapx-secret": true,
        "x-openmapx-setup": {
          "url": "https://github.com/settings/tokens",
          "urlLabel": "Get GitHub token",
          "steps": [
            "Go to github.com/settings/tokens (Settings → Developer settings → Personal access tokens → Tokens (classic)).",
            "Click 'Generate new token (classic)', add a note and an expiration.",
            "Leave ALL scope checkboxes unchecked — a token with no scopes can read public information.",
            "Generate the token and copy it."
          ],
          "cost": "Free.",
          "notes": "No scopes required (public read only). Used solely to raise GitHub's unauthenticated REST limit from 60/hr to 5,000/hr when fetching the public registry."
        }
      }
    }
  },
  "backend": {
    "routes": false
  },
  "healthCheck": [
    {
      "name": "JSDelivr Registry",
      "type": "http",
      "url": "https://data.jsdelivr.com/v1/packages/gh/public-transport/transport-apis@58aec5b1b7c876f133c9d1336739d0f61211b74e"
    },
    {
      "name": "GitHub Registry",
      "type": "http",
      "url": "https://api.github.com/repos/public-transport/transport-apis/git/trees/58aec5b1b7c876f133c9d1336739d0f61211b74e?recursive=1"
    }
  ],
  "dataSources": [
    {
      "sourceId": "jsdelivr",
      "name": "JSDelivr CDN",
      "url": "https://cdn.jsdelivr.net/",
      "license": "MIT",
      "licenseUrl": "https://www.jsdelivr.com/terms/terms-of-use",
      "commercialUse": "yes",
      "providerCountry": "UK",
      "providerPrivacyUrl": "https://www.jsdelivr.com/terms/privacy-policy",
      "endUserExposure": "server-only",
      "personalData": false,
      "cookies": false,
      "dpaAvailable": true,
      "dpaUrl": "https://www.jsdelivr.com/documents/data-processing-agreement.pdf"
    },
    {
      "sourceId": "github",
      "name": "GitHub API",
      "url": "https://api.github.com/",
      "license": "Proprietary (GitHub ToS)",
      "licenseUrl": "https://docs.github.com/en/site-policy/github-terms/github-terms-of-service",
      "commercialUse": "yes",
      "providerCountry": "US",
      "providerPrivacyUrl": "https://docs.github.com/site-policy/privacy-policies/github-privacy-statement",
      "endUserExposure": "server-only",
      "personalData": false,
      "cookies": false,
      "dpaAvailable": true,
      "dpaUrl": "https://github.com/customer-terms/github-data-protection-agreement"
    },
    {
      "sourceId": "regional-operators",
      "name": "Regional public-transport operator APIs (transport-apis registry)",
      "url": "https://github.com/public-transport/transport-apis",
      "license": "Various (per regional operator)",
      "licenseUrl": "https://github.com/public-transport/transport-apis",
      "commercialUse": "unknown",
      "providerCountry": "Various",
      "providerPrivacyUrl": "https://github.com/public-transport/transport-apis",
      "endUserExposure": "server-only",
      "personalData": false,
      "cookies": false,
      "dpaAvailable": false,
      "notes": "Auto-discovered from the public-transport/transport-apis registry (~85 regional operators across many countries). Queried server-side only when no hand-crafted provider covers the requested area; this is a category of recipients, not a single controller — see the linked registry for the operator list, each governed by its own terms."
    }
  ],
  "dependencies": ["transit"]
}
