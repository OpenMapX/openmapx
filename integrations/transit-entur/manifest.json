{
  "id": "transit-entur",
  "version": "1.0.0",
  "author": "OpenMapX",
  "license": "MIT",
  "quality": "built-in",
  "subjectData": {
    "storesPersonalData": false,
    "strategy": "not_personal",
    "registrationIds": [],
    "operatorInstructions": null
  },
  "domains": ["transit"],
  "category": "Transit",
  "configSchema": {
    "type": "object",
    "properties": {
      "enabled": {
        "type": "boolean",
        "default": true
      },
      "clientName": {
        "type": "string",
        "title": "ET-Client-Name",
        "description": "Client identifier sent to Entur. Entur recommends the format \"company-application\".",
        "default": "openmapx-server"
      },
      "boundaryCountry": {
        "type": "string",
        "title": "Boundary country",
        "description": "One lowercase ISO 3166-1 alpha-2 country filter. Defaults to no; an explicit empty string disables country scoping.",
        "default": "no",
        "pattern": "^([a-z]{2})?$"
      },
      "multiModal": {
        "type": "string",
        "title": "Multimodal stop behavior",
        "description": "Whether Entur stop search should return multimodal parent stops, child stops, or both.",
        "enum": ["parent", "child", "all"],
        "default": "parent"
      },
      "geocoderEndpoint": {
        "type": "string",
        "title": "Geocoder endpoint",
        "description": "Unversioned Entur Geocoder service base URL, for example https://api.entur.io/geocoder. Native /v3 operation paths are appended.",
        "format": "url"
      },
      "journeyPlannerEndpoint": {
        "type": "string",
        "title": "Journey Planner endpoint",
        "description": "Full URL of the Entur Journey Planner v3 GraphQL endpoint.",
        "format": "url"
      },
      "vehiclesEndpoint": {
        "type": "string",
        "title": "Vehicle positions endpoint",
        "description": "Full URL of the Entur realtime vehicle GraphQL endpoint.",
        "format": "url"
      },
      "nsrEndpoint": {
        "type": "string",
        "title": "NSR endpoint",
        "description": "Base URL of the Entur National Stop Register read API.",
        "format": "url"
      }
    }
  },
  "backend": {
    "routes": false
  },
  "healthCheck": {
    "name": "Entur transit APIs",
    "type": "ping",
    "url": "https://api.entur.io/journey-planner/v3/graphql",
    "urlTemplate": "${journeyPlannerEndpoint}"
  },
  "dataSources": [
    {
      "commercialUse": "yes",
      "providerCountry": "NO",
      "providerPrivacyUrl": "https://om.entur.no/personvern/",
      "endUserExposure": "server-only",
      "personalData": false,
      "cookies": false,
      "dpaAvailable": false,
      "reviewedAt": "2026-10-19",
      "sourceId": "entur-geocoder",
      "name": "Entur Geocoder API",
      "url": "https://developer.entur.no/docs/open-services/geocoder",
      "attribution": "Geocoder service provided by Entur",
      "owner": "Entur AS",
      "termsUrl": "https://developer.entur.no/terms-of-service",
      "dataUseClass": "attribution",
      "licensing": {
        "version": 1,
        "bindings": [
          {
            "scope": "service",
            "subject": "Entur Geocoder API access",
            "license": {
              "kind": "custom",
              "namespace": "openmapx:entur",
              "id": "LicenseRef-Entur-API-Terms",
              "name": "Entur API terms",
              "url": "https://developer.entur.no/terms-of-service"
            },
            "conditions": [
              "Identify the application with ET-Client-Name and comply with fair use and service rate limits."
            ]
          }
        ],
        "declarations": [
          {
            "text": "Entur API terms",
            "url": "https://developer.entur.no/terms-of-service"
          }
        ]
      }
    },
    {
      "commercialUse": "yes",
