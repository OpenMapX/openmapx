{
  "id": "transit-entur",
  "version": "1.0.0",
  "author": "OpenMapX",
  "license": "MIT",
  "quality": "built-in",
  "subjectData": {
    "storesPersonalData": false,
    "strategy": "not_personal",
    "registrationIds": [],
    "operatorInstructions": null
  },
  "domains": ["transit"],
  "category": "Transit",
  "configSchema": {
    "type": "object",
    "properties": {
      "enabled": {
        "type": "boolean",
        "default": true
      },
      "clientName": {
        "type": "string",
        "title": "ET-Client-Name",
        "description": "Client identifier sent to Entur. Entur recommends the format \"company-application\".",
        "default": "openmapx-server"
      },
      "boundaryCountry": {
        "type": "string",
        "title": "Boundary country",
        "description": "Optional ISO 3166-1 alpha-3 country filter applied to stop search requests. Defaults to NOR.",
        "default": "NOR"
      },
      "multiModal": {
        "type": "string",
        "title": "Multimodal stop behavior",
        "description": "Whether Entur stop search should return multimodal parent stops, child stops, or both.",
        "enum": ["parent", "child", "all"],
        "default": "parent"
      },
      "geocoderEndpoint": {
        "type": "string",
        "title": "Geocoder endpoint",
        "description": "Base URL of the Entur geocoder API. Defaults to the public Entur endpoint.",
        "format": "url"
      },
      "journeyPlannerEndpoint": {
        "type": "string",
        "title": "Journey Planner endpoint",
        "description": "Full URL of the Entur Journey Planner v3 GraphQL endpoint.",
        "format": "url"
      },
      "vehiclesEndpoint": {
        "type": "string",
        "title": "Vehicle positions endpoint",
        "description": "Full URL of the Entur realtime vehicle GraphQL endpoint.",
        "format": "url"
      },
      "nsrEndpoint": {
        "type": "string",
        "title": "NSR endpoint",
        "description": "Base URL of the Entur National Stop Register read API.",
        "format": "url"
      }
    }
  },
  "backend": {
    "routes": false
  },
  "healthCheck": {
    "name": "Entur transit APIs",
    "type": "ping",
    "url": "https://api.entur.io/journey-planner/v3/graphql",
    "urlTemplate": "${journeyPlannerEndpoint}"
  },
  "dataSources": [
    {
      "sourceId": "entur-geocoder",
      "name": "Entur Geocoder",
      "url": "https://developer.entur.org/pages-geocoder-intro/",
      "attribution": "Inneholder data under Norsk lisens for offentlige data (NLOD) tilgjengeliggjort av Entur AS.",
      "commercialUse": "yes",
      "providerCountry": "NO",
      "providerPrivacyUrl": "https://om.entur.no/personvern/",
      "endUserExposure": "server-only",
      "personalData": false,
      "cookies": false,
      "dpaAvailable": false,
      "licensing": {
        "version": 1,
        "bindings": [
          {
            "scope": "data",
            "subject": "Entur Geocoder material",
            "license": {
              "kind": "spdx",
              "expression": "NLOD-2.0",
              "url": "https://data.norge.no/nlod/en/2.0"
            }
          }
        ],
        "declarations": [
          {
            "text": "NLOD-2.0",
            "url": "https://data.norge.no/nlod/en/2.0"
          }
        ]
      }
    },
    {
      "sourceId": "entur-journey-planner",
      "name": "Entur Journey Planner v3",
      "url": "https://developer.entur.org/pages-journeyplanner-journeyplanner/",
      "attribution": "Data made available by Entur",
      "commercialUse": "yes",
      "providerCountry": "NO",
      "providerPrivacyUrl": "https://om.entur.no/personvern/",
      "endUserExposure": "server-only",
      "personalData": false,
      "cookies": false,
      "dpaAvailable": false,
      "licensing": {
        "version": 1,
        "bindings": [
          {
            "scope": "data",
            "subject": "Entur Journey Planner v3 material",
            "license": {
              "kind": "spdx",
              "expression": "NLOD-2.0",
              "url": "https://data.norge.no/nlod/en/2.0"
            }
          }
        ],
        "declarations": [
          {
            "text": "NLOD-2.0",
            "url": "https://data.norge.no/nlod/en/2.0"
          }
        ]
      }
    },
    {
      "sourceId": "entur-vehicles",
      "name": "Entur Vehicle Positions v2",
      "url": "https://developer.entur.org/pages-real-time-vehicle/",
      "attribution": "Data made available by Entur",
      "commercialUse": "yes",
      "providerCountry": "NO",
      "providerPrivacyUrl": "https://om.entur.no/personvern/",
      "endUserExposure": "server-only",
      "personalData": false,
      "cookies": false,
      "dpaAvailable": false,
      "licensing": {
        "version": 1,
        "bindings": [
          {
            "scope": "data",
            "subject": "Entur Vehicle Positions v2 material",
            "license": {
              "kind": "spdx",
              "expression": "NLOD-2.0",
              "url": "https://data.norge.no/nlod/en/2.0"
            }
          }
        ],
        "declarations": [
          {
            "text": "NLOD-2.0",
            "url": "https://data.norge.no/nlod/en/2.0"
          }
        ]
      }
    },
    {
      "sourceId": "entur-nsr",
      "name": "Entur National Stop Register",
      "url": "https://developer.entur.org/stop-places-v1-read/",
      "attribution": "Data made available by Entur",
      "commercialUse": "yes",
      "providerCountry": "NO",
      "providerPrivacyUrl": "https://om.entur.no/personvern/",
      "endUserExposure": "server-only",
      "personalData": false,
      "cookies": false,
      "dpaAvailable": false,
      "licensing": {
        "version": 1,
        "bindings": [
          {
            "scope": "data",
            "subject": "Entur National Stop Register material",
            "license": {
              "kind": "spdx",
              "expression": "NLOD-2.0",
              "url": "https://data.norge.no/nlod/en/2.0"
            }
          }
        ],
        "declarations": [
          {
            "text": "NLOD-2.0",
            "url": "https://data.norge.no/nlod/en/2.0"
          }
        ]
      }
    }
  ],
  "dependencies": ["transit"]
}
