      "endUserExposure": "server-only",
      "personalData": false,
      "cookies": false,
      "dpaAvailable": false,
      "reviewedAt": "2026-10-19",
      "sourceId": "entur-geocoder-nsr",
      "name": "Entur National Stop Register geocoder data",
      "url": "https://developer.entur.no/docs/open-services/geocoder",
      "attribution": "Inneholder data under Norsk lisens for offentlige data (NLOD) tilgjengeliggjort av Entur AS.",
      "owner": "Entur AS",
      "termsUrl": "https://data.norge.no/nlod/en/2.0",
