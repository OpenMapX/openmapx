{
  "id": "transit-tfl",
  "version": "1.0.0",
  "author": "OpenMapX",
  "license": "MIT",
  "quality": "built-in",
  "domains": ["transit"],
  "category": "Transit",
  "configSchema": {
    "type": "object",
    "properties": {
      "enabled": {
        "type": "boolean",
        "default": true
      },
      "apiKey": {
        "type": "string",
        "title": "TfL API Key",
        "description": "Transport for London API key.",
        "x-openmapx-secret": true
      }
    }
  },
  "backend": {
    "routes": false
  },
  "healthCheck": {
    "type": "http",
    "urlTemplate": "https://api.tfl.gov.uk/StopPoint/search?query=victoria&app_key=${apiKey}",
    "requiredConfigKeys": ["apiKey"]
  },
  "dataSources": [
    {
      "sourceId": "tfl",
      "name": "Transport for London",
      "url": "https://tfl.gov.uk/",
      "license": "Proprietary (OGL v2 with TfL amendments)",
      "licenseUrl": "https://tfl.gov.uk/corporate/terms-and-conditions/transport-data-service",
      "attribution": "Powered by <a href=\"https://tfl.gov.uk/\">TfL Open Data</a>",
      "commercialUse": "yes",
      "providerCountry": "UK",
      "providerPrivacyUrl": "https://tfl.gov.uk/corporate/privacy-and-cookies/privacy-and-data-protection-policy",
      "endUserExposure": "server-only",
      "personalData": false,
      "cookies": false,
      "dpaAvailable": false
    }
  ],
  "dependencies": ["transit"]
}
