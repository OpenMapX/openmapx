{
  "id": "transit-tfl",
  "version": "1.0.0",
  "author": "OpenMapX",
  "license": "MIT",
  "quality": "built-in",
  "subjectData": {
    "storesPersonalData": false,
    "strategy": "not_personal",
    "registrationIds": [],
    "operatorInstructions": null
  },
  "domains": ["transit"],
  "category": "Transit",
  "configSchema": {
    "type": "object",
    "properties": {
      "enabled": {
        "type": "boolean",
        "default": true
      },
      "apiKey": {
        "type": "string",
        "title": "TfL API Key",
        "description": "Transport for London API key.",
        "x-openmapx-secret": true,
        "x-openmapx-setup": {
          "url": "https://api-portal.tfl.gov.uk/signup",
          "urlLabel": "Get TfL API key",
          "steps": [
            "Sign up at api-portal.tfl.gov.uk/signup and activate your account via the confirmation email.",
            "Sign in, open the Products section and subscribe to the '500 Requests per min' product.",
            "After subscribing you are taken to your Profile, where your subscription keys are listed.",
            "Copy the key (the 'app_key')."
          ],
          "cost": "Free. Anonymous access is capped at 50 req/min; a registered key raises this to 500 req/min.",
          "notes": "The key is appended to requests as the app_key query parameter."
        }
      }
    }
  },
  "backend": {
    "routes": false
  },
  "healthCheck": {
    "type": "http",
    "urlTemplate": "https://api.tfl.gov.uk/StopPoint/search?query=victoria&app_key=${apiKey}",
    "requiredConfigKeys": ["apiKey"]
  },
  "dataSources": [
    {
      "sourceId": "tfl",
      "name": "Transport for London",
      "url": "https://tfl.gov.uk/",
      "attribution": "<a href=\"https://tfl.gov.uk/\">Powered by TfL Open Data</a> Contains OS data © Crown copyright and database rights 2016 and Geomni UK Map data © and database rights [2019]",
      "commercialUse": "yes",
      "providerCountry": "UK",
      "providerPrivacyUrl": "https://tfl.gov.uk/corporate/privacy-and-cookies/privacy-and-data-protection-policy",
      "endUserExposure": "server-only",
      "personalData": false,
      "cookies": false,
      "dpaAvailable": false,
      "licensing": {
        "version": 1,
        "bindings": [
          {
            "scope": "data",
            "subject": "TfL supplied transport data",
            "license": {
              "kind": "custom",
              "namespace": "publisher:tfl",
              "id": "LicenseRef-TfL-Transport-Data-Service",
              "name": "TfL Transport Data Service licence (OGL v2.0 with TfL amendments)",
              "url": "https://tfl.gov.uk/corporate/terms-and-conditions/transport-data-service"
            }
          },
          {
            "scope": "service",
            "subject": "TfL account/API contract",
            "license": {
              "kind": "custom",
              "namespace": "publisher:tfl",
              "id": "LicenseRef-Service-Terms",
              "name": "TfL account/API contract terms",
              "url": "https://tfl.gov.uk/corporate/terms-and-conditions/transport-data-service"
            }
          }
        ],
        "declarations": [
          {
            "text": "Proprietary (OGL v2 with TfL amendments)",
            "url": "https://tfl.gov.uk/corporate/terms-and-conditions/transport-data-service"
          }
        ]
      }
    }
  ],
  "dependencies": ["transit"]
}
