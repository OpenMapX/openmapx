{
  "id": "transit-gtfs-local",
  "version": "1.0.0",
  "author": "OpenMapX",
  "license": "MIT",
  "quality": "built-in",
  "category": "Transit",
  "domains": ["transit"],
  "infrastructure": {
    "dataRequirements": ["gtfs-feeds"]
  },
  "configSchema": {
    "type": "object",
    "properties": {
      "enabled": {
        "type": "boolean",
        "default": true,
        "description": "Enable local GTFS feeds integration"
      }
    }
  },
  "backend": {
    "routes": false
  },
  "healthCheck": {
    "type": "custom"
  },
  "dependencies": ["transit"],
  "requires": [
    {
      "service": "postgis",
      "optional": false
    }
  ],
  "dataSources": [
    {
      "sourceId": "transit-gtfs-local",
      "name": "Local GTFS Feeds",
      "url": "https://gtfs.org/",
      "license": "Per-feed (see getFeedAttribution)",
      "attribution": "Timetable data from imported GTFS feeds; each feed is credited under its own licence.",
      "commercialUse": "conditional",
      "providerCountry": "XX",
      "providerPrivacyUrl": "https://gtfs.org/",
      "endUserExposure": "server-only",
      "personalData": false,
      "cookies": false,
      "dpaAvailable": false
    }
  ]
}
