{
  "id": "transit-gtfs-local",
  "version": "1.0.0",
  "author": "OpenMapX",
  "license": "MIT",
  "quality": "built-in",
  "domains": ["transit"],
  "infrastructure": {
    "dataRequirements": ["gtfs-feeds"]
  },
  "configSchema": {
    "enabled": {
      "type": "boolean",
      "default": true,
      "description": "Enable local GTFS feeds integration"
    }
  },
  "services": ["postgres"],
  "backend": {
    "routes": false
  },
  "healthCheck": {
    "type": "custom",
    "category": "Transit"
  },
  "attribution": [
    {
      "name": "Various GTFS Feeds",
      "url": "https://gtfs.org/",
      "license": "Various (per feed)"
    }
  ],
  "privacy": {
    "providerCountry": "Self-hosted",
    "providerPrivacyUrl": "N/A",
    "personalData": false
  }
}
