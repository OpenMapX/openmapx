{
  "id": "transit-gtfs-local",
  "version": "1.0.0",
  "author": "OpenMapX",
  "license": "MIT",
  "quality": "built-in",
  "category": "Transit",
  "domains": ["transit"],
  "infrastructure": {
    "dataRequirements": ["gtfs-feeds"]
  },
  "configSchema": {
    "type": "object",
    "properties": {
      "enabled": {
        "type": "boolean",
        "default": true,
        "description": "Enable local GTFS feeds integration"
      }
    }
  },
  "backend": {
    "routes": false
  },
  "healthCheck": {
    "type": "custom"
  },
  "dependencies": ["transit"],
  "requires": [
    {
      "service": "postgis",
      "optional": false
    }
  ]
}
