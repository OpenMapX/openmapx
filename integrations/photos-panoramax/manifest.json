  "license": "MIT",
  "subjectData": {
    "storesPersonalData": false,
    "strategy": "not_personal",
    "registrationIds": [],
    "operatorInstructions": null
  },
  "domains": ["photos"],
  "dependencies": ["photos"],
  "backend": {
    "routes": false
  },
  "configSchema": {
    "type": "object",
    "properties": {
      "enabled": {
        "type": "boolean",
        "default": true
      }
    }
  },
  "healthCheck": {
    "type": "http",
    "url": "https://api.panoramax.xyz/api/search"
  },
  "quality": "built-in",
  "category": "Imagery",
  "dataSources": [
    {
      "sourceId": "panoramax",
      "name": "Panoramax",
      "url": "https://panoramax.xyz/",
      "commercialUse": "yes",
      "providerCountry": "FR",
      "providerPrivacyUrl": "https://www.ign.fr/institut/donnees-caractere-personnel",
      "endUserExposure": "server-only",
      "personalData": false,
      "cookies": false,
      "dpaAvailable": false,
      "licensing": {
        "version": 1,
        "bindings": [
          {
            "scope": "imagery",
            "subject": "Confirmed IGN-instance images",
            "license": {
              "kind": "spdx",
              "expression": "etalab-2.0"
            },
            "attribution": {
              "placement": "details",
              "surfaces": ["image"],
              "basis": "provider-terms",
              "reviewedAt": "2026-10-14",
              "evidenceUrls": [
                "https://docs.panoramax.fr/federated-catalog/",
                "https://docs.panoramax.fr/backend/install/settings/"
              ],
              "reason": "Actual returned instance/file license known and eligible; unspecified defaults proprietary; No universal Panoramax logo duty found"
            }
          },
          {
            "scope": "imagery",
            "subject": "Confirmed OSM-France-instance images",
            "license": {
              "kind": "spdx",
              "expression": "CC-BY-SA-4.0"
            },
            "attribution": {
              "placement": "details",
              "surfaces": ["image"],
              "basis": "provider-terms",
              "reviewedAt": "2026-10-14",
              "evidenceUrls": [
                "https://docs.panoramax.fr/federated-catalog/",
                "https://docs.panoramax.fr/backend/install/settings/"
              ],
              "reason": "Actual returned instance/file license known and eligible; unspecified defaults proprietary; No universal Panoramax logo duty found"
            }
          },
          {
            "scope": "imagery",
            "subject": "Other/missing-licence instance images",
            "license": {
              "kind": "per-item",
              "raw": "Determined by each contributing item or operator"
            }
          }
        ],
        "declarations": [
          {
            "text": "etalab-2.0 (IGN); CC-BY-SA-4.0 (OSM France)",
            "url": "https://docs.panoramax.fr/"
          }
        ]
      }
    }
  ]
