  "frontend": {
    "searchCategory": {
      "id": "fuel",
      "label": "Gas Stations",
      "iconPath": "M19.77 7.23l.01-.01-3.72-3.72L15 4.56l2.11 2.11c-.94.36-1.61 1.26-1.61 2.33 0 1.38 1.12 2.5 2.5 2.5.36 0 .69-.08 1-.21v7.21c0 .55-.45 1-1 1s-1-.45-1-1V14c0-1.1-.9-2-2-2h-1V5c0-1.1-.9-2-2-2H6c-1.1 0-2 .9-2 2v16h10v-7.5h1.5v5c0 1.38 1.12 2.5 2.5 2.5s2.5-1.12 2.5-2.5V9c0-.69-.28-1.32-.73-1.77zM12 10H6V5h6v5z",
      "showInChipBar": true
    }
  },
  "backend": {
    "routes": false
  },
  "configSchema": {
    "type": "object",
    "properties": {
      "enabled": {
        "type": "boolean",
        "default": true
      },
      "de-tankerkoenig-api-key": {
        "type": "string",
        "title": "Tankerkönig API Key",
        "description": "Tankerkoenig API key for German fuel prices.",
        "x-openmapx-secret": true,
        "x-openmapx-setup": {
          "url": "https://onboarding.tankerkoenig.de/",
          "urlLabel": "Request Tankerkönig API key",
          "steps": [
            "Open onboarding.tankerkoenig.de (linked from creativecommons.tankerkoenig.de via 'API-Key').",
            "Enter a working email address and describe your non-commercial use case.",
            "Agree to the CC BY 4.0 terms (attribution to tankerkoenig.de required).",
            "Submit the form; registration is reviewed manually and can take a few days.",
            "Receive the API key by email once approved."
          ],
          "cost": "Free for non-commercial use (commercial use needs a paid agreement).",
          "notes": "Data is CC BY 4.0 (MTS-K) — attribution required. Free-tier limits: 1 request/min, 25 km radius.",
          "email": {
            "to": "info@tankerkoenig.de",
            "subject": "Tankerkönig API key request (non-commercial)",
            "body": "Hello,\n\nI would like to request a free non-commercial Tankerkönig API key.\n\nUse case: displaying current German fuel prices in a self-hosted, non-commercial OpenMapX map application.\n\nI agree to the CC BY 4.0 terms and will attribute the data to tankerkoenig.de.\n\nThank you."
          }
        }
      }
    }
  },
  "requires": [
    {
      "service": "overpass",
      "optional": true
    }
  ],
  "healthCheck": [
    {
      "name": "Tankerkoenig (DE)",
      "type": "http",
      "urlTemplate": "https://creativecommons.tankerkoenig.de/json/list.php?lat=52.52&lng=13.405&rad=1&sort=dist&type=all&apikey=${de-tankerkoenig-api-key}",
      "requiredConfigKeys": ["de-tankerkoenig-api-key"]
    },
    {
      "name": "E-Control (AT)",
      "type": "ping",
      "url": "https://api.e-control.at/sprit/1.0/search/gas-stations/by-address?latitude=48.2082&longitude=16.3738&fuelType=DIE&includeClosed=false"
    },
    {
      "name": "Prix Carburants (FR)",
      "type": "ping",
      "url": "https://data.economie.gouv.fr/api/explore/v2.1/catalog/datasets/prix-des-carburants-en-france-flux-instantane-v2/records?limit=1"
    },
    {
      "name": "Minetur (ES)",
      "type": "ping",
      "url": "https://sedeaplicaciones.minetur.gob.es/ServiciosRESTCarburantes/PreciosCarburantes/EstacionesTerrestres/"
    },
    {
      "name": "OpenStreetMap Overpass",
      "type": "http",
      "url": "https://overpass-api.de/api/status"
    }
  ],
  "quality": "built-in",
  "category": "Fuel Prices",
