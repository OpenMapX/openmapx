{
  "id": "enrichment-wikimedia-commons",
  "name": "Wikimedia Commons Enrichment",
  "version": "1.0.0",
  "description": "Photo enrichment for place details",
  "author": "OpenMapX",
  "license": "MIT",

  "domains": ["enrichment"],

  "backend": {
    "routes": false
  },

  "configSchema": {
    "type": "object",
    "properties": {
      "enabled": { "type": "boolean", "default": true }
    }
  },

  "healthCheck": {
    "type": "http",
    "url": "https://commons.wikimedia.org/w/api.php?action=query&format=json",
    "category": "External"
  },

  "quality": "built-in",

  "attribution": [
    {
      "name": "Wikimedia Commons",
      "url": "https://commons.wikimedia.org/",
      "license": "Various (CC)",
      "licenseUrl": "https://creativecommons.org/licenses/"
    }
  ],

  "privacy": [
    {
      "service": "Wikimedia Commons",
      "purpose": "Enrich place details with photos from Wikimedia Commons categories and files",
      "dataSent": "Wikimedia Commons category/file names (from OSM tags)",
      "providerCountry": "US",
      "providerPrivacyUrl": "https://foundation.wikimedia.org/wiki/Privacy_policy",
      "personalData": false
    }
  ]
}
