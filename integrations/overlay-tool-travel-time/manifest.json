{
  "id": "overlay-tool-travel-time",
  "version": "1.0.0",
  "author": "OpenMapX",
  "license": "MIT",
  "domains": ["map-overlay"],
  "infrastructure": {
    "dataRequirements": ["osm-pbf"]
  },
  "frontend": {
    "mapLayer": true,
    "legend": true,
    "layerSelector": {
      "group": "map-tools",
      "labelKey": "travelTime",
      "icon": "timer",
      "preview": "preview.svg"
    },
    "overlay": {
      "excludes": []
    }
  },
  "backend": {
    "routes": false
  },
  "configSchema": {
    "type": "object",
    "properties": {
      "enabled": {
        "type": "boolean",
        "default": true
      }
    }
  },
  "healthCheck": {
    "name": "Isochrones",
    "type": "custom"
  },
  "quality": "built-in",
  "requires": [
    {
      "service": "valhalla",
      "optional": true
    }
  ]
}
