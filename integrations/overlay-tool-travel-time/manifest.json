{
  "id": "overlay-tool-travel-time",
  "version": "1.0.0",
  "author": "OpenMapX",
  "license": "MIT",
  "domains": ["map-overlay"],
  "infrastructure": {
    "dataRequirements": ["osm-pbf"]
  },
  "frontend": {
    "mapLayer": true,
    "legend": true,
    "layerSelector": {
      "group": "map-tools",
      "labelKey": "travelTime",
      "icon": "timer",
      "preview": "preview.svg"
    },
    "overlay": {
      "excludes": []
    }
  },
  "backend": {
    "routes": false
  },
  "configSchema": {
    "type": "object",
    "properties": {
      "enabled": {
        "type": "boolean",
        "default": true
      }
    }
  },
  "healthCheck": {
    "name": "Isochrones",
    "type": "custom"
  },
  "quality": "built-in",
  "dataSources": [
    {
      "sourceId": "valhalla",
      "name": "Valhalla-compatible street isochrones (Stadia fallback)",
      "url": "https://stadiamaps.com/",
      "attribution": "Routing © <a href=\"https://stadiamaps.com/\">Stadia Maps</a>, © <a href=\"https://www.openstreetmap.org/copyright\">OpenStreetMap contributors</a>",
      "notes": "Street isochrones are requested by the routing-valhalla integration, with its endpoint and its API key (INTEGRATION_ROUTING_VALHALLA_API_KEY). Endpoint resolution prefers the registered self-hosted Valhalla service, then the routing-valhalla endpoint setting, then VALHALLA_URL, and finally Stadia Maps. The Stadia fallback requires that key and its free tier is limited to non-commercial / evaluation use. This source is used only for street modes; transit reachability uses response-attributed MOTIS/Transitous data.",
      "commercialUse": "conditional",
      "providerCountry": "US",
      "providerPrivacyUrl": "https://stadiamaps.com/privacy/privacy-policy/",
      "endUserExposure": "server-only",
      "personalData": false,
      "cookies": false,
      "dpaAvailable": true,
      "dpaUrl": "https://stadiamaps.com/legal/data-processing-addendum/",
      "licensing": {
        "version": 1,
        "bindings": [
          {
            "scope": "software",
            "subject": "Valhalla engine",
            "license": {
              "kind": "spdx",
              "expression": "MIT"
            }
          },
          {
            "scope": "service",
            "subject": "Stadia Maps API",
            "license": {
              "kind": "custom",
              "namespace": "publisher:valhalla",
              "id": "LicenseRef-Service-Terms",
              "name": "Stadia Maps API terms",
              "url": "https://stadiamaps.com/terms-of-service/"
            }
          },
          {
            "scope": "data",
            "subject": "OpenStreetMap routing data",
            "license": {
              "kind": "spdx",
              "expression": "ODbL-1.0"
            }
          }
        ],
        "declarations": [
          {
            "text": "MIT (Valhalla routing engine); Stadia Maps",
            "url": "https://stadiamaps.com/terms-of-service/"
          }
        ]
      }
    }
  ],
  "requires": [
    {
      "service": "valhalla",
      "optional": true
    }
  ]
}
