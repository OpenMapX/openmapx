      "owner": "Entur AS",
      "termsUrl": "https://developer.entur.no/terms-of-service",
      "dataUseClass": "attribution",
      "licensing": {
        "version": 1,
        "bindings": [
          {
            "scope": "service",
            "subject": "Entur Geocoder API access",
            "license": {
              "kind": "custom",
              "namespace": "openmapx:entur",
              "id": "LicenseRef-Entur-API-Terms",
              "name": "Entur API terms",
              "url": "https://developer.entur.no/terms-of-service"
            },
            "conditions": [
              "Identify the application with ET-Client-Name and comply with fair use and service rate limits."
            ],
            "attribution": {
              "placement": "details",
              "surfaces": ["map", "content", "image"],
              "basis": "provider-terms",
              "reviewedAt": "2026-10-19",
              "evidenceUrls": ["https://developer.entur.no/terms-of-service"],
              "reason": "Entur's API terms require application identification and compliance with fair use and rate limits, not end-user display of API access instructions. Keep these service conditions and terms in directly accessible details on map, content and image surfaces; supplier data attribution remains governed by each separate data binding."
            }
          }
        ],
