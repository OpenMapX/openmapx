{
  "id": "geocoding-maptiler",
  "version": "1.0.0",
  "author": "OpenMapX",
  "license": "MIT",
  "domains": ["geocoding"],
  "dependencies": ["geocoding"],
  "backend": {
    "routes": false
  },
  "configSchema": {
    "type": "object",
    "properties": {
      "enabled": {
        "type": "boolean",
        "default": true
      },
      "apiKey": {
        "type": "string",
        "title": "MapTiler API Key",
        "description": "MapTiler API key. Get one at maptiler.com/cloud.",
        "x-openmapx-secret": true,
        "x-openmapx-sharedSecretName": "maptiler-api-key",
        "x-openmapx-setup": {
          "url": "https://cloud.maptiler.com/account/keys/",
          "urlLabel": "Get MapTiler API key",
          "steps": [
            "Sign up at cloud.maptiler.com (no credit card required).",
            "Open Account, then the API keys page.",
            "Click 'New key', enter a name, and optionally restrict it by HTTP origin.",
            "Copy the generated key."
          ],
          "cost": "Free tier: up to 100k tile loads/month, no credit card.",
          "notes": "Free plan is for non-commercial and evaluation use; service pauses for the month once the quota is exhausted."
        }
      }
    }
  },
  "healthCheck": {
    "type": "http",
    "urlTemplate": "https://api.maptiler.com/geocoding/test.json?key=${apiKey}&limit=1",
    "requiredConfigKeys": ["apiKey"]
  },
  "quality": "built-in",
  "category": "Geocoding",
  "dataSources": [
    {
      "sourceId": "maptiler",
      "name": "MapTiler",
      "url": "https://api.maptiler.com/",
      "license": "Proprietary",
      "licenseUrl": "https://www.maptiler.com/terms/cloud/",
      "attribution": "© <a href=\"https://www.maptiler.com/copyright/\">MapTiler</a>",
      "commercialUse": "conditional",
      "providerCountry": "CH",
      "providerPrivacyUrl": "https://www.maptiler.com/privacy-policy/",
      "endUserExposure": "server-only",
      "personalData": false,
      "cookies": false,
      "dpaAvailable": true,
      "dpaUrl": "https://explore.openli.com/privacy/maptiler-cloud/data-processing-agreements"
    }
  ]
}
