{
  "id": "geocoding-maptiler",
  "version": "1.0.0",
  "author": "OpenMapX",
  "license": "MIT",
  "subjectData": {
    "storesPersonalData": false,
    "strategy": "not_personal",
    "registrationIds": [],
    "operatorInstructions": null
  },
  "domains": ["geocoding"],
  "dependencies": ["geocoding"],
  "backend": {
    "routes": false
  },
  "configSchema": {
    "type": "object",
    "properties": {
      "enabled": {
        "type": "boolean",
        "default": true
      },
      "apiKey": {
        "type": "string",
        "title": "MapTiler API Key",
        "description": "MapTiler API key. Get one at maptiler.com/cloud.",
        "x-openmapx-secret": true,
        "x-openmapx-sharedSecretName": "maptiler-api-key",
        "x-openmapx-setup": {
          "url": "https://cloud.maptiler.com/account/keys/",
          "urlLabel": "Get MapTiler API key",
          "steps": [
            "Sign up at cloud.maptiler.com (no credit card required).",
            "Open Account, then the API keys page.",
            "Click 'New key', enter a name, and optionally restrict it by HTTP origin.",
            "Copy the generated key."
          ],
          "cost": "Free tier: up to 100k tile loads/month, no credit card.",
          "notes": "Free plan is for non-commercial and evaluation use; service pauses for the month once the quota is exhausted."
        }
      }
    }
  },
  "healthCheck": {
    "type": "http",
    "urlTemplate": "https://api.maptiler.com/geocoding/test.json?key=${apiKey}&limit=1",
    "requiredConfigKeys": ["apiKey"]
  },
  "quality": "built-in",
  "category": "Geocoding",
  "dataSources": [
    {
      "sourceId": "maptiler",
      "name": "MapTiler",
      "url": "https://api.maptiler.com/",
      "attribution": "© <a href=\"https://www.maptiler.com/copyright/\">MapTiler</a> © <a href=\"https://www.openstreetmap.org/copyright\">OpenStreetMap contributors</a>",
      "commercialUse": "conditional",
      "providerCountry": "CH",
      "providerPrivacyUrl": "https://www.maptiler.com/privacy-policy/",
      "endUserExposure": "server-only",
      "personalData": false,
      "cookies": false,
      "dpaAvailable": true,
      "dpaUrl": "https://explore.openli.com/privacy/maptiler-cloud/data-processing-agreements",
      "licensing": {
        "version": 1,
        "bindings": [
          {
            "scope": "data",
            "subject": "MapTiler material",
            "license": {
              "kind": "unknown"
            }
          },
          {
            "scope": "service",
            "subject": "MapTiler access/account contract",
            "license": {
              "kind": "unknown",
              "url": "https://www.maptiler.com/terms/cloud/"
            },
            "attribution": {
              "placement": "details",
              "surfaces": ["content"],
              "basis": "provider-terms",
              "reviewedAt": "2026-10-14",
              "evidenceUrls": [
                "https://www.maptiler.com/terms/",
                "https://www.maptiler.com/terms/cloud/"
              ],
              "reason": "Only separately scoped search results/database; not map content; Normal hosted map attribution always visible/readable; Small-mobile map permits attribution-only contextual one-tap popup; Free map account logo required; keep visible conservatively"
            }
          }
        ],
        "declarations": [
          {
            "text": "Proprietary",
            "url": "https://www.maptiler.com/terms/cloud/"
          }
        ]
      }
    }
  ]
}
