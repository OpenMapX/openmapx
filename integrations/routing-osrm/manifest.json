{
  "id": "routing-osrm",
  "version": "1.0.0",
  "author": "OpenMapX",
  "license": "MIT",
  "domains": ["routing"],
  "dependencies": ["routing"],
  "infrastructure": {
    "dataRequirements": ["osm-pbf"],
    "planetScale": false
  },
  "backend": {
    "routes": false
  },
  "configSchema": {
    "type": "object",
    "properties": {
      "enabled": {
        "type": "boolean",
        "default": true
      }
    }
  },
  "envVars": [],
  "healthCheck": {
    "type": "ping",
    "url": "https://router.project-osrm.org/route/v1/driving/13.388860,52.517037;13.397634,52.529407?overview=false"
  },
  "quality": "built-in",
  "category": "Routing",
  "dataSources": [
    {
      "sourceId": "osrm",
      "name": "OSRM",
      "url": "https://project-osrm.org/",
      "license": "BSD 2-Clause (software); custom demo server policy",
      "licenseUrl": "https://github.com/Project-OSRM/osrm-backend/wiki/Api-usage-policy",
      "attribution": "<a href=\"https://project-osrm.org/\">OSRM</a>, © <a href=\"https://www.openstreetmap.org/copyright\">OpenStreetMap contributors</a>",
      "commercialUse": "conditional",
      "providerCountry": "DE",
      "providerPrivacyUrl": "https://www.fossgis.de/datenschutzerkl%C3%A4rung/",
      "endUserExposure": "server-only",
      "personalData": false,
      "cookies": false,
      "dpaAvailable": false
    }
  ],
  "requires": [
    {
      "service": "osrm",
      "optional": true
    }
  ]
}
