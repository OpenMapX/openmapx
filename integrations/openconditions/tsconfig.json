{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2024",
    "lib": ["ES2024", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true
  },
  "include": [
    "*.ts",
    "road-conditions",
    "fuel",
    "parking",
    "charging",
    "cameras",
    "signs",
    "road-weather",
    "vehicles",
    "border",
    "hazards",
    "evidence",
    "features",
    "__tests__"
  ]
}
