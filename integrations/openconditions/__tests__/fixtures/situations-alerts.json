      "headline": [
        {
          "lang": "en-US",
          "text": "Small Craft Advisory issued October 8 at 12:03PM AKDT until October 9 at 6:00PM AKDT by NWS Juneau AK"
        }
      ],
      "description": [
        {
          "lang": "en-US",
          "text": "* WHAT...Northwest winds 15 to 25 kt and seas 6 to 9 ft expected.\n\n* WHERE...Cape Decision to Cape Edgecumbe from 15 to 80 NM.\n\n* WHEN...From 1 AM to 6 PM AKDT Friday.\n\n* IMPACTS...Conditions will be hazardous to small craft."
        }
      ],
      "instruction": [
        {
          "lang": "en-US",
          "text": "Inexperienced mariners, especially those operating smaller\nvessels, should avoid navigating in hazardous conditions."
        }
      ],
