{
  "id": "poi-overpass",
  "version": "1.0.0",
  "author": "OpenMapX",
  "license": "MIT",
  "domains": ["poi-search"],
  "infrastructure": {
    "dockerProfile": "overpass",
    "services": ["overpass"],
    "dataRequirements": ["osm-pbf"]
  },
  "backend": {
    "routes": false
  },
  "configSchema": {
    "type": "object",
    "properties": {
      "enabled": {
        "type": "boolean",
        "default": true
      }
    }
  },
  "envVars": [],
  "healthCheck": {
    "type": "ping",
    "url": "https://overpass-api.de/api/status"
  },
  "quality": "built-in",
  "category": "Geocoding",
  "dataSources": [
    {
      "name": "OpenStreetMap (Overpass)",
      "url": "https://overpass-api.de/",
      "license": "ODbL 1.0",
      "licenseUrl": "https://www.openstreetmap.org/copyright",
      "attribution": "© <a href=\"https://www.openstreetmap.org/copyright\">OpenStreetMap contributors</a>",
      "commercialUse": "yes",
      "providerCountry": "UK",
      "providerPrivacyUrl": "https://osmfoundation.org/wiki/Privacy_Policy",
      "endUserExposure": "server-only",
      "personalData": false,
      "cookies": false,
      "dpaAvailable": false
    }
  ]
}
