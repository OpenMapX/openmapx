{
  "id": "poi-overpass",
  "version": "1.0.0",
  "author": "OpenMapX",
  "license": "MIT",
  "domains": ["poi-search"],
  "dependencies": ["poi-search"],
  "infrastructure": {
    "dataRequirements": ["osm-pbf"]
  },
  "backend": {
    "routes": false
  },
  "configSchema": {
    "type": "object",
    "properties": {
      "enabled": {
        "type": "boolean",
        "default": true
      }
    }
  },
  "healthCheck": {
    "type": "ping",
    "url": "https://overpass-api.de/api/status"
  },
  "quality": "built-in",
  "category": "Geocoding",
  "dataSources": [
    {
      "sourceId": "overpass",
      "name": "OpenStreetMap (Overpass)",
      "url": "https://overpass-api.de/",
      "license": "ODbL 1.0",
      "licenseUrl": "https://www.openstreetmap.org/copyright",
      "attribution": "© <a href=\"https://www.openstreetmap.org/copyright\">OpenStreetMap contributors</a>",
      "commercialUse": "yes",
      "providerCountry": "DE",
      "providerPrivacyUrl": "https://osmfoundation.org/wiki/Privacy_Policy",
      "endUserExposure": "server-only",
      "personalData": false,
      "cookies": false,
      "dpaAvailable": false
    },
    {
      "sourceId": "overpass-kumi",
      "name": "Overpass API (Kumi Systems mirror)",
      "url": "https://overpass.kumi.systems/",
      "license": "ODbL-1.0",
      "licenseUrl": "https://opendatacommons.org/licenses/odbl/1-0/",
      "attribution": "© <a href=\"https://www.openstreetmap.org/copyright\">OpenStreetMap contributors</a>",
      "commercialUse": "yes",
      "providerCountry": "AT",
      "providerPrivacyUrl": "https://kumi.systems/en/legal/",
      "endUserExposure": "server-only",
      "personalData": false,
      "cookies": false,
      "dpaAvailable": false
    }
  ],
  "requires": [
    {
      "service": "overpass",
      "optional": true
    }
  ]
}
