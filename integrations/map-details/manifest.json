{
  "id": "map-details",
  "version": "1.0.0",
  "author": "OpenMapX",
  "license": "AGPL-3.0-or-later",
  "domains": ["map-overlay"],
  "frontend": {
    "mapLayer": true,
    "legend": false
  },
  "backend": {
    "routes": false
  },
  "configSchema": {
    "type": "object",
    "properties": {
      "enabled": {
        "type": "boolean",
        "default": true
      }
    }
  },
  "dataSources": [
    {
      "sourceId": "osm-street-detail",
      "name": "OpenStreetMap",
      "url": "https://www.openstreetmap.org/",
      "commercialUse": "yes",
      "attribution": "© <a href=\"https://www.openstreetmap.org/copyright\">OpenStreetMap contributors</a>",
      "providerCountry": "GB",
      "providerPrivacyUrl": "https://wiki.osmfoundation.org/wiki/Privacy_Policy",
      "endUserExposure": "server-only",
      "licensing": {
        "version": 1,
        "bindings": [
          {
            "scope": "data",
            "subject": "OpenStreetMap material",
            "license": {
              "kind": "spdx",
              "expression": "ODbL-1.0",
              "url": "https://opendatacommons.org/licenses/odbl/1-0/"
            }
          }
        ],
        "declarations": [
          {
            "text": "ODbL-1.0",
            "url": "https://opendatacommons.org/licenses/odbl/1-0/"
          }
        ]
      }
    }
  ],
  "quality": "built-in"
}
