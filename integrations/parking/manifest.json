{
  "id": "parking",
  "version": "1.0.0",
  "author": "OpenMapX",
  "license": "MIT",
  "domains": ["data-source"],
  "dependencies": ["data-source"],
  "frontend": {
    "searchCategory": {
      "id": "parking",
      "label": "Parking",
      "iconPath": "M13 3H6v18h4v-6h3c3.31 0 6-2.69 6-6s-2.69-6-6-6zm.2 8H10V7h3.2c1.1 0 2 .9 2 2s-.9 2-2 2z",
      "showInChipBar": true
    }
  },
  "backend": {
    "routes": false
  },
  "configSchema": {
    "type": "object",
    "properties": {
      "enabled": {
        "type": "boolean",
        "default": true
      },
      "clientId": {
        "type": "string",
        "title": "Client ID",
        "description": "Deutsche Bahn Parking API client ID."
      },
      "apiKey": {
        "type": "string",
        "title": "API Key",
        "description": "Deutsche Bahn Parking API key.",
        "x-openmapx-secret": true,
        "x-openmapx-sharedSecretName": "db-parking-api-key"
      },
      "utmcUsername": {
        "type": "string",
        "title": "UTMC Username",
        "description": "NE Travel Data (Newcastle) username. Request via data@glasgow.gov.uk",
        "x-openmapx-secret": true
      },
      "utmcPassword": {
        "type": "string",
        "title": "UTMC Password",
        "description": "NE Travel Data (Newcastle) password.",
        "x-openmapx-secret": true
      },
      "nswTransportApiKey": {
        "type": "string",
        "title": "NSW Transport API Key",
        "description": "Register at https://opendata.transport.nsw.gov.au/",
        "x-openmapx-secret": true
      }
    }
  },
  "envVars": [
    "DB_PARKING_CLIENT_ID",
    "DB_PARKING_API_KEY",
    "UTMC_USERNAME",
    "UTMC_PASSWORD",
    "NSW_TRANSPORT_API_KEY"
  ],
  "healthCheck": [
    {
      "name": "ParkAPI",
      "type": "http",
      "url": "https://api.mobidata-bw.de/park-api/api/public/v3/parking-sites?limit=1"
    },
    {
      "name": "DB BahnPark",
      "type": "http",
      "urlTemplate": "https://apis.deutschebahn.com/db-api-marketplace/apis/parking-information/db-bahnpark/v2/parking-facilities?limit=1",
      "headers": {
        "DB-Client-Id": "${DB_PARKING_CLIENT_ID}",
        "DB-Api-Key": "${DB_PARKING_API_KEY}"
      },
      "requiredEnvVars": ["DB_PARKING_CLIENT_ID", "DB_PARKING_API_KEY"]
    },
    {
      "name": "ParkenDD",
      "type": "http",
      "url": "https://api.parkendd.de"
    },
    {
