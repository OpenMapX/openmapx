{
  "id": "overlay-nautical",
  "version": "1.0.0",
  "author": "OpenMapX",
  "license": "MIT",
  "documentation": "https://wiki.openstreetmap.org/wiki/OpenSeaMap",
  "domains": ["map-overlay"],
  "frontend": {
    "mapLayer": true,
    "legend": true,
    "panel": false,
    "layerSelector": {
      "group": "map-details",
      "labelKey": "nautical",
      "icon": "sailing",
      "iconPath": "M3 13.5L2.5 22h19l-.5-8.5h-3.5l-1.5-4.5L13.5 5l-2.5 4-1.5 4.5H3.5l-.5 0zM12 6.5l1.5 4.5L13 13H11l-.5-2 1.5-4.5z",
      "quickSelector": true,
      "preview": "preview.svg"
    },
    "overlay": {
      "excludes": ["weather", "air-quality"]
    }
  },
  "backend": {
    "routes": true
  },
  "configSchema": {
    "type": "object",
    "properties": {
      "enabled": {
        "type": "boolean",
        "default": true
      },
      "seamarkTileBase": {
        "type": "string",
        "default": "https://tiles.openseamap.org/seamark",
        "title": "OpenSeaMap seamark tile base URL",
        "description": "Upstream tile server for OpenSeaMap seamark overlay. Override to point at a self-hosted mirror."
      },
      "depthWmsUrl": {
        "type": "string",
        "default": "https://depth.openseamap.org/geoserver/openseamap/wms",
        "title": "OpenSeaMap depth WMS URL"
      },
      "gebcoWmsUrl": {
        "type": "string",
        "default": "https://wms.gebco.net/mapserv",
        "title": "GEBCO bathymetry WMS URL"
      },
      "noaaWmsUrl": {
        "type": "string",
        "default": "https://gis.charttools.noaa.gov/arcgis/rest/services/MCS/NOAAChartDisplay/MapServer/exts/MaritimeChartService/WMSServer",
        "title": "NOAA Maritime Chart Service WMS URL"
      },
      "kartverketWmsUrl": {
        "type": "string",
        "default": "https://wms.geonorge.no/skwms1/wms.sjokartraster2",
        "title": "Kartverket Sjøkart 2 WMS URL (Norway)"
      },
      "kartverketLayer": {
        "type": "string",
        "default": "all",
        "title": "Kartverket Sjøkart layer name"
      },
      "harbourApiUrl": {
        "type": "string",
        "default": "https://harbour.openseamap.org/getHarbours.php",
        "title": "OpenSeaMap harbour list API URL"
      }
    }
  },
  "requires": [
    {
      "service": "overpass",
      "optional": true
    }
  ],
  "healthCheck": [
    {
      "name": "OpenSeaMap seamark tiles",
      "type": "http",
      "url": "https://tiles.openseamap.org/seamark/0/0/0.png"
    },
    {
      "name": "OpenSeaMap depth WMS",
      "type": "http",
      "url": "https://depth.openseamap.org/geoserver/openseamap/wms?service=WMS&request=GetCapabilities"
    },
    {
      "name": "GEBCO bathymetry WMS",
      "type": "http",
      "url": "https://wms.gebco.net/mapserv?request=getcapabilities&service=wms&version=1.3.0"
    },
    {
      "name": "NOAA Maritime Chart Service",
      "type": "http",
      "url": "https://gis.charttools.noaa.gov/arcgis/rest/services/MCS/NOAAChartDisplay/MapServer?f=json"
    },
    {
      "name": "OpenSeaMap harbour API",
      "type": "http",
      "url": "https://harbour.openseamap.org/getHarbours.php?b=42&t=43&l=10&r=11&zoom=10"
    },
    {
      "name": "NOAA CO-OPS MDAPI",
      "type": "http",
      "url": "https://api.tidesandcurrents.noaa.gov/mdapi/prod/webapi/stations.json?type=tidepredictions&units=english"
    },
    {
      "name": "Kartverket Sjøkart 2",
      "type": "http",
      "url": "https://wms.geonorge.no/skwms1/wms.sjokartraster2?service=WMS&request=GetCapabilities"
    },
    {
      "name": "DFO IWLS (Canada) station catalog",
      "type": "http",
      "url": "https://api-iwls.dfo-mpo.gc.ca/api/v1/stations?max=1"
    },
    {
      "name": "Kartverket Sehavnivå (Norway) station list",
      "type": "http",
      "url": "https://vannstand.kartverket.no/tideapi.php?tide_request=stationlist&type=perm&lang=en"
    },
    {
      "name": "WSV Pegelonline (Germany) coastal stations",
      "type": "http",
      "url": "https://www.pegelonline.wsv.de/webservices/rest-api/v2/stations.json?waters=NORDSEE,OSTSEE&prettyprint=false"
    },
    {
      "name": "IOC Sea Level Monitoring",
      "type": "http",
      "url": "http://www.ioc-sealevelmonitoring.org/service.php?query=stationlist&format=json"
    },
    {
      "name": "EMODnet Physics tide gauges",
      "type": "http",
      "url": "https://prod-geoserver.emodnet-physics.eu/geoserver/EMODnet/wfs?service=WFS&version=2.0.0&request=GetCapabilities"
    }
  ],
  "quality": "built-in",
  "category": "Map Overlays",
