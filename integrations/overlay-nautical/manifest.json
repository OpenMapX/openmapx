{
  "id": "overlay-nautical",
  "version": "1.0.0",
  "author": "OpenMapX",
  "license": "MIT",
  "documentation": "https://wiki.openstreetmap.org/wiki/OpenSeaMap",
  "subjectData": {
    "storesPersonalData": false,
    "strategy": "not_personal",
    "registrationIds": [],
    "operatorInstructions": null
  },
  "domains": ["map-overlay"],
  "frontend": {
    "mapLayer": true,
    "legend": true,
    "panel": false,
    "layerSelector": {
      "group": "map-details",
      "labelKey": "nautical",
      "icon": "sailing",
      "iconPath": "M3 13.5L2.5 22h19l-.5-8.5h-3.5l-1.5-4.5L13.5 5l-2.5 4-1.5 4.5H3.5l-.5 0zM12 6.5l1.5 4.5L13 13H11l-.5-2 1.5-4.5z",
      "quickSelector": true,
      "preview": "preview.svg"
    },
    "overlay": {
      "excludes": ["weather", "air-quality"]
    }
  },
  "backend": {
    "routes": true
  },
  "configSchema": {
    "type": "object",
    "properties": {
      "enabled": {
        "type": "boolean",
        "default": true
      },
      "seamarkTileBase": {
        "type": "string",
        "default": "https://tiles.openseamap.org/seamark",
        "title": "OpenSeaMap seamark tile base URL",
        "description": "Upstream tile server for OpenSeaMap seamark overlay. Override to point at a self-hosted mirror."
      },
      "depthWmsUrl": {
        "type": "string",
        "default": "https://depth.openseamap.org/geoserver/openseamap/wms",
        "title": "OpenSeaMap depth WMS URL"
      },
      "gebcoWmsUrl": {
        "type": "string",
        "default": "https://wms.gebco.net/mapserv",
        "title": "GEBCO bathymetry WMS URL"
      },
      "noaaWmsUrl": {
        "type": "string",
        "default": "https://gis.charttools.noaa.gov/arcgis/rest/services/MCS/NOAAChartDisplay/MapServer/exts/MaritimeChartService/WMSServer",
        "title": "NOAA Maritime Chart Service WMS URL"
      },
      "kartverketWmsUrl": {
        "type": "string",
        "default": "https://wms.geonorge.no/skwms1/wms.sjokartraster2",
        "title": "Kartverket Sjøkart 2 WMS URL (Norway)"
      },
      "kartverketLayer": {
        "type": "string",
        "default": "all",
        "title": "Kartverket Sjøkart layer name"
      },
      "harbourApiUrl": {
        "type": "string",
        "default": "https://harbour.openseamap.org/getHarbours.php",
        "title": "OpenSeaMap harbour list API URL"
      }
    }
  },
  "requires": [
    {
      "service": "overpass",
      "optional": true
    }
  ],
  "healthCheck": [
    {
      "name": "OpenSeaMap seamark tiles",
      "type": "http",
      "url": "https://tiles.openseamap.org/seamark/0/0/0.png"
    },
    {
      "name": "OpenSeaMap depth WMS",
      "type": "http",
      "url": "https://depth.openseamap.org/geoserver/openseamap/wms?service=WMS&request=GetCapabilities"
    },
    {
      "name": "GEBCO bathymetry WMS",
      "type": "http",
      "url": "https://wms.gebco.net/mapserv?request=getcapabilities&service=wms&version=1.3.0"
    },
    {
      "name": "NOAA Maritime Chart Service",
      "type": "http",
      "url": "https://gis.charttools.noaa.gov/arcgis/rest/services/MCS/NOAAChartDisplay/MapServer?f=json"
