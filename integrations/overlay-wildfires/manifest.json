  "domains": ["map-overlay"],
  "frontend": {
    "mapLayer": true,
    "legend": true,
    "panel": false,
    "layerSelector": {
      "group": "map-details",
      "labelKey": "wildfires",
      "icon": "local_fire_department",
      "iconPath": "M13.5 .67s.74 2.65.74 4.8c0 2.06-1.35 3.73-3.41 3.73-2.07 0-3.63-1.67-3.63-3.73l.03-.36C5.21 7.51 4 10.62 4 14c0 4.42 3.58 8 8 8s8-3.58 8-8C20 8.61 17.41 3.8 13.5.67zM11.71 19c-1.78 0-3.22-1.4-3.22-3.14 0-1.62 1.05-2.76 2.81-3.12 1.77-.36 3.6-1.21 4.62-2.58.39 1.29.59 2.65.59 4.04 0 2.65-2.15 4.8-4.8 4.8z",
      "preview": "preview.svg"
    },
    "overlay": {
      "excludes": ["street-level-imagery", "air-quality", "earthquakes"]
    }
  },
  "backend": {
    "routes": true
  },
  "configSchema": {
    "type": "object",
    "properties": {
      "enabled": {
        "type": "boolean",
        "default": true
      },
      "firmsApiKey": {
        "type": "string",
        "title": "NASA FIRMS Map Key",
        "description": "NASA FIRMS map key.",
        "x-openmapx-secret": true,
        "x-openmapx-setup": {
          "url": "https://firms.modaps.eosdis.nasa.gov/api/map_key/",
          "urlLabel": "Request a FIRMS MAP_KEY",
          "steps": [
            "Open firms.modaps.eosdis.nasa.gov/api/map_key/.",
            "Enter your email address in the MAP_KEY request form and submit.",
            "Check your inbox — FIRMS emails the MAP_KEY to that address.",
            "Paste the MAP_KEY here."
          ],
          "cost": "Free.",
          "notes": "Rate limit is 5000 transactions per 10-minute interval. Return to the same page later to resend, modify, or delete the key."
        }
      }
    }
  },
  "healthCheck": {
    "type": "http",
    "urlTemplate": "https://firms.modaps.eosdis.nasa.gov/api/area/csv/${firmsApiKey}/VIIRS_SNPP_NRT/0,0,1,1/1",
    "requiredConfigKeys": ["firmsApiKey"]
  },
  "quality": "built-in",
  "category": "Data Overlays",
