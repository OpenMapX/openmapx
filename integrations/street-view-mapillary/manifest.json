{
  "id": "street-view-mapillary",
  "version": "1.0.0",
  "author": "OpenMapX",
  "license": "MIT",
  "documentation": "https://www.mapillary.com/developer",
  "domains": ["street-view", "map-overlay"],
  "frontend": {
    "mapLayer": true,
    "legend": true,
    "panel": false,
    "layerSelector": {
      "group": "map-details",
      "labelKey": "streetLevelImagery",
      "icon": "streetview"
    },
    "overlay": {
      "excludes": ["air-quality", "earthquakes", "wildfires", "winter-sports", "hiking"]
    }
  },
  "backend": {
    "routes": true
  },
  "configSchema": {
    "type": "object",
    "properties": {
      "enabled": {
        "type": "boolean",
        "default": true
      }
    }
  },
  "envVars": ["MAPILLARY_TOKEN"],
  "healthCheck": {
    "type": "http",
    "url": "https://graph.mapillary.com",
    "requiredEnvVars": ["MAPILLARY_TOKEN"],
    "category": "Imagery"
  },
  "quality": "built-in",
  "attribution": [
    {
      "name": "Mapillary",
      "url": "https://www.mapillary.com/",
      "license": "CC BY-SA 4.0"
    }
  ],
  "privacy": {
    "providerCountry": "SE",
    "providerPrivacyUrl": "https://www.mapillary.com/privacy",
    "personalData": false,
    "cookies": false
  }
}
