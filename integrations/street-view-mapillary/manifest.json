{
  "id": "street-view-mapillary",
  "version": "1.0.0",
  "author": "OpenMapX",
  "license": "MIT",
  "documentation": "https://www.mapillary.com/developer",
  "domains": ["street-view", "map-overlay"],
  "frontend": {
    "mapLayer": true,
    "legend": true,
    "panel": false,
    "layerSelector": {
      "group": "map-details",
      "labelKey": "streetLevelImagery",
      "icon": "streetview"
    },
    "overlay": {
      "excludes": ["air-quality", "earthquakes", "wildfires", "winter-sports", "hiking"]
    }
  },
  "backend": {
    "routes": true
  },
  "configSchema": {
    "type": "object",
    "properties": {
      "enabled": {
        "type": "boolean",
        "default": true
      },
      "accessToken": {
        "type": "string",
        "title": "Mapillary Access Token",
        "description": "Mapillary client access token for the Graph API.",
        "x-openmapx-secret": true,
        "x-openmapx-sharedSecretName": "mapillary-token"
      }
    }
  },
  "healthCheck": {
    "type": "http",
    "urlTemplate": "https://graph.mapillary.com/images?access_token=${accessToken}&fields=id&limit=1",
    "requiredConfigKeys": ["accessToken"]
  },
  "quality": "built-in",
  "category": "Imagery",
  "dataSources": [
    {
      "sourceId": "mapillary",
      "name": "Mapillary",
      "url": "https://www.mapillary.com/",
      "license": "CC BY-SA 4.0 (imagery); Proprietary (API)",
      "licenseUrl": "https://www.mapillary.com/terms",
      "commercialUse": "conditional",
      "providerCountry": "IE",
      "providerPrivacyUrl": "https://www.mapillary.com/privacy",
      "endUserExposure": "direct",
      "personalData": false,
      "cookies": false,
      "dpaAvailable": false
    }
  ]
}
