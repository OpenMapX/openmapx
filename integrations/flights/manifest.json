{
  "id": "flights",
  "version": "1.0.0",
  "author": "OpenMapX",
  "license": "MIT",
  "subjectData": {
    "storesPersonalData": false,
    "strategy": "not_personal",
    "registrationIds": [],
    "operatorInstructions": null
  },
  "domains": ["flight-search"],
  "backend": {
    "routes": true
  },
  "configSchema": {
    "type": "object",
    "properties": {
      "enabled": {
        "type": "boolean",
        "default": true
      },
      "defaultProvider": {
        "type": "string",
        "title": "Default flight search engine",
        "description": "Which external flight-search engine is pre-selected in the directions panel.",
        "enum": ["skyscanner", "google", "kayak", "kiwi", "momondo", "skiplagged"],
        "default": "skyscanner"
      },
      "skyscannerMediaPartnerId": {
        "type": "string",
        "title": "Skyscanner Affiliate (Impact) mediaPartnerId",
        "description": "Optional. When set, Skyscanner links use the affiliate referral schema so commissions are tracked. Leave empty to deep-link via the plain consumer URL (no account required)."
      }
    }
  },
  "quality": "built-in",
  "category": "External",
  "dataSources": [
    {
      "sourceId": "skyscanner",
      "name": "Skyscanner",
      "url": "https://www.skyscanner.net/",
      "commercialUse": "conditional",
      "providerCountry": "GB",
      "providerPrivacyUrl": "https://www.skyscanner.net/privacy-policy",
      "endUserExposure": "direct",
      "personalData": true,
      "cookies": true,
      "dpaAvailable": false,
      "licensing": {
        "version": 1,
        "bindings": [
          {
            "scope": "service",
            "subject": "Skyscanner link/handoff permission",
            "license": {
              "kind": "unknown",
              "raw": "Proprietary (deep-link only); action identity not dataset grant.",
              "url": "https://www.skyscanner.net/media/terms-of-service"
            }
          }
        ],
        "declarations": [
          {
            "text": "Proprietary (deep-link only)",
