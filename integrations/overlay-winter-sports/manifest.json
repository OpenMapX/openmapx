              "evidenceUrls": ["https://www.opensnowmap.org/iframes/about.eng.html"],
              "reason": "Exact product/operator/file grant or placement remains unresolved; no generic licence-only collapse clearance"
            }
          }
        ],
        "declarations": [
          {
