{
  "id": "overlay-winter-sports",
  "version": "1.0.0",
  "author": "OpenMapX",
  "license": "MIT",
  "documentation": "https://www.opensnowmap.org/",
  "subjectData": {
    "storesPersonalData": false,
    "strategy": "not_personal",
    "registrationIds": [],
    "operatorInstructions": null
  },
  "domains": ["map-overlay"],
  "frontend": {
    "mapLayer": true,
    "legend": true,
    "panel": false,
    "layerSelector": {
      "group": "map-details",
      "labelKey": "winterSports",
      "icon": "ac_unit",
      "preview": "preview.svg"
    },
    "overlay": {
      "excludes": ["street-level-imagery", "hiking"]
    }
  },
  "backend": {
    "routes": true
  },
  "configSchema": {
    "type": "object",
    "properties": {
      "enabled": {
        "type": "boolean",
        "default": true
      },
      "tileUrl": {
        "type": "string",
        "title": "Tile URL template",
        "description": "Tile URL with `{z}/{x}/{y}` placeholders. Defaults to the OpenSnowMap pistes tileset.",
        "format": "url"
      }
    }
  },
  "healthCheck": {
    "type": "http",
    "url": "https://tiles.opensnowmap.org/pistes/0/0/0.png"
  },
  "quality": "built-in",
  "category": "Map Overlays",
  "dataSources": [
    {
      "sourceId": "opensnowmap",
      "name": "OpenSnowMap",
      "url": "https://www.opensnowmap.org/",
      "attribution": "<a href=\"https://www.opensnowmap.org/\">OpenSnowMap</a>, © <a href=\"https://www.openstreetmap.org/copyright\">OpenStreetMap contributors</a>",
      "commercialUse": "yes",
      "providerCountry": "FR",
      "providerPrivacyUrl": "-",
      "endUserExposure": "proxied",
      "personalData": false,
      "cookies": false,
      "dpaAvailable": false,
      "licensing": {
        "version": 1,
        "bindings": [
          {
            "scope": "imagery",
            "subject": "OpenSnowMap rendered tiles",
            "license": {
              "kind": "unknown",
              "raw": "CC BY-SA"
            },
            "attribution": {
              "placement": "visible",
              "surfaces": ["map", "content", "image"],
              "basis": "unresolved",
              "reviewedAt": "2026-10-14",
              "evidenceUrls": ["https://www.opensnowmap.org/iframes/about.eng.html"],
              "reason": "Exact product/operator/file grant or placement remains unresolved; no generic licence-only collapse clearance"
            }
          },
          {
            "scope": "data",
            "subject": "Underlying OSM database",
