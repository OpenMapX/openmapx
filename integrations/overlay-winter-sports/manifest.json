{
  "id": "overlay-winter-sports",
  "version": "1.0.0",
  "author": "OpenMapX",
  "license": "MIT",
  "documentation": "https://www.opensnowmap.org/",
  "domains": ["map-overlay"],
  "frontend": {
    "mapLayer": true,
    "legend": true,
    "panel": false,
    "layerSelector": {
      "group": "map-details",
      "labelKey": "winterSports",
      "icon": "ac_unit"
    },
    "overlay": {
      "excludes": ["street-view", "hiking"]
    }
  },
  "backend": {
    "routes": false
  },
  "configSchema": {
    "type": "object",
    "properties": {
      "enabled": {
        "type": "boolean",
        "default": true
      }
    }
  },
  "envVars": [],
  "healthCheck": {
    "type": "http",
    "url": "https://tiles.opensnowmap.org/pistes/0/0/0.png"
  },
  "quality": "built-in",
  "category": "Map Overlays",
  "attribution": [
    {
      "name": "OpenSnowMap",
      "url": "https://www.opensnowmap.org/",
      "license": "CC BY-SA 3.0",
      "licenseUrl": "https://creativecommons.org/licenses/by-sa/3.0/"
    }
  ],
  "privacy": [
    {
      "providerCountry": "CH",
      "providerPrivacyUrl": "https://www.opensnowmap.org/",
      "personalData": false,
      "cookies": false
    }
  ]
}
