{
  "id": "overlay-winter-sports",
  "version": "1.0.0",
  "author": "OpenMapX",
  "license": "MIT",
  "documentation": "https://www.opensnowmap.org/",
  "domains": ["map-overlay"],
  "frontend": {
    "mapLayer": true,
    "legend": true,
    "panel": false,
    "layerSelector": {
      "group": "map-details",
      "labelKey": "winterSports",
      "icon": "ac_unit",
      "preview": "preview.svg"
    },
    "overlay": {
      "excludes": ["street-view", "hiking"]
    }
  },
  "backend": {
    "routes": true
  },
  "configSchema": {
    "type": "object",
    "properties": {
      "enabled": {
        "type": "boolean",
        "default": true
      },
      "tileUrl": {
        "type": "string",
        "title": "Tile URL template",
        "description": "Tile URL with `{z}/{x}/{y}` placeholders. Defaults to the OpenSnowMap pistes tileset.",
        "format": "url"
      }
    }
  },
  "healthCheck": {
    "type": "http",
    "url": "https://tiles.opensnowmap.org/pistes/0/0/0.png"
  },
  "quality": "built-in",
  "category": "Map Overlays",
  "dataSources": [
    {
      "sourceId": "opensnowmap",
      "name": "OpenSnowMap",
      "url": "https://www.opensnowmap.org/",
      "license": "CC BY-SA (tiles); ODbL (OSM data)",
      "licenseUrl": "https://www.opensnowmap.org/iframes/about.eng.html",
      "attribution": "<a href=\"https://www.opensnowmap.org/\">OpenSnowMap</a>, © <a href=\"https://www.openstreetmap.org/copyright\">OpenStreetMap contributors</a>",
      "commercialUse": "yes",
      "providerCountry": "FR",
      "providerPrivacyUrl": "-",
      "endUserExposure": "proxied",
      "personalData": false,
      "cookies": false,
      "dpaAvailable": false
    }
  ]
}
