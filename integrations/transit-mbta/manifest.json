{
  "id": "transit-mbta",
  "version": "1.0.0",
  "author": "OpenMapX",
  "license": "MIT",
  "quality": "built-in",
  "subjectData": {
    "storesPersonalData": false,
    "strategy": "not_personal",
    "registrationIds": [],
    "operatorInstructions": null
  },
  "domains": ["transit"],
  "category": "Transit",
  "configSchema": {
    "type": "object",
    "properties": {
      "enabled": {
        "type": "boolean",
        "default": true
      },
      "apiKey": {
        "type": "string",
        "title": "MBTA API Key",
        "description": "MBTA v3 API key.",
        "x-openmapx-secret": true,
        "x-openmapx-setup": {
          "url": "https://api-v3.mbta.com/register",
          "urlLabel": "Get MBTA API key",
          "steps": [
            "Go to api-v3.mbta.com/register and create an account with your email and password.",
            "Verify your email, then sign in to the MBTA V3 API client portal.",
            "Request a key for your application (issuing may take up to a day).",
            "Copy the generated API key."
          ],
          "cost": "Free. A registered key raises the limit from 20 req/min (unauthenticated) to a default of 1,000 req/min.",
          "notes": "OpenMapX requires a configured key for every MBTA request. The integration selects the API version; streaming is not used. You can request a higher rate limit from within the portal."
        }
      }
    }
  },
  "backend": {
    "routes": false
  },
  "healthCheck": {
    "type": "http",
    "url": "https://api-v3.mbta.com/",
    "requiredConfigKeys": ["apiKey"]
  },
  "dataSources": [
    {
      "sourceId": "mbta",
      "name": "MBTA",
      "url": "https://api-v3.mbta.com/",
      "commercialUse": "yes",
      "providerCountry": "US",
      "providerPrivacyUrl": "https://www.mbta.com/policies/privacy-policy",
      "endUserExposure": "server-only",
      "personalData": false,
      "cookies": false,
      "dpaAvailable": false,
      "licensing": {
        "version": 1,
        "bindings": [
          {
            "scope": "data",
            "subject": "MBTA material",
            "license": {
              "kind": "unknown"
            }
          },
          {
            "scope": "service",
            "subject": "MBTA access/account contract",
            "license": {
              "kind": "unknown",
              "url": "https://www.mbta.com/developers/v3-api"
            }
          }
        ],
        "declarations": [
          {
            "text": "Proprietary (MassDOT Developers License)",
            "url": "https://www.mbta.com/developers/v3-api"
          }
        ]
      }
    }
  ],
  "dependencies": ["transit"]
}
