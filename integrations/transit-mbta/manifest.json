{
  "id": "transit-mbta",
  "version": "1.0.0",
  "author": "OpenMapX",
  "license": "MIT",
  "quality": "built-in",
  "domains": ["transit"],
  "category": "Transit",
  "envVars": ["MBTA_API_KEY"],
  "configSchema": {
    "type": "object",
    "properties": {
      "enabled": {
        "type": "boolean",
        "default": true
      },
      "apiKey": {
        "type": "string",
        "title": "API Key",
        "description": "MBTA v3 API key.",
        "x-openmapx-secret": true
      }
    }
  },
  "backend": {
    "routes": false
  },
  "healthCheck": {
    "type": "http",
    "urlTemplate": "https://api-v3.mbta.com/stops?filter[latitude]=42.36&filter[longitude]=-71.06&filter[radius]=0.01&api_key=${MBTA_API_KEY}",
    "requiredEnvVars": ["MBTA_API_KEY"]
  },
  "dataSources": [
    {
      "sourceId": "mbta",
      "name": "MBTA",
      "url": "https://api-v3.mbta.com/",
      "license": "Proprietary (MassDOT Developers License)",
      "licenseUrl": "https://www.mbta.com/developers/v3-api",
      "commercialUse": "yes",
      "providerCountry": "US",
      "providerPrivacyUrl": "https://www.mbta.com/policies/privacy-policy",
      "endUserExposure": "server-only",
      "personalData": false,
      "cookies": false,
      "dpaAvailable": false
    }
  ],
  "dependencies": ["transit"]
}
