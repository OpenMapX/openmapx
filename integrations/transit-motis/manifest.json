{
  "id": "transit-motis",
  "version": "1.0.0",
  "author": "OpenMapX",
  "license": "MIT",
  "quality": "built-in",
  "domains": ["transit"],
  "infrastructure": {
    "dockerProfile": "transit",
    "services": ["motis"],
    "dataRequirements": ["osm-pbf", "gtfs-feeds"]
  },
  "category": "Transit",
  "envVars": [],
  "configSchema": {
    "type": "object",
    "properties": {
      "enabled": {
        "type": "boolean",
        "default": true,
        "description": "Enable MOTIS/Transitous transit integration"
      }
    }
  },
  "backend": {
    "routes": true
  },
  "healthCheck": {
    "type": "http",
    "url": "https://api.transitous.org/api/v1/geocode?text=test"
  },
  "dataSources": [
    {
      "sourceId": "transitous",
      "name": "Transitous (Cloud MOTIS)",
      "url": "https://api.transitous.org/",
      "license": "AGPL-3.0-or-later",
      "licenseUrl": "https://transitous.org/api/",
      "commercialUse": "no",
      "providerCountry": "DE",
      "providerPrivacyUrl": "https://transitous.org/privacy/",
      "endUserExposure": "server-only",
      "personalData": false,
      "cookies": false,
      "dpaAvailable": false
    },
    {
      "sourceId": "motis",
      "name": "MOTIS (self-hosted)",
      "url": "https://github.com/motis-project/motis",
      "license": "MIT",
      "licenseUrl": "https://github.com/motis-project/motis",
      "commercialUse": "yes",
      "providerCountry": "DE",
      "providerPrivacyUrl": "-",
      "endUserExposure": "server-only",
      "personalData": false,
      "cookies": false,
      "dpaAvailable": false
    }
  ],
  "dependencies": ["transit"]
}
