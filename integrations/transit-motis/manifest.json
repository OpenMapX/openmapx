{
  "id": "transit-motis",
  "version": "1.0.0",
  "author": "OpenMapX",
  "license": "MIT",
  "quality": "built-in",
  "domains": ["transit"],
  "infrastructure": {
    "dockerProfile": "transit",
    "services": ["motis"],
    "dataRequirements": ["osm-pbf", "gtfs-feeds"]
  },
  "category": "Transit",
  "envVars": [],
  "configSchema": {
    "type": "object",
    "properties": {
      "enabled": {
        "type": "boolean",
        "default": true,
        "description": "Enable MOTIS/Transitous transit integration"
      }
    }
  },
  "backend": {
    "routes": true
  },
  "healthCheck": {
    "type": "http",
    "url": "https://api.transitous.org/api/v1/geocode?text=test"
  },
  "attribution": [
    {
      "name": "Transitous/MOTIS",
      "url": "https://transitous.org/",
      "license": "AGPL-3.0",
      "licenseUrl": "https://www.gnu.org/licenses/agpl-3.0.html"
    },
    {
      "name": "Various GTFS Feeds",
      "url": "https://transitous.org/",
      "license": "Various (per feed)",
      "dynamic": true,
      "dynamicEndpoint": "/api/integrations/transit-motis/attribution"
    }
  ],
  "privacy": [
    {
      "providerCountry": "DE",
      "providerPrivacyUrl": "https://transitous.org/",
      "personalData": false
    }
  ]
}
