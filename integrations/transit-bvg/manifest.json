{
  "id": "transit-bvg",
  "version": "1.0.0",
  "author": "OpenMapX",
  "license": "MIT",
  "quality": "built-in",
  "domains": ["transit"],
  "category": "Transit",
  "configSchema": {
    "type": "object",
    "properties": {
      "enabled": {
        "type": "boolean",
        "default": true,
        "description": "Enable BVG Transit integration"
      }
    }
  },
  "backend": {
    "routes": false
  },
  "healthCheck": {
    "type": "ping",
    "url": "https://v6.bvg.transport.rest/locations/nearby?latitude=52.52&longitude=13.405&results=1"
  },
  "dataSources": [
    {
      "sourceId": "bvg",
      "name": "BVG HAFAS REST API (transport.rest)",
      "url": "https://v6.bvg.transport.rest/",
      "license": "ISC (software); no open license for data",
      "licenseUrl": "https://github.com/public-transport/hafas-rest-api",
      "commercialUse": "unknown",
      "providerCountry": "DE",
      "providerPrivacyUrl": "-",
      "endUserExposure": "server-only",
      "personalData": false,
      "cookies": false,
      "dpaAvailable": false
    }
  ],
  "dependencies": ["transit"]
}
