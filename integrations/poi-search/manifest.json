      "providerCountry": "US",
      "providerPrivacyUrl": "https://docs.github.com/en/site-policy/privacy-policies/github-general-privacy-statement",
      "endUserExposure": "server-only",
      "personalData": false,
      "cookies": false,
      "dpaAvailable": false,
      "licensing": {
        "version": 1,
        "bindings": [
          {
            "scope": "data",
            "subject": "Name Suggestion Index dataset",
            "license": {
              "kind": "spdx",
              "expression": "BSD-3-Clause"
            }
          },
          {
            "scope": "imagery",
            "subject": "Embedded Commons logos and brands",
            "license": {
              "kind": "per-item",
              "raw": "Determined by each contributing item or operator"
            }
          }
        ],
        "declarations": [
          {
            "text": "BSD-3-Clause",
            "url": "https://github.com/osmlab/name-suggestion-index/blob/main/LICENSE.md"
          }
        ]
      }
    },
    {
      "sourceId": "wikimedia-commons-logos",
      "name": "Wikimedia Commons (brand logos)",
      "url": "https://commons.wikimedia.org/",
      "commercialUse": "yes",
      "providerCountry": "US",
      "providerPrivacyUrl": "https://foundation.wikimedia.org/wiki/Policy:Privacy_policy",
      "endUserExposure": "server-only",
      "personalData": false,
      "cookies": false,
      "dpaAvailable": false,
      "licensing": {
        "version": 1,
        "bindings": [
          {
            "scope": "imagery",
            "subject": "Each returned image/file and actual creator",
            "license": {
              "kind": "per-item",
              "raw": "Per-file (CC BY-SA, CC BY, or Public Domain)",
              "url": "https://commons.wikimedia.org/wiki/Commons:Licensing"
            }
          }
        ],
        "declarations": [
          {
            "text": "Per-file (CC BY-SA, CC BY, or Public Domain)",
            "url": "https://commons.wikimedia.org/wiki/Commons:Licensing"
          }
        ]
      }
    },
    {
      "sourceId": "wikidata",
      "name": "Wikidata",
      "url": "https://www.wikidata.org/",
      "commercialUse": "yes",
      "providerCountry": "US",
      "providerPrivacyUrl": "https://foundation.wikimedia.org/wiki/Policy:Privacy_policy",
      "endUserExposure": "build-time",
      "personalData": false,
      "cookies": false,
      "dpaAvailable": false,
      "licensing": {
        "version": 1,
        "bindings": [
          {
            "scope": "data",
            "subject": "Wikidata material",
            "license": {
              "kind": "spdx",
              "expression": "CC0-1.0",
              "url": "https://www.wikidata.org/wiki/Wikidata:Licensing"
            }
          }
        ],
        "declarations": [
          {
            "text": "CC0-1.0",
            "url": "https://www.wikidata.org/wiki/Wikidata:Licensing"
          }
        ]
