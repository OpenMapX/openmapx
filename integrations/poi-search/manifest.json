{
  "id": "poi-search",
  "version": "1.0.0",
  "author": "OpenMapX",
  "license": "MIT",
  "subjectData": {
    "storesPersonalData": false,
    "strategy": "not_personal",
    "registrationIds": [],
    "operatorInstructions": null
  },
  "domains": ["poi-search"],
  "backend": {
    "routes": true
  },
  "quality": "built-in",
  "category": "Geocoding",
  "requires": [
    {
      "service": "postgis",
      "optional": true
    }
  ],
  "dataSources": [
