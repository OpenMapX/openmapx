{
  "id": "street-level-imagery-mapillary",
  "version": "1.0.0",
  "author": "OpenMapX",
  "license": "MIT",
  "documentation": "https://www.mapillary.com/developer",
  "subjectData": {
    "storesPersonalData": false,
    "strategy": "not_personal",
    "registrationIds": [],
    "operatorInstructions": null
  },
  "domains": ["street-level-imagery", "map-overlay"],
  "frontend": {
    "mapLayer": true,
    "sharedMapLayer": "street-level-imagery",
    "legend": true,
    "panel": false,
    "layerSelector": {
      "group": "map-details",
      "labelKey": "streetLevelImagery",
      "icon": "panorama",
      "preview": "preview.svg"
    },
    "overlay": {
      "excludes": ["air-quality", "earthquakes", "wildfires", "winter-sports", "hiking"],
      "minZoom": 6
    }
  },
  "backend": {
    "routes": true
  },
  "configSchema": {
    "type": "object",
    "properties": {
      "enabled": {
        "type": "boolean",
        "default": false,
        "description": "Disabled by default. Mapillary's Terms restrict use in connection with real-time navigation or route guidance, and require apps to materially supplement rather than replicate Mapillary. Enable only if you have reviewed those terms for your deployment."
      },
      "accessToken": {
        "type": "string",
        "title": "Mapillary Access Token",
        "description": "Mapillary client access token for the Graph API.",
        "x-openmapx-secret": true,
        "x-openmapx-sharedSecretName": "mapillary-token",
        "x-openmapx-setup": {
          "url": "https://www.mapillary.com/dashboard/developers",
          "urlLabel": "Get Mapillary access token",
          "steps": [
            "Sign in at mapillary.com and open the Developers dashboard.",
            "Click 'Register Application'.",
            "Fill in the application details and submit.",
            "Copy the Client Token (format MLY|...) for use as the Graph API v4 access token."
          ],
          "notes": "Same Mapillary account/token as photos-mapillary."
        }
      }
    }
  },
  "healthCheck": {
    "type": "http",
    "urlTemplate": "https://graph.mapillary.com/images?access_token=${accessToken}&fields=id&limit=1",
    "requiredConfigKeys": ["accessToken"]
  },
  "quality": "built-in",
  "category": "Imagery",
  "dataSources": [
    {
      "sourceId": "mapillary",
      "name": "Mapillary",
      "url": "https://www.mapillary.com/",
      "commercialUse": "conditional",
      "providerCountry": "IE",
      "providerPrivacyUrl": "https://www.mapillary.com/privacy",
      "endUserExposure": "server-only",
      "personalData": false,
      "cookies": false,
      "dpaAvailable": false,
      "licensing": {
        "version": 1,
        "bindings": [
          {
            "scope": "imagery",
            "subject": "Mapillary contributed image",
            "license": {
              "kind": "spdx",
              "expression": "CC-BY-SA-4.0"
            },
            "attribution": {
              "placement": "visible",
              "surfaces": ["map", "content", "image"],
              "basis": "unresolved",
              "reviewedAt": "2026-10-14",
              "evidenceUrls": [
                "https://www.mapillary.com/terms",
                "https://help.mapillary.com/hc/en-us/articles/115001770409-CC-BY-SA-license-for-open-data",
                "https://help.mapillary.com/hc/en-us/articles/8348198426396-Mapillary-FAQ"
              ],
              "reason": "Exact product/operator/file grant or placement remains unresolved; no generic licence-only collapse clearance"
            }
          },
          {
            "scope": "service",
            "subject": "Mapillary API/proxy/branding agreement",
            "license": {
              "kind": "unknown"
            },
            "attribution": {
              "placement": "visible",
              "surfaces": ["map", "content", "image"],
              "basis": "provider-terms",
              "reviewedAt": "2026-10-14",
              "evidenceUrls": ["https://www.mapillary.com/terms"],
              "reason": "Images served from own servers trigger section 11; Extracted imagery data via API/vector tiles additionally triggers logo rule; CC BY-SA imagery creator/source/license receipt remains separate",
              "compactText": "<a href=\"https://www.mapillary.com/\">Mapillary</a>",
              "logo": "mapillary"
            }
          }
        ],
        "declarations": [
          {
            "text": "CC-BY-SA-4.0 (imagery); Proprietary (API)",
            "url": "https://www.mapillary.com/terms"
          }
        ]
      }
    }
  ]
}
