  "frontend": {
    "searchCategory": {
      "id": "bike-sharing",
      "label": "Bike Sharing",
      "iconPath": "M18.18 10l-1.7-4.68A2.008 2.008 0 0014.6 4H12v2h2.6l1.46 4h-4.81l-.36-1H12V7H7v2h1.75l1.82 5H9.9c-.44-2.23-2.31-3.88-4.65-3.99C2.45 9.87 0 12.2 0 15c0 2.8 2.2 5 5 5 2.46 0 4.45-1.69 4.9-4h4.2c.44 2.23 2.31 3.88 4.65 3.99 2.8.13 5.25-2.19 5.25-5C24 12.2 21.8 10 19 10zM7.82 16c-.4 1.17-1.49 2-2.82 2-1.68 0-3-1.32-3-3s1.32-3 3-3c1.33 0 2.42.83 2.82 2H5v2h2.82zm6.28-2h-1.4l-.73-2H15c-.46.64-.79 1.29-.9 2zm4.9 4c-1.68 0-3-1.32-3-3 0-.93.41-1.73 1.05-2.28l.96 2.64 1.88-.68-.97-2.67c.02 0 .05-.01.08-.01 1.68 0 3 1.32 3 3s-1.32 3-3 3z",
      "showInChipBar": true
    }
  },
  "backend": {
    "routes": false
  },
  "configSchema": {
    "type": "object",
    "properties": {
      "enabled": {
        "type": "boolean",
        "default": true
      },
      "clientId": {
        "type": "string",
        "title": "DB Call-a-Bike Client ID",
        "description": "Deutsche Bahn GBFS client ID.",
        "x-openmapx-secret": true
      },
      "apiKey": {
        "type": "string",
        "title": "DB Call-a-Bike API Key",
        "description": "Deutsche Bahn GBFS API key.",
        "x-openmapx-secret": true
      }
    }
  },
  "requires": [
    {
      "service": "motis",
      "optional": true
    },
    {
      "service": "nominatim",
      "optional": true
    }
  ],
  "healthCheck": [
    {
      "name": "Nextbike",
      "type": "http",
      "url": "https://maps.nextbike.net/maps/nextbike-live.json?limit=0"
    },
    {
      "name": "CityBikes",
      "type": "http",
      "url": "https://api.citybik.es/v2/networks?fields=id&limit=1"
    },
    {
      "name": "Donkey Republic",
      "type": "ping",
      "url": "https://stables.donkey.bike/api/public/nearby?latitude=52.52&longitude=13.405&radius=1"
    },
    {
      "name": "Deutsche Bahn GBFS",
      "type": "http",
      "url": "https://apis.deutschebahn.com/db-api-marketplace/apis/shared-mobility-gbfs/v2/de/CallABike/system_information",
      "headers": {
        "DB-Client-ID": "${clientId}",
        "DB-Api-Key": "${apiKey}"
      },
      "requiredConfigKeys": ["clientId", "apiKey"]
    },
    {
      "name": "GBFS Catalog",
      "type": "http",
      "url": "https://raw.githubusercontent.com/MobilityData/gbfs/master/systems.csv"
    },
    {
      "name": "Entur Mobility",
      "type": "ping",
      "url": "https://api.entur.io/mobility/v2/graphql"
    },
    {
      "name": "Transitous Rentals",
      "type": "http",
      "url": "https://api.transitous.org/api/v1/geocode?text=test"
    }
  ],
  "quality": "built-in",
  "category": "Shared Mobility",
