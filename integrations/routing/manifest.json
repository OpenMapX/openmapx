{
  "id": "routing",
  "version": "1.0.0",
  "author": "OpenMapX",
  "license": "MIT",
  "subjectData": {
    "storesPersonalData": false,
    "strategy": "not_personal",
    "registrationIds": [],
    "operatorInstructions": null
  },
  "domains": ["routing"],
  "backend": { "routes": true },
  "quality": "built-in",
  "category": "Routing",
  "requires": [
    { "capability": "routing-engine", "optional": true },
    { "service": "data-manager", "optional": true }
  ],
  "configSchema": {
    "type": "object",
    "properties": {
      "providerRequestsPerMinute": {
        "type": "integer",
        "default": 600,
        "minimum": 1,
        "description": "Most routing-engine calls per engine per minute, across every client and API replica. Calls past it are refused before they reach the engine."
      },
      "providerRequestsPerDay": {
        "type": "integer",
        "default": 100000,
        "minimum": 1,
        "description": "Most routing-engine calls per engine per day, across every client and API replica."
      }
    }
  }
}
