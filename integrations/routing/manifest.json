{
  "id": "routing",
  "version": "1.0.0",
  "author": "OpenMapX",
  "license": "MIT",
  "domains": ["routing"],
  "backend": {
    "routes": true
  },
  "quality": "built-in",
  "requires": [
    {
      "capability": "routing-engine",
      "optional": true
    },
    {
      "service": "data-manager",
      "optional": true
    }
  ],
  "configSchema": {
    "type": "object",
    "properties": {
      "providerOrder": {
        "type": "array",
        "items": { "type": "string" },
        "maxItems": 64,
        "default": ["routing-brouter", "routing-valhalla", "routing-osrm"]
      },
      "providerRequestsPerMinute": {
        "type": "integer",
        "default": 3000,
        "minimum": 1,
        "description": "Most routing-engine calls per engine per minute, across every client and API replica. Calls past it are refused before they reach the engine."
      },
      "providerRequestsPerDay": {
        "type": "integer",
        "default": 500000,
        "minimum": 1,
        "description": "Most routing-engine calls per engine per day, across every client and API replica."
      }
    }
  },
  "dataSources": [
    {
      "sourceId": "overpass",
      "name": "OpenStreetMap (Overpass)",
      "url": "https://overpass-api.de/",
      "attribution": "© <a href=\"https://www.openstreetmap.org/copyright\">OpenStreetMap contributors</a>",
      "commercialUse": "yes",
      "providerCountry": "DE",
      "providerPrivacyUrl": "https://osmfoundation.org/wiki/Privacy_Policy",
      "endUserExposure": "server-only",
      "personalData": false,
      "cookies": false,
      "dpaAvailable": false,
      "licensing": {
        "version": 1,
        "bindings": [
          {
            "scope": "data",
            "subject": "OpenStreetMap (Overpass) material",
            "license": {
              "kind": "spdx",
              "expression": "ODbL-1.0",
              "url": "https://opendatacommons.org/licenses/odbl/1-0/"
            }
          }
        ],
        "declarations": [
          {
            "text": "ODbL-1.0",
            "url": "https://www.openstreetmap.org/copyright"
          }
        ]
      }
    },
    {
      "sourceId": "overpass-kumi",
      "name": "Overpass API (Kumi Systems mirror)",
      "url": "https://kumi.systems/en/",
      "attribution": "© <a href=\"https://www.openstreetmap.org/copyright\">OpenStreetMap contributors</a>",
      "commercialUse": "yes",
      "providerCountry": "AT",
      "providerPrivacyUrl": "https://kumi.systems/en/legal/",
      "endUserExposure": "server-only",
      "personalData": false,
      "cookies": false,
      "dpaAvailable": false,
      "licensing": {
        "version": 1,
        "bindings": [
          {
            "scope": "data",
            "subject": "Overpass API (Kumi Systems mirror) material",
            "license": {
              "kind": "spdx",
              "expression": "ODbL-1.0",
              "url": "https://opendatacommons.org/licenses/odbl/1-0/"
            }
          }
        ],
        "declarations": [
          {
            "text": "ODbL-1.0",
            "url": "https://opendatacommons.org/licenses/odbl/1-0/"
          }
        ]
      }
    }
  ]
}
