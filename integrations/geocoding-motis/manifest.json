{
  "id": "geocoding-motis",
  "version": "1.0.0",
  "author": "OpenMapX",
  "license": "MIT",
  "domains": ["geocoding"],
  "dependencies": ["geocoding"],
  "infrastructure": {
    "dataRequirements": ["osm-pbf", "gtfs-feeds"]
  },
  "backend": {
    "routes": false
  },
  "configSchema": {
    "type": "object",
    "properties": {
      "enabled": {
        "type": "boolean",
        "default": true
      },
      "endpoint": {
        "type": "string",
        "title": "Local MOTIS endpoint URL",
        "description": "Base URL of a self-hosted MOTIS server. Leave blank to rely on the `motis` service registry entry.",
        "format": "url"
      },
      "transitousUrl": {
        "type": "string",
        "title": "Transitous endpoint URL",
        "description": "Base URL of the cloud Transitous instance (fallback when local MOTIS is unreachable).",
        "format": "url"
      }
    }
  },
  "healthCheck": [
    {
      "name": "Transitous",
      "type": "http",
      "url": "https://europe.motis-project.de/api/v1/geocode?text=test"
    },
    {
      "name": "MOTIS self-hosted",
      "type": "ping",
      "urlTemplate": "${endpoint}/api/v1/geocode?text=test",
      "requiredConfigKeys": ["endpoint"]
    }
  ],
  "quality": "built-in",
  "category": "Geocoding",
  "dataSources": [
    {
      "sourceId": "transitous",
      "name": "Transitous",
      "url": "https://api.transitous.org/",
      "license": "AGPL-3.0-or-later",
      "licenseUrl": "https://transitous.org/api/",
      "commercialUse": "no",
      "providerCountry": "DE",
      "providerPrivacyUrl": "https://transitous.org/privacy/",
      "endUserExposure": "server-only",
      "personalData": false,
      "cookies": false,
      "dpaAvailable": false
    },
    {
      "sourceId": "motis",
      "name": "MOTIS (self-hosted)",
      "url": "https://github.com/motis-project/motis",
      "license": "MIT",
      "licenseUrl": "https://github.com/motis-project/motis",
      "commercialUse": "yes",
      "providerCountry": "DE",
      "providerPrivacyUrl": "-",
      "endUserExposure": "server-only",
      "personalData": false,
      "cookies": false,
      "dpaAvailable": false
    }
  ],
  "requires": [
    {
      "service": "motis",
      "optional": true
    }
  ]
}
