{
  "id": "geocoding-motis",
  "version": "1.0.0",
  "author": "OpenMapX",
  "license": "MIT",
  "domains": ["geocoding"],
  "dependencies": ["geocoding"],
  "infrastructure": {
    "dockerProfile": "transit",
    "services": ["motis"],
    "dataRequirements": ["osm-pbf", "gtfs-feeds"]
  },
  "backend": {
    "routes": false
  },
  "configSchema": {
    "type": "object",
    "properties": {
      "enabled": {
        "type": "boolean",
        "default": true
      }
    }
  },
  "envVars": ["MOTIS_URL"],
  "healthCheck": {
    "type": "http",
    "url": "https://europe.motis-project.de/api/v1/geocode?text=test"
  },
  "quality": "built-in",
  "category": "Geocoding",
  "dataSources": [
    {
      "name": "Transitous",
      "url": "https://api.transitous.org/",
      "license": "AGPL-3.0-or-later",
      "licenseUrl": "https://transitous.org/api/",
      "commercialUse": "no",
      "providerCountry": "DE",
      "providerPrivacyUrl": "https://transitous.org/privacy/",
      "endUserExposure": "server-only",
      "personalData": false,
      "cookies": false,
      "dpaAvailable": false
    },
    {
      "name": "MOTIS (self-hosted)",
      "url": "https://github.com/motis-project/motis",
      "license": "MIT",
      "licenseUrl": "https://github.com/motis-project/motis",
      "commercialUse": "yes",
      "providerCountry": "DE",
      "providerPrivacyUrl": "-",
      "endUserExposure": "server-only",
      "personalData": false,
      "cookies": false,
      "dpaAvailable": false
    }
  ]
}
