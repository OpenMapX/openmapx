{
  "id": "geocoding-motis",
  "version": "1.0.0",
  "author": "OpenMapX",
  "license": "MIT",
  "subjectData": {
    "storesPersonalData": false,
    "strategy": "not_personal",
    "registrationIds": [],
    "operatorInstructions": null
  },
  "domains": ["geocoding"],
  "dependencies": ["geocoding"],
  "infrastructure": {
    "dataRequirements": ["osm-pbf", "gtfs-feeds"]
  },
  "backend": {
    "routes": false
  },
  "configSchema": {
    "type": "object",
    "properties": {
      "enabled": {
        "type": "boolean",
        "default": true
      },
      "endpoint": {
        "type": "string",
        "title": "Local MOTIS endpoint URL",
        "description": "Base URL of a self-hosted MOTIS server. Leave blank to rely on the `motis` service registry entry.",
        "format": "url"
      },
      "transitousUrl": {
        "type": "string",
        "title": "Transitous endpoint URL",
        "description": "Base URL of the cloud Transitous instance (fallback when local MOTIS is unreachable).",
        "format": "url"
      }
    }
  },
  "healthCheck": [
    {
      "name": "Transitous",
      "type": "http",
      "url": "https://europe.motis-project.de/api/v1/geocode?text=test"
    },
    {
      "name": "MOTIS self-hosted",
      "type": "ping",
      "urlTemplate": "${endpoint}/api/v1/geocode?text=test",
      "requiredConfigKeys": ["endpoint"]
    }
  ],
  "quality": "built-in",
  "category": "Geocoding",
  "dataSources": [
    {
      "sourceId": "transitous",
      "name": "Transitous",
      "url": "https://api.transitous.org/",
      "commercialUse": "conditional",
      "attribution": "Public transport data via <a href=\"https://transitous.org/\">Transitous</a> (see <a href=\"https://transitous.org/sources/\">data sources</a>)",
      "notes": "The Transitous public API (api.transitous.org) is 'not intended for commercial or for-profit purposes' — commercial use is decided case-by-case on request, and open-source clients must publish their source and visibly link transitous.org/sources/ for attribution (see transitous.org/api/). Upstream MOTIS is MIT licensed; that software license is separate from OpenMapX integration code, Transitous tooling, and the per-source timetable data licenses (mostly CC-BY / CC-BY-SA / open-government licences).",
      "providerCountry": "DE",
      "providerPrivacyUrl": "https://transitous.org/privacy/",
      "endUserExposure": "server-only",
      "personalData": false,
      "cookies": false,
      "dpaAvailable": false,
      "licensing": {
        "version": 1,
        "bindings": [
          {
            "scope": "data",
            "subject": "Each actual contributing feed/operator/source",
            "license": {
              "kind": "per-item",
              "raw": "Determined by each contributing item or operator"
            }
          },
          {
            "scope": "service",
            "subject": "Transitous endpoint policy",
            "license": {
              "kind": "unknown",
              "url": "https://transitous.org/sources/"
            },
            "attribution": {
              "placement": "visible",
              "surfaces": ["map", "content"],
              "basis": "recommendation",
              "reviewedAt": "2026-10-14",
              "evidenceUrls": ["https://transitous.org/api/"],
              "reason": "Visible source link expressly required; persistent interpretation conservative; Preserve each contributing feed license; Commercial use prohibited by public API policy",
              "compactText": "<a href=\"https://transitous.org/sources/\">Transitous sources</a>"
            }
          }
        ],
        "declarations": [
          {
            "text": "Mixed (per upstream GTFS/GBFS feed; mostly open data)",
            "url": "https://transitous.org/sources/"
          }
        ]
      }
    },
    {
      "sourceId": "motis",
      "name": "MOTIS (self-hosted)",
      "url": "https://github.com/motis-project/motis",
      "commercialUse": "yes",
      "providerCountry": "DE",
      "providerPrivacyUrl": "-",
      "endUserExposure": "server-only",
      "personalData": false,
      "cookies": false,
      "dpaAvailable": false,
      "licensing": {
        "version": 1,
        "bindings": [
          {
            "scope": "software",
            "subject": "MOTIS (self-hosted) engine/software",
            "license": {
              "kind": "spdx",
              "expression": "MIT"
            }
          },
          {
            "scope": "data",
            "subject": "Actual configured/result upstream datasets",
            "license": {
              "kind": "unknown"
            }
          }
        ],
        "declarations": [
          {
            "text": "MIT",
            "url": "https://github.com/motis-project/motis"
          }
        ]
      }
    }
  ],
  "requires": [
    {
      "service": "motis",
      "optional": true
    }
  ]
}
