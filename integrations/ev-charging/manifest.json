  "backend": {
    "routes": false
  },
  "configSchema": {
    "type": "object",
    "properties": {
      "enabled": {
        "type": "boolean",
        "default": true
      },
      "ocm-api-key": {
        "type": "string",
        "title": "OpenChargeMap API Key",
        "description": "OpenChargeMap API key.",
        "x-openmapx-secret": true,
        "x-openmapx-setup": {
          "url": "https://openchargemap.org/site/loginprovider/beginlogin",
          "urlLabel": "Get Open Charge Map API key",
          "steps": [
            "Go to openchargemap.org and create an account or sign in.",
            "Open 'My Profile' → 'My Apps'.",
            "Click 'Register an Application' and enter a name and description.",
            "Copy the API key issued immediately."
          ],
          "cost": "Free",
          "notes": "Required for regular use and for calls with maxresults > 250. Sent via the 'X-API-Key' header or 'key' query parameter."
        }
      },
      "us-afdc-api-key": {
        "type": "string",
        "title": "AFDC/NREL API Key",
        "description": "NREL (National Renewable Energy Laboratory) developer API key (developer.nlr.gov) covering the AFDC Alternative Fuel Stations dataset for the United States and Canada.",
        "x-openmapx-secret": true,
        "x-openmapx-setup": {
          "url": "https://developer.nlr.gov/signup/",
          "urlLabel": "Sign up for an NREL API key",
          "steps": [
            "Open developer.nlr.gov/signup/.",
            "Enter your first name, last name, and email, and accept the terms.",
            "Submit the form; the 40-character API key is generated instantly and emailed to you."
          ],
          "cost": "Free, instant",
          "notes": "This NREL / api.data.gov key powers the AFDC Alternative Fuel Stations dataset. DEMO_KEY works for testing but has very low rate limits."
        }
      },
      "no-nobil-api-key": {
        "type": "string",
        "title": "NOBIL API Key",
        "description": "NOBIL API key for Norway and Sweden charging station data.",
        "x-openmapx-secret": true,
        "x-openmapx-setup": {
          "url": "https://info.nobil.no/api",
          "urlLabel": "Request a NOBIL API key",
          "steps": [
            "Open info.nobil.no/api and review the Creative Commons (CC BY 4.0) terms.",
            "Use the 'Ask for an API-key' section to contact NOBIL with your project details.",
            "Accept the CC BY 4.0 terms of use.",
            "Receive the API key by email."
          ],
          "cost": "Free (Creative Commons data, attribution required)",
          "notes": "Norway/Sweden charging data. The request is handled by email rather than an instant self-service form.",
          "email": {
            "to": "post@nobil.no",
            "subject": "NOBIL API key request",
            "body": "Hello,\n\nI would like to request a NOBIL API key (API v3) to display Norwegian/Swedish EV charging station data in a self-hosted OpenMapX map application.\n\nI have read and accept the Creative Commons Attribution 4.0 (CC BY 4.0) terms of use and will attribute NOBIL accordingly.\n\nProject: self-hosted, non-commercial mapping application.\n\nThank you."
          }
        }
      },
      "si-nap-api-key": {
        "type": "string",
        "title": "NAP Slovenija API Token",
        "description": "NAP Slovenija (National Access Point) OAuth2 refresh token for the Prometej IDACS Energy Infrastructure Table dataset (Slovenian EV charging). Requires free business-entity registration.",
        "x-openmapx-secret": true,
        "x-openmapx-setup": {
          "url": "https://www.nap.si/en/datasets_details?id=46963663-38dd-eb04-43a9-cca9bdc0e4ba",
          "urlLabel": "Register with NAP Slovenija",
          "steps": [
            "Create a business-entity account at nap.si (click the user icon → Registration) and confirm the email.",
            "Log in, open your profile, and request permission for the 'Prometej IDACS Energy Infrastructure Table (DATEX II v3.6)' dataset. Accept the general terms of use.",
            "Wait for NAP to grant the request (shown as 'granted' on your profile page).",
            "Once granted, do a one-time OAuth2 password-grant login to obtain a refresh token: POST to https://b2b.nap.si/uc/user/token with Content-Type: application/x-www-form-urlencoded and body grant_type=password&username=<your email>&password=<your password>.",
            "The JSON response includes a 'refresh_token' field — paste that value here (not the 'access_token', which expires in ~24h; OpenMapX exchanges the refresh token for a fresh access token on every ingest run)."
          ],
          "cost": "Free (business-entity registration required)",
          "notes": "NAP Slovenija authenticates via OAuth2 (see nap.si 'Instructions for data access' / B2B documentation), not a static API key — there is no self-service token page. The dataset is documented as 'available for exchange and re-use on a non-discriminatory basis'; the specific dataset page lists a CC BY-SA 4.0 licence, but overall re-use is still gated by NAP's general terms of use, so treat commercial redistribution rights as unconfirmed."
        }
      },
      "at-econtrol-api-key": {
        "type": "string",
        "title": "E-Control Ladestellenverzeichnis API Key",
        "description": "E-Control Austria Ladestellenverzeichnis API key (Austrian national EV charging directory). Requires a matching at-econtrol-referer-domain — the gateway checks both.",
        "x-openmapx-secret": true,
        "x-openmapx-setup": {
          "url": "https://admin.ladestellen.at/#/api/registrieren",
          "urlLabel": "Register for a Ladestellenverzeichnis API key",
          "steps": [
            "Open admin.ladestellen.at and register, accepting the Nutzungsbedingungen (terms of use).",
            "Provide the domain you'll use — it must match the at-econtrol-referer-domain field below.",
            "Receive your individual API key by email after registration.",
            "The email also links the online API documentation, only visible once registered."
          ],
          "cost": "Free",
          "notes": "The gateway compares the Referer header's hostname against the domain registered at signup — set at-econtrol-referer-domain to that same bare hostname or every request 403s. Fair-use limit: 2500 requests/hour, 30 concurrent."
        }
      },
      "at-econtrol-referer-domain": {
        "type": "string",
        "title": "E-Control Registered Referer Domain",
        "description": "Bare hostname (no scheme/port/path) registered together with the API key at admin.ladestellen.at — sent as the Referer header on every request. Must match exactly or E-Control's gateway returns 403."
      },
      "pl-eipa-api-key": {
        "type": "string",
        "title": "EIPA (UDT) Reader API Key",
        "description": "Polish UDT alt-fuel/EV register reader credential. Read by the data-manager POI-ingest process from the environment (INTEGRATION_EV_CHARGING_PL_EIPA_API_KEY), not from this vault.",
        "x-openmapx-secret": true,
        "x-openmapx-setup": {
          "url": "https://eipa.udt.gov.pl/reader/register",
          "urlLabel": "Register a free EIPA reader account",
          "steps": [
            "Open eipa.udt.gov.pl/reader/register and submit your email plus the required consent.",
            "Click the confirmation link sent by email to activate the account.",
            "A follow-up email arrives with the access data and hourly download limits.",
            "Verify the exact header/query format against that email; this integration's assumed Bearer-token shape is unconfirmed."
          ],
          "cost": "Free",
          "notes": "License is not stated on the EIPA site — treat reuse terms as unconfirmed; consider emailing eipa@udt.gov.pl before commercial deployment."
        }
      },
      "sg-ltadatamall-api-key": {
        "type": "string",
        "title": "LTA DataMall AccountKey",
        "description": "Singapore Land Transport Authority (LTA) DataMall AccountKey covering the EV Charging Points dataset (station locations, connectors, and real-time availability by postal code).",
        "x-openmapx-secret": true,
        "x-openmapx-setup": {
          "url": "https://datamall.lta.gov.sg/content/datamall/en/request-for-api.html",
          "urlLabel": "Register for an LTA DataMall AccountKey",
          "steps": [
            "Open datamall.lta.gov.sg and go to 'Request for API Access'.",
            "Register with your name, email, and organisation, and accept the Singapore Open Data Licence.",
            "Confirm your email; the AccountKey is issued to your registered email.",
            "Copy the AccountKey — it is sent in the 'AccountKey' request header."
          ],
          "cost": "Free",
          "notes": "Covers the EV Charging Points APIs (station location, connector types, real-time availability by postal code). Sent via the 'AccountKey' header, never as a query parameter."
        }
      },
      "tw-tdx-client-id": {
        "type": "string",
        "title": "TDX Client ID",
        "description": "TDX (Taiwan Transport Data eXchange) OAuth2 Client ID for Taiwanese EV charging station data.",
        "x-openmapx-secret": true,
        "x-openmapx-setup": {
          "url": "https://tdx.transportdata.tw/register",
          "urlLabel": "Register for a TDX platform account",
          "steps": [
            "Go to tdx.transportdata.tw/register and create a free platform member account.",
            "Sign in, open Member Center → 資料服務 → 服務金鑰 (API Key).",
            "Create a Client Id / Client Secret pair (up to 3 per account).",
            "Copy both values — the Client Secret is only shown once."
          ],
          "cost": "Free",
          "notes": "Used to obtain an OAuth2 client-credentials bearer token from tdx.transportdata.tw for the EV charging Station and ConnectorLiveStatus APIs."
        }
      },
      "tw-tdx-client-secret": {
        "type": "string",
        "title": "TDX Client Secret",
        "description": "TDX OAuth2 Client Secret paired with the Client ID above.",
        "x-openmapx-secret": true
      }
    }
  },
  "requires": [
    {
      "service": "overpass",
      "optional": true
    },
    {
      "service": "postgis"
    }
  ],
