  "domains": ["data-source"],
  "dependencies": ["data-source"],
  "frontend": {
    "searchCategory": {
      "id": "ev-charging",
      "label": "EV Charging",
      "iconPath": "M19.77 7.23l.01-.01-3.72-3.72L15 4.56l2.11 2.11c-.94.36-1.61 1.26-1.61 2.33 0 1.38 1.12 2.5 2.5 2.5.36 0 .69-.08 1-.21v7.21c0 .55-.45 1-1 1s-1-.45-1-1V14c0-1.1-.9-2-2-2h-1V5c0-1.1-.9-2-2-2H6c-1.1 0-2 .9-2 2v16h10v-7.5h1.5v5c0 1.38 1.12 2.5 2.5 2.5s2.5-1.12 2.5-2.5V9c0-.69-.28-1.32-.73-1.77zM12 10H6V5h6v5z",
      "showInChipBar": true
    }
  },
  "backend": {
    "routes": false
  },
  "configSchema": {
    "type": "object",
    "properties": {
      "enabled": {
        "type": "boolean",
        "default": true
      },
      "ocm-api-key": {
        "type": "string",
        "title": "OpenChargeMap API Key",
        "description": "OpenChargeMap API key.",
        "x-openmapx-secret": true,
        "x-openmapx-setup": {
          "url": "https://openchargemap.org/site/loginprovider/beginlogin",
          "urlLabel": "Get Open Charge Map API key",
          "steps": [
            "Go to openchargemap.org and create an account or sign in.",
            "Open 'My Profile' → 'My Apps'.",
            "Click 'Register an Application' and enter a name and description.",
            "Copy the API key issued immediately."
          ],
          "cost": "Free",
          "notes": "Required for regular use and for calls with maxresults > 250. Sent via the 'X-API-Key' header or 'key' query parameter."
        }
      },
      "us-afdc-api-key": {
        "type": "string",
        "title": "AFDC/NREL API Key",
        "description": "NREL (National Renewable Energy Laboratory) developer API key (developer.nlr.gov) covering the AFDC Alternative Fuel Stations dataset for the United States and Canada.",
        "x-openmapx-secret": true,
        "x-openmapx-setup": {
          "url": "https://developer.nlr.gov/signup/",
          "urlLabel": "Sign up for an NREL API key",
          "steps": [
            "Open developer.nlr.gov/signup/.",
            "Enter your first name, last name, and email, and accept the terms.",
            "Submit the form; the 40-character API key is generated instantly and emailed to you."
          ],
          "cost": "Free, instant",
          "notes": "This NREL / api.data.gov key powers the AFDC Alternative Fuel Stations dataset. DEMO_KEY works for testing but has very low rate limits."
        }
      },
      "no-nobil-api-key": {
        "type": "string",
        "title": "NOBIL API Key",
        "description": "NOBIL API key for Norway and Sweden charging station data.",
        "x-openmapx-secret": true,
        "x-openmapx-setup": {
          "url": "https://info.nobil.no/api",
          "urlLabel": "Request a NOBIL API key",
          "steps": [
            "Open info.nobil.no/api and review the Creative Commons (CC BY 4.0) terms.",
            "Use the 'Ask for an API-key' section to contact NOBIL with your project details.",
            "Accept the CC BY 4.0 terms of use.",
            "Receive the API key by email."
          ],
          "cost": "Free (Creative Commons data, attribution required)",
          "notes": "Norway/Sweden charging data. The request is handled by email rather than an instant self-service form.",
          "email": {
            "to": "post@nobil.no",
            "subject": "NOBIL API key request",
            "body": "Hello,\n\nI would like to request a NOBIL API key (API v3) to display Norwegian/Swedish EV charging station data in a self-hosted OpenMapX map application.\n\nI have read and accept the Creative Commons Attribution 4.0 (CC BY 4.0) terms of use and will attribute NOBIL accordingly.\n\nProject: self-hosted, non-commercial mapping application.\n\nThank you."
          }
        }
      }
    }
  },
  "requires": [
    {
      "service": "overpass",
      "optional": true
    },
    {
      "service": "postgis"
    }
  ],
  "healthCheck": [
    {
      "name": "OpenChargeMap",
      "type": "http",
      "urlTemplate": "https://api.openchargemap.io/v3/poi/?output=json&maxresults=1&key=${ocm-api-key}&latitude=0&longitude=0&distance=100",
      "requiredConfigKeys": ["ocm-api-key"],
      "impersonate": true
    },
    {
      "name": "AFDC/NREL (US/CA)",
      "type": "http",
      "urlTemplate": "https://developer.nlr.gov/api/alt-fuel-stations/v1/nearest.json?api_key=${us-afdc-api-key}&fuel_type=ELEC&country=all&status=E&access=public&latitude=38.8977&longitude=-77.0365&radius=1&limit=1&format=json",
      "requiredConfigKeys": ["us-afdc-api-key"]
    },
    {
      "name": "Bundesnetzagentur (DE)",
      "type": "http",
      "url": "https://www.bundesnetzagentur.de/DE/Fachthemen/ElektrizitaetundGas/E-Mobilitaet/DownloadundKontakt.html"
    },
    {
      "name": "France IRVE",
      "type": "http",
      "url": "https://public.opendatasoft.com/api/explore/v2.1/catalog/datasets/mobilityref-france-irve-220/records?limit=1"
    },
    {
      "name": "SFOE (CH)",
      "type": "http",
      "url": "https://data.geo.admin.ch/ch.bfe.ladestellen-elektromobilitaet/status/oicp/ch.bfe.ladestellen-elektromobilitaet.json"
    },
    {
      "name": "NOBIL",
      "type": "http",
      "urlTemplate": "https://nobil.no/api/server/search.php?apikey=${no-nobil-api-key}&apiversion=3&action=search&type=rectangle&northeast=%2859.95%2C10.85%29&southwest=%2859.85%2C10.65%29&limit=1&format=json",
      "requiredConfigKeys": ["no-nobil-api-key"]
    },
    {
      "name": "OpenStreetMap / Overpass",
      "type": "ping",
      "url": "https://overpass-api.de/api/status"
    }
  ],
