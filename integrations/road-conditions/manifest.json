{
  "id": "road-conditions",
  "version": "1.0.0",
  "author": "OpenMapX",
  "license": "AGPL-3.0-or-later",
  "domains": ["road-conditions", "map-overlay"],
  "backend": {
    "routes": true
  },
  "quality": "built-in",
  "category": "Navigation",
  "frontend": {
    "mapLayer": true,
    "layerSelector": {
      "group": "map-details",
      "labelKey": "trafficIncidents",
      "icon": "warning"
    },
    "overlay": {
      "minZoom": 5,
      "legend": {
        "kind": "categorical",
        "title": "Road conditions",
        "items": [
          { "color": "#7e0023", "label": "Critical" },
          { "color": "#cc0033", "label": "High" },
          { "color": "#ff9933", "label": "Medium" },
          { "color": "#ffde33", "label": "Low" }
        ]
      }
    }
  }
}
