{
  "id": "photos-wikimedia",
  "version": "1.0.0",
  "author": "OpenMapX",
  "license": "MIT",
  "domains": ["photos"],
  "backend": {
    "routes": false
  },
  "configSchema": {
    "type": "object",
    "properties": {
      "enabled": {
        "type": "boolean",
        "default": true
      }
    }
  },
  "healthCheck": {
    "type": "http",
    "url": "https://commons.wikimedia.org/w/api.php?action=query&format=json"
  },
  "quality": "built-in",
  "category": "External",
  "attribution": [
    {
      "name": "Wikimedia Commons",
      "url": "https://commons.wikimedia.org/",
      "license": "Various (CC)"
    }
  ],
  "privacy": [
    {
      "providerCountry": "US",
      "providerPrivacyUrl": "https://foundation.wikimedia.org/wiki/Privacy_policy",
      "personalData": false
    }
  ]
}
