{
  "id": "photos-wikimedia",
  "version": "1.0.0",
  "author": "OpenMapX",
  "license": "MIT",
  "domains": ["photos"],
  "backend": {
    "routes": false
  },
  "configSchema": {
    "type": "object",
    "properties": {
      "enabled": {
        "type": "boolean",
        "default": true
      }
    }
  },
  "envVars": [],
  "healthCheck": {
    "type": "http",
    "url": "https://commons.wikimedia.org/w/api.php?action=query&format=json"
  },
  "quality": "built-in",
  "category": "External",
  "dataSources": [
    {
      "name": "Wikimedia Commons",
      "url": "https://commons.wikimedia.org/",
      "license": "Per-file (CC BY-SA, CC BY, or Public Domain)",
      "licenseUrl": "https://commons.wikimedia.org/wiki/Commons:Licensing",
      "attribution": "© <a href=\"https://commons.wikimedia.org/\">Wikimedia Commons</a>",
      "commercialUse": "yes",
      "providerCountry": "US",
      "providerPrivacyUrl": "https://foundation.wikimedia.org/wiki/Policy:Privacy_policy",
      "endUserExposure": "server-only",
      "personalData": false,
      "cookies": false,
      "dpaAvailable": false
    }
  ]
}
