    "type": "object",
    "properties": {
      "enabled": {
        "type": "boolean",
        "default": true
      },
      "uberEatsScid": {
        "type": "string",
        "title": "Uber Eats Impact click id (scid)",
        "description": "Optional. Appended to Uber Eats links as &scid= for affiliate attribution. Leave empty to deep-link without tracking (no account required)."
      },
      "affiliateTemplates": {
        "type": "object",
        "title": "Affiliate link wrappers",
        "description": "Optional per-provider affiliate deep-link wrappers. Key = provider id (e.g. \"deliveroo\"), value = a URL template containing the literal token {url}, which is replaced with the URL-encoded destination link. Lets you plug in an Awin / Impact / Partnerize wrapper without code changes. Leave empty for plain links.",
        "additionalProperties": {
          "type": "string"
        }
      }
    }
  },
