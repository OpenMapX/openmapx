{
  "id": "transit-otp",
  "version": "1.0.0",
  "author": "OpenMapX",
  "license": "MIT",
  "quality": "built-in",
  "domains": ["transit"],
  "infrastructure": {
    "dockerProfile": "transit",
    "services": ["otp"],
    "dataRequirements": ["osm-pbf", "gtfs-feeds"],
    "planetScale": false
  },
  "category": "Transit",
  "envVars": ["OTP_URL"],
  "configSchema": {
    "type": "object",
    "properties": {
      "enabled": {
        "type": "boolean",
        "default": true,
        "description": "Enable OpenTripPlanner integration"
      }
    }
  },
  "backend": {
    "routes": false
  },
  "healthCheck": {
    "type": "ping",
    "urlTemplate": "${OTP_URL}/otp/routers/default",
    "requiredEnvVars": ["OTP_URL"]
  },
  "dataSources": [
    {
      "name": "OpenTripPlanner (self-hosted)",
      "url": "http://localhost:8090/",
      "license": "LGPL v3+",
      "licenseUrl": "https://github.com/opentripplanner/OpenTripPlanner/blob/dev-2.x/LICENSE",
      "commercialUse": "yes",
      "providerCountry": "US",
      "providerPrivacyUrl": "-",
      "endUserExposure": "server-only",
      "personalData": false,
      "cookies": false,
      "dpaAvailable": false
    }
  ]
}
