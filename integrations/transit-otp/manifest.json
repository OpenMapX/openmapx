{
  "id": "transit-otp",
  "version": "1.0.0",
  "author": "OpenMapX",
  "license": "MIT",
  "quality": "built-in",
  "domains": ["transit"],
  "infrastructure": {
    "dataRequirements": ["osm-pbf", "gtfs-feeds"],
    "planetScale": false
  },
  "category": "Transit",
  "configSchema": {
    "type": "object",
    "properties": {
      "enabled": {
        "type": "boolean",
        "default": true,
        "description": "Enable OpenTripPlanner integration"
      },
      "endpoint": {
        "type": "string",
        "title": "OpenTripPlanner endpoint URL",
        "description": "Base URL of the OTP server (e.g. http://localhost:8090).",
        "format": "url"
      }
    }
  },
  "backend": {
    "routes": false
  },
  "healthCheck": {
    "type": "ping",
    "urlTemplate": "${endpoint}/otp/routers/default",
    "requiredConfigKeys": ["endpoint"]
  },
  "dataSources": [
    {
      "sourceId": "otp",
      "name": "OpenTripPlanner (self-hosted)",
      "url": "http://localhost:8090/",
      "license": "LGPL v3+",
      "licenseUrl": "https://github.com/opentripplanner/OpenTripPlanner/blob/dev-2.x/LICENSE",
      "commercialUse": "yes",
      "providerCountry": "US",
      "providerPrivacyUrl": "-",
      "endUserExposure": "server-only",
      "personalData": false,
      "cookies": false,
      "dpaAvailable": false
    }
  ],
  "dependencies": ["transit"],
  "requires": [
    {
      "service": "otp",
      "optional": true
    }
  ]
}
