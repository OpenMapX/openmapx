{
  "id": "transit-otp",
  "version": "1.0.0",
  "author": "OpenMapX",
  "license": "MIT",
  "quality": "built-in",
  "subjectData": {
    "storesPersonalData": false,
    "strategy": "not_personal",
    "registrationIds": [],
    "operatorInstructions": null
  },
  "domains": ["transit"],
  "infrastructure": {
    "dataRequirements": ["osm-pbf", "gtfs-feeds"],
    "planetScale": false
  },
  "category": "Transit",
  "configSchema": {
    "type": "object",
    "properties": {
      "enabled": {
        "type": "boolean",
        "default": true,
        "description": "Enable OpenTripPlanner integration"
      },
      "endpoint": {
        "type": "string",
        "title": "OpenTripPlanner endpoint URL",
        "description": "Base URL of the OTP server (e.g. http://localhost:8090).",
        "format": "url"
      }
    }
  },
  "backend": {
    "routes": false
  },
  "dataSources": [
    {
      "sourceId": "otp",
      "name": "OpenTripPlanner (self-hosted)",
      "url": "http://localhost:8090/",
      "commercialUse": "yes",
      "providerCountry": "US",
      "providerPrivacyUrl": "-",
      "endUserExposure": "server-only",
      "personalData": false,
      "cookies": false,
      "dpaAvailable": false,
      "licensing": {
        "version": 1,
        "bindings": [
          {
            "scope": "software",
            "subject": "OpenTripPlanner engine",
            "license": {
              "kind": "spdx",
              "expression": "LGPL-3.0-or-later"
            }
          },
          {
            "scope": "data",
            "subject": "Configured GTFS/RT/OSM inputs and output",
            "license": {
              "kind": "unknown"
            }
          }
        ],
        "declarations": [
          {
            "text": "LGPL-3.0-or-later",
            "url": "https://github.com/opentripplanner/OpenTripPlanner/blob/dev-2.x/LICENSE"
          }
        ]
      }
    }
  ],
  "dependencies": ["transit"],
  "requires": [
    {
      "service": "otp",
      "optional": true
    }
  ]
}
