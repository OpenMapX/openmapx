{
  "id": "geocoding-pelias",
  "version": "1.0.0",
  "author": "OpenMapX",
  "license": "MIT",
  "domains": ["geocoding"],
  "infrastructure": {
    "dockerProfile": "pelias",
    "services": ["pelias-api", "pelias-placeholder", "pelias-pip", "elasticsearch"],
    "dataRequirements": ["osm-pbf"]
  },
  "backend": {
    "routes": false
  },
  "configSchema": {
    "type": "object",
    "properties": {
      "enabled": {
        "type": "boolean",
        "default": true
      }
    }
  },
  "envVars": ["PELIAS_URL"],
  "healthCheck": {
    "type": "http",
    "urlTemplate": "http://localhost:4000/v1/search?text=test&size=1",
    "category": "Geocoding"
  },
  "quality": "built-in",
  "attribution": [
    {
      "name": "Pelias",
      "url": "https://pelias.io/",
      "license": "MIT"
    }
  ],
  "privacy": [
    {
      "providerCountry": "Self-hosted",
      "providerPrivacyUrl": "https://pelias.io/",
      "personalData": false
    }
  ]
}
