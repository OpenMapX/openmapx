{
  "id": "geocoding-pelias",
  "version": "1.0.0",
  "author": "OpenMapX",
  "license": "MIT",
  "subjectData": {
    "storesPersonalData": false,
    "strategy": "not_personal",
    "registrationIds": [],
    "operatorInstructions": null
  },
  "domains": ["geocoding"],
  "dependencies": ["geocoding"],
  "infrastructure": {
    "dataRequirements": ["osm-pbf"]
  },
  "backend": {
    "routes": false
  },
  "configSchema": {
    "type": "object",
    "properties": {
      "enabled": {
        "type": "boolean",
        "default": true
      },
      "endpoint": {
        "type": "string",
        "title": "Pelias endpoint URL",
        "description": "Base URL of the self-hosted Pelias server.",
        "format": "url"
      }
    }
  },
  "endpointConfigKeys": {
    "pelias": "endpoint"
  },
  "healthCheck": {
    "type": "http",
    "urlTemplate": "${endpoint:pelias}/v1/search?text=test&size=1"
  },
  "quality": "built-in",
  "category": "Geocoding",
  "dataSources": [
    {
      "sourceId": "pelias",
      "name": "Pelias (self-hosted)",
      "url": "https://github.com/pelias/pelias",
      "commercialUse": "yes",
      "providerCountry": "US",
      "providerPrivacyUrl": "-",
      "endUserExposure": "server-only",
      "personalData": false,
      "cookies": false,
      "dpaAvailable": false,
      "licensing": {
        "version": 1,
        "bindings": [
          {
            "scope": "software",
            "subject": "Pelias (self-hosted) engine/software",
            "license": {
              "kind": "spdx",
              "expression": "MIT"
            }
          },
          {
            "scope": "data",
            "subject": "Actual configured/result upstream datasets",
            "license": {
              "kind": "unknown"
            },
            "attribution": {
              "placement": "visible",
              "surfaces": ["map", "content", "image"],
              "basis": "unresolved",
              "reviewedAt": "2026-10-14",
              "evidenceUrls": [
                "https://github.com/pelias/documentation/blob/master/data-sources.md",
                "https://github.com/pelias/pelias"
              ],
              "reason": "Exact product/operator/file grant or placement remains unresolved; no generic licence-only collapse clearance"
            }
          }
        ],
        "declarations": [
          {
            "text": "MIT",
            "url": "https://github.com/pelias/pelias/blob/master/LICENSE"
          }
        ]
      }
    }
  ],
  "requires": [
    {
      "service": "pelias",
      "optional": true
    }
  ]
}
