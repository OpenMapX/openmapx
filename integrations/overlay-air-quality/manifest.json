{
  "id": "overlay-air-quality",
  "name": "OpenAQ Air Quality",
  "version": "1.0.0",
  "description": "Real-time air quality measurements (PM2.5, AQI)",
  "author": "OpenMapX",
  "license": "MIT",
  "documentation": "https://openaq.org/",

  "domains": ["map-overlay"],

  "frontend": {
    "mapLayer": true,
    "legend": true,
    "panel": false,
    "layerSelector": {
      "group": "map-details",
      "labelKey": "airQuality",
      "icon": "air",
      "iconPath": "M17 7h2v2h-2V7zm-4-4h2v2h-2V3zm-2 6h2v2h-2V9zM3 3h2v2H3V3zm2 4h2v2H5V7zm-2 6h2v2H3v-2zm0 4h2v2H3v-2zm14 0h2v2h-2v-2zm0-8h2v2h-2v-2zM7 3h2v2H7V3zm0 8h2v2H7v-2zm0 4h2v2H7v-2zm0 4h2v2H7v-2zm4-16h2v2h-2V3zm0 8h2v2h-2v-2zm0 4h2v2h-2v-2zm0 4h2v2h-2v-2zm4 0h2v2h-2v-2zm4-12h2v2h-2V7zm0 4h2v2h-2v-2zm-4 0h2v2h-2v-2zm0-4h2v2h-2V7zm-4 4h2v2h-2v-2z"
    },
    "overlay": {
      "excludes": ["street-view", "earthquakes", "wildfires"],
      "minZoom": 5
    }
  },

  "backend": {
    "routes": true
  },

  "configSchema": {
    "type": "object",
    "properties": {
      "enabled": { "type": "boolean", "default": true }
    }
  },

  "envVars": ["OPENAQ_API_KEY"],

  "healthCheck": {
    "type": "http",
    "urlTemplate": "https://api.openaq.org/v3/locations?bbox=-0.1,-0.1,0.1,0.1&parameters_id=2&limit=1&page=1",
    "requiredEnvVars": ["OPENAQ_API_KEY"],
    "category": "Data Overlays"
  },

  "quality": "built-in",

  "attribution": [
    {
      "name": "OpenAQ",
      "url": "https://openaq.org/",
      "license": "CC BY 4.0",
      "licenseUrl": "https://creativecommons.org/licenses/by/4.0/"
    }
  ],

  "privacy": {
    "purpose": "Air quality measurements (PM2.5, AQI)",
    "dataSent": "Bounding box coordinates",
    "dataReceived": "Air quality station locations, PM2.5 measurements, AQI values",
    "providerCountry": "US",
    "providerPrivacyUrl": "https://openaq.org/privacy/",
    "dataRetention": "Cached for 15 minutes server-side",
    "personalData": false,
    "cookies": false
  }
}
