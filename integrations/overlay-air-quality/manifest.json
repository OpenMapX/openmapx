{
  "id": "overlay-air-quality",
  "version": "1.0.0",
  "author": "OpenMapX",
  "license": "MIT",
  "documentation": "https://openaq.org/",
  "domains": ["air-quality"],
  "frontend": {
    "mapLayer": false,
    "legend": false,
    "panel": false
  },
  "backend": {
    "routes": true
  },
  "configSchema": {
    "type": "object",
    "properties": {
      "enabled": {
        "type": "boolean",
        "default": true
      },
      "openAqApiKey": {
        "type": "string",
        "title": "OpenAQ API Key",
        "description": "OpenAQ API key.",
        "x-openmapx-secret": true,
        "x-openmapx-setup": {
          "url": "https://explore.openaq.org/register",
          "urlLabel": "Register at OpenAQ",
          "steps": [
            "Register a free account at explore.openaq.org/register (no disposable email addresses).",
            "Verify your email and sign in to OpenAQ Explorer.",
            "Open the account settings page (explore.openaq.org/account).",
            "Copy your API key from settings."
          ],
          "cost": "Free.",
          "notes": "OpenAQ now requires an API key for all programmatic access (use the v3 API). The key is sent in the X-API-Key request header."
        }
      }
    }
  },
  "quality": "built-in",
  "category": "Data Overlays",
  "dataSources": [
    {
      "sourceId": "openaq",
      "name": "OpenAQ",
      "url": "https://api.openaq.org/",
      "owner": "OpenAQ, Inc.",
      "termsUrl": "https://docs.openaq.org/about/terms",
      "methodologyUrl": "https://docs.openaq.org/resources/measurements",
      "dataUseClass": "attribution",
      "credentialOwner": "instance-operator",
      "reviewedAt": "2026-08-30",
      "apiHosts": ["api.openaq.org"],
      "license": "Varies by contributing source",
      "licenseUrl": "https://docs.openaq.org/resources/licenses",
      "attribution": "OpenAQ and the contributing data owner",
      "notes": "Each location carries its own source license and attribution; callers must retain both.",
      "commercialUse": "conditional",
      "providerCountry": "US",
      "providerPrivacyUrl": "https://openaq.org/privacy/",
      "endUserExposure": "server-only",
      "personalData": false,
      "cookies": false,
      "dpaAvailable": false
    }
  ]
}
