{
  "id": "overlay-air-quality",
  "version": "1.0.0",
  "author": "OpenMapX",
  "license": "MIT",
  "documentation": "https://openaq.org/",
  "domains": ["map-overlay"],
  "frontend": {
    "mapLayer": true,
    "legend": true,
    "panel": false,
    "layerSelector": {
      "group": "map-details",
      "labelKey": "airQuality",
      "icon": "air",
      "iconPath": "M17 7h2v2h-2V7zm-4-4h2v2h-2V3zm-2 6h2v2h-2V9zM3 3h2v2H3V3zm2 4h2v2H5V7zm-2 6h2v2H3v-2zm0 4h2v2H3v-2zm14 0h2v2h-2v-2zm0-8h2v2h-2v-2zM7 3h2v2H7V3zm0 8h2v2H7v-2zm0 4h2v2H7v-2zm0 4h2v2H7v-2zm4-16h2v2h-2V3zm0 8h2v2h-2v-2zm0 4h2v2h-2v-2zm0 4h2v2h-2v-2zm4 0h2v2h-2v-2zm4-12h2v2h-2V7zm0 4h2v2h-2v-2zm-4 0h2v2h-2v-2zm0-4h2v2h-2V7zm-4 4h2v2h-2v-2z"
    },
    "overlay": {
      "excludes": ["street-view", "earthquakes", "wildfires"],
      "minZoom": 5
    }
  },
  "backend": {
    "routes": true
  },
  "configSchema": {
    "type": "object",
    "properties": {
      "enabled": {
        "type": "boolean",
        "default": true
      },
      "openAqApiKey": {
        "type": "string",
        "title": "OpenAQ API Key",
        "description": "OpenAQ API key.",
        "x-openmapx-secret": true,
        "x-openmapx-setup": {
          "url": "https://explore.openaq.org/register",
          "urlLabel": "Register at OpenAQ",
          "steps": [
            "Register a free account at explore.openaq.org/register (no disposable email addresses).",
            "Verify your email and sign in to OpenAQ Explorer.",
            "Open the account settings page (explore.openaq.org/account).",
            "Copy your API key from settings."
          ],
          "cost": "Free.",
          "notes": "OpenAQ now requires an API key for all programmatic access (use the v3 API). The key is sent in the X-API-Key request header."
        }
      }
    }
  },
  "healthCheck": {
    "type": "http",
    "urlTemplate": "https://api.openaq.org/v3/locations?bbox=-0.1,-0.1,0.1,0.1&parameters_id=2&limit=1&page=1",
    "headers": {
      "X-API-Key": "${openAqApiKey}"
    },
    "requiredConfigKeys": ["openAqApiKey"]
  },
  "quality": "built-in",
  "category": "Data Overlays",
  "dataSources": [
    {
      "sourceId": "openaq",
      "name": "OpenAQ",
      "url": "https://api.openaq.org/",
      "license": "CC BY 4.0 (varies per source)",
      "licenseUrl": "https://docs.openaq.org/resources/licenses",
      "commercialUse": "yes",
      "providerCountry": "US",
      "providerPrivacyUrl": "https://openaq.org/privacy/",
      "endUserExposure": "server-only",
      "personalData": false,
      "cookies": false,
      "dpaAvailable": false
    }
  ]
}
