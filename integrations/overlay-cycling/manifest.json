{
  "id": "overlay-cycling",
  "name": "Cycling Infrastructure",
  "version": "1.0.0",
  "description": "Cycling infrastructure visualization on the map",
  "author": "OpenMapX",
  "license": "MIT",
  "documentation": "https://wiki.openstreetmap.org/wiki/Cycling",

  "domains": ["map-overlay"],

  "frontend": {
    "mapLayer": true,
    "legend": true,
    "panel": false,
    "layerSelector": {
      "group": "map-details",
      "labelKey": "cycling"
    },
    "overlay": {
      "excludes": []
    }
  },

  "backend": {
    "routes": false
  },

  "configSchema": {
    "type": "object",
    "properties": {
      "enabled": { "type": "boolean", "default": true }
    }
  },

  "envVars": [],

  "healthCheck": {
    "type": "http",
    "url": "https://tiles.openstreetmap.org/0/0/0.png",
    "category": "Map Overlays"
  },

  "quality": "stable",

  "attribution": [
    {
      "name": "OpenStreetMap",
      "url": "https://www.openstreetmap.org/",
      "license": "ODbL"
    }
  ],

  "privacy": {
    "purpose": "Cycling infrastructure visualization",
    "dataSent": "Map tile requests",
    "dataReceived": "Cycling infrastructure overlay tiles",
    "providerCountry": "Various",
    "providerPrivacyUrl": "https://wiki.openstreetmap.org/wiki/Privacy_policy",
    "personalData": false,
    "cookies": false
  }
}
