  "frontend": {
    "searchCategory": {
      "id": "webcam",
      "label": "Webcams",
      "iconPath": "M17 10.5V7c0-.55-.45-1-1-1H4c-.55 0-1 .45-1 1v10c0 .55.45 1 1 1h12c.55 0 1-.45 1-1v-3.5l4 4v-11l-4 4z",
      "showInChipBar": true
    }
  },
  "backend": {
    "routes": false
  },
  "configSchema": {
    "type": "object",
    "properties": {
      "enabled": {
        "type": "boolean",
        "default": true
      },
      "windyApiKey": {
        "type": "string",
        "title": "Windy Webcams API Key",
        "description": "Get a free key at https://api.windy.com/keys",
        "x-openmapx-secret": true,
        "x-openmapx-setup": {
          "url": "https://api.windy.com/keys",
          "urlLabel": "Get a Windy Webcams API key",
          "steps": [
            "Sign in to (or create) a free Windy account, then open api.windy.com/keys.",
            "Create a new API key and select the Webcams API; the free tier requires no payment.",
            "Copy the key (it may take a few minutes to propagate); it is sent as the 'x-windy-api-key' header."
          ],
          "cost": "Free (paid 'professional' tier optional)",
          "notes": "Free tier returns only low-resolution images, image URLs expire after 10 minutes, and the listing offset is capped (~1000)."
        }
      },
      "npsApiKey": {
        "type": "string",
        "title": "NPS API Key",
        "description": "Get a free key at https://developer.nps.gov/signup/",
        "x-openmapx-secret": true,
        "x-openmapx-setup": {
          "url": "https://www.nps.gov/subjects/developer/get-started.htm",
          "urlLabel": "Get an NPS API key",
          "steps": [
            "Open nps.gov/subjects/developer/get-started.htm and fill out the 'Get Started' sign-up form.",
            "Submit the form; an email with your personalized 40-character API key is sent to you.",
            "Copy the key (passed on each request as ?api_key=...)."
          ],
          "cost": "Free",
          "notes": "Self-service form on nps.gov; the key arrives by email (developer portal is developer.nps.gov). Delivery is usually near-instant."
        }
      },
      "dotGaApiKey": {
        "type": "string",
        "title": "Georgia 511 API Key",
        "description": "Register at https://511ga.org/my511/register",
        "x-openmapx-secret": true,
        "x-openmapx-setup": {
          "url": "https://511ga.org/developers/doc",
          "urlLabel": "Register for API access",
          "steps": [
            "Create a free My511 account at 511ga.org/my511/register (or log in).",
            "Open the Developer Resources page (Developers → Documentation) at 511ga.org/developers/doc.",
            "Request a Developer API key from your account; it is issued automatically.",
            "Copy the key (sent as the 'key' query parameter)."
          ],
          "cost": "Free",
          "notes": "Georgia 511 runs the IBI Group / Castle Rock 511 platform. Self-service. Rate limit: 10 calls per 60 seconds."
        }
      },
      "dotFlApiKey": {
        "type": "string",
        "title": "Florida 511 API Key",
        "description": "Register at https://fl511.com/my511/register",
        "x-openmapx-secret": true,
        "x-openmapx-setup": {
          "url": "https://fl511.com",
          "urlLabel": "Request data/API access (FDOT SunGuide)",
          "steps": [
            "FL511 runs FDOT's SunGuide platform, not the IBI 511 platform, so there is no self-service developer key page.",
            "Email FDOT/SunGuide to request programmatic access to the data feeds powering FL511.",
            "After approval, use the credentials and feed host they provision."
          ],
          "cost": "Free (granted by request)",
          "notes": "Florida does not use the IBI self-service flow; API/data access is by request through FDOT rather than an automated web form.",
          "email": {
            "to": "Christine.Shafik@dot.state.fl.us",
            "subject": "FL511 / SunGuide traffic data feed access request",
            "body": "Hello,\n\nI am building an application that would use Florida 511 (FL511) traffic camera and event data, and would like to request programmatic access to the FDOT SunGuide data feeds that power FL511.\n\nCould you let me know the process to obtain access credentials, any usage terms, and which datasets (cameras, events, message signs, etc.) are available?\n\nThank you."
          }
        }
      },
      "dotAzApiKey": {
        "type": "string",
        "title": "Arizona 511 API Key",
        "description": "Register at https://az511.com/my511/register",
        "x-openmapx-secret": true,
        "x-openmapx-setup": {
          "url": "https://az511.com/developers/doc",
          "urlLabel": "Register for API access",
          "steps": [
            "Create a free My AZ 511 account at az511.com/my511/register (or log in).",
            "Open the Developer Resources page at az511.com/developers/doc.",
            "Request a Developer API key from your account; it is issued automatically.",
            "Copy the key (sent as the 'key' query parameter)."
          ],
          "cost": "Free",
          "notes": "Arizona 511 runs the IBI Group / Castle Rock 511 platform. Self-service. Rate limit: 10 calls per 60 seconds."
        }
      },
      "dotIdApiKey": {
        "type": "string",
        "title": "Idaho 511 API Key",
        "description": "Register at https://511.idaho.gov/my511/register",
        "x-openmapx-secret": true,
        "x-openmapx-setup": {
          "url": "https://511.idaho.gov/developers/doc",
          "urlLabel": "Register for API access",
          "steps": [
            "Create a free account at 511.idaho.gov/my511/register (or log in).",
            "Open the Developer Resources page at 511.idaho.gov/developers/doc.",
            "Request a Developer API key from your account; it is issued automatically.",
            "Copy the key (sent as the 'key' query parameter)."
          ],
          "cost": "Free",
          "notes": "Idaho 511 runs the IBI Group / Castle Rock 511 platform. Self-service. Rate limit: 10 calls per 60 seconds."
        }
      },
      "dotUtApiKey": {
        "type": "string",
        "title": "Utah 511 API Key",
        "description": "Register at https://prod-ut.ibi511.com/my511/register",
        "x-openmapx-secret": true,
        "x-openmapx-setup": {
          "url": "https://udottraffic.utah.gov/developers/doc",
          "urlLabel": "Register for API access",
          "steps": [
            "Create a free account at udottraffic.utah.gov/my511/register (or log in).",
            "Open the Developer Resources / API documentation page and request a Developer API key.",
            "Copy the key (sent as the 'key' query parameter)."
          ],
          "cost": "Free",
          "notes": "UDOT Traffic 511 runs the IBI Group / Castle Rock platform. Self-service; an account is required first. Rate limit: 10 calls per 60 seconds."
        }
      },
      "dotLaApiKey": {
        "type": "string",
        "title": "Louisiana 511 API Key",
        "description": "Register at https://511la.org/my511/register",
        "x-openmapx-secret": true,
        "x-openmapx-setup": {
          "url": "https://www.511la.org/developers/doc",
          "urlLabel": "Register for API access",
          "steps": [
            "Create a free account at 511la.org/my511/register and verify via the emailed link.",
            "Log in and open the Developer Resources page at 511la.org/developers/doc.",
            "Request a Developer API key from your account.",
            "Copy the key (sent as the 'key' query parameter)."
          ],
          "cost": "Free",
          "notes": "Louisiana 511 runs the IBI Group / Castle Rock 511 platform. Self-service; an account is required first. Rate limit: 10 calls per 60 seconds."
        }
      },
      "dotPaApiKey": {
        "type": "string",
        "title": "Pennsylvania 511 API Key",
        "description": "Register at https://www.511pa.com/my511/register",
        "x-openmapx-secret": true,
        "x-openmapx-setup": {
          "url": "https://www.pa.gov/agencies/penndot/programs-and-doing-business/online-services/developer-resources-documentation-api",
          "urlLabel": "Request access to PennDOT data feeds",
          "steps": [
            "Submit the PennDOT Data Feed Request Form to request the RCRS_Event_Data service.",
            "Create a PDAuth account at gis.penndot.pa.gov/pdauth/login.",
            "Email penndotdata@pa.gov with your PDAuth username and reason for access.",
            "After approval, use your PDAuth credentials (HTTP Basic Auth) to access the feed."
          ],
          "cost": "Free",
          "notes": "Not the IBI511 self-service flow. The public 511PA site has no developer page; access is granted by request through PennDOT's open-data program.",
          "email": {
            "to": "penndotdata@pa.gov",
            "subject": "Request for access to PennDOT RCRS Event Data feed",
            "body": "Hello,\n\nI would like to request access to the PennDOT RCRS_Event_Data web service. My PDAuth username is: <your PDAuth username>.\n\nReason for access: <brief description of your intended use>.\n\nThank you."
          }
        }
      },
      "dotScApiKey": {
        "type": "string",
        "title": "South Carolina 511 API Key",
        "description": "Register at https://511sc.org/my511/register",
        "x-openmapx-secret": true,
        "x-openmapx-setup": {
          "url": "https://511sc.org/developers/doc",
          "urlLabel": "Register for API access",
          "steps": [
            "Create a free My511SC account at 511sc.org/my511/register.",
            "Log in and open the Developer Resources page at 511sc.org/developers/doc.",
            "Request a Developer API key from the developer portal.",
            "Copy the key (sent as the 'key' query parameter)."
          ],
          "cost": "Free",
          "notes": "South Carolina 511 runs the IBI Group / Castle Rock 511 platform. Self-service; an account is required first. Rate limit ~10 calls per 60 seconds."
        }
      },
      "dotMaApiKey": {
        "type": "string",
        "title": "Massachusetts 511 API Key",
        "description": "Register at https://www.mass511.com/my511/register",
        "x-openmapx-secret": true,
        "x-openmapx-setup": {
          "url": "https://www.mass511.com/developers/doc",
          "urlLabel": "Register for API access",
          "steps": [
            "Create a free Mass511 account at mass511.com/my511/register.",
            "Log in and open the Developer Resources page at mass511.com/developers/doc.",
            "Request a Developer API key from the developer portal.",
            "Copy the key (sent as the 'key' query parameter)."
          ],
          "cost": "Free",
          "notes": "Massachusetts 511 (MassDOT) runs the same IBI Group / Castle Rock 511 platform. Self-service; an account is required first. The /developers pages are JS-rendered, so open them in a browser."
        }
      }
    }
