{
  "id": "webcam",
  "version": "1.0.0",
  "author": "OpenMapX",
  "license": "MIT",
  "domains": ["data-source"],
  "dependencies": ["data-source"],
  "frontend": {
    "searchCategory": {
      "id": "webcam",
      "label": "Webcams",
      "iconPath": "M17 10.5V7c0-.55-.45-1-1-1H4c-.55 0-1 .45-1 1v10c0 .55.45 1 1 1h12c.55 0 1-.45 1-1v-3.5l4 4v-11l-4 4z",
      "showInChipBar": true
    }
  },
  "backend": { "routes": false },
  "configSchema": {
    "type": "object",
    "properties": {
      "enabled": { "type": "boolean", "default": true },
      "apiKey": {
        "type": "string",
        "title": "Windy Webcams API Key",
        "description": "Get a free key at https://api.windy.com/keys",
        "x-openmapx-secret": true
      }
    }
  },
  "envVars": ["WINDY_WEBCAMS_API_KEY"],
  "healthCheck": {
    "type": "http",
    "urlTemplate": "https://api.windy.com/webcams/api/v3/webcams?limit=1",
    "headers": { "x-windy-api-key": "${WINDY_WEBCAMS_API_KEY}" },
    "requiredEnvVars": ["WINDY_WEBCAMS_API_KEY"]
  },
  "quality": "built-in",
  "category": "Data Overlays",
  "dataSources": [
    {
      "sourceId": "windy",
      "name": "Windy Webcams",
      "url": "https://www.windy.com/webcams",
      "license": "Proprietary (free tier, attribution required)",
      "licenseUrl": "https://api.windy.com/webcams/terms",
      "attribution": "Webcams provided by <a href=\"https://www.windy.com\">Windy.com</a> \u2014 <a href=\"https://www.windy.com/webcams/add\">add a webcam</a>",
      "commercialUse": "conditional",
      "providerCountry": "CZ",
      "providerPrivacyUrl": "https://account.windy.com/agreements/windy-privacy-policy",
      "endUserExposure": "server-only",
      "personalData": false,
      "cookies": false,
      "dpaAvailable": false
    },
    {
      "sourceId": "osm-webcam",
      "name": "OpenStreetMap (Overpass)",
      "url": "https://www.openstreetmap.org/",
      "license": "ODbL",
      "licenseUrl": "https://opendatacommons.org/licenses/odbl/1-0/",
      "attribution": "© <a href=\"https://www.openstreetmap.org/copyright\">OpenStreetMap contributors</a>",
      "commercialUse": "yes",
      "providerCountry": "UK",
      "providerPrivacyUrl": "https://osmfoundation.org/wiki/Privacy_Policy",
      "endUserExposure": "server-only",
      "personalData": false,
      "cookies": false,
      "dpaAvailable": false
    },
    {
      "sourceId": "caltrans",
      "name": "Caltrans CCTV",
      "url": "https://cwwp2.dot.ca.gov/",
      "license": "Public domain (US government)",
      "licenseUrl": "https://dot.ca.gov/conditions-of-use",
      "commercialUse": "yes",
      "providerCountry": "US",
      "providerPrivacyUrl": "https://dot.ca.gov/privacy-policy",
      "endUserExposure": "server-only",
      "personalData": false,
      "cookies": false,
      "dpaAvailable": false
    },
    {
      "sourceId": "tfl",
      "name": "TfL JamCam",
      "url": "https://tfl.gov.uk/",
      "license": "Open Government Licence v3.0",
      "licenseUrl": "https://www.nationalarchives.gov.uk/doc/open-government-licence/version/3/",
      "attribution": "Powered by <a href=\"https://tfl.gov.uk/\">TfL</a> Open Data",
      "commercialUse": "yes",
      "providerCountry": "UK",
      "providerPrivacyUrl": "https://tfl.gov.uk/corporate/privacy-and-cookies/",
      "endUserExposure": "server-only",
      "personalData": false,
      "cookies": false,
      "dpaAvailable": false
    }
  ]
}
