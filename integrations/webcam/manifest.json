{
  "id": "webcam",
  "version": "1.0.0",
  "author": "OpenMapX",
  "license": "MIT",
  "domains": ["data-source"],
  "dependencies": ["data-source"],
  "frontend": {
    "searchCategory": {
      "id": "webcam",
      "label": "Webcams",
      "iconPath": "M17 10.5V7c0-.55-.45-1-1-1H4c-.55 0-1 .45-1 1v10c0 .55.45 1 1 1h12c.55 0 1-.45 1-1v-3.5l4 4v-11l-4 4z",
      "showInChipBar": true
    }
  },
  "backend": { "routes": false },
  "configSchema": {
    "type": "object",
    "properties": {
      "enabled": { "type": "boolean", "default": true },
      "apiKey": {
        "type": "string",
        "title": "Windy Webcams API Key",
        "description": "Get a free key at https://api.windy.com/keys",
        "x-openmapx-secret": true
      },
      "npsApiKey": {
        "type": "string",
        "title": "NPS API Key",
        "description": "Get a free key at https://developer.nps.gov/signup/",
        "x-openmapx-secret": true
      },
      "dotGaApiKey": {
        "type": "string",
        "title": "Georgia 511 API Key",
        "description": "Register at https://511ga.org/my511/register",
        "x-openmapx-secret": true
      },
      "dotFlApiKey": {
        "type": "string",
        "title": "Florida 511 API Key",
        "description": "Register at https://fl511.com/my511/register",
        "x-openmapx-secret": true
      },
      "dotAzApiKey": {
        "type": "string",
        "title": "Arizona 511 API Key",
        "description": "Register at https://az511.com/my511/register",
        "x-openmapx-secret": true
      },
      "dotIdApiKey": {
        "type": "string",
        "title": "Idaho 511 API Key",
        "description": "Register at https://511.idaho.gov/my511/register",
        "x-openmapx-secret": true
      },
      "dotUtApiKey": {
        "type": "string",
        "title": "Utah 511 API Key",
        "description": "Register at https://prod-ut.ibi511.com/my511/register",
        "x-openmapx-secret": true
      },
      "dotLaApiKey": {
        "type": "string",
        "title": "Louisiana 511 API Key",
        "description": "Register at https://511la.org/my511/register",
        "x-openmapx-secret": true
      },
      "dotPaApiKey": {
        "type": "string",
        "title": "Pennsylvania 511 API Key",
        "description": "Register at https://www.511pa.com/my511/register",
        "x-openmapx-secret": true
      },
      "dotScApiKey": {
        "type": "string",
        "title": "South Carolina 511 API Key",
        "description": "Register at https://511sc.org/my511/register",
        "x-openmapx-secret": true
      },
      "dotMaApiKey": {
        "type": "string",
        "title": "Massachusetts 511 API Key",
        "description": "Register at https://www.mass511.com/my511/register",
        "x-openmapx-secret": true
      }
    }
  },
  "envVars": [
    "WINDY_WEBCAMS_API_KEY",
    "NPS_API_KEY",
    "DOT_GA_API_KEY",
    "DOT_FL_API_KEY",
    "DOT_AZ_API_KEY",
    "DOT_ID_API_KEY",
    "DOT_UT_API_KEY",
    "DOT_LA_API_KEY",
    "DOT_PA_API_KEY",
    "DOT_SC_API_KEY",
    "DOT_MA_API_KEY"
  ],
  "healthCheck": [
    {
      "name": "Windy Webcams",
      "type": "http",
      "urlTemplate": "https://api.windy.com/webcams/api/v3/webcams?limit=1",
      "headers": { "x-windy-api-key": "${WINDY_WEBCAMS_API_KEY}" },
      "requiredEnvVars": ["WINDY_WEBCAMS_API_KEY"]
    },
    {
      "name": "NPS Webcams",
      "type": "http",
      "urlTemplate": "https://developer.nps.gov/api/v1/webcams?limit=1&api_key=${NPS_API_KEY}",
      "requiredEnvVars": ["NPS_API_KEY"]
    },
    {
      "name": "Caltrans CCTV",
      "type": "http",
      "url": "https://cwwp2.dot.ca.gov/data/d7/cctv/cctvStatusD07.json"
    },
    {
