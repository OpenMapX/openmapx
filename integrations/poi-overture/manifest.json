{
  "id": "poi-overture",
  "name": "Overture Places POI Search",
  "version": "1.0.0",
  "domains": ["poi-search"],
  "dependencies": ["poi-search"],
  "requires": [{ "service": "postgis", "optional": false }],
  "backend": {
    "routes": false
  },
  "configSchema": {
    "type": "object",
    "properties": {
      "enabled": { "type": "boolean", "default": false }
    }
  },
  "healthCheck": { "type": "custom" },
  "dataSources": [
    {
      "sourceId": "overture",
      "name": "Overture Maps",
      "url": "https://overturemaps.org",
      "license": "CDLA-Permissive-2.0",
      "attribution": "© Overture Maps Foundation contributors (Meta, Microsoft, PinMeTo, AllThePlaces)",
      "providerCountry": "US",
      "providerPrivacyUrl": "https://overturemaps.org/privacy/",
      "endUserExposure": "server-only"
    },
    {
      "sourceId": "foursquare",
      "name": "Foursquare",
      "url": "https://foursquare.com",
      "license": "Apache-2.0",
      "providerCountry": "US",
      "providerPrivacyUrl": "https://location.foursquare.com/legal/fsq-privacy-statement/",
      "endUserExposure": "server-only"
    }
  ]
}
