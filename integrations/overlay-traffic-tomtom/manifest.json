{
  "id": "overlay-traffic-tomtom",
  "version": "1.0.0",
  "author": "OpenMapX",
  "license": "MIT",
  "documentation": "https://developer.tomtom.com/traffic-api/documentation",
  "domains": ["map-overlay"],
  "frontend": {
    "mapLayer": true,
    "legend": false,
    "panel": false,
    "layerSelector": {
      "group": "map-details",
      "labelKey": "trafficTomtom",
      "icon": "traffic",
      "quickSelector": true,
      "preview": "preview.svg"
    },
    "overlay": {
      "excludes": ["traffic-flow"],
      "minZoom": 10
    }
  },
  "backend": {
    "routes": false
  },
  "configSchema": {
    "type": "object",
    "properties": {
      "enabled": {
        "type": "boolean",
        "default": true
      },
      "apiKey": {
        "type": "string",
        "title": "TomTom Traffic API Key",
        "description": "TomTom Traffic API key.",
        "x-openmapx-secret": true,
        "x-openmapx-setup": {
          "url": "https://developer.tomtom.com/",
          "urlLabel": "Get TomTom API key",
          "steps": [
            "Register for a free account on the TomTom Developer Portal at developer.tomtom.com.",
            "Open the Dashboard / 'My APIs & SDKs' key-management area.",
            "Use the auto-created 'My first API key' or add a new key.",
            "Copy the API key."
          ],
          "cost": "Free Freemium tier: 2,500 non-tile + 50,000 tile requests/day, no credit card.",
          "notes": "Freemium tier permits commercial use; rate limit ~5 calls/sec for non-tile APIs."
        }
      }
    }
  },
  "healthCheck": {
    "type": "http",
    "urlTemplate": "https://api.tomtom.com/traffic/map/4/tile/flow/relative-delay/0/0/0.png?key=${apiKey}&tileSize=256",
    "requiredConfigKeys": ["apiKey"]
  },
  "quality": "built-in",
  "category": "Traffic",
  "dataSources": [
    {
      "sourceId": "tomtom",
      "name": "TomTom",
      "url": "https://developer.tomtom.com/",
      "license": "Proprietary",
      "licenseUrl": "https://developer.tomtom.com/terms-and-conditions",
      "attribution": "© <a href=\"https://www.tomtom.com/\">TomTom</a>",
      "commercialUse": "yes",
      "providerCountry": "NL",
      "providerPrivacyUrl": "https://www.tomtom.com/en_us/privacy/general/",
      "endUserExposure": "proxied",
      "personalData": false,
      "cookies": false,
      "dpaAvailable": true,
      "dpaUrl": "https://www.tomtom.com/legal/en_gb/third-party-product-terms/data-processing-schedule/"
    }
  ]
}
