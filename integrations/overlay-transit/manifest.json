{
  "id": "overlay-transit",
  "version": "1.0.0",
  "author": "OpenMapX",
  "license": "MIT",
  "documentation": "https://wiki.openstreetmap.org/wiki/Public_transport",
  "domains": ["map-overlay"],
  "frontend": {
    "mapLayer": true,
    "legend": false,
    "panel": false,
    "layerSelector": {
      "group": "map-details",
      "labelKey": "transit",
      "icon": "directions_transit",
      "quickSelector": true
    },
    "overlay": {
      "excludes": []
    }
  },
  "backend": {
    "routes": false
  },
  "configSchema": {
    "type": "object",
    "properties": {
      "enabled": {
        "type": "boolean",
        "default": true
      }
    }
  },
  "envVars": [],
  "healthCheck": {
    "type": "http",
    "url": "https://tile.openstreetmap.org/0/0/0.png"
  },
  "quality": "built-in",
  "category": "Transit",
  "attribution": [
    {
      "name": "OpenStreetMap",
      "url": "https://www.openstreetmap.org/",
      "license": "ODbL"
    }
  ],
  "privacy": [
    {
      "providerCountry": "Various",
      "providerPrivacyUrl": "https://wiki.openstreetmap.org/wiki/Privacy_policy",
      "personalData": false,
      "cookies": false
    }
  ]
}
