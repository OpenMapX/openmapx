{
  "id": "geocoding-db-ris",
  "version": "1.0.0",
  "author": "OpenMapX",
  "license": "MIT",
  "domains": ["geocoding"],
  "backend": {
    "routes": false
  },
  "configSchema": {
    "type": "object",
    "properties": {
      "enabled": {
        "type": "boolean",
        "default": true
      }
    }
  },
  "envVars": ["DB_RIS_CLIENT_ID", "DB_RIS_API_KEY"],
  "healthCheck": {
    "type": "custom",
    "requiredEnvVars": ["DB_RIS_CLIENT_ID", "DB_RIS_API_KEY"],
    "category": "Geocoding"
  },
  "quality": "built-in",
  "attribution": [
    {
      "name": "Deutsche Bahn",
      "url": "https://developers.deutschebahn.com",
      "license": "DB API Terms"
    }
  ],
  "privacy": [
    {
      "providerCountry": "DE",
      "providerPrivacyUrl": "https://www.bahn.de/service/datenschutz",
      "personalData": false
    }
  ]
}
