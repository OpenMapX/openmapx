{
  "id": "geocoding-db-ris",
  "version": "1.0.0",
  "author": "OpenMapX",
  "license": "MIT",
  "domains": ["geocoding"],
  "dependencies": ["geocoding"],
  "backend": {
    "routes": false
  },
  "configSchema": {
    "type": "object",
    "properties": {
      "enabled": {
        "type": "boolean",
        "default": true
      },
      "clientId": {
        "type": "string",
        "title": "DB RIS Stations Client ID",
        "description": "Deutsche Bahn RIS API client ID.",
        "x-openmapx-secret": true
      },
      "apiKey": {
        "type": "string",
        "title": "DB RIS Stations API Key",
        "description": "Deutsche Bahn RIS API key.",
        "x-openmapx-secret": true,
        "x-openmapx-sharedSecretName": "db-ris-api-key"
      }
    }
  },
  "healthCheck": {
    "type": "custom",
    "requiredConfigKeys": ["clientId", "apiKey"]
  },
  "quality": "built-in",
  "category": "Geocoding",
  "dataSources": [
    {
      "sourceId": "db-ris-stations",
      "name": "Deutsche Bahn RIS Stations",
      "url": "https://apis.deutschebahn.com/",
      "license": "Proprietary (bilateral license)",
      "licenseUrl": "https://developers.deutschebahn.com/db-api-marketplace/apis/nutzungsbedingungen",
      "commercialUse": "conditional",
      "providerCountry": "DE",
      "providerPrivacyUrl": "https://developers.deutschebahn.com/db-api-marketplace/apis/privacypolicy",
      "endUserExposure": "server-only",
      "personalData": false,
      "cookies": false,
      "dpaAvailable": false
    }
  ]
}
