{
  "id": "routing-valhalla",
  "version": "1.0.0",
  "author": "OpenMapX",
  "license": "MIT",
  "domains": ["routing"],
  "dependencies": ["routing"],
  "infrastructure": {
    "dataRequirements": ["osm-pbf"]
  },
  "backend": {
    "routes": false
  },
  "configSchema": {
    "type": "object",
    "properties": {
      "enabled": {
        "type": "boolean",
        "default": true
      },
      "endpoint": {
        "type": "string",
        "title": "Valhalla endpoint URL",
        "description": "Base URL of the Valhalla server. Leave blank to use the public FOSSGIS instance or a self-hosted service resolved via the `valhalla` capability.",
        "format": "url"
      }
    }
  },
  "healthCheck": {
    "type": "ping",
    "url": "https://valhalla1.openstreetmap.de/status"
  },
  "quality": "built-in",
  "category": "Routing",
  "dataSources": [
    {
      "sourceId": "valhalla",
      "name": "Valhalla",
      "url": "https://github.com/valhalla/valhalla",
      "license": "MIT (software); fair-use demo server",
      "licenseUrl": "https://github.com/valhalla/valhalla/blob/master/COPYING",
      "attribution": "<a href=\"https://github.com/valhalla/valhalla\">Valhalla</a>, © <a href=\"https://www.openstreetmap.org/copyright\">OpenStreetMap contributors</a>",
      "commercialUse": "yes",
      "providerCountry": "DE",
      "providerPrivacyUrl": "https://www.fossgis.de/datenschutzerkl%C3%A4rung/",
      "endUserExposure": "server-only",
      "personalData": false,
      "cookies": false,
      "dpaAvailable": false
    }
  ],
  "requires": [
    {
      "service": "valhalla",
      "optional": true
    }
  ]
}
