{
  "id": "geocoding-photon",
  "version": "1.0.0",
  "author": "OpenMapX",
  "license": "MIT",
  "subjectData": {
    "storesPersonalData": false,
    "strategy": "not_personal",
    "registrationIds": [],
    "operatorInstructions": null
  },
  "domains": ["geocoding"],
  "dependencies": ["geocoding"],
  "backend": {
    "routes": false
  },
  "configSchema": {
    "type": "object",
    "properties": {
      "enabled": {
        "type": "boolean",
        "default": true
      },
      "endpoint": {
        "type": "string",
        "title": "Photon endpoint URL",
        "description": "Base URL of the Photon server. Leave blank to use the public Komoot instance or a self-hosted service resolved via the `photon` capability.",
        "format": "url"
      }
    }
  },
  "healthCheck": {
    "type": "http",
    "url": "https://photon.komoot.io/api?q=test&limit=1"
  },
  "quality": "built-in",
  "category": "Geocoding",
  "dataSources": [
    {
      "sourceId": "photon",
      "name": "Photon",
      "url": "https://github.com/komoot/photon",
      "license": "Apache License 2.0 (software); ODbL (OSM data)",
      "licenseUrl": "https://github.com/komoot/photon/blob/master/LICENSE",
      "attribution": "© <a href=\"https://www.openstreetmap.org/copyright\">OpenStreetMap contributors</a>",
      "notes": "Self-hosted or other operator-configured Photon endpoint. Requests stay with the instance operator's chosen host.",
      "commercialUse": "yes",
      "providerCountry": "XX",
      "providerPrivacyUrl": "https://github.com/komoot/photon",
      "endUserExposure": "server-only",
      "personalData": false,
      "cookies": false,
      "dpaAvailable": false
    },
    {
      "sourceId": "komoot",
      "name": "Photon (Komoot)",
      "url": "https://photon.komoot.io/",
      "license": "Apache License 2.0 (software); ODbL (OSM data)",
      "licenseUrl": "https://github.com/komoot/photon/blob/master/LICENSE",
      "attribution": "© <a href=\"https://www.openstreetmap.org/copyright\">OpenStreetMap contributors</a>",
      "commercialUse": "yes",
      "providerCountry": "DE",
      "providerPrivacyUrl": "https://www.komoot.com/privacy",
      "endUserExposure": "server-only",
      "personalData": false,
      "cookies": false,
      "dpaAvailable": false,
      "notes": "Komoot's public Photon instance, used only when no self-hosted or other endpoint is configured."
    }
  ],
  "requires": [
    {
      "service": "photon",
      "optional": true
    }
  ]
}
