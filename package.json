{
  "name": "openmapx",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "start": "turbo run start",
    "lint": "biome check . && prettier --check \"**/*.{md,yml,yaml}\" && pnpm check-translations",
    "format": "biome format --write . && prettier --write \"**/*.{md,yml,yaml}\"",
    "clean": "turbo clean && rm -rf node_modules",
    "check-types": "turbo run check-types && pnpm discovery-eval:check-types",
    "check-dead-code": "knip --no-progress --reporter compact && pnpm check-unused-exports",
    "check-unused-exports": "knip --no-progress --reporter compact --workspace apps/ops-agent --workspace apps/transitous-runner --include exports,types --exclude files,dependencies",
    "check-duplicates": "jscpd --config .jscpd.json --cross-formats js-ts --no-tips apps packages integrations services scripts",
    "check-infrastructure": "bash scripts/check-infrastructure.sh",
    "test": "vitest run",
    "test:database": "node scripts/test-database.mjs",
    "test:watch": "vitest",
    "test:coverage": "OPENMAPX_SKIP_SLOW_CRYPTO=1 vitest run --coverage",
    "prepare": "husky",
    "redis:flush": "docker exec docker-redis-1 redis-cli FLUSHALL",
    "mobile:doctor": "pnpm -C apps/mobile run doctor",
    "mobile:prebuild": "pnpm -C apps/mobile run prebuild",
    "mobile:verify": "pnpm -C apps/mobile run test && pnpm -C apps/mobile run test:native && pnpm -C apps/mobile run check-types && pnpm -C apps/mobile run doctor",
    "mobile:prebuild:check": "pnpm -C apps/mobile exec tsx scripts/clean-prebuild-check.mts",
    "mobile:bundle:check": "pnpm -C apps/mobile exec tsx scripts/check-background-bundle.mts",
    "mobile:qa:validate": "pnpm -C apps/mobile exec tsx qa/validate-report.mts",
    "mobile:smoke": "pnpm -C apps/mobile exec tsx scripts/run-maestro.mts",
    "mobile:build:android": "pnpm -C apps/mobile exec expo run:android --variant release",
    "mobile:build:ios": "pnpm -C apps/mobile exec expo run:ios --configuration Release",
    "check-translations": "pnpm -C packages/i18n exec tsx scripts/check-translations.ts",
    "check-data-flows": "pnpm -C packages/cli exec tsx ../../scripts/check-data-flows.ts",
    "check-subject-data": "pnpm -C packages/cli exec tsx ../../scripts/check-subject-data.ts",
    "check-dockerfile-sync": "pnpm -C packages/cli exec tsx ../../scripts/check-dockerfile-workspace-sync.ts",
    "check-docker-context-secrets": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/check-docker-context-secrets.ts",
    "check-ops-authority": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/check-ops-authority.ts",
    "check-service-files": "node scripts/service-files.mjs --check",
    "generate:service-files": "node scripts/service-files.mjs",
    "check-feed-ids": "pnpm -C packages/cli exec tsx ../../scripts/check-feed-ids.ts",
    "check-credential-keys": "pnpm -C packages/cli exec tsx ../../scripts/check-credential-keys.ts",
    "check-legal-tables": "pnpm -C packages/cli exec tsx ../../scripts/check-legal-tables.ts",
    "check-legal-updated": "pnpm -C packages/cli exec tsx ../../scripts/check-legal-updated.ts",
    "check-legal-urls": "pnpm -C packages/cli exec tsx ../../scripts/check-legal-urls.ts",
    "check-routing-canaries": "pnpm -C packages/cli exec tsx ../../scripts/check-routing-canaries.ts",
    "check-license-metadata": "pnpm -C packages/cli exec tsx ../../scripts/check-license-metadata.ts",
    "check-air-quality-release-gates": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/check-air-quality-release-gates.ts",
    "bench-air-quality": "pnpm -C packages/cli exec tsx ../../scripts/bench-air-quality.ts",
    "discovery-eval:check-types": "tsc -p scripts/discovery-eval/tsconfig.json",
    "discovery-eval": "pnpm -C packages/cli exec tsx ../../scripts/discovery-eval/run.ts",
    "search-eval:record": "pnpm -C packages/cli exec tsx ../../scripts/record-search-eval.mts",
    "check-toolchain-pins": "pnpm -C packages/cli exec tsx ../../scripts/check-toolchain-pins.ts",
    "pin:gbfs-catalog": "pnpm -C packages/cli exec tsx ../../scripts/pin-gbfs-catalog.ts",
    "pin:transport-apis": "pnpm -C packages/cli exec tsx ../../scripts/pin-transport-apis.ts",
    "check-production-audits": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/check-production-audits.ts",
    "check:policy": "pnpm check-legal-tables && pnpm check-legal-updated && pnpm check-data-flows && pnpm check-subject-data && pnpm check-license-metadata && pnpm check-air-quality-release-gates && pnpm check-toolchain-pins && pnpm check-feed-ids && pnpm check-credential-keys && pnpm check-dockerfile-sync && pnpm check-image-size-dos && pnpm check-docker-context-secrets && pnpm check-ops-authority && pnpm check-entur-graphql && pnpm check-entur-geocoder && pnpm check-mbta && pnpm check-otp && pnpm check-api-sdk && pnpm check-data-manager-openapi && pnpm check-data-manager-sdk",
    "check-openapi": "pnpm -C apps/api exec tsx scripts/openapi/generate.ts --check",
    "validate:privacy-release": "node scripts/validate-privacy-release.mjs",
    "check-packed-packages": "node scripts/check-packed-packages.mjs",
    "check-image-size-dos": "node scripts/check-image-size-dos.mjs",
    "openapi:generate": "pnpm -C apps/api exec tsx scripts/openapi/generate.ts",
    "gen-ev-vehicles": "pnpm -C packages/cli exec tsx ../../scripts/ev-vehicles/generate.ts",
    "openmapx": "pnpm -C packages/cli exec tsx src/index.ts",
    "mobile:release:prepare": "pnpm -C apps/mobile exec tsx release/prepare.mts",
    "mobile:release:ios": "pnpm -C apps/mobile exec tsx release/build-ios.mts",
    "mobile:release:android": "pnpm -C apps/mobile exec tsx release/build-android.mts",
    "mobile:release:verify": "pnpm -C apps/mobile exec tsx release/verify-artifact.mts",
    "verify:full": "sh scripts/verify-full.sh",
    "check-release-information": "node scripts/check-release-information.mjs",
    "entur:generate": "node scripts/entur/codegen.mjs",
    "check-entur-graphql": "node scripts/entur/codegen.mjs --check",
    "entur:refresh-schemas": "node scripts/entur/refresh-schemas.mjs",
    "sdk:generate": "node scripts/api-sdk/codegen.mjs",
    "check-api-sdk": "node scripts/api-sdk/codegen.mjs --check",
    "data-manager:openapi:generate": "pnpm -C services/data-manager exec tsx scripts/openapi/generate.ts",
    "check-data-manager-openapi": "pnpm -C services/data-manager exec tsx scripts/openapi/generate.ts --check",
    "data-manager:sdk:generate": "node scripts/data-manager-sdk/codegen.mjs",
    "check-data-manager-sdk": "node scripts/data-manager-sdk/codegen.mjs --check",
    "entur-geocoder:generate": "node scripts/entur-geocoder/codegen.mjs",
    "check-entur-geocoder": "node scripts/entur-geocoder/codegen.mjs --check",
    "mbta:generate": "node scripts/mbta/codegen.mjs",
    "check-mbta": "node scripts/mbta/codegen.mjs --check",
    "otp:generate": "node packages/otp-codegen/generate.mjs",
    "check-otp": "node packages/otp-codegen/generate.mjs --check"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@changesets/cli": "3.0.3",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@graphql-codegen/cli": "7.4.6",
    "@graphql-codegen/typed-document-node": "7.2.0",
    "@graphql-codegen/typescript-operations": "6.2.0",
    "@scalar/openapi-parser": "^0.29.18",
    "@vitest/coverage-v8": "^5.0.5",
    "esbuild": "^0.28.2",
    "graphql": "17.0.2",
    "husky": "^9.1.7",
    "jscpd": "^5.4.2",
    "knip": "^6.43.0",
    "orval": "8.45.0",
    "p-map": "7.1.1",
    "prettier": "^3.9.10",
    "turbo": "^2.11.10",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5",
    "yaml": "^2.9.1"
  },
  "packageManager": "pnpm@12.16.1+sha512.091d1dee7927575661b25dab3c2ae31cafc1c54d6b71ed6a6600cf0c1cb10434a447eae14015f1b23e2e6bedeed79df94a932e2164d2832280dce3fb32f656d1",
  "engines": {
    "node": ">=24.22.2"
  }
}
