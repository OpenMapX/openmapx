{
  "$schema": "https://biomejs.dev/schemas/2.6.5/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!node_modules",
      "!.next",
      "!dist",
      "!.turbo",
      "!apps/web/public/sw.js",
      "!**/*.svg",
      "!**/db/migrations",
      "!**/__fixtures__",
      "!infra/docker/data",
      "!docs",
      "!apps/api/openapi.json",
      "!services/data-manager/openapi.json",
      "!packages/entur-client/schema/geocoder.openapi.json",
      "!packages/otp-client/schema/*.graphql",
      "!integrations/transit-mbta/schema/swagger.json",
      "!packages/brands/src/data/brands-index.json",
      "!integrations/overlay-sun-time/data/timezones.simplified.json"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "css": {
    "formatter": {
      "enabled": false
    },
    "linter": {
      "enabled": false
    }
  },
  "markdown": {
    "formatter": {
      "enabled": false
    },
    "linter": {
      "enabled": false
    }
  },
  "yaml": {
    "formatter": {
      "enabled": false
    },
    "linter": {
      "enabled": false
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "nursery": {
        "noFloatingPromises": "error"
      },
      "suspicious": {
        "noImportCycles": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": ["**/*.test.ts", "**/*.test.tsx", "**/test/**"],
      "linter": {
        "rules": {
          "correctness": {
            "noComponentHookFactories": "off",
            "noUnsafeOptionalChaining": "off"
          }
        }
      }
    },
    {
      "includes": [
        "services/data-manager/src/jobs/**",
        "!services/data-manager/src/jobs/overture/eval/**",
        "!**/*.test.ts"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "error"
          }
        }
      }
    },
    {
      "includes": [
        "apps/web/src/**",
        "integrations/**",
        "!apps/web/src/components/ui/Dialog.tsx",
        "!apps/web/src/components/ui/Menu.tsx",
        "!apps/web/src/components/ui/Popover.tsx",
        "!**/*.test.ts",
        "!**/*.test.tsx"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "@mui/material/Dialog": "Use @/components/ui/Dialog (integrations: @/integration-api/components/Dialog), which the Back gesture closes.",
                  "@mui/material/Menu": "Use @/components/ui/Menu, which the Back gesture closes.",
                  "@mui/material/Popover": "Use @/components/ui/Popover, which the Back gesture closes.",
                  "@mui/material": {
                    "importNames": ["Dialog", "Menu", "Popover"],
                    "message": "Use the Back-aware wrappers in @/components/ui (Dialog, Menu, Popover)."
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": ["integrations/**"],
      "linter": {
        "domains": {
          "react": "recommended"
        }
      }
    },
    {
      "includes": ["apps/web/src/**", "integrations/**", "!**/*.test.tsx"],
      "plugins": ["./scripts/biome-plugins/noClickableLayoutElement.grit"]
    },
    {
      "includes": ["integrations/overlay-tool-travel-time/transit-field-layer.ts"],
      "linter": {
        "rules": {
          "correctness": {
            "useHookAtTopLevel": "off"
          }
        }
      }
    }
  ],
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
