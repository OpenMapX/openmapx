{
  "$schema": "https://biomejs.dev/schemas/2.6.6/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!node_modules",
      "!.next",
      "!dist",
      "!.turbo",
      "!apps/web/public/sw.js",
      "!**/*.svg",
      "!**/db/migrations",
      "!**/__fixtures__",
      "!infra/docker/data",
      "!docs",
      "!apps/api/openapi.json",
      "!services/data-manager/openapi.json",
      "!packages/entur-client/schema/geocoder.openapi.json",
      "!packages/otp-client/schema/*.graphql",
      "!integrations/transit-mbta/schema/swagger.json",
      "!packages/brands/src/data/brands-index.json",
      "!integrations/overlay-sun-time/data/timezones.simplified.json"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "css": {
    "formatter": {
      "enabled": false
    },
    "linter": {
      "enabled": false
    }
  },
  "markdown": {
    "formatter": {
      "enabled": false
    },
    "linter": {
      "enabled": false
    }
  },
  "yaml": {
    "formatter": {
      "enabled": false
    },
    "linter": {
      "enabled": false
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "nursery": {
        "noFloatingPromises": "error"
      },
      "suspicious": {
        "noImportCycles": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": ["**/*.test.ts", "**/*.test.tsx", "**/test/**"],
      "linter": {
        "rules": {
          "correctness": {
            "noComponentHookFactories": "off",
            "noUnsafeOptionalChaining": "off"
          }
        }
      }
    },
    {
      "includes": ["apps/api/src/**", "!**/*.test.ts", "!**/__tests__/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "error"
          }
        }
      }
    },
    {
      "includes": [
        "services/data-manager/src/jobs/**",
        "!services/data-manager/src/jobs/overture/eval/**",
        "!**/*.test.ts"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "error"
          }
        }
      }
    },
    {
      "includes": [
        "apps/web/src/**",
        "integrations/**",
        "!apps/web/src/components/ui/Dialog.tsx",
        "!apps/web/src/components/ui/Menu.tsx",
        "!apps/web/src/components/ui/Popover.tsx",
        "!**/*.test.ts",
        "!**/*.test.tsx"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "@mui/material/Dialog": "Use @/components/ui/Dialog (integrations: @/integration-api/components/Dialog), which the Back gesture closes.",
                  "@mui/material/Menu": "Use @/components/ui/Menu, which the Back gesture closes.",
                  "@mui/material/Popover": "Use @/components/ui/Popover, which the Back gesture closes.",
                  "@mui/material": {
                    "importNames": ["Dialog", "Menu", "Popover"],
                    "message": "Use the Back-aware wrappers in @/components/ui (Dialog, Menu, Popover)."
                  },
                  "@openmapx/i18n": "This barrel bundles every message catalogue. In client code import @openmapx/i18n/locale (locales, resolveLocale) or @openmapx/i18n/navigationCuesCompact (spoken cues); server-only code may suppress this with a reason."
                },
                "patterns": [
                  {
                    "group": [
                      "@openmapx/i18n/index",
                      "@openmapx/i18n/config",
                      "@openmapx/i18n/translator",
                      "@openmapx/i18n/navigationCues",
                      "@openmapx/i18n/locales/*"
                    ],
                    "message": "This module bundles every message catalogue. In client code import @openmapx/i18n/locale or @openmapx/i18n/navigationCuesCompact; server-only code may suppress this with a reason."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["integrations/**"],
      "linter": {
        "domains": {
          "react": "recommended"
        }
      }
    },
    {
      "includes": ["apps/web/src/**", "integrations/**", "!**/*.test.tsx"],
      "plugins": ["./scripts/biome-plugins/noClickableLayoutElement.grit"]
    },
    {
      "includes": [
        "apps/web/src/components/admin/**",
        "apps/web/src/app/admin/**",
        "!**/*.test.ts",
        "!**/*.test.tsx",
        "!**/__tests__/**",
        "!**/*.test-support.ts",
        "!**/*.test-support.tsx",
        "!apps/web/src/components/admin/cache/**",
        "!apps/web/src/components/admin/settings/**",
        "!apps/web/src/components/admin/system/**",
        "!apps/web/src/components/admin/activity/AppLogViewer.tsx",
        "!apps/web/src/components/admin/activity/AuditLog.tsx",
        "!apps/web/src/app/admin/(full-admin)/system/cache/**",
        "!apps/web/src/app/admin/(full-admin)/data/coverage/**",
        "!apps/web/src/app/admin/(full-admin)/settings/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noJsxLiterals": {
              "level": "error",
              "options": {
                "allowedStrings": [
                  "·",
                  "—",
                  "–",
                  "…",
                  "(",
                  ")",
                  ":",
                  "/",
                  "%",
                  ".",
                  ",",
                  "v",
                  "+",
                  "×",
                  "→"
                ]
              }
            }
          }
        }
      },
      "plugins": [
        "./scripts/biome-plugins/noLiteralCopy.grit",
        "./scripts/biome-plugins/noRawCodeCopy.grit"
      ]
    },
    {
      "includes": [
        "apps/web/src/lib/admin/**",
        "!**/*.test.ts",
        "!**/*.test.tsx",
        "!**/__tests__/**",
        "!**/*.test-support.ts",
        "!**/*.test-support.tsx"
      ],
      "plugins": ["./scripts/biome-plugins/noLiteralCopy.grit"]
    },
    {
      "includes": ["integrations/overlay-tool-travel-time/transit-field-layer.ts"],
      "linter": {
        "rules": {
          "correctness": {
            "useHookAtTopLevel": "off"
          }
        }
      }
    },
    {
      "includes": ["apps/api/src/services/__tests__/crash-points/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "@openmapx/core/build-artifacts": "The crash-point suite observes the system from outside: not the signed control layer.",
                  "@openmapx/ops-agent": "The crash-point suite observes the system from outside: not the agent's sources.",
                  "@openmapx/data-manager": "The crash-point suite observes the system from outside: not the data-manager's sources."
                },
                "patterns": [
                  {
                    "group": [
                      "@openmapx/core/build-artifacts/*",
                      "@openmapx/ops-agent/*",
                      "@openmapx/data-manager/*",
                      "**/core/src/build-artifacts",
                      "**/core/src/build-artifacts/**",
                      "**/ops-agent/src",
                      "**/ops-agent/src/**",
                      "**/data-manager/src",
                      "**/data-manager/src/**"
                    ],
                    "message": "The crash-point suite observes the system from outside: not the control layer, the agent or the data-manager."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/api/src/services/__tests__/crash-points/scenarios/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**", "!vitest", "!../driver", "!../scenario"],
                    "message": "Crash-point scenarios talk to the system only through the driver."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ],
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
