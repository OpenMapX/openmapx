# Expo CNG outputs and local mobile credentials.
# `ios/` and `android/` at the app root are generated by `expo prebuild` and are
# build output, never a second maintained codebase. The module directories below
# are committed source; only their compiler output is ignored.
apps/mobile/ios/
apps/mobile/android/
apps/mobile/.expo/
apps/mobile/.gradle/
apps/mobile/*.jks
apps/mobile/*.keystore
apps/mobile/*.mobileprovision
apps/mobile/*.p12
apps/mobile/*.ipa
apps/mobile/*.aab
apps/mobile/*.apk
apps/mobile/qa/results/raw/

# Local Expo module build output (SwiftPM, Gradle, Xcode).
apps/mobile/modules/*/.build/
apps/mobile/modules/*/.swiftpm/
apps/mobile/modules/*/android/build/
apps/mobile/modules/*/android/.gradle/
apps/mobile/modules/*/Package.resolved

# Locally built release artifacts, symbols and provenance output.
dist/mobile/

# Generated Traefik file-provider routing (produced by `openmapx compose render`).
services/traefik/config/dynamic/generated-routes.yml
