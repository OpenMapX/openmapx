# URLs lychee should not check (regex, one per line).

# Local / example hosts that only resolve inside a deployment.
^https?://localhost
^https?://127\.0\.0\.1
^https?://0\.0\.0\.0
^https?://([a-z0-9-]+\.)*example\.(com|org)

# Badge endpoint is generated on first Scorecard run; 404s until then.
^https://api\.scorecard\.dev/

# Private repo paths (security advisories, settings) require auth.
^https://github\.com/OpenMapX/openmapx/security/

# npm package page returns 403 to lychee although the documentation link is valid.
^https://www\.npmjs\.com/package/@openmapx/extension-sdk$

# OTP GraphQL API endpoints accept POST queries only; a plain GET returns 405/500.
^https://api\.stadtnavi\.de/otp/gtfs/v1$
^https://api\.peatus\.ee/routing/v1/routers/estonia/index/graphql$
^https://mapi\.5t\.torino\.it/routing/v1/routers/mat/index/graphql$
^https://otp281\.trufi\.app/otp/transmodel/v3$

# Digitransit returns 403 to automated link checkers; the pages work in a browser.
^https://digitransit\.fi/en/developers/
